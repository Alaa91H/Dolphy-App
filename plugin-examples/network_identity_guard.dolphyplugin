import html
import json
import random
import re
import time

__id__ = "network_identity_guard"
__name__ = "Network Identity Guard"
__version__ = "1.0.0"
__author__ = "Dolphy"
__description__ = "Audit the network identity apps can see and rotate the Wi-Fi MAC with verified results"
__icon__ = "rounded:security"
__permissions__ = ["wifi", "bluetooth", "root", "files"]

STORE_PATHS = (
    "/data/misc/apexdata/com.android.wifi/WifiConfigStore.xml",
    "/data/misc/wifi/WifiConfigStore.xml",
    "/data/misc/apexdata/com.android.wifi/misc/WifiConfigStore.xml",
)
STORE_COMMAND = "for f in " + " ".join(STORE_PATHS) + "; do [ -f \"$f\" ] && cat \"$f\" && break; done"
REPORT_PATH = "reports/network_identity_audit.txt"
EXPORT_KEY = "dolphy.net.identity.audit"
SERVICE_ID = "net.identity"

MAC_RE = re.compile(r"^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}$")
IFACE_RE = re.compile(r"^[A-Za-z0-9_.-]{1,32}$")
NETWORK_RE = re.compile(r"<(?:Network|network)\b[^>]*>(.*?)</(?:Network|network)>", re.S)

