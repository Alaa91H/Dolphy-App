import json

__id__ = "ble_advert_lab"
__name__ = "BLE Advert Lab"
__version__ = "1.1.0"
__author__ = "Dolphy"
__description__ = "Compose custom BLE advertising packets and broadcast them"
__icon__ = "rounded:radar"
__permissions__ = ["ble_spam", "bluetooth"]

# User-interface translations (Arabic, English and Russian).
__i18n__ = {"ar":{"Idle":"خامل","Start":"بدء","Stop":"إيقاف","No":"لا","Bluetooth on":"البلوتوث مفعّل","Bluetooth off":"البلوتوث معطّل","Advertiser":"المعلن","No advertiser":"لا يوجد معلن","Broadcasting":"جارٍ البث","Start advertising":"بدء البث","Stop advertising":"إيقاف البث","None":"لا شيء","Custom advertising":"إعلان مخصص","Manufacturer data broadcast":"بث بيانات المُصنّع","Packet":"الحزمة","Packet preview":"معاينة الحزمة","Manufacturer id must be 0-65535":"يجب أن يكون معرّف المُصنّع بين 0 و65535","Payload must be even-length hexadecimal (max 27 bytes)":"يجب أن تكون الحمولة سداسية عشرية بطول زوجي (بحد أقصى 27 بايت)","Advertiser unavailable or rejected the packet":"المعلن غير متاح أو رفض الحزمة","Advertising stopped":"تم إيقاف البث","Manufacturer data":"بيانات المُصنّع","Manufacturer":"المُصنّع","Connectable":"قابل للاتصال","Payload":"الحمولة","All":"الكل","Build":"البناء","Device":"الجهاز","Bluetooth name":"اسم البلوتوث","unavailable":"غير متاح","no":"لا","Android":"Android","BLE Advert Lab":"مختبر إعلانات BLE","Build manufacturer data and broadcast a custom BLE advertisement":"أنشئ بيانات المُصنّع وابث إعلان BLE مخصصًا","Include device name":"تضمين اسم الجهاز","Adds the Bluetooth name to the advertisement":"يضيف اسم البلوتوث إلى الإعلان","Allows a central device to connect":"يسمح لجهاز مركزي بالاتصال","bytes":"بايت","max":"بحد أقصى","flags: LE general discoverable":"الأعلام: LE عام قابل للاكتشاف","manufacturer id: 0x":"معرّف المُصنّع: 0x","manufacturer data:":"بيانات المُصنّع:","invalid":"غير صالح"},"ru":{"Idle":"Ожидание","Start":"Запустить","Stop":"Остановить","No":"Нет","Bluetooth on":"Bluetooth включён","Bluetooth off":"Bluetooth выключен","Advertiser":"Рекламодатель","No advertiser":"Нет рекламодателя","Broadcasting":"Идёт вещание","Start advertising":"Начать вещание","Stop advertising":"Остановить вещание","None":"Нет","Custom advertising":"Пользовательская реклама","Manufacturer data broadcast":"Вещание данных производителя","Packet":"Пакет","Packet preview":"Предпросмотр пакета","Manufacturer id must be 0-65535":"ID производителя должен быть от 0 до 65535","Payload must be even-length hexadecimal (max 27 bytes)":"Данные должны быть шестнадцатеричными чётной длины (до 27 байт)","Advertiser unavailable or rejected the packet":"Рекламодатель недоступен или отклонил пакет","Advertising stopped":"Вещание остановлено","Manufacturer data":"Данные производителя","Manufacturer":"Производитель","Connectable":"С возможностью подключения","Payload":"Полезная нагрузка","All":"Все","Build":"Сборка","Device":"Устройство","Bluetooth name":"Имя Bluetooth","unavailable":"недоступно","no":"нет","Android":"Android","BLE Advert Lab":"Лаборатория BLE-рекламы","Build manufacturer data and broadcast a custom BLE advertisement":"Создавайте данные производителя и транслируйте BLE-объявление","Include device name":"Включить имя устройства","Adds the Bluetooth name to the advertisement":"Добавляет имя Bluetooth в объявление","Allows a central device to connect":"Позволяет центральному устройству подключиться","bytes":"байт","max":"макс.","flags: LE general discoverable":"Флаги: LE general discoverable","manufacturer id: 0x":"ID производителя: 0x","manufacturer data:":"Данные производителя:","invalid":"недопустимо"}}





SAMPLE_PAYLOAD = "444F4C504859"


class BleAdvertLab(BasePlugin):
    def __init__(self):
        super().__init__()
        self.manufacturer_id = "65535"
        self.payload = SAMPLE_PAYLOAD
        self.include_name = False
        self.connectable = False
        self.running = False
        self.status = "Idle"
        self.sent_packets = 0
        self.last_error = ""

    def on_plugin_load(self):
        self.add_module(
            "BLE Advert Lab",
            "Build manufacturer data and broadcast a custom BLE advertisement",
            "bluetooth",
            "main",
            "BLUETOOTH",
            40,
        )

    def on_plugin_unload(self):
        self.stop()

    def capabilities(self):
        try:
            return json.loads(str(self.api.getDevice().btCapabilitiesJson()))
        except Exception:
            return {}

    def set_manufacturer(self, value):
        self.manufacturer_id = str(value).strip()
        self.refresh()

    def set_payload(self, value):
        self.payload = str(value).strip()
        self.refresh()

    def set_include_name(self, value):
        self.include_name = bool(value)
        self.refresh()

    def set_connectable(self, value):
        self.connectable = bool(value)
        self.refresh()

    def parsed_manufacturer(self):
        try:
            return max(0, min(65535, int(str(self.manufacturer_id).strip(), 0)))
        except Exception:
            return -1

    def normalized_payload(self):
        clean = str(self.payload).replace(" ", "").replace(":", "").replace("-", "").upper()
        if not clean or len(clean) % 2 != 0 or any(char not in "0123456789ABCDEF" for char in clean):
            return ""
        if len(clean) > 54:
            return ""
        return clean

    def toggle(self):
        if self.running:
            self.stop()
            return
        manufacturer = self.parsed_manufacturer()
        payload = self.normalized_payload()
        if manufacturer < 0:
            self.status = "Manufacturer id must be 0-65535"
            self.refresh()
            return
        if not payload:
            self.status = "Payload must be even-length hexadecimal (max 27 bytes)"
            self.refresh()
            return
        android = self.api.getAndroid()
        try:
            started = bool(
                android.bleAdvertiseCustom(
                    manufacturer,
                    payload,
                    None,
                    None,
                    None,
                    self.include_name,
                    False,
                    self.connectable,
                )
            )
        except Exception as error:
            started = False
            self.last_error = str(error)
        self.running = started
        if started:
            self.sent_packets += 1
            self.status = "Advertising 0x" + format(manufacturer, "04X") + " · " + str(len(payload) // 2) + " bytes"
        else:
            self.status = "Advertiser unavailable or rejected the packet"
        self.refresh()

    def stop(self):
        if not self.running:
            self.status = "Idle"
            return
        try:
            self.api.getAndroid().bleAdvertiseStop()
        except Exception:
            pass
        self.running = False
        self.status = "Advertising stopped"
        self.refresh()

    def screen_main(self, ui, api, state):
        capabilities = self.capabilities()
        payload_bytes = len(self.normalized_payload()) // 2
        return ui.scaffold(
            title="BLE Advert Lab",
            content=ui.lazy_column(
                [
                    ui.card(
                        [
                            ui.row(
                                [
                                    ui.icon("radar", 36),
                                    ui.column(
                                        [
                                            ui.text("Custom advertising", "titleLarge"),
                                            ui.text("Manufacturer data broadcast", "bodySmall"),
                                        ],
                                        spacing=2,
                                    ),
                                ],
                                spacing=12,
                            ),
                            ui.row(
                                [
                                    ui.chip("Bluetooth on" if capabilities.get("enabled") else "Bluetooth off", bool(capabilities.get("enabled"))),
                                    ui.chip("Advertiser" if capabilities.get("leAdvertiser") else "No advertiser", bool(capabilities.get("leAdvertiser"))),
                                    ui.chip("Broadcasting" if self.running else "Idle", self.running),
                                ],
                                spacing=6,
                            ),
                            ui.text(self.status, "bodySmall"),
                            ui.text(self.last_error, "bodySmall") if self.last_error else ui.empty(),
                        ]
                    ),
                    ui.card(
                        [
                            ui.text("Packet", "titleLarge"),
                            ui.text_field(self.manufacturer_id, self.set_manufacturer, "Manufacturer id (decimal or 0xHEX)"),
                            ui.text_field(self.payload, self.set_payload, "Manufacturer data (hex)", single_line=False),
                            ui.text(str(payload_bytes) + " bytes · max 27 bytes", "bodySmall"),
                            ui.switch(self.include_name, self.set_include_name, "Include device name", "Adds the Bluetooth name to the advertisement"),
                            ui.switch(self.connectable, self.set_connectable, "Connectable", "Allows a central device to connect"),
                            ui.button("Stop advertising" if self.running else "Start advertising", self.toggle, fill_max_width=True),
                        ]
                    ),
                    ui.card(
                        [
                            ui.text("Packet preview", "titleMedium"),
                            ui.log_panel(
                                self._tr("flags: LE general discoverable")
                                + "\n"
                                + self._tr("manufacturer id: 0x")
                                + format(self.parsed_manufacturer(), "04X")
                                + "\n"
                                + self._tr("manufacturer data:")
                                + " "
                                + (self.normalized_payload() or self._tr("invalid")),
                                160,
                            ),
                        ]
                    ),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )
