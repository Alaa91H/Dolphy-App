                            actions=self._screen_actions(ui, "logs"))

    # ----------------------------------------------------------
    #  MAIN
    # ----------------------------------------------------------

    def _main_body(self, ui, page):
        with self._lock:
            result_count = len(self._results)
            busy = self._busy
        children = []
        if self._init_error:
            children.append(ui.card([
                ui.text(self._t("common_warning"), "titleSmall", color="warning"),
                ui.text(self._init_error, "bodySmall", color="muted"),
            ]))
        elif not self._ready:
            children.append(ui.card([
                ui.text(self._t("err_not_ready"), "bodyMedium", color="warning"),
            ]))
        advanced = bool(self._settings.get("advanced"))
        children.append(self._hero_card(ui))
        children.append(self._quick_start_card(ui))
        progress = self._progress_card(ui)
        if progress is not None:
            children.append(progress)
        if advanced:
            children.extend([
                self._main_stats_card(ui, result_count),
                self._generate_card(ui, busy),
                self._quick_card(ui),
            ])
        children.append(self._integration_card(ui))
        children.append(self._ethics_card(ui))
        children.append(self._nav(ui, "main"))
        return ui.lazy_column(children, padding=16, spacing=12, fill_max_size=True)

    def _hero_card(self, ui):
        return ui.card([
            ui.row([
                ui.icon("key", 40, tint="primary"),
                ui.column([
                    ui.text(self._t("app_title"), "headlineSmall"),
                    ui.text(self._t("app_subtitle"), "bodySmall", color="secondary"),
                ], spacing=2),
            ], spacing=12),
            ui.row([
                ui.chip("v" + __version__, True),
                ui.chip(self._lang_name(), False),
            ], spacing=6),
            ui.row([
                ui.chip(self._t("main_templates_count") % len(self._templates), False),
                ui.chip(self._t("main_vars_count") % len(self._vars), False),
            ], spacing=6),
        ])

    def _quick_start_card(self, ui):
        vendor, _source = self._vendor_info()
        advanced = bool(self._settings.get("advanced"))
        children = [
            ui.text(self._t("main_simple_title"), "titleSmall"),
            ui.text(self._t("main_simple_hint"), "bodySmall", color="muted"),
            ui.text_field(
                value=self._ssid,
                on_change=self._on_ssid_change,
                label=self._t("main_ssid"),
                single_line=True,
            ),
            ui.row([
                ui.button(self._t("main_detect"), self._bind(self._detect_current, False),
                          style="tonal"),
                ui.button(self._t("main_scan"), self._go("scan"), style="outlined"),
            ], spacing=8),
        ]
        if self._ssid:
            if vendor:
                children.append(ui.text(self._t("main_vendor") % vendor,
                                        "bodySmall", color="success"))
            else:
                children.append(ui.text(self._t("main_no_vendor"),
                                        "bodySmall", color="muted"))
        else:
            children.append(ui.text(self._t("main_ssid_required"), "bodySmall",
                                    color="warning"))
        children.append(ui.bounce_button(
            self._t("main_quick_start"), self._quick_start,
            enabled=not self._busy, fill_max_width=True))
        children.append(ui.text(self._t("main_ssid_hint"), "bodySmall", color="muted"))
        children.append(ui.row([
            ui.button(self._t("nav_results"), self._go("results"), style="outlined"),
            ui.button(self._t("nav_integration"), self._go("integration"), style="outlined"),
        ], spacing=8))
        children.append(ui.button(
            self._t("main_advanced_off") if advanced else self._t("main_advanced_on"),
            self._bind(self._set_toggle, "advanced", not advanced),
            style="text", fill_max_width=True))
        return ui.card(children)

    def _integration_card(self, ui):
        saved = len(self._saved_credentials)
        return ui.card([
            ui.text(self._t("integration_card_title"), "titleSmall"),
            ui.text(self._t("integration_card_hint"), "bodySmall", color="muted"),
            ui.row([
                ui.chip(self._t("integration_saved_count") % saved, saved > 0),
                ui.chip(self._t("integration_published_chip") %
                        (self._published_at or "—"), bool(self._published_at)),
            ], spacing=6),
            ui.row([
                ui.button(self._t("integration_saved_load"), self._load_passwords_async,
                          style="tonal", enabled=not self._passwords_loading),
                ui.button(self._t("nav_integration"), self._go("integration"),
                          style="outlined"),
            ], spacing=8),
        ])

    def _main_stats_card(self, ui, result_count):
        capacity = self._capacity()
        prefix = "≤ " if capacity >= ESTIMATE_CAP else "≈ "
        children = [
            ui.text(self._t("main_capacity"), "labelSmall", color="secondary"),
            ui.text(prefix + format_count(capacity), "headlineSmall"),
        ]
        last = self._last
        if last and last.get("count"):
            children.append(ui.text(
                "%s: %s" % (self._t("main_last"), format_count(last.get("count"))),
                "bodySmall", color="secondary"))
            detail = "%s · %s" % (last.get("ssid") or "—", last.get("at") or "")
            children.append(ui.text(detail, "bodySmall", color="muted"))
        else:
            children.append(ui.text(self._t("main_never"), "bodySmall", color="muted"))
        children.append(ui.row([
            ui.chip(self._t("main_results_count") % result_count, False),
            ui.chip(self._t("main_templates_count") % len(self._templates), False),
        ], spacing=6))
        return ui.card(children)

    def _generate_card(self, ui, busy):
        return ui.card([
            ui.bounce_button(
                self._t("main_generate"),
                self._start_generation,
                enabled=not busy,
                fill_max_width=True,
            ),
            ui.row([
                ui.button(self._t("main_templates"), self._go("editor"), style="tonal"),
                ui.button(self._t("main_results"), self._go("results"), style="outlined"),
            ], spacing=8),
        ])

    def _quick_card(self, ui):
        packs = [
            ("starter", "pack_starter"),
            ("dates", "pack_dates"),
            ("numbers", "pack_numbers"),
            ("ssid", "pack_ssid"),
        ]
        rows = []
        for index in range(0, len(packs), 2):
            pair = packs[index:index + 2]
            rows.append(ui.row([
                ui.chip(self._t(key), False, on_click=self._bind(self._add_preset, pack_id))
                for pack_id, key in pair
            ], spacing=6))
        return ui.card([
            ui.text(self._t("main_quick"), "titleSmall"),
            ui.text(self._t("main_quick_hint"), "bodySmall", color="muted"),
        ] + rows)

    def _ethics_card(self, ui):
        return ui.card([
            ui.row([
                ui.icon("security", 20, tint="muted"),
                ui.spacer(width=8),
                ui.text(self._t("main_ethics"), "bodySmall", color="muted"),
            ], spacing=4),
        ], padding=12)

    # ----------------------------------------------------------
    #  SCAN
    # ----------------------------------------------------------

    def _scan_body(self, ui, page):
        try:
            if not self._scan and not self._scanning:
                self._load_scan()
        except Exception as exc:
            self._log("warning", "scan body: " + str(exc)[:160])

        children = []
        current = {}
        try:
            current = normalize_connection(self.api.getDevice().wifiConnectionInfoJson())
        except Exception:
            current = {}
        if current.get("ssid"):
            band = self._band_label(band_of(current.get("frequency", 0)))
            children.append(ui.card([
                ui.text(self._t("scan_current"), "labelSmall", color="secondary"),
                ui.text(current["ssid"], "titleMedium"),
                ui.text("%s · %d dBm" % (band, current.get("rssi", 0)),
                        "bodySmall", color="muted"),
                ui.button(
                    self._t("scan_use"),
                    self._bind(self._pick_ssid, current["ssid"],
                               current.get("bssid", "")),
                    style="tonal",
                ),
            ]))

        children.append(ui.row([
            ui.button(self._t("scan_now"), self._start_scan, style="filled",
                      enabled=not self._scanning),
            ui.button(self._t("scan_open_settings"), self._open_wifi_settings,
                      style="outlined"),
        ], spacing=8))

        if self._scanning:
            children.append(ui.card([
                ui.wavy_progress(None, 56),
                ui.text(self._t("scan_scanning"), "bodySmall", color="secondary"),
            ]))
        if self._scan_error:
            children.append(ui.card([
                ui.text(self._t("scan_error"), "bodySmall", color="error"),
                ui.text(self._scan_error, "labelSmall", color="muted"),
            ]))

        children.append(ui.text(
            self._t("scan_count") % len(self._scan), "titleSmall"))
        if self._scan and not self._scanning:
            children.append(ui.text(self._t("scan_cached"), "labelSmall",
                                    color="muted"))
        if self._scan:
            rows = []
            for network in self._scan[:60]:
                subtitle = "%s · %s · %d dBm" % (
                    network["security"],
                    self._band_label(network["band"]),
                    network["rssi"],
                )
                rows.append(ui.function_row(
                    network["ssid"],
                    subtitle,
                    "wifi",
                    on_click=self._bind(self._pick_ssid, network["ssid"],
                                        network.get("bssid", "")),
                ))
            children.append(ui.segmented_list(rows))
        else:
            children.append(ui.card([
                ui.text(self._t("scan_empty"), "titleMedium"),
                ui.text(self._t("scan_empty_hint"), "bodySmall", color="muted"),
            ]))

        if self._saved_networks:
            children.append(ui.text(self._t("scan_saved"), "titleSmall"))
            children.append(ui.text(self._t("scan_saved_hint"), "bodySmall", color="muted"))
            children.append(ui.segmented_list([
                ui.function_row(
                    ssid,
                    self._t("scan_saved"),
                    "history",
                    on_click=self._bind(self._pick_ssid, ssid),
                )
                for ssid in self._saved_networks[:40]
            ]))

        children.append(ui.card([
            ui.text(self._t("integration_card_title"), "titleSmall"),
            ui.text(self._t("integration_card_hint"), "bodySmall", color="muted"),
            ui.button(self._t("nav_integration"), self._go("integration"),
                      style="tonal", fill_max_width=True),
        ]))
        children.append(self._nav(ui, "scan"))
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    # ----------------------------------------------------------
    #  INTEGRATION
    # ----------------------------------------------------------

    def _integration_body(self, ui, page):
        if not self._read_once:
            self._read_once = True
            if self._settings.get("auto_passwords"):
                self._load_passwords_async()

        children = [
            ui.card([
                ui.text(self._t("integration_saved_title"), "titleSmall"),
                ui.text(self._t("integration_saved_hint"), "bodySmall", color="muted"),
                ui.row([
                    ui.button(self._t("integration_saved_load"),
                              self._load_passwords_async, style="filled",
                              enabled=not self._passwords_loading),
                    ui.button(self._t("integration_hide") if self._reveal
                              else self._t("integration_show"),
                              self._toggle_reveal, style="outlined"),
                ], spacing=8),
            ]),
        ]
        if self._passwords_loading:
            children.append(ui.card([
                ui.wavy_progress(None, 48),
                ui.text(self._t("common_loading"), "bodySmall", color="secondary"),
            ]))
        if self._passwords_error:
            locked = self._passwords_error in (
                "no_root", "permission_denied", "read_failed")
            children.append(ui.card([
                ui.text(self._t("integration_saved_locked") if locked
                        else self._t("integration_saved_error"),
                        "bodySmall", color="warning"),
                ui.text(self._passwords_error, "labelSmall", color="muted"),
            ]))
        if self._saved_credentials:
            children.append(ui.text(
                self._t("integration_saved_count") % len(self._saved_credentials),
                "titleSmall"))
            for item in self._saved_credentials[:30]:
                password = item["password"] if self._reveal else "•" * 8
                children.append(ui.card([
                    ui.text(item["ssid"], "titleSmall"),
                    ui.text(password, "bodyMedium", color="secondary"),
                    ui.text(item["security"] or self._t("scan_saved"),
                            "labelSmall", color="muted"),
                    ui.row([
                        ui.button(self._t("scan_use"),
                                  self._bind(self._pick_ssid, item["ssid"]),
                                  style="tonal"),
                        ui.button(self._t("integration_copy_password"),
                                  self._bind(self._copy_text, item["password"], 1),
                                  style="outlined"),
                    ], spacing=6),
                ], padding=12))
        elif not self._passwords_loading and not self._passwords_error:
            children.append(ui.card([
                ui.text(self._t("integration_saved_empty"), "bodyMedium"),
            ]))

        with self._lock:
            total = len(self._results)
        children.append(ui.card([
            ui.text(self._t("integration_shared_title"), "titleSmall"),
            ui.text(self._t("integration_shared_hint"), "bodySmall", color="muted"),
            ui.settings_row(self._t("integration_shared_ssid"),
                            self._ssid or "—", "wifi"),
            ui.settings_row(self._t("integration_shared_count"),
                            format_count(total), "list"),
            ui.settings_row(self._t("integration_shared_published"),
                            self._published_at or self._t("about_none"), "share"),
            ui.button(self._t("integration_publish"), self._publish_safe,
                      style="tonal", fill_max_width=True),
            ui.text(self._t("integration_service_hint"), "labelSmall", color="muted"),
        ]))
        children.append(self._nav(ui, "integration"))
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    # ----------------------------------------------------------
    #  EDITOR
    # ----------------------------------------------------------

    def _editor_body(self, ui, page):
        enabled = [item for item in self._templates if item["on"]]
        capacity = self._capacity()
        prefix = "≤ " if capacity >= ESTIMATE_CAP else "≈ "
        header = ui.card([
            ui.text(self._t("editor_count") % len(enabled), "titleMedium"),
            ui.text(self._t("editor_capacity") % (prefix + format_count(capacity)),
                    "bodySmall", color="secondary"),
            ui.row([
                ui.button(self._t("editor_starter"), self._add_starter, style="tonal"),
                ui.button(self._t("main_presets"), self._go("presets"), style="outlined"),
            ], spacing=8),
            ui.row([
                ui.button(self._t("editor_help"), self._go("help"), style="text"),
                ui.button(self._t("editor_clear"), self._ask_clear_templates, style="text"),
            ], spacing=8),
        ])

        editing = bool(self._editing_tid) and self._template_by_id(self._editing_tid) is not None
        children = [header]
        if not editing:
            children.append(self._editor_form_card(ui))
        children.extend(self._editor_template_cards(ui))
        children.append(ui.button(
            self._t("editor_generate"),
            self._start_generation,
            fill_max_width=True,
            enabled=not self._busy,
        ))
        children.append(self._nav(ui, "editor"))
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    def _editor_form_card(self, ui):
        editing = bool(self._editing_tid) and self._template_by_id(self._editing_tid) is not None
        children = [
            ui.text(self._t("editor_edit") if editing else self._t("editor_add"),
                    "titleSmall"),
            ui.text_field(
                value=self._draft,
                on_change=self._on_draft_change,
                label=self._t("editor_label"),
                single_line=True,
            ),
        ]
        if not self._draft:
            children.append(ui.text(self._t("editor_placeholder"),
                                    "bodySmall", color="muted"))
        status, color = self._draft_status()
        if status:
            children.append(ui.text(status, "bodySmall", color=color))
        children.append(ui.text(self._t("editor_tokens"), "labelSmall", color="secondary"))
        children.append(ui.row([
            ui.chip("+{0..99}", False, on_click=self._bind(self._append_draft, "+{0..99}")),
            ui.chip("+{0000..9999}", False,
                    on_click=self._bind(self._append_draft, "+{0000..9999}")),
            ui.chip("+(1|2|3)", False,
                    on_click=self._bind(self._append_draft, "+(1|2|3)")),
        ], spacing=4))
        children.append(ui.row([
            ui.chip("+$year", False, on_click=self._bind(self._append_draft, "+$year")),
            ui.chip("+$ssid", False, on_click=self._bind(self._append_draft, "+$ssid")),
            ui.chip("+\"!\"", False, on_click=self._bind(self._append_draft, "+\"!\"")),
        ], spacing=4))
        children.append(ui.text(self._t("editor_rules"), "labelSmall", color="secondary"))
        children.append(ui.row([
            ui.chip(" c", False, on_click=self._bind(self._append_draft, " c")),
            ui.chip(" u", False, on_click=self._bind(self._append_draft, " u")),
            ui.chip(" l", False, on_click=self._bind(self._append_draft, " l")),
            ui.chip(" k", False, on_click=self._bind(self._append_draft, " k")),
            ui.chip(" $1", False, on_click=self._bind(self._append_draft, " $1")),
        ], spacing=4))
        children.append(ui.text(self._t("editor_rule_hint"), "bodySmall", color="muted"))
        buttons = [
            ui.button(
                self._t("editor_save") if editing else self._t("editor_add"),
                self._add_draft_template,
                style="filled",
            ),
        ]
        if editing:
            buttons.append(ui.button(self._t("editor_cancel"), self._cancel_edit,
                                     style="text"))
        children.append(ui.row(buttons, spacing=8))
        return ui.card(children)

    def _editor_template_cards(self, ui):
        nodes = []
        if not self._templates:
            nodes.append(ui.card([
                ui.text(self._t("editor_empty"), "titleMedium"),
                ui.text(self._t("editor_empty_hint"), "bodySmall", color="muted"),
                ui.button(self._t("editor_starter"), self._add_starter, style="tonal"),
            ]))
            return nodes
        nodes.append(ui.text(
            self._t("editor_title") + " · " + str(len(self._templates)),
            "titleSmall",
        ))
        for index, item in enumerate(self._templates):
            error = self._template_error(item["expr"])
            estimate = self._estimate_expr(item["expr"])
            if error:
                badge = error
                badge_color = "error"
            else:
                badge = self._t("editor_estimate") % format_count(max(0, estimate))
                badge_color = "muted"
            title_row = ui.row([
                ui.text("%d." % (index + 1), "labelSmall", color="muted"),
                ui.text(item["expr"], "bodyMedium", max_lines=2),
                ui.spacer(width=4),
                ui.text(badge, "labelSmall", color=badge_color),
            ], spacing=4)
            actions = ui.row([
                ui.icon_button("edit", on_click=self._bind(self._edit_template, item["id"])),
                ui.icon_button(
                    "visibility_off" if item["on"] else "visibility",
                    on_click=self._bind(self._toggle_template, item["id"]),
                ),
                ui.icon_button("arrow_upward",
                               on_click=self._bind(self._move_template, item["id"], -1)),
                ui.icon_button("arrow_downward",
                               on_click=self._bind(self._move_template, item["id"], 1)),
                ui.icon_button("delete",
                               on_click=self._bind(self._delete_template, item["id"])),
            ], spacing=0)
            children = [title_row, actions]
            if not item["on"]:
                children.insert(0, ui.text(self._t("editor_disabled"), "labelSmall",
                                           color="warning"))
            nodes.append(ui.card(children, padding=10))
            if item["id"] == self._editing_tid:
                nodes.append(self._editor_form_card(ui))
        return nodes

    # ----------------------------------------------------------
    #  PRESETS
    # ----------------------------------------------------------

    def _presets_body(self, ui, page):
        children = [ui.card([
            ui.text(self._t("presets_title"), "titleSmall"),
            ui.text(self._t("presets_intro"), "bodySmall", color="muted"),
        ])]
        for pack in PRESETS:
            card_children = [
                ui.row([
                    ui.icon(pack["icon"], 26, tint="primary"),
                    ui.spacer(width=10),
                    ui.column([
                        ui.text(self._t(pack["title"]), "titleMedium"),
                        ui.text(self._t(pack["desc"]), "bodySmall", color="muted"),
                        ui.text(self._t("presets_count") % len(pack["templates"]),
                                "labelSmall", color="muted"),
                    ], spacing=2),
                ], spacing=6),
            ]
            if pack["id"] == "vendor" and not self._vendor_info()[0]:
                card_children.append(ui.text(
                    self._t("main_no_vendor"), "bodySmall", color="warning"))
            card_children.append(
                ui.row([
                    ui.button(
                        self._t("presets_hide") if self._preset_open == pack["id"]
                        else self._t("presets_preview"),
                        self._bind(self._toggle_preset, pack["id"]),
                        style="outlined",
                    ),
                    ui.button(
                        self._t("presets_add"),
                        self._bind(self._add_preset, pack["id"]),
                        style="filled",
                    ),
                ], spacing=8),
            )
            if self._preset_open == pack["id"]:
                for expr in pack["templates"]:
                    estimate = self._estimate_expr(expr)
                    label = (self._t("editor_estimate") % format_count(estimate)
                             if estimate >= 0 else "!")
                    card_children.append(ui.row([
                        ui.text(expr, "bodySmall", max_lines=1),
                        ui.spacer(width=6),
                        ui.text(label, "labelSmall", color="muted"),
                    ], spacing=4))
            children.append(ui.card(card_children))
        children.append(self._nav(ui, "presets"))
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    # ----------------------------------------------------------
    #  VARIABLES
    # ----------------------------------------------------------

    def _vars_body(self, ui, page):
        editing = bool(self._editing_var) and self._editing_var in self._vars
        children = [ui.card([
            ui.text(self._t("vars_count") % len(self._vars), "titleMedium"),
            ui.text(self._t("vars_empty_hint") if not self._vars
                    else self._t("vars_builtin_hint"),
                    "bodySmall", color="muted"),
        ])]
        if not editing:
            children.append(self._vars_form_card(ui))
        children.extend(self._vars_cards(ui))
        children.append(self._builtin_card(ui))
        children.append(self._nav(ui, "vars"))
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    def _vars_form_card(self, ui):
        editing = bool(self._editing_var) and self._editing_var in self._vars
        children = []
        if editing:
            children.append(ui.text(self._t("vars_editing") % self._editing_var,
                                    "titleSmall"))
            children.append(ui.chip("$" + self._editing_var, True))
        else:
            children.append(ui.text(self._t("vars_add"), "titleSmall"))
            children.append(ui.text_field(
                value=self._new_var_name,
                on_change=self._on_new_name,
                label=self._t("vars_name"),
                single_line=True,
            ))
        children.append(ui.text_field(
            value=self._new_var_value,
            on_change=self._on_new_value,
            label=self._t("vars_value"),
            single_line=True,
        ))
        children.append(ui.text(self._t("vars_value_hint"), "bodySmall", color="muted"))
        buttons = [
            ui.button(self._t("vars_save") if editing else self._t("vars_add"),
                      self._add_variable, style="filled"),
        ]
        if editing:
            buttons.append(ui.button(self._t("vars_cancel"),
                                     self._cancel_variable, style="text"))
        children.append(ui.row(buttons, spacing=8))
        return ui.card(children)

    def _vars_cards(self, ui):
        nodes = []
        if not self._vars:
            nodes.append(ui.card([
                ui.text(self._t("vars_empty"), "titleMedium"),
                ui.text(self._t("vars_empty_hint"), "bodySmall", color="muted"),
            ]))
            return nodes
        for name, value in self._vars.items():
            usage = self._var_usage(name)
            usage_text = (self._t("vars_used") % usage) if usage else self._t("vars_unused")
            nodes.append(ui.card([
                ui.text("%s = %s" % (name, value), "bodyMedium", max_lines=2),
                ui.text(usage_text, "labelSmall", color="muted"),
                ui.row([
                    ui.icon_button("edit",
                                   on_click=self._bind(self._edit_variable, name)),
                    ui.icon_button("arrow_upward",
                                   on_click=self._bind(self._move_variable, name, -1)),
                    ui.icon_button("arrow_downward",
                                   on_click=self._bind(self._move_variable, name, 1)),
                    ui.icon_button("delete",
                                   on_click=self._bind(self._ask_delete_variable, name)),
                ], spacing=0),
            ], padding=10))
            if name == self._editing_var:
                nodes.append(self._vars_form_card(ui))
        return nodes

    def _builtin_card(self, ui):
        ctx = self._context()
        rows = [
            ("$ssid", "ssid"),
            ("$ssid_core", "ssid_core"),
            ("$ssid_digits", "ssid_digits"),
            ("$ssid_latin", "ssid_latin"),
            ("$vendor", "vendor"),
            ("$year", "year"),
            ("$date", "date"),
            ("$short_date", "short_date"),
        ]
        children = [
            ui.text(self._t("vars_builtin"), "titleSmall"),
            ui.text(self._t("vars_builtin_hint"), "bodySmall", color="muted"),
        ]
        for label, key in rows:
            value = ctx.get(key) or "—"
            children.append(ui.settings_row(label, value, "tag"))
        return ui.card(children)

    def _ask_delete_variable(self, name):
        usage = self._var_usage(name)
        if usage:
            message = self._t("vars_delete_body") % (name, usage, name)
            self._ask("delete_var", self._t("vars_delete_title"), message, name)
        else:
            self._delete_variable(name)

    # ----------------------------------------------------------
    #  RESULTS
    # ----------------------------------------------------------

    def _results_body(self, ui, page):
        stats = self._stats_display()
        busy = self._busy
        children = []
        progress = self._progress_card(ui)
        if progress is not None:
            children.append(progress)

        if not stats["count"] and not busy:
            children.append(ui.card([
                ui.text(self._t("results_empty"), "titleMedium"),
                ui.text(self._t("results_empty_hint"), "bodySmall", color="muted"),
                ui.button(self._t("results_generate"), self._start_generation,
                          fill_max_width=True),
            ]))
            children.append(self._nav(ui, "results"))
            return ui.lazy_column(children, padding=16, spacing=12, fill_max_size=True)

        last_ssid = str(self._last.get("ssid") or "")
        if last_ssid and self._ssid and last_ssid != self._ssid:
            children.append(ui.text(self._t("results_stale"), "bodySmall",
                                    color="warning"))

        if stats["count"]:
            children.append(self._stats_card(ui, stats,
                                             full=bool(self._settings.get("tech"))))
        if last_ssid:
            children.append(ui.text(self._t("results_ssid") % last_ssid,
                                    "bodySmall", color="muted"))

        children.append(ui.text_field(
            value=self._query,
            on_change=self._set_query,
            label=self._t("results_search"),
            single_line=True,
        ))
        visible = self._visible_results()
        if self._query and not visible:
            children.append(ui.text(self._t("results_no_match"), "bodySmall",
                                    color="warning"))
        data, total, pages, start = self._page_slice(visible)
        if self._query:
            children.append(ui.text(self._t("results_filtered") % total,
                                    "labelSmall", color="muted"))
        if data:
            lines = "\n".join(
                "%d. %s" % (start + index + 1, value)
                for index, value in enumerate(data)
            )
            children.append(ui.log_panel(lines, max_height=380))
            children.append(ui.text(
                self._t("results_show") % (start + 1, start + len(data), total),
                "labelSmall", color="muted"))
            children.append(ui.row([
                ui.button(self._t("results_prev"),
                          self._bind(self._set_page, -1),
                          style="outlined",
                          enabled=self._result_page > 0),
                ui.text(self._t("results_page") % (self._result_page + 1, pages),
                        "labelSmall", color="muted"),
                ui.button(self._t("results_next"),
                          self._bind(self._set_page, 1),
                          style="outlined",
                          enabled=self._result_page + 1 < pages),
            ], spacing=8))
            children.append(ui.row([
                ui.button(self._t("results_copy_page"), self._copy_page,
                          style="tonal"),
                ui.button(self._t("results_copy_all"), self._copy_all,
                          style="outlined"),
            ], spacing=8))
            children.append(ui.row([
                ui.button(self._t("results_save"), self._save_results_file,
                          style="filled", enabled=not busy),
                ui.button(self._t("results_share"), self._share_results,
                          style="outlined", enabled=not busy),
            ], spacing=8))
            children.append(ui.button(self._t("results_open"),
                                      self._open_results_file,
                                      style="text", enabled=not busy,
                                      fill_max_width=True))
        else:
            children.append(ui.card([
                ui.text(self._t("results_no_match") if self._query
                        else self._t("results_empty"), "bodyMedium"),
            ]))

        if self._last_export:
            try:
                shown = self.api.getAndroid().filesAbsolute(self._last_export) or self._last_export
            except Exception:
                shown = self._last_export
            children.append(ui.text(self._t("results_saved") % shown,
                                    "labelSmall", color="muted"))
        children.append(ui.row([
            ui.button(self._t("results_import"), self._import_clipboard,
                      style="outlined", enabled=not busy),
            ui.button(self._t("results_clear"), self._ask_clear_results,
                      style="text", enabled=not busy),
        ], spacing=8))
        children.append(ui.button(self._t("results_generate"),
                                  self._start_generation,
                                  fill_max_width=True, enabled=not busy))
        children.append(self._nav(ui, "results"))
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    # ----------------------------------------------------------
    #  SETTINGS
    # ----------------------------------------------------------

    def _settings_body(self, ui, page):
        children = [
            self._settings_language_card(ui),
            self._settings_output_card(ui),
            self._settings_generation_card(ui),
            self._settings_behavior_card(ui),
            self._settings_integration_card(ui),
            self._settings_data_card(ui),
            self._settings_paths_card(ui),
            self._nav(ui, "settings"),
        ]
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    def _settings_language_card(self, ui):
        return ui.card([
            ui.text(self._t("settings_language"), "titleSmall"),
            ui.button_group(
                [["ar", "العربية"], ["en", "English"], ["ru", "Русский"]],
                self._lang,
                self._on_value(self._set_lang),
            ),
        ])

    def _settings_output_card(self, ui):
        limit = self._settings["limit"]
        options = [[str(value), format_count(value)]
                   for value in (1000, 5000, 10000, 20000, 50000, 100000, MAX_LIMIT)]
        if str(limit) not in [item[0] for item in options]:
            options.insert(0, [str(limit), format_count(limit)])
        sort_labels = {
            "order": self._t("settings_sort_order"),
            "length": self._t("settings_sort_length"),
            "alpha": self._t("settings_sort_alpha"),
        }
        sort_options = [[key, sort_labels[key]]
                        for key in ("order", "length", "alpha")]
        min_options = [[str(value), str(value)] for value in (8, 10, 12, 14)]
        max_options = [[str(value), str(value)] for value in (16, 24, 32, 63)]
        if str(self._settings["min_len"]) not in [item[0] for item in min_options]:
            min_options.append([str(self._settings["min_len"]),
                                str(self._settings["min_len"])])
        if str(self._settings["max_len"]) not in [item[0] for item in max_options]:
            max_options.append([str(self._settings["max_len"]),
                                str(self._settings["max_len"])])
        return ui.card([
            ui.text(self._t("settings_output"), "titleSmall"),
            ui.dropdown(options, str(limit), self._on_value(self._set_limit),
                        label=self._t("settings_limit")),
            ui.text(self._t("settings_min"), "labelSmall", color="secondary"),
            ui.button_group(min_options, str(self._settings["min_len"]),
                            self._on_value(self._set_min_len)),
            ui.text(self._t("settings_max"), "labelSmall", color="secondary"),
            ui.button_group(max_options, str(self._settings["max_len"]),
                            self._on_value(self._set_max_len)),
            ui.text(self._t("settings_minmax"), "bodySmall", color="muted"),
            ui.dropdown(sort_options, self._settings["sort"],
                        self._on_value(self._set_sort),
                        label=self._t("settings_sort")),
        ])

    def _settings_generation_card(self, ui):
        s = self._settings
        return ui.card([
            ui.text(self._t("settings_generation"), "titleSmall"),
            ui.switch(checked=s["mutations"],
                      on_change=self._on_value(self._toggle_cb("mutations")),
                      title=self._t("settings_mutations"),
                      subtitle=self._t("settings_mutations_sub")),
            ui.switch(checked=s["bundled"],
                      on_change=self._on_value(self._toggle_cb("bundled")),
                      title=self._t("settings_bundled"),
                      subtitle=self._t("settings_bundled_sub")),
            ui.switch(checked=s["strict"],
                      on_change=self._on_value(self._toggle_cb("strict")),
                      title=self._t("settings_strict"),
                      subtitle=self._t("settings_strict_sub")),
        ])

    def _settings_behavior_card(self, ui):
        s = self._settings
        return ui.card([
            ui.text(self._t("settings_behavior"), "titleSmall"),
            ui.switch(checked=s["auto_detect"],
                      on_change=self._on_value(self._toggle_cb("auto_detect")),
                      title=self._t("settings_autodetect"),
                      subtitle=self._t("settings_autodetect_sub")),
            ui.switch(checked=s["notify"],
                      on_change=self._on_value(self._toggle_cb("notify")),
                      title=self._t("settings_notify"),
                      subtitle=self._t("settings_notify_sub")),
            ui.switch(checked=s["haptic"],
                      on_change=self._on_value(self._toggle_cb("haptic")),
                      title=self._t("settings_haptic"),
                      subtitle=self._t("settings_haptic_sub")),
            ui.switch(checked=s["tech"],
                      on_change=self._on_value(self._toggle_cb("tech")),
                      title=self._t("settings_tech"),
                      subtitle=self._t("settings_tech_sub")),
            ui.switch(checked=s["advanced"],
                      on_change=self._on_value(self._toggle_cb("advanced")),
                      title=self._t("settings_advanced"),
                      subtitle=self._t("settings_advanced_sub")),
        ])

    def _settings_integration_card(self, ui):
        s = self._settings
        return ui.card([
            ui.text(self._t("settings_integration"), "titleSmall"),
            ui.switch(checked=s["publish"],
                      on_change=self._on_value(self._toggle_cb("publish")),
                      title=self._t("settings_publish"),
                      subtitle=self._t("settings_publish_sub")),
            ui.switch(checked=s["auto_passwords"],
                      on_change=self._on_value(self._toggle_cb("auto_passwords")),
                      title=self._t("settings_auto_passwords"),
                      subtitle=self._t("settings_auto_passwords_sub")),
            ui.button(self._t("nav_integration"), self._go("integration"),
                      style="outlined", fill_max_width=True),
        ])

    def _settings_data_card(self, ui):
        return ui.card([
            ui.text(self._t("settings_data"), "titleSmall"),
            ui.button(self._t("settings_clear_results"), self._ask_clear_results,
                      style="outlined", fill_max_width=True),
            ui.button(self._t("settings_clear_exports"), self._ask_clear_exports,
                      style="outlined", fill_max_width=True),
            ui.button(self._t("settings_reload_bundled"), self._reload_bundled,
                      style="outlined", fill_max_width=True),
            ui.button(self._t("settings_restore_bundled"), self._restore_bundled,
                      style="tonal", fill_max_width=True),
            ui.button(self._t("settings_reset"), self._ask_reset,
                      style="text", fill_max_width=True),
        ])

    def _settings_paths_card(self, ui):
        try:
            bundled = self._bundled_path()
        except Exception:
            bundled = BUNDLED_FILE
        try:
            exports = self.api.getAndroid().filesAbsolute(EXPORT_DIR) or EXPORT_DIR
        except Exception:
            exports = EXPORT_DIR
        children = [
            ui.text(self._t("settings_paths"), "titleSmall"),
            ui.settings_row(self._t("settings_path"),
                            self._plugin_dir() or "—", "folder"),
            ui.settings_row("bundled.txt", bundled, "file"),
            ui.settings_row(EXPORT_DIR, exports, "folder"),
            ui.settings_row(self._t("settings_version"), "v" + __version__, "info"),
            ui.row([
                ui.button(self._t("settings_logs"), self._go("logs"), style="outlined"),
                ui.button(self._t("settings_about"), self._go("about"), style="outlined"),
            ], spacing=8),
        ]
        return ui.card(children)

    # ----------------------------------------------------------
    #  HELP
    # ----------------------------------------------------------

    def _help_body(self, ui, page):
        token_rows = [
            ("$ssid", "help_token_ssid"),
            ("$ssid_lower / $ssid_upper / $ssid_clean", "help_token_variants"),
            ("$ssid_core", "help_token_core"),
            ("$ssid_digits", "help_token_digits"),
            ("$ssid_alpha / $ssid_latin_lower", "help_token_alpha"),
            ("$ssid_latin", "help_token_latin"),
            ("$year / $last_year / $next_year / $yy", "help_token_years"),
            ("$date / $short_date / $month / $day", "help_token_dates"),
            ("$vendor", "help_token_vendor"),
            ("$name", "help_token_var"),
        ]
        rule_rows = [
            ("l", "help_rule_l"),
            ("u", "help_rule_u"),
            ("c", "help_rule_c"),
            ("t", "help_rule_t"),
            ("r", "help_rule_r"),
            ("d", "help_rule_d"),
            ("k", "help_rule_k"),
            ("$text", "help_rule_suffix"),
            ("^text", "help_rule_prefix"),
        ]
        children = [
            ui.card([
                ui.text(self._t("help_how"), "titleSmall"),
                ui.text(self._t("help_how_1"), "bodyMedium"),
                ui.text(self._t("help_how_2"), "bodyMedium"),
                ui.text(self._t("help_how_3"), "bodyMedium"),
            ]),
            ui.card([
                ui.text(self._t("help_syntax"), "titleSmall"),
                ui.text(self._t("help_syntax_intro"), "bodySmall", color="muted"),
                ui.text(self._t("help_plus"), "labelSmall", color="secondary"),
                ui.text(self._t("help_plus_desc"), "bodySmall"),
                ui.text(self._t("help_ranges"), "labelSmall", color="secondary"),
                ui.text(self._t("help_range_desc"), "bodySmall"),
                ui.text(self._t("help_choice"), "labelSmall", color="secondary"),
                ui.text(self._t("help_choice_desc"), "bodySmall"),
            ]),
            ui.card([ui.text(self._t("help_tokens"), "titleSmall")] + [
                ui.settings_row(token, self._t(key), "tag")
                for token, key in token_rows
            ]),
            ui.card([ui.text(self._t("help_rules"), "titleSmall")] + [
                ui.settings_row(token, self._t(key), "code")
                for token, key in rule_rows
            ]),
            ui.card([
                ui.text(self._t("help_quotes"), "titleSmall"),
                ui.text(self._t("help_quotes_desc"), "bodySmall"),
                ui.text(self._t("help_escape"), "labelSmall", color="secondary"),
                ui.text(self._t("help_escape_desc"), "bodySmall"),
            ]),
            ui.card([ui.text(self._t("help_examples"), "titleSmall")] + [
                ui.function_row(
                    expr,
                    self._t("help_example_add"),
                    "add",
                    on_click=self._bind(self._add_example, expr),
                )
                for expr in HELP_EXAMPLES
            ]),
            ui.card([
                ui.text(self._t("help_limits"), "titleSmall"),
                ui.text(self._t("help_limits_body"), "bodySmall", color="muted"),
            ]),
            ui.card([
                ui.text(self._t("help_ethics_title"), "titleSmall", color="warning"),
                ui.text(self._t("help_ethics_body"), "bodySmall", color="muted"),
            ]),
            ui.card([
                ui.text(self._t("help_faq"), "titleSmall"),
                ui.text(self._t("help_faq_1_q"), "bodyMedium"),
                ui.text(self._t("help_faq_1_a"), "bodySmall", color="muted"),
                ui.text(self._t("help_faq_2_q"), "bodyMedium"),
                ui.text(self._t("help_faq_2_a"), "bodySmall", color="muted"),
                ui.text(self._t("help_faq_3_q"), "bodyMedium"),
                ui.text(self._t("help_faq_3_a"), "bodySmall", color="muted"),
            ]),
            self._nav(ui, "help"),
        ]
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    # ----------------------------------------------------------
    #  ABOUT
    # ----------------------------------------------------------

    def _about_body(self, ui, page):
        try:
            exports = len(json.loads(str(self.api.getAndroid().filesList(EXPORT_DIR)) or "[]"))
        except Exception:
            exports = 0
        with self._lock:
            results = len(self._results)
        last_error = self._init_error
        if not last_error:
            for level, _stamp, message in reversed(self._logs_snapshot()):
                if level == "error":
                    last_error = message
                    break
        children = [
            ui.card([
                ui.row([
                    ui.icon("key", 42, tint="primary"),
                    ui.spacer(width=10),
                    ui.column([
                        ui.text(self._t("app_title"), "headlineSmall"),
                        ui.text(self._t("about_version") % __version__,
                                "bodyMedium", color="secondary"),
                        ui.text(self._t("about_author") % __author__,
                                "bodySmall", color="muted"),
                    ], spacing=2),
                ], spacing=8),
                ui.text(self._t("about_id") % __id__, "labelSmall", color="muted"),
            ]),
            ui.card([
                ui.text(self._t("about_privacy_title"), "titleSmall", color="success"),
                ui.text(self._t("about_privacy_body"), "bodySmall", color="muted"),
            ]),
            ui.card([
                ui.text(self._t("about_data_title"), "titleSmall"),
                ui.text(self._t("about_data_body"), "bodySmall", color="muted"),
                ui.settings_row(self._t("about_templates") % len(self._templates), "", "list"),
                ui.settings_row(self._t("about_vars") % len(self._vars), "", "tag"),
                ui.settings_row(self._t("about_results") % results, "", "search"),
                ui.settings_row(self._t("about_exports") % exports, "", "folder"),
                ui.settings_row(self._t("about_last_error") % (last_error or self._t("about_none")),
                                "", "warning"),
            ]),
            ui.card([
                ui.text(self._t("about_paths"), "titleSmall"),
                ui.settings_row(self._t("settings_path"),
                                self._plugin_dir() or "—", "folder"),
                ui.settings_row("bundled.txt", self._bundled_path(), "file"),
            ]),
            ui.card([
                ui.button(self._t("about_copy_diag"), self._copy_diagnostics,
                          style="tonal", fill_max_width=True),
                ui.row([
                    ui.button(self._t("settings_logs"), self._go("logs"), style="outlined"),
                    ui.button(self._t("help_title"), self._go("help"), style="outlined"),
                ], spacing=8),
            ]),
            ui.card([
                ui.text(self._t("about_whats_new"), "titleSmall"),
                ui.text(self._t("about_new_1"), "bodySmall"),
                ui.text(self._t("about_new_2"), "bodySmall"),
                ui.text(self._t("about_new_3"), "bodySmall"),
                ui.text(self._t("about_new_4"), "bodySmall"),
                ui.text(self._t("about_new_5"), "bodySmall"),
            ]),
            ui.card([
                ui.text(self._t("about_credits"), "bodySmall", color="muted"),
            ]),
            self._nav(ui, "about"),
        ]
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    # ----------------------------------------------------------
    #  LOGS
    # ----------------------------------------------------------

    def _logs_body(self, ui, page):
        logs = self._logs_snapshot()
        children = [ui.row([
            ui.button(self._t("logs_copy"), self._copy_logs, style="tonal"),
            ui.button(self._t("logs_clear"), self._clear_logs, style="text"),
        ], spacing=8)]
        if logs:
            marks = {"error": "✖", "warning": "⚠", "info": "•"}
            lines = []
            for level, stamp, message in reversed(logs[-80:]):
                lines.append("%s  %s  %s" % (marks.get(level, "•"), stamp, message))
            children.append(ui.log_panel("\n".join(lines), max_height=420))
            children.append(ui.text(self._t("logs_show"), "labelSmall", color="muted"))
        else:
            children.append(ui.card([
                ui.text(self._t("logs_empty"), "bodyMedium", color="muted"),
            ]))
        children.append(self._nav(ui, "logs"))
        return ui.lazy_column(children, padding=16, spacing=10, fill_max_size=True)

    def _copy_logs(self):
        logs = self._logs_snapshot()
        if not logs:
            self._toast(self._t("logs_empty"))
            return
        text = "\n".join("%s %s %s" % item for item in logs)
        self._copy_text(text, len(logs))

    def _clear_logs(self):
        with self._log_lock:
            self._logs = []
        self._toast(self._t("logs_cleared"))
        self._refresh()

    def _ask_clear_exports(self):
        self._ask(
            "clear_exports",
            self._t("settings_exports_title"),
            self._t("settings_exports_body"),
        )

