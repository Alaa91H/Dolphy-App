# ============================================================
#  TEMPLATE ENGINE (pure helpers — testable outside Dolphy)
# ============================================================


class TemplateError(Exception):
    """A user-facing template problem with a translatable code."""

    def __init__(self, code, detail=""):
        Exception.__init__(self, code)
        self.code = code
        self.detail = detail


class Token(object):
    __slots__ = ("kind", "value")

    def __init__(self, kind, value):
        self.kind = kind
        self.value = value


class ParsedTemplate(object):
    __slots__ = ("tokens", "rules", "expr", "rules_text")

    def __init__(self, tokens, rules, expr, rules_text):
        self.tokens = tokens
        self.rules = rules
        self.expr = expr
        self.rules_text = rules_text

    # -- token value lists ------------------------------------------------
    def value_lists(self, ctx):
        lists = []
        for token in self.tokens:
            if token.kind == "lit":
                lists.append([token.value])
            elif token.kind == "var":
                lists.append([ctx.require(token.value)])
            elif token.kind == "bare":
                found = ctx.get(token.value)
                lists.append([found if found is not None else token.value])
            elif token.kind == "range":
                lists.append(range_values(token.value))
            elif token.kind == "choice":
                lists.append(list(token.value))
            else:
                lists.append([""])
        return lists

    def counts(self, ctx):
        """Cheap per-token cardinality; never materialises a range."""
        counts = []
        for token in self.tokens:
            if token.kind == "lit":
                counts.append(1)
            elif token.kind == "var":
                ctx.require(token.value)
                counts.append(1)
            elif token.kind == "bare":
                counts.append(1)
            elif token.kind == "range":
                counts.append(range_count(token.value))
            elif token.kind == "choice":
                counts.append(len(token.value))
            else:
                counts.append(1)
        return counts

    def estimate(self, ctx):
        total = 1
        for size in self.counts(ctx):
            if size <= 0:
                return 0
            total *= size
            if total >= ESTIMATE_CAP:
                return ESTIMATE_CAP
        return total

    def expand(self, ctx, should_stop=None):
        lists = self.value_lists(ctx)
        for combo in itertools.product(*lists):
            if should_stop is not None and should_stop():
                return
            yield apply_rules("".join(combo), self.rules)


def _is_ident_start(ch):
    return ch == "_" or ch.isalpha()


def _is_ident_char(ch):
    return ch.isalnum() or ch in "_-"


def _is_name_char(ch):
    return ch.isalnum() or ch == "_"


def _scan_name(text, index):
    """Explicit $name: letters, digits and underscore only."""
    length = len(text)
    i = index
    while i < length and _is_name_char(text[i]):
        i += 1
    return text[index:i], i


def _scan_bare(text, index):
    """Bare identifier; hyphens are allowed so Wi-Fi_name keeps working."""
    length = len(text)
    i = index
    while i < length and _is_ident_char(text[i]):
        i += 1
    return text[index:i], i


def _split_expression_rules(line):
    depth = 0
    quote = None
    i = 0
    length = len(line)
    while i < length:
        ch = line[i]
        if ch == "\\":
            i += 2
            continue
        if quote is not None:
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "\"'":
            quote = ch
            i += 1
            continue
        if ch in "{(":
            depth += 1
        elif ch in "})":
            if depth > 0:
                depth -= 1
        elif ch.isspace() and depth == 0:
            return line[:i], line[i:].strip()
        i += 1
    return line, ""


def _read_group(text, index, opener, closer):
    """Return (inner_text, index_after_closer) for a balanced group."""
    depth = 0
    quote = None
    i = index
    length = len(text)
    start = index + 1
    while i < length:
        ch = text[i]
        if ch == "\\":
            i += 2
            continue
        if quote is not None:
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "\"'":
            quote = ch
            i += 1
            continue
        if ch == opener:
            depth += 1
        elif ch == closer:
            depth -= 1
            if depth == 0:
                return text[start:i], i + 1
        i += 1
    raise TemplateError("err_unbalanced")


_NUM_RANGE = re.compile(r"^(-?\d+)\.\.(-?\d+)(?::(-?\d+))?$")
_CHAR_RANGE = re.compile(r"^(.)\.\.(.)$", re.DOTALL)


def _parse_range_token(inner):
    inner = inner.strip()
    match = _NUM_RANGE.match(inner)
    if match is not None:
        start = int(match.group(1))
        end = int(match.group(2))
        step = int(match.group(3) or 1)
        if step == 0:
            raise TemplateError("err_bad_range", inner)
        pad = 0
        if start >= 0 and end >= 0:
            pad = max(len(match.group(1)), len(match.group(2)))
            if not (match.group(1).startswith("0") and len(match.group(1)) > 1):
                if not (match.group(2).startswith("0") and len(match.group(2)) > 1):
                    pad = 0
        spec = {
            "char": False, "start": start, "end": end,
            "step": abs(step), "pad": pad,
        }
        return Token("range", spec)
    match = _CHAR_RANGE.match(inner)
    if match is not None:
        start = ord(match.group(1))
        end = ord(match.group(2))
        if start > end:
            start, end = end, start
        if end - start > 512:
            raise TemplateError("err_bad_range", inner)
        return Token("range", {
            "char": True, "start": start, "end": end,
            "step": 1, "pad": 0,
        })
    raise TemplateError("err_bad_range", inner)


def range_count(spec):
    start = spec["start"]
    end = spec["end"]
    step = spec["step"] or 1
    count = abs(end - start) // step + 1
    if count > MAX_TOKEN_VALUES:
        count = MAX_TOKEN_VALUES
    return count


def range_values(spec):
    values = []
    start = spec["start"]
    end = spec["end"]
    step = spec["step"] or 1
    if start <= end:
        iterator = range(start, end + 1, step)
    else:
        iterator = range(start, end - 1, -step)
    if spec["char"]:
        for code in iterator:
            values.append(chr(code))
            if len(values) >= MAX_TOKEN_VALUES:
                break
    else:
        pad = spec.get("pad", 0)
        for number in iterator:
            if pad:
                values.append(("%0*d" % (pad, number)))
            else:
                values.append(str(number))
            if len(values) >= MAX_TOKEN_VALUES:
                break
    return values


def _split_choices(inner):
    parts = []
    current = []
    quote = None
    i = 0
    length = len(inner)
    while i < length:
        ch = inner[i]
        if ch == "\\":
            if i + 1 < length:
                nxt = inner[i + 1]
                current.append(" " if nxt == "s" else nxt)
                i += 2
                continue
            current.append(ch)
            i += 1
            continue
        if quote is not None:
            if ch == quote:
                quote = None
            else:
                current.append(ch)
            i += 1
            continue
        if ch in "\"'":
            quote = ch
            i += 1
            continue
        if ch == "|":
            parts.append("".join(current))
            current = []
            i += 1
            continue
        if ch in "()":
            raise TemplateError("err_unbalanced")
        current.append(ch)
        i += 1
    parts.append("".join(current))
    if len(parts) > 256:
        raise TemplateError("err_bad_range", "choice")
    return parts


def _scan_tokens(expr):
    tokens = []
    buffer = []

    def flush():
        if buffer:
            tokens.append(Token("lit", "".join(buffer)))
            del buffer[:]

    i = 0
    length = len(expr)
    while i < length:
        ch = expr[i]
        if ch == "\\":
            if i + 1 < length:
                nxt = expr[i + 1]
                buffer.append(" " if nxt == "s" else nxt)
                i += 2
            else:
                buffer.append("\\")
                i += 1
        elif ch in "\"'":
            quote = ch
            i += 1
            piece = []
            closed = False
            while i < length:
                current = expr[i]
                if current == "\\" and i + 1 < length:
                    nxt = expr[i + 1]
                    piece.append(" " if nxt == "s" else nxt)
                    i += 2
                    continue
                if current == quote:
                    closed = True
                    i += 1
                    break
                piece.append(current)
                i += 1
            if not closed:
                raise TemplateError("err_unbalanced")
            buffer.append("".join(piece))
        elif ch == "+":
            flush()
            i += 1
        elif ch == "$":
            flush()
            name, i = _scan_name(expr, i + 1)
            if not name:
                raise TemplateError("err_unknown_var", "")
            tokens.append(Token("var", name))
        elif ch == "{":
            flush()
            inner, i = _read_group(expr, i, "{", "}")
            tokens.append(_parse_range_token(inner))
        elif ch == "(":
            flush()
            inner, i = _read_group(expr, i, "(", ")")
            tokens.append(Token("choice", _split_choices(inner)))
        elif _is_ident_start(ch):
            flush()
            name, i = _scan_bare(expr, i)
            tokens.append(Token("bare", name))
        else:
            buffer.append(ch)
            i += 1
    flush()
    return tokens


def _parse_rules(text):
    rules = []
    if not text:
        return rules
    parts = []
    current = []
    quote = None
    i = 0
    length = len(text)
    while i < length:
        ch = text[i]
        if ch == "\\" and i + 1 < length:
            current.append(text[i + 1])
            i += 2
            continue
        if quote is not None:
            if ch == quote:
                quote = None
            else:
                current.append(ch)
            i += 1
            continue
        if ch in "\"'":
            quote = ch
            i += 1
            continue
        if ch.isspace():
            if current:
                parts.append("".join(current))
                current = []
            i += 1
            continue
        current.append(ch)
        i += 1
    if quote is not None:
        raise TemplateError("err_unbalanced")
    if current:
        parts.append("".join(current))

    for part in parts:
        low = part.lower()
        if low in ("l", "lower"):
            rules.append(("op", "l"))
        elif low in ("u", "upper"):
            rules.append(("op", "u"))
        elif low in ("c", "cap", "capitalize"):
            rules.append(("op", "c"))
        elif low in ("t", "title"):
            rules.append(("op", "t"))
        elif low in ("r", "reverse", "rev"):
            rules.append(("op", "r"))
        elif low in ("d", "dup", "duplicate"):
            rules.append(("op", "d"))
        elif low in ("k", "leet"):
            rules.append(("op", "k"))
        elif part.startswith("$") or part.startswith("^"):
            value = part[1:]
            if not value:
                raise TemplateError("err_bad_rule", part)
            rules.append(("suffix" if part[0] == "$" else "prefix", value))
        else:
            raise TemplateError("err_bad_rule", part)
    return rules


def _normalize_plus(line):
    """Drop optional spaces around top-level '+', preserving quoted text."""
    text = (line or "").strip()
    output = []
    quote = None
    i = 0
    length = len(text)
    while i < length:
        ch = text[i]
        if ch == "\\":
            output.append(text[i:i + 2])
            i += 2
            continue
        if quote is not None:
            output.append(ch)
            if ch == quote:
                quote = None
            i += 1
            continue
        if ch in "\"'":
            quote = ch
            output.append(ch)
            i += 1
            continue
        if ch == "+":
            while output and output[-1] == " ":
                output.pop()
            output.append("+")
            i += 1
            while i < length and text[i] == " ":
                i += 1
            continue
        output.append(ch)
        i += 1
    return "".join(output)


def parse_template(expr):
    expr = _normalize_plus((expr or "").strip())
    if not expr:
        raise TemplateError("err_empty")
    if len(expr) > MAX_EXPR:
        raise TemplateError("err_too_long")
    body, rules_text = _split_expression_rules(expr)
    tokens = _scan_tokens(body)
    rules = _parse_rules(rules_text)
    has_text = False
    for token in tokens:
        if token.kind == "lit" and token.value:
            has_text = True
        elif token.kind != "lit":
            has_text = True
    if not tokens or not has_text:
        raise TemplateError("err_no_tokens")
    return ParsedTemplate(tokens, rules, body, rules_text)


def validate_template(expr, ctx):
    """Parse and resolve every token, raising TemplateError when unusable."""
    parsed = parse_template(expr)
    parsed.estimate(ctx)
    return parsed


def apply_leet(text):
    output = []
    for ch in text:
        output.append(LEET_MAP.get(ch, ch))
    return "".join(output)


def apply_rules(text, rules):
    value = text
    for kind, rule in rules:
        if kind == "op":
            if rule == "l":
                value = value.lower()
            elif rule == "u":
                value = value.upper()
            elif rule == "c":
                value = value.capitalize()
            elif rule == "t":
                value = value.title()
            elif rule == "r":
                value = value[::-1]
            elif rule == "d":
                value = value + value
            elif rule == "k":
                value = apply_leet(value)
        elif kind == "suffix":
            value = value + rule
        elif kind == "prefix":
            value = rule + value
    return value


def transliterate(text):
    output = []
    for ch in text:
        lower = ch.lower()
        mapped = TRANSLIT_MAP.get(lower)
        if mapped is None:
            output.append(ch)
        elif ch.isupper() and mapped:
            output.append(mapped.upper())
        else:
            output.append(mapped)
    return "".join(output)


def vendor_from_ssid(ssid):
    low = (ssid or "").strip().lower()
    if not low:
        return ""
    for vendor, prefixes in VENDOR_PATTERNS:
        for prefix in prefixes:
            if low.startswith(prefix):
                return vendor
    return ""


def vendor_from_bssid(bssid):
    raw = (bssid or "").strip().upper().replace("-", ":")
    if len(raw) < 8:
        return ""
    return OUI_VENDORS.get(raw[:8], "")


def detect_vendor(ssid, bssid=""):
    vendor = vendor_from_ssid(ssid)
    if vendor:
        return vendor, "ssid"
    vendor = vendor_from_bssid(bssid)
    if vendor:
        return vendor, "oui"
    return "", ""


def _vendor_prefix_pattern(prefix):
    parts = re.split(r"[\s_\-\.:]+", (prefix or "").strip())
    cleaned = [re.escape(part) for part in parts if part]
    if not cleaned:
        return r"^$"
    return r"^" + r"[\s_\-\.:]*".join(cleaned) + r"[\s_\-\.:]*"


def ssid_core(ssid):
    original = (ssid or "").strip()
    if not original:
        return ""
    text = original
    changed = False
    for _vendor, prefixes in VENDOR_PATTERNS:
        for prefix in prefixes:
            try:
                stripped = re.sub(_vendor_prefix_pattern(prefix), "", text,
                                  count=1, flags=re.I)
            except Exception:
                stripped = text
            if stripped != text:
                text = stripped
                changed = True
                break
        if changed:
            break
    text = re.sub(r"^(5g|2\.?4g)[\s_\-\.:]*", "", text, flags=re.I)
    text = re.sub(r"[\s_\-\.:]*(5g|2\.?4g)$", "", text, flags=re.I)
    text = re.sub(r"[\s_\-\.:]+(wifi|wi-fi)$", "", text, flags=re.I)
    text = text.strip(" _-.")
    return text or original


def build_context_values(ssid, variables, vendor="", now=None):
    ssid = (ssid or "").strip()
    stamp = now if now is not None else time.localtime()
    year = int(stamp.tm_year)
    core = ssid_core(ssid)
    digits = ""
    match = re.search(r"(\d+)\s*$", ssid)
    if match is None and core:
        match = re.search(r"(\d+)\s*$", core)
    if match is not None:
        digits = match.group(1)
    alpha = ""
    alpha_source = core if core and core[0].isalpha() else ssid
    match = re.match(r"^([^\d\s]+)", alpha_source)
    if match is not None:
        alpha = match.group(1).strip(" _-.")
    values = {
        "ssid": ssid,
        "ssid_lower": ssid.lower(),
        "ssid_upper": ssid.upper(),
        "ssid_clean": re.sub(r"[\s_\-\.:]+", "", ssid),
        "ssid_core": core,
        "ssid_digits": digits,
        "ssid_alpha": alpha,
        "ssid_latin": transliterate(ssid),
        "ssid_latin_lower": transliterate(ssid).lower(),
        "vendor": vendor or "",
        "year": str(year),
        "last_year": str(year - 1),
        "next_year": str(year + 1),
        "yy": "%02d" % (year % 100),
        "month": "%02d" % int(stamp.tm_mon),
        "day": "%02d" % int(stamp.tm_mday),
        "date": "%04d%02d%02d" % (year, int(stamp.tm_mon), int(stamp.tm_mday)),
        "short_date": "%02d%02d" % (int(stamp.tm_mday), int(stamp.tm_mon)),
    }
    for name, value in (variables or {}).items():
        if name not in values:
            values[name] = str(value)
    return values


class GenerationContext(object):
    def __init__(self, ssid, variables, vendor="", now=None):
        self.values = build_context_values(ssid, variables, vendor, now)
        self.lower = {}
        for key, value in self.values.items():
            self.lower[key.lower()] = value

    def get(self, name):
        name = str(name)
        if name in self.values:
            return self.values[name]
        low = name.lower()
        if low in self.lower:
            return self.lower[low]
        alias = BUILTIN_ALIASES.get(low)
        if alias is not None:
            return self.values.get(alias, "")
        return None

    def require(self, name):
        value = self.get(name)
        if value is None:
            raise TemplateError("err_unknown_var", name)
        return value


def estimate_template(expr, ctx):
    return parse_template(expr).estimate(ctx)


def entropy_bits(value):
    has_lower = has_upper = has_digit = has_symbol = False
    for ch in value:
        if "a" <= ch <= "z":
            has_lower = True
        elif "A" <= ch <= "Z":
            has_upper = True
        elif "0" <= ch <= "9":
            has_digit = True
        else:
            has_symbol = True
    alphabet = 0
    if has_lower:
        alphabet += 26
    if has_upper:
        alphabet += 26
    if has_digit:
        alphabet += 10
    if has_symbol:
        alphabet += 33
    if alphabet <= 1:
        return 0.0
    return len(value) * math.log(alphabet, 2)


def strength_of(bits):
    if bits < 40.0:
        return "weak"
    if bits < 60.0:
        return "medium"
    return "strong"


def default_bundled_lines():
    """The shipped common-password list, filtered to valid WPA lengths."""
    seen = set()
    values = []
    for value in COMMON_PASSWORDS:
        if 8 <= len(value) <= 63 and value not in seen:
            seen.add(value)
            values.append(value)
    return values


def valid_passphrase(value, min_len, max_len, strict=True):
    if not value:
        return False
    length = len(value)
    if length < min_len or length > max_len:
        return False
    for ch in value:
        code = ord(ch)
        if code < 32 or code == 127:
            return False
        if ch in "\r\n\t":
            return False
        if strict and not (32 <= code <= 126):
            return False
    return True


def mutations_for(base, year=None):
    """Deterministic, de-duplicated mutations of a base candidate."""
    stamp = year if year is not None else time.localtime().tm_year
    output = []
    seen = set()

    def add(value):
        if len(value) > 63 or value in seen:
            return
        seen.add(value)
        output.append(value)

    for suffix in MUTATION_SUFFIXES:
        add(base + suffix)
    for value in (base.lower(), base.upper(), base.capitalize(), base.title()):
        add(value)
    add(apply_leet(base))
    add(base + str(stamp))
    add(base + str(stamp)[2:])
    add(base + "_" + str(stamp))
    return output


def format_count(value):
    try:
        number = int(value)
    except (TypeError, ValueError):
        return "0"
    return "{:,}".format(number)


def parse_int(value, fallback):
    try:
        return int(float(str(value).strip()))
    except (TypeError, ValueError):
        return fallback


def _as_bool(value):
    if isinstance(value, bool):
        return value
    text = str(value).strip().lower()
    return text in ("1", "true", "yes", "on", "enabled")


def _field(data, names, fallback=""):
    if not isinstance(data, dict):
        return fallback
    for name in names:
        if name in data and data[name] is not None:
            return data[name]
    lowered = {}
    for key, value in data.items():
        lowered[str(key).lower()] = value
    for name in names:
        key = str(name).lower()
        if key in lowered and lowered[key] is not None:
            return lowered[key]
    return fallback


def security_of(capabilities):
    value = str(capabilities or "").upper()
    if "SAE" in value:
        return "WPA3"
    if "OWE" in value:
        return "OWE"
    if "RSN" in value or "WPA2" in value:
        return "WPA2"
    if "WEP" in value:
        return "WEP"
    if "WPA" in value:
        return "WPA"
    return "Open"


def band_of(frequency):
    try:
        value = int(frequency)
    except (TypeError, ValueError):
        return "unknown"
    if 5925 <= value <= 7125:
        return "6"
    if 4900 <= value <= 5900:
        return "5"
    if 2400 <= value <= 2500:
        return "2.4"
    return "unknown"


def normalize_scan(raw):
    try:
        data = json.loads(str(raw)) if raw else []
    except Exception:
        return []
    if isinstance(data, dict):
        for key in ("results", "networks", "list", "scanResults"):
            if isinstance(data.get(key), list):
                data = data[key]
                break
        else:
            data = []
    if not isinstance(data, list):
        return []
    output = []
    for item in data:
        if not isinstance(item, dict):
            continue
        ssid = str(_field(item, ("ssid", "SSID", "name"), "") or "").strip()
        bssid = str(_field(item, ("bssid", "BSSID", "address"), "") or "").strip()
        rssi = parse_int(_field(item, ("rssi", "level", "signal"), -127), -127)
        frequency = parse_int(_field(item, ("frequency", "freq", "channelFrequency"), 0), 0)
        capabilities = str(_field(item, ("capabilities", "security", "flags"), "") or "")
        if not ssid:
            continue
        output.append({
            "ssid": ssid,
            "bssid": bssid,
            "rssi": rssi,
            "frequency": frequency,
            "capabilities": capabilities,
            "security": security_of(capabilities),
            "band": band_of(frequency),
        })
    output.sort(key=lambda row: row["rssi"], reverse=True)
    return output[:80]


def normalize_connection(raw):
    try:
        data = json.loads(str(raw)) if raw else {}
    except Exception:
        return {}
    if not isinstance(data, dict):
        return {}
    ssid = str(_field(data, ("ssid", "SSID", "wifiSsid"), "") or "").strip()
    if ssid.lower() in (
        "<unknown ssid>", "<unknown>", "unknown", "unknown ssid", "0x",
        "", "--", "<hidden>", "<hidden network>", "<hidden ssid>",
        "hidden", "hidden network",
    ):
        ssid = ""
    return {
        "ssid": ssid,
        "bssid": str(_field(data, ("bssid", "BSSID"), "") or ""),
        "rssi": parse_int(_field(data, ("rssi", "level"), 0), 0),
        "frequency": parse_int(_field(data, ("frequency", "freq"), 0), 0),
        "ip": str(_field(data, ("ip", "ipAddress"), "") or ""),
    }


def normalize_configured(raw):
    try:
        data = json.loads(str(raw)) if raw else []
    except Exception:
        return []
    if isinstance(data, dict):
        for key in ("networks", "results", "list"):
            if isinstance(data.get(key), list):
                data = data[key]
                break
        else:
            data = []
    if not isinstance(data, list):
        return []
    output = []
    for item in data:
        if not isinstance(item, dict):
            continue
        ssid = str(_field(item, ("ssid", "SSID", "name"), "") or "").strip()
        if ssid:
            output.append(ssid)
    return output[:80]


def _device_language():
    try:
        from java import jclass
        locale = jclass("java.util.Locale").getDefault()
        code = str(locale.getLanguage()).lower()
        if code.startswith("ar"):
            return "ar"
        if code.startswith("ru"):
            return "ru"
        if code.startswith("en"):
            return "en"
        return "en"
    except Exception:
        return "ar"


# ============================================================
#  PLUGIN
# ============================================================


class WifiWordlistLab(BasePlugin):  # noqa: F821 - injected by Dolphy
    def __init__(self):
        BasePlugin.__init__(self)  # noqa: F821 - injected by Dolphy
        self._ready = False
        self._init_error = ""
        self._shutdown_done = False
        self._lock = threading.RLock()
        self._log_lock = threading.Lock()
        self._logs = []

        self._lang = "ar"
        self._ssid = ""
        self._vars = {}
        self._templates = []
        self._next_tid = 1
        self._settings = dict(DEFAULT_SETTINGS)

        self._results = []
        self._stats = self._empty_stats()
        self._dupes = 0
        self._rejected = 0
        self._run_id = 0
        self._busy = False
        self._cancel = threading.Event()
        self._worker = None
        self._started_at = 0.0
        self._finished_at = 0.0
        self._last = {}
        self._last_export = ""
        self._gen_error = ""

        self._result_page = 0
        self._query = ""
        self._filter_cache = None
        self._filter_key = None

        self._scan = []
        self._saved_networks = []
        self._scan_at = 0.0
        self._scan_timer = None
        self._scanning = False
        self._scan_error = ""

        self._dialog = None
        self._draft = ""
        self._editing_tid = 0
        self._new_var_name = ""
        self._new_var_value = ""
        self._editing_var = ""
        self._preset_open = ""
        self._last_persist = 0.0
        self._last_ui_tick = 0.0
        self._ui_lock = threading.Lock()
        self._current_page = "main"
        self._picked_ssid = ""
        self._picked_bssid = ""
        self._vendor_cache = None
        self._bundled = []
        self._first_run = False

        self._saved_credentials = []
        self._passwords_error = ""
        self._passwords_at = 0.0
        self._passwords_loading = False
        self._passwords_source = ""
        self._published_at = ""
        self._reveal = True
        self._read_once = False

    # ----------------------------------------------------------
    #  Lifecycle
    # ----------------------------------------------------------

    def on_plugin_load(self, bridge=None):
        if bridge is not None:
            self.api = bridge
        try:
            self._load_state()
        except Exception as exc:
            self._init_error = "state: " + str(exc)[:180]
            self._log("error", self._init_error)

        try:
            self._init_bundled()
        except Exception as exc:
            self._bundled = [value for value in COMMON_PASSWORDS]
            self._log("warning", "bundled: " + str(exc)[:180])

        try:
            self._register_module()
        except Exception as exc:
            self._log("warning", "module: " + str(exc)[:180])

        try:
            self._register_native_settings()
        except Exception as exc:
            self._log("warning", "settings: " + str(exc)[:180])

        self._ready = True
        self._log("info", "%s %s ready" % (APP_NAME, __version__))
        if self._first_run:
            self._log("info", "first run: starter templates created")
            self._save_now()

        if self._settings.get("auto_detect") and not self._ssid:
            try:
                self._detect_current(silent=True)
            except Exception as exc:
                self._log("warning", "detect: " + str(exc)[:180])

        try:
            self._pull_integration()
        except Exception as exc:
            self._log("warning", "integration import: " + str(exc)[:160])
        try:
            if self._settings.get("publish"):
                self._publish_integration()
        except Exception as exc:
            self._log("warning", "integration publish: " + str(exc)[:160])

    def on_plugin_disable(self):
        self._shutdown()

    def on_plugin_unload(self):
        self._shutdown()

    def _shutdown(self):
        if self._shutdown_done:
            return
        self._shutdown_done = True
        self._ready = False
        self._cancel.set()
        timer = self._scan_timer
        self._scan_timer = None
        if timer is not None:
            try:
                timer.cancel()
            except Exception:
                pass
        worker = self._worker
        if worker is not None and worker.is_alive():
            try:
                worker.join(0.4)
            except Exception:
                pass
        try:
            self._save_now()
        except Exception:
            pass

    # ----------------------------------------------------------
    #  State
    # ----------------------------------------------------------

    def _legacy_value(self, key, default):
        try:
            return self.get_setting(key, default)
        except Exception:
            return default

    def _load_state(self):
        raw = self._legacy_value(STATE_KEY, None)
        if isinstance(raw, str):
            try:
                raw = json.loads(raw)
            except Exception:
                raw = None
        legacy = {
            "ssid": self._legacy_value("ssid", ""),
            "vars": self._legacy_value("vars", {}),
            "script": self._legacy_value("script", ""),
            "limit": self._legacy_value("limit", None),
            "lang": self._legacy_value("lang", ""),
        }
        migrating = not isinstance(raw, dict)
        if migrating:
            raw = self._migrate(legacy)
            self._first_run = raw.pop("_first_run", False)
        self._apply_state(raw, seed_empty=migrating)

        native_limit = self._legacy_value("limit", None)
        if native_limit is not None:
            self._settings["limit"] = self._clamp(
                parse_int(native_limit, DEFAULT_LIMIT), MIN_LIMIT, MAX_LIMIT
            )
        native_auto = self._legacy_value("auto_detect", None)
        if isinstance(native_auto, bool):
            self._settings["auto_detect"] = native_auto
        if migrating:
            self._save_now()

    def _migrate(self, legacy):
        lang = str(legacy.get("lang") or "").strip().lower()
        if lang not in ("ar", "en", "ru"):
            lang = _device_language()
        templates = []
        script = legacy.get("script")
        if isinstance(script, list):
            lines = [str(item).strip() for item in script if str(item).strip()]
        else:
            lines = [item.strip() for item in str(script or "").splitlines() if item.strip()]
        first_run = not lines
        if first_run:
            lines = list(STARTER_TEMPLATES)
        for line in lines[:MAX_TEMPLATES]:
            templates.append({
                "id": len(templates) + 1,
                "expr": line[:MAX_EXPR],
                "on": True,
            })
        variables = {}
        raw_vars = legacy.get("vars")
        if isinstance(raw_vars, str):
            try:
                raw_vars = json.loads(raw_vars)
            except Exception:
                raw_vars = {}
        if isinstance(raw_vars, dict):
            for name, value in list(raw_vars.items())[:MAX_VARS]:
                if self._valid_var_name(str(name)) and str(name).lower() not in self._reserved_names():
                    variables[str(name)] = str(value)
        settings = dict(DEFAULT_SETTINGS)
        limit = legacy.get("limit")
        if limit is not None:
            settings["limit"] = self._clamp(parse_int(limit, DEFAULT_LIMIT), MIN_LIMIT, MAX_LIMIT)
        ssid = re.sub(r"[\x00-\x1f\x7f]", "", str(legacy.get("ssid") or ""))[:64]
        return {
            "schema": SCHEMA,
            "lang": lang,
            "ssid": ssid,
            "vars": variables,
            "templates": templates,
            "settings": settings,
            "last": {},
            "last_export": "",
            "_first_run": first_run,
        }

    def _apply_state(self, raw, seed_empty=False):
        if not isinstance(raw, dict):
            raw = {}
        lang = str(raw.get("lang") or "").strip().lower()
        self._lang = lang if lang in ("ar", "en", "ru") else _device_language()
        self._ssid = re.sub(r"[\x00-\x1f\x7f]", "", str(raw.get("ssid") or ""))[:64]

        variables = raw.get("vars")
        self._vars = {}
        if isinstance(variables, dict):
            for name, value in list(variables.items())[:MAX_VARS]:
                name = str(name)
                if not self._valid_var_name(name) or name.lower() in self._reserved_names():
                    continue
                self._vars[name] = str(value)[:120].replace("\n", " ").replace("\r", " ")

        templates = raw.get("templates")
        self._templates = []
        if isinstance(templates, list):
            for index, item in enumerate(templates):
                if len(self._templates) >= MAX_TEMPLATES:
                    break
                if isinstance(item, dict):
                    expr = str(item.get("expr") or "").strip()
                    enabled = bool(item.get("on", True))
                    tid = parse_int(item.get("id"), index + 1)
                else:
                    expr = str(item or "").strip()
                    enabled = True
                    tid = index + 1
                if not expr:
                    continue
                self._templates.append({
                    "id": tid,
                    "expr": expr[:MAX_EXPR],
                    "on": enabled,
                })
        if not self._templates and seed_empty:
            self._templates = [
                {"id": index + 1, "expr": expr, "on": True}
                for index, expr in enumerate(STARTER_TEMPLATES)
            ]
            self._first_run = True
        used_ids = set()
        next_id = 1
        for item in self._templates:
            tid = item["id"]
            while tid in used_ids:
                tid += 1
            item["id"] = tid
            used_ids.add(tid)
            next_id = max(next_id, tid + 1)
        self._next_tid = next_id

        settings = raw.get("settings")
        merged = dict(DEFAULT_SETTINGS)
        if isinstance(settings, dict):
            for key in DEFAULT_SETTINGS:
                if key in settings:
                    merged[key] = settings[key]
        merged["limit"] = self._clamp(parse_int(merged.get("limit"), DEFAULT_LIMIT), MIN_LIMIT, MAX_LIMIT)
        merged["min_len"] = self._clamp(parse_int(merged.get("min_len"), 8), 8, 32)
        merged["max_len"] = self._clamp(parse_int(merged.get("max_len"), 63), merged["min_len"], 63)
        merged["mutations"] = bool(merged.get("mutations"))
        merged["bundled"] = bool(merged.get("bundled", True))
        merged["strict"] = bool(merged.get("strict", True))
        merged["auto_detect"] = bool(merged.get("auto_detect", True))
        merged["notify"] = bool(merged.get("notify", True))
        merged["haptic"] = bool(merged.get("haptic", False))
        merged["tech"] = bool(merged.get("tech", False))
        merged["advanced"] = bool(merged.get("advanced", False))
        merged["publish"] = bool(merged.get("publish", True))
        merged["auto_passwords"] = bool(merged.get("auto_passwords", True))
        if merged.get("sort") not in SORT_VALUES:
            merged["sort"] = "order"
        self._settings = merged

        last = raw.get("last")
        self._last = last if isinstance(last, dict) else {}
        self._last_export = str(raw.get("last_export") or "")[:200]

    def _state_payload(self):
        with self._lock:
            payload = {
                "schema": SCHEMA,
                "lang": self._lang,
                "ssid": self._ssid,
                "vars": dict(self._vars),
                "templates": [
                    {"id": item["id"], "expr": item["expr"], "on": bool(item["on"])}
                    for item in self._templates
                ],
                "settings": dict(self._settings),
                "last": dict(self._last),
                "last_export": self._last_export,
            }
        return payload

    def _save_now(self):
        try:
            self.set_setting(STATE_KEY, self._state_payload())
            self._last_persist = time.monotonic()
        except Exception as exc:
            self._log("warning", "save: " + str(exc)[:160])

    def _save_soon(self):
        now = time.monotonic()
        if now - self._last_persist >= 1.0:
            self._save_now()

    # ----------------------------------------------------------
    #  i18n / logging / small helpers
    # ----------------------------------------------------------

    def _t(self, key):
        table = STRINGS.get(self._lang)
        if table is None:
            table = STRINGS["en"]
        value = table.get(key)
        if value is None:
            value = STRINGS["en"].get(key, key)
        return value

    def _log(self, level, message):
        try:
            line = str(message)[:500]
        except Exception:
            line = "?"
        with self._log_lock:
            self._logs.append((level, time.strftime("%H:%M:%S"), line))
            if len(self._logs) > MAX_LOGS:
                del self._logs[0:len(self._logs) - MAX_LOGS]

    def _logs_snapshot(self):
        with self._log_lock:
            return list(self._logs)

    def _toast(self, message):
        try:
            if self._ready:
                self.toast(str(message)[:220])
        except Exception:
            pass

    def _notify(self, title, text):
        try:
            android = self.api.getAndroid()
            android.notifyShow(1001, str(title)[:120], str(text)[:220])
        except Exception as exc:
            self._log("warning", "notify: " + str(exc)[:120])

    def _vibrate(self):
        try:
            self.api.getAndroid().vibratePattern([0, 30])
        except Exception:
            pass

    def _refresh(self):
        try:
            self.refresh()
        except Exception:
            pass

    def _tick(self):
        now = time.monotonic()
        with self._ui_lock:
            if now - self._last_ui_tick < (UI_THROTTLE_MS / 1000.0):
                return
            self._last_ui_tick = now
        self._refresh()

    @staticmethod
    def _clamp(value, low, high):
        if value < low:
            return low
        if value > high:
            return high
        return value

    @staticmethod
    def _valid_var_name(name):
        if not name or len(name) > 24:
            return False
        if not (name[0] == "_" or name[0].isalpha()):
            return False
        for ch in name:
            if not (ch.isalnum() or ch == "_"):
                return False
        return True

    @staticmethod
    def _reserved_names():
        names = set(BUILTIN_KEYS)
        names.update(BUILTIN_ALIASES.keys())
        return names

    def _device_lang(self):
        return _device_language()

    def _vendor_info(self):
        now = time.monotonic()
        cache = self._vendor_cache
        if (cache is not None and cache[0] == self._ssid
                and (now - cache[1]) < 5.0):
            return cache[2], cache[3]
        vendor = vendor_from_ssid(self._ssid)
        if vendor:
            result = (vendor, "ssid")
        else:
            bssid = ""
            if self._picked_ssid and self._picked_ssid == self._ssid:
                bssid = self._picked_bssid
            else:
                try:
                    connection = normalize_connection(
                        self.api.getDevice().wifiConnectionInfoJson()
                    )
                    if connection.get("ssid") == self._ssid:
                        bssid = connection.get("bssid", "")
                except Exception:
                    bssid = ""
            result = detect_vendor(self._ssid, bssid)
        self._vendor_cache = (self._ssid, now, result[0], result[1])
        return result

    # ----------------------------------------------------------
    #  Bundled file
    # ----------------------------------------------------------

    def _init_bundled(self):
        content = None
        try:
            android = self.api.getAndroid()
            if not android.filesExists(BUNDLED_FILE):
                android.filesWrite(BUNDLED_FILE,
                                   "\n".join(default_bundled_lines()))
            content = android.filesRead(BUNDLED_FILE)
        except Exception as exc:
            self._log("warning", "bundled read: " + str(exc)[:160])
        self._parse_bundled(content)

    def _parse_bundled(self, content):
        seen = set()
        values = []
        for line in str(content or "").splitlines():
            value = line.strip()
            if not value or value.startswith("#"):
                continue
            if len(value) < 8 or len(value) > 63 or value in seen:
                continue
            seen.add(value)
            values.append(value)
            if len(values) >= 5000:
                break
        if not values:
            values = default_bundled_lines()
        self._bundled = values

    def _reload_bundled(self):
        try:
            content = self.api.getAndroid().filesRead(BUNDLED_FILE)
            self._parse_bundled(content)
            self._toast(self._t("settings_bundled_reloaded"))
            self._log("info", "bundled reloaded: %d entries" % len(self._bundled))
            self._refresh()
        except Exception as exc:
            self._toast(self._t("settings_bundled_fail"))
            self._log("error", "bundled reload: " + str(exc)[:160])

    def _restore_bundled(self):
        try:
            lines = default_bundled_lines()
            text = "\n".join(lines)
            ok = self.api.getAndroid().filesWrite(BUNDLED_FILE, text)
            if not ok:
                raise RuntimeError("write failed")
            self._parse_bundled(text)
            self._toast(self._t("settings_bundled_restored"))
            self._log("info", "bundled restored: %d entries" % len(lines))
        except Exception as exc:
            self._toast(self._t("settings_bundled_fail"))
            self._log("error", "bundled restore: " + str(exc)[:160])
        self._refresh()

    def _bundled_path(self):
        try:
            return self.api.getAndroid().filesAbsolute(BUNDLED_FILE) or BUNDLED_FILE
        except Exception:
            return BUNDLED_FILE

    def _plugin_dir(self):
        try:
            return str(self.api.getAndroid().pluginFilesDir())
        except Exception:
            return ""

    # ----------------------------------------------------------
    #  Registration
    # ----------------------------------------------------------

    def _register_module(self):
        self.add_module(
            title=self._t("module_title"),
            description=self._t("module_description"),
            icon="key",
            screen="main",
            section="PLUGINS",
            order=20,
        )
        try:
            self.hook_action(ACTION_GENERATE, 20)
            self.provide_service(SERVICE_ID, 20)
        except Exception as exc:
            self._log("warning", "integration registration: " + str(exc)[:160])

    def _register_native_settings(self):
        items = [
            {"type": "header", "title": self._t("app_title")},
            {
                "type": "switch",
                "key": "auto_detect",
                "title": self._t("settings_autodetect"),
                "subtitle": self._t("settings_native_autodetect_sub"),
                "default": True,
            },
            {
                "type": "slider",
                "key": "limit",
                "title": self._t("settings_limit"),
                "subtitle": "%s – %s" % (format_count(MIN_LIMIT), format_count(MAX_LIMIT)),
                "min": MIN_LIMIT,
                "max": MAX_LIMIT,
                "default": DEFAULT_LIMIT,
                "steps": 198,
            },
            {"type": "nav", "title": self._t("nav_editor"), "subtitle": self._t("settings_generator_sub"), "icon": "key", "screen": "editor"},
            {"type": "nav", "title": self._t("nav_results"), "subtitle": self._t("settings_results_sub"), "icon": "list", "screen": "results"},
            {"type": "nav", "title": self._t("nav_help"), "subtitle": self._t("help_syntax"), "icon": "info", "screen": "help"},
        ]
        self.api.registerSettings(self._t("app_title"), json.dumps(items, ensure_ascii=False), 20)

    def on_setting_changed(self, payload):
        key = str(self._payload_get(payload, "key", "") or "")
        value = self._payload_get(payload, "value", None)
        if key == "limit":
            self._settings["limit"] = self._clamp(parse_int(value, DEFAULT_LIMIT), MIN_LIMIT, MAX_LIMIT)
            self._save_now()
        elif key == "auto_detect":
            self._settings["auto_detect"] = _as_bool(value)
            self._save_now()
        else:
            return
        self._refresh()

    @staticmethod
    def _payload_get(payload, key, default=None):
        if isinstance(payload, dict):
            return payload.get(key, default)
        try:
            return payload.get(key)
        except Exception:
            pass
        try:
            return json.loads(str(payload)).get(key, default)
        except Exception:
            return default

    def _mirror_native(self, key, value):
        try:
            current = self.get_setting(key, None)
            if current != value:
                self.set_setting(key, value)
        except Exception:
            pass

    # ----------------------------------------------------------
    #  Wi-Fi
    # ----------------------------------------------------------

    def _detect_current(self, silent=False):
        try:
            raw = self.api.getDevice().wifiConnectionInfoJson()
            connection = normalize_connection(raw)
            ssid = connection.get("ssid", "")
            if ssid:
                self._ssid = ssid[:64]
                self._picked_ssid = self._ssid
                self._picked_bssid = connection.get("bssid", "")
                self._vendor_cache = None
                self._save_now()
                self._log("info", "SSID detected: " + ssid[:48])
                if not silent:
                    self._toast(self._t("scan_selected") % ssid[:40])
                return ssid
        except Exception as exc:
            self._log("warning", "detect current: " + str(exc)[:160])
        if not silent:
            self._toast(self._t("err_wifi"))
        return ""

    def _load_scan(self, force=False):
        now = time.monotonic()
        if not force and (now - self._scan_at) < 10.0:
            return
        self._scan_at = now
        try:
            device = self.api.getDevice()
            self._scan = normalize_scan(device.wifiScanResultsJson(80, -95))
            self._scan_error = ""
        except Exception as exc:
            self._scan_error = str(exc)[:160]
            self._log("warning", "scan read: " + self._scan_error)
        try:
            self._saved_networks = normalize_configured(
                self.api.getDevice().wifiConfiguredNetworksJson()
            )
        except Exception:
            self._saved_networks = []

    def _start_scan(self):
        if self._scanning:
            return
        try:
            device = self.api.getDevice()
            if hasattr(device, "wifiIsEnabled") and not device.wifiIsEnabled():
                self._toast(self._t("err_wifi"))
                return
            started = device.wifiStartScan(True)
            if not started:
                self._toast(self._t("toast_scan_fail"))
            else:
                self._toast(self._t("toast_scan_started"))
            self._scanning = True
            timer = threading.Timer(2.4, self._finish_scan)
            timer.daemon = True
            self._scan_timer = timer
            timer.start()
        except Exception as exc:
            self._scanning = False
            self._toast(self._t("toast_scan_fail"))
            self._log("error", "scan start: " + str(exc)[:160])
        self._refresh()

    def _finish_scan(self):
        self._scanning = False
        try:
            self._load_scan(force=True)
            self._log("info", "scan finished: %d networks" % len(self._scan))
        except Exception as exc:
            self._log("warning", "scan finish: " + str(exc)[:160])
        self._refresh()

    def _pick_ssid(self, ssid, bssid=""):
        value = re.sub(r"[\x00-\x1f\x7f]", "", str(ssid or ""))[:64]
        if not value:
            return
        self._ssid = value
        self._picked_ssid = value
        self._picked_bssid = str(bssid or "")[:32]
        self._vendor_cache = None
        self._save_now()
        try:
            if self._settings.get("publish"):
                self._publish_integration()
        except Exception:
            pass
        self._toast(self._t("scan_selected") % value[:40])
        self.navigate("main")

    def _open_wifi_settings(self):
        try:
            self.api.getDevice().wifiOpenSettings()
        except Exception as exc:
            self._log("warning", "wifi settings: " + str(exc)[:160])

    # ----------------------------------------------------------
    #  Integration: saved passwords + cross-plugin sharing
    # ----------------------------------------------------------

    def _load_passwords_async(self):
        if self._passwords_loading:
            return
        self._passwords_loading = True
        self._refresh()
        worker = threading.Thread(target=self._read_saved_passwords, args=(False,))
        worker.daemon = True
        try:
            worker.start()
        except Exception as exc:
            self._passwords_loading = False
            self._log("error", "passwords worker: " + str(exc)[:160])

    def _read_saved_passwords(self, silent=False):
        self._passwords_loading = True
        try:
            raw = self.api.getDevice().wifiSavedPasswordsJson()
            parsed = json.loads(str(raw) if raw else "{}")
            if not isinstance(parsed, dict):
                parsed = {}
            error = ""
            if not parsed.get("ok"):
                error = str(parsed.get("error") or "read_failed")
            entries = []
            seen = set()
            for item in parsed.get("networks") or []:
                if not isinstance(item, dict):
                    continue
                ssid = str(item.get("ssid") or "").strip()[:64]
                password = str(item.get("password") or "").strip()[:128]
                if not ssid or not password or ssid in seen:
                    continue
                seen.add(ssid)
                entries.append({
                    "ssid": ssid,
                    "password": password,
                    "security": str(item.get("security") or "")[:24],
                })
            self._saved_credentials = entries
            self._passwords_error = error
            self._passwords_at = time.time()
            if entries:
                self._passwords_source = str(parsed.get("source") or "")[:160]
                self._log("info", "saved passwords: %d networks" % len(entries))
            elif error:
                self._log("warning", "saved passwords: " + error)
            if self._settings.get("publish"):
                self._publish_integration()
        except Exception as exc:
            self._passwords_error = str(exc)[:160]
            self._log("error", "saved passwords: " + self._passwords_error)
        finally:
            self._passwords_loading = False
        if not silent:
            if self._saved_credentials:
                self._toast(self._t("integration_saved_ready") % len(self._saved_credentials))
            elif self._passwords_error in ("no_root", "permission_denied", "read_failed"):
                self._toast(self._t("integration_saved_locked"))
            else:
                self._toast(self._t("integration_saved_error"))
        self._refresh()

    def _toggle_reveal(self):
        self._reveal = not self._reveal

    def _resolve_quick_ssid(self):
        if self._ssid:
            return self._ssid
        detected = self._detect_current(silent=True)
        if detected:
            return detected
        for item in self._saved_credentials:
            if item.get("ssid"):
                self._pick_ssid(item["ssid"])
                return item["ssid"]
        try:
            self._load_scan(force=True)
        except Exception:
            pass
        for network in self._scan:
            if network.get("ssid"):
                self._pick_ssid(network["ssid"], network.get("bssid", ""))
                return network["ssid"]
        return ""

    def _quick_start(self):
        if self._busy:
            self._toast(self._t("toast_busy"))
            return
        if not self._resolve_quick_ssid():
            self._toast(self._t("main_ssid_required"))
            self.navigate("main")
            return
        if not self._templates:
            if not self._add_templates(STARTER_TEMPLATES):
                self._toast(self._t("err_results"))
                self.navigate("editor")
                return
        self._start_generation()

    def _publish_integration(self):
        vendor, source = self._vendor_info()
        with self._lock:
            ssid = self._ssid
            total = len(self._results)
            words = list(self._results[:MAX_PUBLISHED_WORDS])
        stamp = time.strftime("%Y-%m-%d %H:%M")
        self.export_java_object(EXPORT_WORDLIST_KEY, json.dumps({
            "version": INTEGRATION_VERSION,
            "ssid": ssid,
            "vendor": vendor,
            "source": source,
            "count": total,
            "updatedAt": stamp,
            "words": words,
        }, ensure_ascii=False))
        self.export_java_object(EXPORT_SSID_KEY, json.dumps({
            "version": INTEGRATION_VERSION,
            "ssid": ssid,
            "vendor": vendor,
            "bssid": self._picked_bssid if self._picked_ssid == ssid else "",
            "count": total,
            "updatedAt": stamp,
        }, ensure_ascii=False))
        self.export_java_object(EXPORT_PASSWORDS_KEY, json.dumps({
            "version": INTEGRATION_VERSION,
            "ok": bool(self._saved_credentials),
            "source": self._passwords_source,
            "updatedAt": stamp,
            "networks": [
                {"ssid": item["ssid"], "password": item["password"],
                 "security": item["security"]}
                for item in self._saved_credentials[:MAX_SHARED_PASSWORDS]
            ],
        }, ensure_ascii=False))
        self._published_at = stamp
        self._log("info", "published %d words, %d saved networks" % (
            total, len(self._saved_credentials)))

    def _publish_safe(self):
        try:
            self._publish_integration()
            self._toast(self._t("integration_published"))
        except Exception as exc:
            self._log("error", "publish: " + str(exc)[:160])
            self._toast(self._t("integration_publish_fail"))

    def _pull_integration(self):
        if self._saved_credentials:
            return
        try:
            raw = self.import_java_object(EXPORT_PASSWORDS_KEY)
        except Exception:
            return
        if not raw:
            return
        try:
            data = json.loads(str(raw))
        except Exception:
            return
        if not isinstance(data, dict):
            return
        entries = []
        for item in data.get("networks") or []:
            if not isinstance(item, dict):
                continue
            ssid = str(item.get("ssid") or "").strip()[:64]
            password = str(item.get("password") or "").strip()[:128]
            if ssid and password:
                entries.append({
                    "ssid": ssid,
                    "password": password,
                    "security": str(item.get("security") or "")[:24],
                })
        if entries:
            self._saved_credentials = entries
            self._passwords_source = "shared"
            self._log("info", "imported %d shared networks" % len(entries))

    def hook_wifi_wordlist_generate(self, payload):
        data = payload if isinstance(payload, dict) else {}
        ssid = str(data.get("ssid") or "").strip()
        if ssid:
            self._pick_ssid(ssid, str(data.get("bssid") or ""))
        self._quick_start()
        return {"handled": True, "ok": bool(self._ssid)}

    def service_wifi_wordlist_get(self, payload):
        with self._lock:
            words = list(self._results[:MAX_PUBLISHED_WORDS])
            ssid = self._ssid
        return {"ok": True, "ssid": ssid, "count": len(words), "words": words}

    # ----------------------------------------------------------
    #  Templates / variables business logic
    # ----------------------------------------------------------

    def _context(self):
        vendor, _source = self._vendor_info()
        return GenerationContext(self._ssid, self._vars, vendor)

    def _template_error(self, expr):
        try:
            validate_template(expr, self._context())
            return None
        except TemplateError as exc:
            return self._error_text(exc)
        except Exception as exc:
            return str(exc)[:160]

    def _error_text(self, exc):
        if isinstance(exc, TemplateError):
            message = self._t(exc.code)
            if "%s" in message:
                return message % (exc.detail or "")
            return message
        return str(exc)[:160]

    def _estimate_expr(self, expr):
        try:
            ctx = self._context()
            return validate_template(expr, ctx).estimate(ctx)
        except Exception:
            return -1

    def _capacity(self):
        total = 0
        ctx = self._context()
        for item in self._templates:
            if not item["on"]:
                continue
            try:
                total += parse_template(item["expr"]).estimate(ctx)
            except Exception:
                continue
            if total >= ESTIMATE_CAP:
                return ESTIMATE_CAP
        if self._settings.get("bundled"):
            total += len(self._bundled)
        return total

    def _template_by_id(self, tid):
        for item in self._templates:
            if item["id"] == tid:
                return item
        return None

    def _add_templates(self, expressions):
        added = 0
        existing = set(item["expr"] for item in self._templates)
        for expr in expressions:
            if len(self._templates) >= MAX_TEMPLATES:
                break
            expr = str(expr).strip()[:MAX_EXPR]
            if not expr or expr in existing:
                continue
            self._templates.append({
                "id": self._next_tid,
                "expr": expr,
                "on": True,
            })
            self._next_tid += 1
            existing.add(expr)
            added += 1
        if added:
            self._save_now()
        return added

    def _add_draft_template(self):
        expr = self._draft.strip()
        if not expr:
            self._toast(self._t("err_empty"))
            return
        error = self._template_error(expr)
        if error:
            self._toast(error)
            return
        if self._editing_tid:
            item = self._template_by_id(self._editing_tid)
            if item is None:
                self._editing_tid = 0
                return
            for other in self._templates:
                if other["id"] != item["id"] and other["expr"] == expr:
                    self._toast(self._t("editor_duplicate_err"))
                    return
            item["expr"] = expr[:MAX_EXPR]
            self._editing_tid = 0
            self._draft = ""
            self._save_now()
            self._toast(self._t("editor_saved"))
            return
        if len(self._templates) >= MAX_TEMPLATES:
            self._toast(self._t("editor_max") % MAX_TEMPLATES)
            return
        if any(item["expr"] == expr for item in self._templates):
            self._toast(self._t("editor_duplicate_err"))
            return
        self._templates.append({
            "id": self._next_tid,
            "expr": expr[:MAX_EXPR],
            "on": True,
        })
        self._next_tid += 1
        self._draft = ""
        self._save_now()
        self._toast(self._t("editor_added"))

    def _edit_template(self, tid):
        item = self._template_by_id(tid)
        if item is None:
            return
        self._draft = item["expr"]
        self._editing_tid = tid

    def _cancel_edit(self):
        self._draft = ""
        self._editing_tid = 0

    def _delete_template(self, tid):
        before = len(self._templates)
        self._templates = [item for item in self._templates if item["id"] != tid]
        if len(self._templates) != before:
            if self._editing_tid == tid:
                self._cancel_edit()
            self._save_now()
            self._toast(self._t("editor_deleted"))

    def _toggle_template(self, tid):
        item = self._template_by_id(tid)
        if item is None:
            return
        item["on"] = not item["on"]
        self._save_now()

    def _move_template(self, tid, delta):
        index = None
        for position, item in enumerate(self._templates):
            if item["id"] == tid:
                index = position
                break
        if index is None:
            return
        target = index + delta
        if target < 0 or target >= len(self._templates):
            return
        self._templates[index], self._templates[target] = (
            self._templates[target], self._templates[index],
        )
        self._save_now()
        self._toast(self._t("editor_moved"))

    def _clear_templates(self):
        self._templates = []
        self._cancel_edit()
        self._save_now()
        self._toast(self._t("toast_cleared"))

    def _add_starter(self):
        added = self._add_templates(STARTER_TEMPLATES)
        if added:
            self._toast(self._t("editor_starter_done"))
        else:
            self._toast(self._t("presets_none"))

    def _append_draft(self, text):
        if not self._draft:
            text = text.lstrip()
        self._draft = (self._draft + text)[:MAX_EXPR]

    def _var_usage(self, name):
        pattern = re.compile(r"(?<![\w-])(?:\$)?" + re.escape(name) + r"(?![\w-])")
        count = 0
        for item in self._templates:
            if pattern.search(item["expr"]):
                count += 1
        return count

    def _add_variable(self):
        if self._editing_var:
            name = self._editing_var
        else:
            name = self._new_var_name.strip()
        if not name:
            self._toast(self._t("vars_need_name"))
            return
        if not self._valid_var_name(name):
            self._toast(self._t("vars_invalid"))
            return
        if name.lower() in self._reserved_names():
            self._toast(self._t("vars_reserved"))
            return
        value = self._new_var_value.strip()
        if self._editing_var:
            self._vars[name] = value[:120]
            self._editing_var = ""
            self._new_var_name = ""
            self._new_var_value = ""
            self._save_now()
            self._toast(self._t("vars_saved"))
            return
        if len(self._vars) >= MAX_VARS:
            self._toast(self._t("vars_max") % MAX_VARS)
            return
        for existing in self._vars:
            if existing.lower() == name.lower():
                self._toast(self._t("vars_invalid"))
                return
        self._vars[name] = value[:120]
        self._new_var_name = ""
        self._new_var_value = ""
        self._save_now()
        self._toast(self._t("vars_added"))

    def _edit_variable(self, name):
        if name not in self._vars:
            return
        self._editing_var = name
        self._new_var_name = name
        self._new_var_value = self._vars[name]

    def _cancel_variable(self):
        self._editing_var = ""
        self._new_var_name = ""
        self._new_var_value = ""

    def _delete_variable(self, name):
        if name in self._vars:
            self._vars.pop(name, None)
            if self._editing_var == name:
                self._cancel_variable()
            self._save_now()
            self._toast(self._t("vars_deleted"))

    def _move_variable(self, name, delta):
        if name not in self._vars:
            return
        keys = list(self._vars.keys())
        index = keys.index(name)
        target = index + delta
        if target < 0 or target >= len(keys):
            return
        keys[index], keys[target] = keys[target], keys[index]
        self._vars = dict((key, self._vars[key]) for key in keys)
        self._save_now()

    def _add_preset(self, pack_id):
        for pack in PRESETS:
            if pack["id"] == pack_id:
                added = self._add_templates(pack["templates"])
                if added:
                    self._toast(self._t("presets_added") % added)
                else:
                    self._toast(self._t("presets_none"))
                return

    def _toggle_preset(self, pack_id):
        self._preset_open = "" if self._preset_open == pack_id else pack_id

    def _add_example(self, expr):
        added = self._add_templates([expr])
        if added:
            self._toast(self._t("help_example_added"))
        else:
            self._toast(self._t("presets_none"))

    # ----------------------------------------------------------
    #  Generation
    # ----------------------------------------------------------

    def _snapshot_generation(self):
        vendor, _source = self._vendor_info()
        with self._lock:
            templates = [
                (item["id"], item["expr"])
                for item in self._templates if item["on"]
            ]
            settings = dict(self._settings)
            variables = dict(self._vars)
            ssid = self._ssid
        return {
            "templates": templates,
            "settings": settings,
            "vars": variables,
            "ssid": ssid,
            "vendor": vendor,
        }

    def _start_generation(self):
        if self._busy:
            self._toast(self._t("toast_busy"))
            return
        snapshot = self._snapshot_generation()
        if not snapshot["templates"] and not snapshot["settings"].get("bundled"):
            self._toast(self._t("err_results"))
            self.navigate("editor")
            return
        if not self._ssid:
            self._toast(self._t("toast_no_ssid"))
        self._save_now()
        self._result_page = 0
        self._query = ""
        self._filter_cache = None
        self._filter_key = None
        with self._lock:
            self._results = []
            self._stats = self._empty_stats()
            self._dupes = 0
            self._rejected = 0
            self._gen_error = ""
            self._busy = True
            self._started_at = time.monotonic()
            self._finished_at = 0.0
            self._cancel.clear()
        self._toast(self._t("toast_generate_started"))
        worker = threading.Thread(target=self._worker_main, args=(snapshot,))
        worker.daemon = True
        self._worker = worker
        try:
            worker.start()
        except Exception as exc:
            with self._lock:
                self._busy = False
            self._log("error", "worker start: " + str(exc)[:160])
            self._toast(self._t("err_engine") % str(exc)[:120])
            return
        if self._current_page != "results":
            self.navigate("results")

    def _stop_generation(self):
        if not self._busy:
            return
        self._cancel.set()
        self._toast(self._t("toast_cancel_request"))
        self._refresh()

    @staticmethod
    def _empty_stats():
        return {
            "count": 0,
            "len_sum": 0,
            "len_min": 0,
            "len_max": 0,
            "bits_sum": 0.0,
            "weak": 0,
            "medium": 0,
            "strong": 0,
            "lower": 0,
            "upper": 0,
            "digit": 0,
            "symbol": 0,
            "dist": [0, 0, 0, 0, 0],
        }

    def _stats_add(self, stats, value):
        length = len(value)
        stats["count"] += 1
        stats["len_sum"] += length
        if stats["len_min"] == 0 or length < stats["len_min"]:
            stats["len_min"] = length
        if length > stats["len_max"]:
            stats["len_max"] = length
        bits = entropy_bits(value)
        stats["bits_sum"] += bits
        label = strength_of(bits)
        if label == "weak":
            stats["weak"] += 1
        elif label == "strong":
            stats["strong"] += 1
        else:
            stats["medium"] += 1
        has_lower = has_upper = has_digit = has_symbol = False
        for ch in value:
            if "a" <= ch <= "z":
                has_lower = True
            elif "A" <= ch <= "Z":
                has_upper = True
            elif "0" <= ch <= "9":
                has_digit = True
            else:
                has_symbol = True
        if has_lower:
            stats["lower"] += 1
        if has_upper:
            stats["upper"] += 1
        if has_digit:
            stats["digit"] += 1
        if has_symbol:
            stats["symbol"] += 1
        if length <= 9:
            stats["dist"][0] += 1
        elif length <= 11:
            stats["dist"][1] += 1
        elif length <= 13:
            stats["dist"][2] += 1
        elif length <= 15:
            stats["dist"][3] += 1
        else:
            stats["dist"][4] += 1

    def _accept(self, value, seen, limit, settings):
        if not valid_passphrase(
            value, settings["min_len"], settings["max_len"], settings["strict"]
        ):
            self._rejected += 1
            return True, False
        with self._lock:
            if len(self._results) >= limit:
                return False, False
            if value in seen:
                self._dupes += 1
                return True, False
            seen.add(value)
            self._results.append(value)
            self._stats_add(self._stats, value)
            return True, True

    def _worker_main(self, snapshot):
        settings = snapshot["settings"]
        limit = self._clamp(parse_int(settings.get("limit"), DEFAULT_LIMIT), MIN_LIMIT, MAX_LIMIT)
        ctx = GenerationContext(snapshot["ssid"], snapshot["vars"], snapshot["vendor"])
        seen = set()
        extra_bases = []
        extra_seen = set()
        stopped = False
        try:
            for _tid, expr in snapshot["templates"]:
                if self._cancel.is_set():
                    stopped = True
                    break
                try:
                    parsed = parse_template(expr)
                except TemplateError as exc:
                    self._log("warning", "template skipped: " + self._error_text(exc))
                    continue
                attempts = 0
                try:
                    for value in parsed.expand(ctx, self._cancel.is_set):
                        if self._cancel.is_set():
                            stopped = True
                            break
                        attempts += 1
                        if attempts > MAX_ATTEMPTS_PER_TEMPLATE:
                            self._log("warning", "attempt limit: " + expr[:80])
                            break
                        cont, added = self._accept(value, seen, limit, settings)
                        if not cont:
                            break
                        if (not added and len(extra_bases) < limit
                                and value not in seen and value not in extra_seen):
                            extra_seen.add(value)
                            extra_bases.append(value)
                        if attempts % 256 == 0:
                            self._tick()
                except TemplateError as exc:
                    self._log("warning", "template error: " + self._error_text(exc))
                except Exception as exc:
                    self._log("error", "template crash: " + str(exc)[:160])
                if len(self._results) >= limit or stopped:
                    break
                self._tick()

            if not stopped and settings.get("mutations") and len(self._results) < limit:
                base_snapshot = list(self._results) + extra_bases
                for index, base in enumerate(base_snapshot):
                    if self._cancel.is_set():
                        stopped = True
                        break
                    if len(self._results) >= limit:
                        break
                    for value in mutations_for(base):
                        cont, _added = self._accept(value, seen, limit, settings)
                        if not cont:
                            break
                        if len(self._results) >= limit:
                            break
                    if index % 64 == 0:
                        self._tick()

            if not stopped and settings.get("bundled") and len(self._results) < limit:
                for value in self._bundled:
                    if self._cancel.is_set():
                        stopped = True
                        break
                    cont, _added = self._accept(value, seen, limit, settings)
                    if not cont:
                        break
                self._tick()
        except Exception as exc:
            self._gen_error = str(exc)[:200]
            self._log("error", "generation: " + self._gen_error)
        finally:
            self._finalize_generation(snapshot, stopped)

    def _finalize_generation(self, snapshot, stopped):
        elapsed = max(0.0, time.monotonic() - self._started_at)
        settings = snapshot["settings"]
        sort_mode = settings.get("sort", "order")
        with self._lock:
            if sort_mode == "length":
                self._results.sort(key=lambda value: (len(value), value))
            elif sort_mode == "alpha":
                self._results.sort()
            count = len(self._results)
            self._busy = False
            self._finished_at = time.monotonic()
            self._run_id += 1
            self._last = {
                "count": count,
                "ssid": snapshot["ssid"],
                "at": time.strftime("%Y-%m-%d %H:%M"),
                "seconds": round(elapsed, 2),
                "duplicates": self._dupes,
                "rejected": self._rejected,
                "stopped": bool(stopped),
            }
            error = self._gen_error
        self._save_now()
        if settings.get("publish"):
            try:
                self._publish_integration()
            except Exception as exc:
                self._log("warning", "publish: " + str(exc)[:160])
        if error:
            self._toast(self._t("err_engine") % error)
            self._log("error", "generation failed: " + error)
        elif stopped:
            self._toast(self._t("toast_canceled"))
            self._log("info", "generation stopped at %d results" % count)
        else:
            self._toast(self._t("toast_generate_done") % count)
            self._log(
                "info",
                "generated %d in %.2fs (dupes %d)" % (count, elapsed, self._dupes),
            )
            if settings.get("notify"):
                self._notify(APP_NAME, self._t("toast_generate_done") % count)
            if settings.get("haptic"):
                self._vibrate()
        self._refresh()

    # ----------------------------------------------------------
    #  Results / search / export
    # ----------------------------------------------------------

    def _results_snapshot(self):
        with self._lock:
            return list(self._results), self._run_id

    def _visible_results(self):
        results, run_id = self._results_snapshot()
        query = self._query.strip().lower()
        if not query:
            return results
        key = (run_id, len(results), query)
        if self._filter_key == key and self._filter_cache is not None:
            return self._filter_cache
        filtered = [value for value in results if query in value.lower()]
        self._filter_key = key
        self._filter_cache = filtered
        return filtered

    def _page_slice(self, visible):
        total = len(visible)
        pages = max(1, (total + PAGE_SIZE - 1) // PAGE_SIZE)
        page = self._result_page
        if page < 0:
            page = 0
        if page >= pages:
            page = pages - 1
        self._result_page = page
        start = page * PAGE_SIZE
        return visible[start:start + PAGE_SIZE], total, pages, start

    def _set_page(self, delta):
        self._result_page = max(0, self._result_page + delta)
        self._refresh()

    def _set_query(self, value):
        self._query = str(value or "")[:80]
        self._result_page = 0

    def _stats_display(self):
        with self._lock:
            stats = dict(self._stats) if self._stats else self._empty_stats()
            dist = stats.get("dist")
            stats["dist"] = list(dist) if isinstance(dist, list) else [0, 0, 0, 0, 0]
            count = len(self._results)
        stats["count"] = count
        if count:
            stats["avg_len"] = stats["len_sum"] / float(count)
            stats["avg_bits"] = stats["bits_sum"] / float(count)
        else:
            stats["avg_len"] = 0.0
            stats["avg_bits"] = 0.0
        return stats

    def _copy_text(self, text, count=None):
        try:
            ok = self.api.getAndroid().clipboardSet(text)
            if ok:
                self._toast(self._t("toast_copied") % (count if count is not None else len(text.splitlines())))
            else:
                self._toast(self._t("err_clipboard"))
            return bool(ok)
        except Exception as exc:
            self._toast(self._t("err_clipboard"))
            self._log("error", "clipboard: " + str(exc)[:160])
            return False

    def _copy_page(self):
        data, total, pages, start = self._page_slice(self._visible_results())
        if not data:
            self._toast(self._t("results_nothing"))
            return
        self._copy_text("\n".join(data), len(data))

    def _copy_all(self):
        data, _run = self._results_snapshot()
        if not data:
            self._toast(self._t("results_nothing"))
            return
        self._copy_text("\n".join(data), len(data))

    def _export_name(self):
        with self._lock:
            ssid = str(self._last.get("ssid") or self._ssid)
        slug = re.sub(r"[^A-Za-z0-9_-]+", "_", ssid).strip("_")[:32]
        if not slug:
            slug = "ssid"
        stamp = time.strftime("%Y%m%d_%H%M%S")
        return "%s/wl_%s_%s.txt" % (EXPORT_DIR, slug, stamp)

    def _save_results_file(self):
        data, _run = self._results_snapshot()
        if not data:
            self._toast(self._t("err_results"))
            return ""
        path = self._export_name()
        try:
            ok = self.api.getAndroid().filesWrite(path, "\n".join(data) + "\n")
            if not ok:
                raise RuntimeError("write failed")
            self._last_export = path
            self._save_now()
            absolute = self.api.getAndroid().filesAbsolute(path) or path
            self._toast(self._t("results_saved") % absolute)
            self._log("info", "exported %d to %s" % (len(data), path))
            return path
        except Exception as exc:
            self._toast(self._t("err_file"))
            self._log("error", "export: " + str(exc)[:160])
            return ""

    def _share_results(self):
        path = self._last_export
        try:
            if not path or not self.api.getAndroid().filesExists(path):
                path = self._save_results_file()
            if not path:
                return
            ok = self.api.getAndroid().filesShare(path, "text/plain", "Wi-Fi wordlist")
            self._toast(self._t("toast_shared") if ok else self._t("toast_share_fail"))
        except Exception as exc:
            self._toast(self._t("toast_share_fail"))
            self._log("error", "share: " + str(exc)[:160])

    def _open_results_file(self):
        path = self._last_export
        try:
            if not path or not self.api.getAndroid().filesExists(path):
                path = self._save_results_file()
            if not path:
                return
            ok = self.api.getAndroid().filesOpenWith(path, "text/plain")
            if not ok:
                self._toast(self._t("toast_open_fail"))
        except Exception as exc:
            self._toast(self._t("toast_open_fail"))
            self._log("error", "open: " + str(exc)[:160])

    def _import_clipboard(self):
        if self._busy:
            self._toast(self._t("toast_busy"))
            return
        try:
            raw = self.api.getAndroid().clipboardGet() or ""
        except Exception as exc:
            self._toast(self._t("err_clipboard"))
            self._log("error", "clipboard get: " + str(exc)[:160])
            return
        lines = [line.strip() for line in str(raw)[:2000000].splitlines()]
        settings = self._settings
        seen = set(self._results)
        added = 0
        with self._lock:
            for value in lines:
                if len(self._results) >= settings["limit"]:
                    break
                if value in seen:
                    continue
                if not valid_passphrase(
                    value, settings["min_len"], settings["max_len"], settings["strict"]
                ):
                    continue
                seen.add(value)
                self._results.append(value)
                self._stats_add(self._stats, value)
                added += 1
            if added:
                self._run_id += 1
                self._filter_cache = None
                self._filter_key = None
        if added:
            self._toast(self._t("results_imported") % added)
            self._log("info", "imported %d from clipboard" % added)
        else:
            self._toast(self._t("results_import_none"))
        self._refresh()

    def _clear_results(self):
        if self._busy:
            self._toast(self._t("toast_busy"))
            return
        with self._lock:
            self._results = []
            self._stats = self._empty_stats()
            self._dupes = 0
            self._rejected = 0
            self._run_id += 1
            self._filter_cache = None
            self._filter_key = None
        self._result_page = 0
        self._query = ""
        self._toast(self._t("settings_results_cleared"))

    # ----------------------------------------------------------
    #  Settings actions
    # ----------------------------------------------------------

    def _set_lang(self, value):
        value = str(value or "").lower()
        if value in ("ar", "en", "ru") and value != self._lang:
            self._lang = value
            self._save_now()
            self._refresh()

    def _toggle_lang(self):
        order = ["ar", "en", "ru"]
        try:
            index = order.index(self._lang)
        except ValueError:
            index = 0
        self._lang = order[(index + 1) % len(order)]
        self._save_now()
        self._toast(self._lang_name())

    def _set_limit(self, value):
        self._settings["limit"] = self._clamp(parse_int(value, DEFAULT_LIMIT), MIN_LIMIT, MAX_LIMIT)
        self._mirror_native("limit", self._settings["limit"])
        self._save_now()

    def _set_min_len(self, value):
        minimum = self._clamp(parse_int(value, 8), 8, 32)
        self._settings["min_len"] = minimum
        if self._settings["max_len"] < minimum:
            self._settings["max_len"] = minimum
        self._save_now()

    def _set_max_len(self, value):
        maximum = self._clamp(parse_int(value, 63), 8, 63)
        self._settings["max_len"] = maximum
        if self._settings["min_len"] > maximum:
            self._settings["min_len"] = maximum
        self._save_now()

    def _set_sort(self, value):
        value = str(value or "order")
        if value in SORT_VALUES:
            self._settings["sort"] = value
            self._save_now()

    def _set_toggle(self, key, value):
        if key not in DEFAULT_SETTINGS:
            return
        self._settings[key] = bool(value)
        if key == "auto_detect":
            self._mirror_native("auto_detect", bool(value))
        self._save_now()
        if key == "auto_detect" and value and not self._ssid:
            self._detect_current(silent=True)

    def _clear_exports(self):
        try:
            self.api.getAndroid().filesDelete(EXPORT_DIR)
            self._last_export = ""
            self._save_now()
            self._toast(self._t("settings_exports_cleared"))
        except Exception as exc:
            self._log("warning", "clear exports: " + str(exc)[:160])

    def _reset_all(self):
        self._cancel_generation_quiet()
        self._lang = _device_language()
        self._ssid = ""
        self._picked_ssid = ""
        self._picked_bssid = ""
        self._vendor_cache = None
        self._vars = {}
        self._templates = [
            {"id": index + 1, "expr": expr, "on": True}
            for index, expr in enumerate(STARTER_TEMPLATES)
        ]
        self._next_tid = len(self._templates) + 1
        self._settings = dict(DEFAULT_SETTINGS)
        self._last = {}
        self._last_export = ""
        self._result_page = 0
        self._query = ""
        self._dialog = None
        self._cancel_edit()
        self._cancel_variable()
        with self._lock:
            self._results = []
            self._stats = self._empty_stats()
            self._dupes = 0
            self._rejected = 0
            self._run_id += 1
        self._save_now()
        self._mirror_native("limit", DEFAULT_LIMIT)
        self._mirror_native("auto_detect", True)
        self._toast(self._t("toast_cleared"))
        self._refresh()

    def _cancel_generation_quiet(self):
        self._cancel.set()
        worker = self._worker
        if worker is not None and worker.is_alive():
            try:
                worker.join(0.5)
            except Exception:
                pass

    # ----------------------------------------------------------
    #  Dialogs
    # ----------------------------------------------------------

    def _ask(self, kind, title, message, arg=None):
        self._dialog = {
            "kind": kind,
            "title": title,
            "message": message,
            "arg": arg,
        }

    def _dialog_cancel(self):
        self._dialog = None

    def _dialog_confirm(self):
        dialog = self._dialog
        self._dialog = None
        if not dialog:
            return
        kind = dialog.get("kind")
        arg = dialog.get("arg")
        if kind == "clear_templates":
            self._clear_templates()
        elif kind == "clear_results":
            self._clear_results()
        elif kind == "clear_exports":
            self._clear_exports()
        elif kind == "reset":
            self._reset_all()
        elif kind == "delete_var" and isinstance(arg, str):
            self._delete_variable(arg)
        elif kind == "delete_template" and isinstance(arg, int):
            self._delete_template(arg)

    def _ask_clear_templates(self):
        self._ask(
            "clear_templates",
            self._t("editor_clear_title"),
            self._t("editor_clear_body"),
        )

    def _ask_clear_results(self):
        self._ask(
            "clear_results",
            self._t("results_clear_title"),
            self._t("results_clear_body"),
        )

    def _ask_reset(self):
        self._ask(
            "reset",
            self._t("settings_reset_title"),
            self._t("settings_reset_body"),
        )

    # ----------------------------------------------------------
    #  Diagnostics
    # ----------------------------------------------------------

    def _diagnostics(self):
        with self._lock:
            results = len(self._results)
        exports = 0
        try:
            raw = self.api.getAndroid().filesList(EXPORT_DIR)
            data = json.loads(str(raw)) if raw else []
            exports = len(data) if isinstance(data, list) else 0
        except Exception:
            exports = 0
        info = {
            "plugin": APP_NAME,
            "version": __version__,
            "id": __id__,
            "lang": self._lang,
            "ssid": self._ssid,
            "templates": len(self._templates),
            "variables": len(self._vars),
            "results": results,
            "exports": exports,
            "busy": self._busy,
            "last": self._last,
            "plugin_dir": self._plugin_dir(),
            "bundled": self._bundled_path(),
            "settings": dict(self._settings),
        }
        return json.dumps(info, ensure_ascii=False, indent=2)

    def _copy_diagnostics(self):
        self._copy_text(self._diagnostics(), 1)
        self._toast(self._t("about_diag_copied"))

    # ----------------------------------------------------------
    #  UI helpers
    # ----------------------------------------------------------

    def _nav(self, ui, current):
        return ui.card([
            ui.text(self._t("nav_title"), "labelSmall", color="secondary"),
            ui.row([
                ui.button(self._t("nav_home"), self._go("main"),
                          style="text" if current != "main" else "tonal"),
                ui.button(self._t("nav_editor"), self._go("editor"),
                          style="text" if current != "editor" else "tonal"),
                ui.button(self._t("nav_results"), self._go("results"),
                          style="text" if current != "results" else "tonal"),
            ], spacing=4),
            ui.row([
                ui.button(self._t("nav_presets"), self._go("presets"),
                          style="text" if current != "presets" else "tonal"),
                ui.button(self._t("nav_vars"), self._go("vars"),
                          style="text" if current != "vars" else "tonal"),
                ui.button(self._t("nav_settings"), self._go("settings"),
                          style="text" if current != "settings" else "tonal"),
            ], spacing=4),
            ui.row([
                ui.button(self._t("nav_help"), self._go("help"),
                          style="text" if current != "help" else "tonal"),
                ui.button(self._t("nav_about"), self._go("about"),
                          style="text" if current != "about" else "tonal"),
                ui.button(self._t("nav_logs"), self._go("logs"),
                          style="text" if current != "logs" else "tonal"),
            ], spacing=4),
            ui.row([
                ui.button(self._t("nav_integration"), self._go("integration"),
                          style="text" if current != "integration" else "tonal"),
            ], spacing=4),
        ], padding=12)

    def _go(self, screen):
        def callback(*_args):
            self.navigate(screen)
        return callback

    def _bind(self, function, *args):
        def callback(*_args):
            try:
                function(*args)
            except Exception as exc:
                self._log("error", "%s: %s" % (getattr(function, "__name__", "callback"), str(exc)[:160]))
                self._toast(self._t("common_error"))
            finally:
                self._refresh()
        return callback

    def _on_value(self, function):
        def callback(value=None):
            try:
                function(value)
            except Exception as exc:
                self._log("error", "%s: %s" % (getattr(function, "__name__", "callback"), str(exc)[:160]))
                self._toast(self._t("common_error"))
            finally:
                self._refresh()
        return callback

    def _dialog_node(self, ui):
        dialog = self._dialog
        if not dialog:
            return None
        return ui.alert_dialog(
            show=True,
            title=dialog.get("title", ""),
            message=dialog.get("message", ""),
            confirm_text=self._t("common_confirm"),
            dismiss_text=self._t("common_cancel"),
            on_confirm=self._dialog_confirm,
            on_dismiss=self._dialog_cancel,
        )

    def _error_scaffold(self, ui, exc):
        return ui.scaffold(
            title=self._t("common_error"),
            content=ui.column([
                ui.card([
                    ui.text(self._t("common_error"), "titleLarge", color="error"),
                    ui.text(str(exc)[:400], "bodySmall", color="warning"),
                    ui.button(self._t("nav_home"), self._go("main"), style="tonal"),
                ]),
            ], padding=16, spacing=10, fill_max_size=False),
        )

    def _render(self, ui, page, body, title_key=None, actions=None):
        try:
            self._current_page = page
            content = body(ui, page)
            if content is None:
                content = ui.column([], padding=16)
            dialog = self._dialog_node(ui)
            if dialog is not None:
                content = ui.box([content, dialog], fill_max_size=True)
            return ui.scaffold(
                title=self._t(title_key or (page + "_title")),
                content=content,
                actions=actions or [],
            )
        except Exception as exc:
            self._log("error", "render %s: %s" % (page, str(exc)[:200]))
            return self._error_scaffold(ui, exc)

    def _screen_actions(self, ui, page):
        actions = [ui.top_action("translate", on_click=self._toggle_lang)]
        if page != "help":
            actions.append(ui.top_action("help", on_click=self._go("help")))
        return actions

    def _progress_card(self, ui):
        with self._lock:
            count = len(self._results)
            busy = self._busy
            started = self._started_at
        if not busy:
            return None
        total = max(1, self._settings["limit"])
        elapsed = max(0.0, time.monotonic() - started)
        children = [
            ui.row([
                ui.text(self._t("main_busy"), "titleMedium"),
                ui.spacer(width=8),
                ui.text(self._t("results_time") % elapsed, "labelSmall", color="muted"),
            ], spacing=4),
            ui.wavy_progress(min(1.0, count / float(total)), 72),
            ui.text(self._t("main_busy_count") % (count, total), "bodySmall", color="secondary"),
            ui.button(self._t("results_stop"), self._stop_generation, style="tonal"),
        ]
        return ui.card(children)

    def _stats_card(self, ui, stats, full=False):
        if not stats.get("count"):
            return None
        children = [
            ui.text(self._t("results_count") % format_count(stats["count"]),
                    "titleMedium"),
            ui.row([
                ui.chip(self._t("results_len") % (stats["len_min"], stats["len_max"]), True),
                ui.chip(self._t("results_entropy") % stats["avg_bits"], False),
            ], spacing=6),
            ui.row([
                ui.chip(self._t("results_weak") % stats["weak"], False),
                ui.chip(self._t("results_strong") % stats["strong"], False),
            ], spacing=6),
        ]
        with self._lock:
            duplicates = self._dupes
        if duplicates:
            children.append(ui.text(self._t("results_dupes") % duplicates,
                                    "bodySmall", color="muted"))
        if not full:
            return ui.card(children)
        children.append(ui.text(self._t("results_dist"), "labelSmall", color="secondary"))
        labels = ["results_dist_8", "results_dist_10", "results_dist_12",
                  "results_dist_14", "results_dist_16"]
        maximum = max(1, max(stats["dist"]))
        for index, key in enumerate(labels):
            value = stats["dist"][index]
            children.append(ui.column([
                ui.row([
                    ui.text(self._t(key), "labelSmall", color="muted"),
                    ui.spacer(width=8),
                    ui.text(format_count(value), "labelSmall", color="muted"),
                ]),
                ui.linear_progress(progress=float(value) / float(maximum)),
            ], spacing=2))
        return ui.card(children)

    # ----------------------------------------------------------
    #  Small input callbacks
    # ----------------------------------------------------------

    def _on_ssid_change(self, value):
        text = re.sub(r"[\x00-\x1f\x7f]", "", str(value or ""))[:64]
        if text == self._ssid:
            return
        self._ssid = text
        if text != self._picked_ssid:
            self._picked_ssid = ""
            self._picked_bssid = ""
        self._vendor_cache = None
        self._filter_cache = None
        self._filter_key = None
        self._save_soon()

    def _on_draft_change(self, value):
        self._draft = str(value or "")[:MAX_EXPR]

    def _on_new_name(self, value):
        self._new_var_name = str(value or "")[:24]

    def _on_new_value(self, value):
        self._new_var_value = str(value or "")[:120]

    def _lang_name(self):
        return {"ar": "العربية", "en": "English", "ru": "Русский"}.get(self._lang, "English")

    def _band_label(self, band):
        if band == "2.4":
            return "2.4 GHz"
        if band == "5":
            return "5 GHz"
        if band == "6":
            return "6 GHz"
        return "?"

    def _view_row(self, ui, label, value, color="secondary"):
        return ui.row([
            ui.text(label, "bodySmall", color="muted"),
            ui.spacer(width=8),
            ui.text(value, "bodySmall", color=color),
        ], spacing=4)

    def _draft_status(self):
        expr = self._draft.strip()
        if not expr:
            return "", ""
        error = self._template_error(expr)
        if error:
            return error, "error"
        estimate = self._estimate_expr(expr)
        if estimate < 0:
            return self._t("editor_invalid"), "error"
        return self._t("editor_estimate") % format_count(estimate), "success"

    def _toggle_cb(self, key):
        def callback(value):
            self._set_toggle(key, bool(value))
        return callback

    # ----------------------------------------------------------
    #  Screens
    # ----------------------------------------------------------

    def screen_main(self, ui, api, state):
        if api is not None:
            self.api = api
        return self._render(ui, "main", self._main_body,
                            actions=self._screen_actions(ui, "main"))

