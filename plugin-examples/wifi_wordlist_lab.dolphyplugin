# -*- coding: utf-8 -*-
"""Wi-Fi Wordlist Lab 3.1 — SSID-aware WPA wordlist studio for Dolphy.

A single-file Dolphy plugin.  Everything runs locally: no network calls.
It builds a candidate wordlist from templates that can reference the network
name (SSID), the detected vendor, dates, variables, numeric ranges,
alternatives and text transformations, then offers search, statistics,
clipboard export and sandbox file export.

Two integrations are built in:
  * Saved-network passwords.  The "wifi" capability plus root or Shizuku lets
    the plugin read the passwords Android already stored on this device.  The
    bridge hides the elevated shell, so the plugin never runs root commands
    itself.  Without root or Shizuku the section stays read-only and says so.
  * Cross-plugin sharing.  The plugin publishes its SSID, wordlist and saved
    credentials as global exported objects (`dolphy.wifi.wordlist.ssid`,
    `dolphy.wifi.wordlist.list`, `dolphy.wifi.passwords`), provides the
    `wifi.wordlist` service and answers the `wifi.wordlist.generate` action, so
    other Dolphy plugins reuse one list instead of guessing independently.

Use it only on networks you own or are explicitly authorised to audit.
"""

__id__ = "wifi_wordlist_lab"
__name__ = "Wi-Fi Wordlist Lab"
__version__ = "3.1.1"
__author__ = "DCA"
__description__ = "SSID-aware WPA wordlist studio — one-tap start, saved-network passwords and plugin integration"
__icon__ = "rounded:key"
__library__ = False
__design_library__ = False
__dependencies__ = []
__permissions__ = ["files", "wifi"]

import itertools
import json
import math
import re
import threading
import time


