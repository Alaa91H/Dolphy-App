import json

__id__ = "bt_classic_lab"
__name__ = "Classic Bluetooth Lab"
__version__ = "1.1.0"
__author__ = "Dolphy"
__description__ = "Bonded devices, discovery and classic Bluetooth device details"
__icon__ = "rounded:bluetooth"
__permissions__ = ["bluetooth"]

# User-interface translations (Arabic, English and Russian).
