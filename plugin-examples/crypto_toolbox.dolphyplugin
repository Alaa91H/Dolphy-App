import json

__id__ = "crypto_toolbox"
__name__ = "Crypto Toolbox"
__version__ = "1.1.0"
__author__ = "Dolphy"
__description__ = "Hashes, Base64, hexadecimal conversion and random identifiers"
__icon__ = "rounded:security"
__permissions__ = []

# User-interface translations (Arabic, English and Russian).
__i18n__ = {"ar":{"Ready":"جاهز","Clear":"مسح","Copy":"نسخ","History":"السجل","Hashes":"التجزئات","Encodings":"الترميزات","Random":"عشوائي","No":"لا","Use result":"استخدام النتيجة","Input text":"نص الإدخال","Result appears here":"تظهر النتيجة هنا","hash the input":"تجزئة الإدخال","cryptographically secure":"آمن تشفيريًا","new identifier":"معرّف جديد","No operations yet":"لا توجد عمليات بعد","None":"لا شيء","Crypto Toolbox":"صندوق أدوات التشفير","Hashes, encodings and random identifiers":"تجزئات وترميزات ومعرّفات عشوائية","Crypto and encoding":"التشفير والترميز","Everything runs locally on the device":"كل شيء يعمل محليًا على الجهاز","SHA-256":"SHA-256","SHA-512":"SHA-512","SHA-1":"SHA-1","MD5":"MD5","Base64 encode":"ترميز Base64","Base64 decode":"فك Base64","UTF-8 text to Base64":"نص UTF-8 إلى Base64","Base64 back to text":"Base64 إلى نص","Hex encode":"ترميز سداسي عشري","Hex decode":"فك سداسي عشري","UTF-8 text to hex":"نص UTF-8 إلى سداسي عشري","Hex back to text":"سداسي عشري إلى نص","Random 16 bytes":"16 بايت عشوائية","UUID v4":"UUID v4","Clipboard unavailable":"الحافظة غير متاحة","Copied to clipboard":"تم النسخ إلى الحافظة","unavailable":"غير متاح","no":"لا","Android":"Android","Read":"قراءة","bytes":"بايت","max":"بحد أقصى"},"ru":{"Ready":"Готово","Clear":"Очистить","Copy":"Копировать","History":"История","Hashes":"Хэши","Encodings":"Кодировки","Random":"Случайное","No":"Нет","Use result":"Использовать результат","Input text":"Входной текст","Result appears here":"Результат появится здесь","hash the input":"хэшировать ввод","cryptographically secure":"криптографически стойкий","new identifier":"новый идентификатор","No operations yet":"Операций пока нет","None":"Нет","Crypto Toolbox":"Криптографический набор","Hashes, encodings and random identifiers":"Хэши, кодировки и случайные идентификаторы","Crypto and encoding":"Криптография и кодирование","Everything runs locally on the device":"Всё выполняется локально на устройстве","SHA-256":"SHA-256","SHA-512":"SHA-512","SHA-1":"SHA-1","MD5":"MD5","Base64 encode":"Кодировать Base64","Base64 decode":"Декодировать Base64","UTF-8 text to Base64":"Текст UTF-8 в Base64","Base64 back to text":"Base64 обратно в текст","Hex encode":"Кодировать в hex","Hex decode":"Декодировать hex","UTF-8 text to hex":"Текст UTF-8 в hex","Hex back to text":"Hex обратно в текст","Random 16 bytes":"16 случайных байт","UUID v4":"UUID v4","Clipboard unavailable":"Буфер обмена недоступен","Copied to clipboard":"Скопировано в буфер обмена","unavailable":"недоступно","no":"нет","Android":"Android","Read":"Чтение","bytes":"байт","max":"макс."}}






class CryptoToolbox(BasePlugin):
    def __init__(self):
        super().__init__()
        self.input_text = "Dolphy"
        self.result = ""
        self.operation = "Ready"
        self.history = []

    def on_plugin_load(self):
        self.add_module(
            "Crypto Toolbox",
            "Hashes, encodings and random identifiers",
            "security",
            "main",
            "OTHER",
            90,
        )

    def set_input(self, value):
        self.input_text = str(value)
        self.refresh()

    def record(self, operation, value):
        self.operation = operation
        self.result = "" if value is None else str(value)
        if value is None:
            self.operation = operation + " failed"
        self.history.insert(0, self.operation + ": " + (self.result[:64] if self.result else "—"))
        self.history = self.history[:20]
        self.refresh()

    def digest(self, algorithm):
        try:
            value = self.api.getAndroid().cryptoHash(algorithm, self.input_text)
        except Exception:
            value = None
        self.record(algorithm.upper(), value)

    def base64_encode(self):
        try:
            value = self.api.getAndroid().cryptoBase64Encode(self.input_text)
        except Exception:
            value = None
        self.record("Base64 encode", value)

    def base64_decode(self):
        try:
            value = self.api.getAndroid().cryptoBase64Decode(self.input_text)
        except Exception:
            value = None
        self.record("Base64 decode", value)

    def hex_encode(self):
        try:
            value = self.api.getAndroid().cryptoHexEncode(self.input_text)
        except Exception:
            value = None
        self.record("Hex encode", value)

    def hex_decode(self):
        try:
            value = self.api.getAndroid().cryptoHexDecode(self.input_text)
        except Exception:
            value = None
        self.record("Hex decode", value)

    def random_hex(self):
        try:
            value = self.api.getAndroid().cryptoRandomHex(16)
        except Exception:
            value = None
        self.record("Random 16 bytes", value)

    def uuid(self):
        try:
            value = self.api.getAndroid().cryptoUuid()
        except Exception:
            value = None
        self.record("UUID v4", value)

    def copy_result(self):
        if not self.result:
            return
        try:
            self.api.getAndroid().clipboardSet(self.result)
            self.operation = "Copied to clipboard"
        except Exception:
            self.operation = "Clipboard unavailable"
        self.refresh()

    def use_result(self):
        if self.result:
            self.input_text = self.result
            self.refresh()

    def clear(self):
        self.result = ""
        self.history = []
        self.operation = "Ready"
        self.refresh()

    def screen_main(self, ui, api, state):
        history_rows = [ui.text(line, "bodySmall") for line in self.history]
        if not history_rows:
            history_rows = [ui.text("No operations yet", "bodyMedium")]
        return ui.scaffold(
            title="Crypto Toolbox",
            content=ui.lazy_column(
                [
                    ui.card(
                        [
                            ui.row(
                                [
                                    ui.icon("security", 36),
                                    ui.column(
                                        [
                                            ui.text("Crypto and encoding", "titleLarge"),
                                            ui.text("Everything runs locally on the device", "bodySmall"),
                                        ],
                                        spacing=2,
                                    ),
                                ],
                                spacing=12,
                            ),
                            ui.text_field(self.input_text, self.set_input, "Input text", single_line=False),
                            ui.text(self.operation, "bodySmall"),
                            ui.log_panel(self.result or "Result appears here", 160),
                            ui.row(
                                [
                                    ui.button("Copy", self.copy_result, style="tonal", fill_max_width=True),
                                    ui.button("Use result", self.use_result, style="tonal", fill_max_width=True),
                                    ui.button("Clear", self.clear, style="text", fill_max_width=True),
                                ],
                                spacing=8,
                            ),
                        ]
                    ),
                    ui.text("Hashes", "titleMedium"),
                    ui.segmented_list(
                        [
                            ui.settings_row("SHA-256", "hash the input", "security", on_click=self.hash_callback("sha256")),
                            ui.settings_row("SHA-512", "hash the input", "security", on_click=self.hash_callback("sha512")),
                            ui.settings_row("SHA-1", "hash the input", "security", on_click=self.hash_callback("sha1")),
                            ui.settings_row("MD5", "hash the input", "security", on_click=self.hash_callback("md5")),
                        ]
                    ),
                    ui.text("Encodings", "titleMedium"),
                    ui.segmented_list(
                        [
                            ui.settings_row("Base64 encode", "UTF-8 text to Base64", "code", on_click=self.action_callback(self.base64_encode)),
                            ui.settings_row("Base64 decode", "Base64 back to text", "code", on_click=self.action_callback(self.base64_decode)),
                            ui.settings_row("Hex encode", "UTF-8 text to hex", "code", on_click=self.action_callback(self.hex_encode)),
                            ui.settings_row("Hex decode", "Hex back to text", "code", on_click=self.action_callback(self.hex_decode)),
                        ]
                    ),
                    ui.text("Random", "titleMedium"),
                    ui.segmented_list(
                        [
                            ui.settings_row("Random 16 bytes", "cryptographically secure", "memory", on_click=self.action_callback(self.random_hex)),
                            ui.settings_row("UUID v4", "new identifier", "info", on_click=self.action_callback(self.uuid)),
                        ]
                    ),
                    ui.card(
                        [
                            ui.text("History", "titleMedium"),
                            ui.segmented_list(history_rows),
                        ]
                    ),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )

    def hash_callback(self, algorithm):
        def callback(value=None):
            self.digest(algorithm)

        return callback

    def action_callback(self, action):
        def callback(value=None):
            action()

        return callback
