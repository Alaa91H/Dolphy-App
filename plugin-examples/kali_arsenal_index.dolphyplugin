class KaliArsenalIndex(BasePlugin):
    def __init__(self):
        super().__init__()
        self.query = ""
        self.category = "all"
        self.status = "all"
        self.limit = SHOW_LIMIT
        self.selected = ""
        self.notice = ""
        self.authorized = False

    def on_plugin_load(self):
        self.add_module(
            self._t("title"),
            self._t("module_desc"),
            "rounded:terminal",
            "main",
            "PLUGINS",
            160,
        )

    def _lang(self):
        raw = str(self.get_setting("language", "") or "").strip().lower()
        if raw in ("ar", "en", "ru"):
            return raw
        return device_language()

    def _t(self, key, *args):
        table = STRINGS.get(self._lang(), STRINGS["ar"])
        text = table.get(key) or STRINGS["en"].get(key) or STRINGS["ar"].get(key) or key
        if args:
            try:
                return text.format(*args)
            except Exception:
                return text
        return text

    def _language_value(self):
        raw = str(self.get_setting("language", "") or "").strip().lower()
        return raw if raw in ("ar", "en", "ru") else "auto"

    def _language_options(self):
        return [
            ["auto", self._t("language_auto")],
            ["ar", "العربية"],
            ["en", "English"],
            ["ru", "Русский"],
        ]

    def _set_language(self, value):
        raw = str(value or "auto").strip().lower()
        self.set_setting("language", raw if raw in ("ar", "en", "ru") else "")
        self.refresh()

    def _reset_limit(self):
        self.limit = SHOW_LIMIT

    def _set_query(self, value):
        self.query = str(value or "")
        self._reset_limit()
        self.refresh()

    def _set_category(self, value):
        self.category = str(value or "all")
        self._reset_limit()
        self.refresh()

    def _set_status(self, value):
        self.status = str(value or "all")
        self._reset_limit()
        self.refresh()

    def _show_more(self):
        self.limit += SHOW_LIMIT
        self.refresh()

    def _bucket(self, tool):
        bucket = str(tool.get("bucket", "") or "")
        if bucket in ("safe", "recon", "offensive", "other"):
            return bucket
        status = str(tool.get("status", "") or "")
        if status.startswith("هجومي"):
            return "offensive"
        if status.startswith("استطلاع"):
            return "recon"
        if status.startswith("دفاعي") or status.startswith("تحقيق"):
            return "safe"
        return "other"

    def _status_text(self, tool):
        return self._t("status_" + self._bucket(tool))

    def _status_color(self, tool):
        bucket = self._bucket(tool)
        if bucket == "offensive":
            return "error"
        if bucket == "safe":
            return "primary"
        return None

    def _category_names(self, tool):
        lang = self._lang()
        names = CATEGORY_NAMES.get(lang, CATEGORY_NAMES["ar"])
        fallback = CATEGORY_NAMES["en"]
        return [names.get(cid) or fallback.get(cid) or cid for cid in tool["cats"]]

    def _category_text(self, tool):
        return self._t("list_sep").join(self._category_names(tool))

    def _sub(self, tool):
        lang = self._lang()
        if lang == "en":
            return tool.get("sub", "")
        return tool.get("sub_" + lang) or tool.get("sub", "")

    def _sub_note(self, tool):
        notes = SUB_NOTES.get(str(tool.get("sub", "")), {})
        return notes.get(self._lang()) or notes.get("en") or self._t("sub_note_fallback")

    def _summary(self, tool):
        lang = self._lang()
        if lang == "en":
            return tool.get("summary", "")
        return tool.get("summary_" + lang) or tool.get("summary", "")

    def _description(self, tool):
        lang = self._lang()
        if lang == "en":
            return tool.get("desc", "")
        return tool.get("desc_" + lang) or tool.get("desc", "")

    def _features(self, tool):
        lang = self._lang()
        if lang == "en":
            return list(tool.get("features") or [])
        return list(tool.get("features_" + lang) or tool.get("features") or [])

    def _equiv(self, tool):
        lang = self._lang()
        if lang == "en":
            return tool.get("equiv_en") or tool.get("equiv", "")
        if lang == "ru":
            return tool.get("equiv_ru") or tool.get("equiv", "")
        return tool.get("equiv", "")

    def _category_options(self):
        options = [["all", self._t("all_categories")]]
        names = CATEGORY_NAMES.get(self._lang(), CATEGORY_NAMES["ar"])
        fallback = CATEGORY_NAMES["en"]
        for item in CATEGORIES:
            label = names.get(item["id"]) or fallback.get(item["id"]) or item["id"]
            options.append([item["id"], label + " (%d)" % item["count"]])
        return options

    def _status_options(self):
        return [
            ["all", self._t("all_statuses")],
            ["safe", self._t("filter_safe")],
            ["recon", self._t("filter_recon")],
            ["offensive", self._t("filter_offensive")],
            ["other", self._t("filter_other")],
        ]

    def _filtered(self):
        query = self.query.strip().lower()
        result = []
        for tool in TOOLS:
            if self.category != "all" and self.category not in tool["cats"]:
                continue
            if self.status != "all" and self._bucket(tool) != self.status:
                continue
            values = [
                tool.get("name", ""),
                tool.get("sub", ""),
                tool.get("summary", ""),
                tool.get("desc", ""),
                tool.get("version", ""),
                tool.get("slug", ""),
                tool.get("equiv", ""),
                tool.get("equiv_en", ""),
                tool.get("equiv_ru", ""),
            ]
            for lang in ("ar", "en", "ru"):
                values.extend(
                    [
                        tool.get("summary_" + lang, ""),
                        tool.get("desc_" + lang, ""),
                        tool.get("sub_" + lang, ""),
                        " ".join(tool.get("features_" + lang) or []),
                        " ".join(
                            CATEGORY_NAMES.get(lang, {}).get(cid, "")
                            for cid in tool["cats"]
                        ),
                    ]
                )
            values.extend(tool.get("features") or [])
            if query and query not in " ".join(values).lower():
                continue
            result.append(tool)
        return result

    def _find(self, name):
        for tool in TOOLS:
            if tool["name"] == name:
                return tool
        return None

    def _open_tool(self, name):
        self.selected = str(name)
        self.notice = ""
        self.authorized = False
        self.navigate("detail")
        self.refresh()

    def _tool_callback(self, name):
        def callback(value=None):
            self._open_tool(name)

        return callback

    def _open_url(self, url, success):
        if not url:
            self.notice = self._t("notice_no_link")
            self.refresh()
            return
        try:
            opened = bool(self.api.getAndroid().openUrl(url))
        except Exception as error:
            opened = False
            self.notice = self._t("notice_open_failed", error)
        if opened:
            self.notice = success
        elif not self.notice:
            self.notice = self._t("notice_no_browser")
        self.refresh()

    def _open_docs(self):
        tool = self._find(self.selected)
        if tool:
            self._open_url(tool["url"], self._t("notice_docs"))

    def _open_homepage(self):
        tool = self._find(self.selected)
        if tool:
            self._open_url(tool.get("homepage", ""), self._t("notice_homepage"))

    def _open_repo(self):
        tool = self._find(self.selected)
        if tool:
            self._open_url(tool.get("repo", ""), self._t("notice_repo"))

    def _copy_text(self, text, success):
        try:
            self.api.getAndroid().clipboardSet(text)
            self.notice = success
        except Exception as error:
            self.notice = self._t("notice_copy_failed", error)
        self.refresh()

    def _copy_tool(self):
        tool = self._find(self.selected)
        if tool:
            self._copy_text(tool["name"] + " — " + tool["url"], self._t("notice_copied_name"))

    def _copy_details(self):
        tool = self._find(self.selected)
        if not tool:
            return
        parts = [
            tool["name"],
            self._summary(tool),
            self._t("version") + ": " + (tool.get("version") or self._t("unavailable")),
            self._t("architecture") + ": " + (tool.get("arch") or self._t("unavailable")),
            self._t("subcategory") + ": " + self._sub(tool),
            self._t("status") + ": " + self._status_text(tool),
            self._t("open_docs") + ": " + tool["url"],
        ]
        if tool.get("homepage"):
            parts.append(self._t("open_homepage") + ": " + tool["homepage"])
        self._copy_text("\n".join(parts), self._t("notice_copied_details"))

    def _package(self, tool):
        return str(tool.get("slug") or tool.get("name") or "").strip()

    def _install_command(self, tool):
        return "sudo apt install " + self._package(tool)

    def _help_command(self, tool):
        return str(tool.get("name", "")) + " --help"

    def _launch_command(self, tool):
        return str(tool.get("name", ""))

    def _example_command(self, tool):
        return RECON_EXAMPLES.get(str(tool.get("name", "")), "")

    def _toggle_authorized(self, value):
        self.authorized = bool(value)
        self.refresh()

    def _copy_install(self):
        tool = self._find(self.selected)
        if tool and self._bucket(tool) in ("safe", "recon"):
            self._copy_text(self._install_command(tool), self._t("notice_install"))

    def _copy_help(self):
        tool = self._find(self.selected)
        if tool and self._bucket(tool) in ("safe", "recon"):
            self._copy_text(self._help_command(tool), self._t("notice_help"))

    def _copy_launch(self):
        tool = self._find(self.selected)
        if tool and self._bucket(tool) == "safe":
            self._copy_text(self._launch_command(tool), self._t("notice_launch"))

    def _copy_example(self):
        tool = self._find(self.selected)
        if not tool or self._bucket(tool) != "recon":
            return
        if not self.authorized:
            self.notice = self._t("notice_consent_required")
            self.refresh()
            return
        example = self._example_command(tool)
        if example:
            self._copy_text(example, self._t("notice_example"))

    def _open_source(self):
        self._open_url(_DATA["source"], self._t("notice_source"))

    def _back(self):
        self.notice = ""
        self.navigate("main")
        self.refresh()

    def _subtitle(self, tool):
        summary = self._summary(tool) or self._sub(tool)
        return self._category_text(tool) + " · " + summary + " · " + self._status_text(tool)

    def _features_card(self, ui, tool):
        features = self._features(tool)
        nodes = [ui.text(self._t("features_title"), "titleMedium")]
        if features:
            nodes.append(ui.text(self._t("features_note"), "bodySmall"))
            for item in features:
                nodes.append(ui.text("• " + item, "bodySmall"))
        else:
            nodes.append(ui.text(self._t("no_features"), "bodySmall"))
        return ui.card(nodes)

    def _workspace_card(self, ui, tool):
        bucket = self._bucket(tool)
        color = "error" if bucket == "offensive" else ("primary" if bucket in ("safe", "recon") else None)
        return ui.card(
            [
                ui.text(self._t("workspace_title"), "titleMedium"),
                ui.text(self._t("workspace_note"), "bodySmall"),
                ui.row(
                    [
                        ui.chip(self._t("mode_" + bucket + "_title"), True),
                        ui.chip(self._sub(tool), False),
                    ],
                    spacing=6,
                ),
                ui.text(self._t("mode_" + bucket + "_body"), "bodySmall", color=color),
                ui.text(self._sub_note(tool), "bodySmall"),
                ui.settings_row(self._t("input_label"), self._t("input_" + bucket), "login"),
                ui.settings_row(self._t("output_label"), self._t("output_" + bucket), "output"),
            ]
        )

    def _steps_card(self, ui, tool):
        bucket = self._bucket(tool)
        return ui.card(
            [
                ui.text(self._t("steps_title"), "titleMedium"),
                ui.text(self._t("steps_" + bucket), "bodySmall"),
            ]
        )

    def _actions_card(self, ui, tool):
        bucket = self._bucket(tool)
        nodes = [ui.text(self._t("actions_title"), "titleMedium")]
        if bucket == "safe":
            nodes.extend(
                [
                    ui.function_row(
                        self._t("install_command"),
                        self._install_command(tool),
                        "download",
                        on_click=self._copy_install,
                    ),
                    ui.function_row(
                        self._t("help_command"),
                        self._help_command(tool),
                        "help",
                        on_click=self._copy_help,
                    ),
                    ui.function_row(
                        self._t("launch_command"),
                        self._launch_command(tool),
                        "play_arrow",
                        on_click=self._copy_launch,
                    ),
                    ui.text(self._t("command_note"), "bodySmall"),
                    ui.text(self._t("install_note"), "bodySmall"),
                ]
            )
        elif bucket == "recon":
            nodes.append(
                ui.checkbox(
                    self.authorized,
                    self._toggle_authorized,
                    self._t("consent_title"),
                    self._t("consent_body"),
                )
            )
            nodes.extend(
                [
                    ui.function_row(
                        self._t("install_command"),
                        self._install_command(tool),
                        "download",
                        on_click=self._copy_install,
                    ),
                    ui.function_row(
                        self._t("help_command"),
                        self._help_command(tool),
                        "help",
                        on_click=self._copy_help,
                    ),
                ]
            )
            example = self._example_command(tool)
            if example:
                nodes.append(ui.text(self._t("example_command") + ": " + example, "bodySmall"))
                nodes.append(
                    ui.button(
                        self._t("copy_example"),
                        self._copy_example,
                        enabled=self.authorized,
                        style="tonal",
                        fill_max_width=True,
                    )
                )
            nodes.append(ui.text(self._t("command_note"), "bodySmall"))
            nodes.append(ui.text(self._t("install_note"), "bodySmall"))
        else:
            nodes.append(ui.text(self._t("locked_actions"), "bodySmall"))
        return ui.card(nodes)

    def screen_main(self, ui, api, state):
        matches = self._filtered()
        shown = matches[:self.limit]
        rows = []
        for tool in shown:
            rows.append(
                ui.function_row(
                    tool["name"],
                    self._subtitle(tool),
                    "terminal",
                    icon_tint=self._status_color(tool),
                    on_click=self._tool_callback(tool["name"]),
                )
            )
        nodes = [
            ui.card(
                [
                    ui.row(
                        [
                            ui.icon("terminal", 36),
                            ui.column(
                                [
                                    ui.text(self._t("title"), "titleLarge"),
                                    ui.text(self._t("main_subtitle"), "bodySmall"),
                                ],
                                spacing=2,
                            ),
                        ],
                        spacing=12,
                    ),
                    ui.row(
                        [
                            ui.chip(self._t("tool_count", len(TOOLS)), True),
                            ui.chip(self._t("category_count", len(CATEGORIES)), False),
                            ui.chip(self._t("feature_count", sum(len(t.get("features", [])) for t in TOOLS)), False),
                        ],
                        spacing=6,
                    ),
                    ui.text(self._t("intro"), "bodySmall"),
                ]
            ),
            ui.card(
                [
                    ui.text(self._t("search_title"), "titleMedium"),
                    ui.text_field(self.query, self._set_query, self._t("search_label")),
                    ui.dropdown(self._category_options(), self.category, self._set_category, self._t("category_label")),
                    ui.dropdown(self._status_options(), self.status, self._set_status, self._t("status_label")),
                    ui.dropdown(self._language_options(), self._language_value(), self._set_language, self._t("language")),
                    ui.text(self._t("results", len(matches), len(shown)), "bodySmall"),
                ]
            ),
        ]
        if rows:
            nodes.append(ui.segmented_list(rows))
        else:
            nodes.append(ui.card([ui.text(self._t("no_matches"), "bodySmall")]))
        if len(matches) > self.limit:
            nodes.append(
                ui.button(
                    self._t("show_more", len(matches) - self.limit),
                    self._show_more,
                    style="tonal",
                    fill_max_width=True,
                )
            )
        nodes.extend(
            [
                ui.card(
                    [
                        ui.text(self._t("limits_title"), "titleMedium"),
                        ui.text(self._t("limits_body"), "bodySmall"),
                    ]
                ),
                ui.row(
                    [
                        ui.button(
                            self._t("about"),
                            lambda value=None: (self.navigate("about"), self.refresh()),
                            style="tonal",
                            fill_max_width=True,
                        ),
                        ui.button(self._t("open_source"), self._open_source, style="outlined", fill_max_width=True),
                    ],
                    spacing=8,
                ),
                ui.text(self._t("source_footer", _DATA["source"], _DATA["updated"]), "bodySmall"),
                ui.text(self.notice, "bodySmall", color="primary"),
            ]
        )
        return ui.scaffold(
            title=self._t("title"),
            content=ui.lazy_column(nodes, padding=16, spacing=12, fill_max_size=True),
        )

    def screen_detail(self, ui, api, state):
        tool = self._find(self.selected)
        if not tool:
            return self.screen_main(ui, api, state)
        nodes = [
            ui.card(
                [
                    ui.row(
                        [
                            ui.icon("terminal", 36, tint=self._status_color(tool)),
                            ui.column(
                                [
                                    ui.text(tool["name"], "titleLarge"),
                                    ui.text(self._category_text(tool), "bodySmall"),
                                ],
                                spacing=2,
                            ),
                        ],
                        spacing=12,
                    ),
                    ui.row(
                        [
                            ui.chip(self._status_text(tool), True),
                            ui.chip(self._sub(tool), False),
                        ],
                        spacing=6,
                    ),
                    ui.text(self._summary(tool) or self._t("official_tool"), "titleSmall"),
                ]
            ),
            ui.card(
                [
                    ui.text(self._t("official_description"), "titleMedium"),
                    ui.text(self._description(tool) or self._t("desc_fallback"), "bodySmall"),
                ]
            ),
            self._features_card(ui, tool),
            self._workspace_card(ui, tool),
            self._steps_card(ui, tool),
            self._actions_card(ui, tool),
            ui.card(
                [
                    ui.text(self._t("package_data"), "titleMedium"),
                    ui.settings_row(self._t("version"), tool.get("version") or self._t("unavailable"), "info"),
                    ui.settings_row(self._t("architecture"), tool.get("arch") or self._t("unavailable"), "memory"),
                    ui.settings_row(self._t("package_name"), tool.get("slug") or tool["name"], "package"),
                    ui.settings_row(self._t("subcategory"), self._sub(tool), "label"),
                    ui.settings_row(self._t("status"), self._status_text(tool), "info"),
                ]
            ),
        ]
        if self._equiv(tool):
            nodes.append(
                ui.card(
                    [
                        ui.text(self._t("defensive_alternative"), "titleMedium", color="primary"),
                        ui.text(self._equiv(tool), "bodySmall"),
                    ]
                )
            )
        if tool.get("homepage"):
            nodes.append(ui.button(self._t("open_homepage"), self._open_homepage, style="tonal", fill_max_width=True))
        if tool.get("repo"):
            nodes.append(ui.button(self._t("open_repo"), self._open_repo, style="outlined", fill_max_width=True))
        nodes.extend(
            [
                ui.button(self._t("open_docs"), self._open_docs, fill_max_width=True),
                ui.button(self._t("copy_details"), self._copy_details, style="tonal", fill_max_width=True),
                ui.button(self._t("copy_name"), self._copy_tool, style="text", fill_max_width=True),
                ui.button(self._t("back_index"), self._back, style="text", fill_max_width=True),
                ui.text(tool["url"], "bodySmall"),
                ui.text(self.notice, "bodySmall", color="primary"),
            ]
        )
        return ui.scaffold(
            title=tool["name"],
            content=ui.lazy_column(nodes, padding=16, spacing=12, fill_max_size=True),
        )

    def screen_about(self, ui, api, state):
        names = CATEGORY_NAMES.get(self._lang(), CATEGORY_NAMES["ar"])
        fallback = CATEGORY_NAMES["en"]
        category_rows = []
        for item in CATEGORIES:
            label = names.get(item["id"]) or fallback.get(item["id"]) or item["id"]
            category_rows.append(
                ui.settings_row(label, self._t("tool_count", item["count"]), "category")
            )
        return ui.scaffold(
            title=self._t("about_title"),
            content=ui.lazy_column(
                [
                    ui.card(
                        [
                            ui.text(self._t("about_what"), "titleLarge"),
                            ui.text(self._t("about_body", len(TOOLS), len(CATEGORIES)), "bodySmall"),
                            ui.text(self._t("about_source"), "bodySmall"),
                        ]
                    ),
                    ui.card(
                        [
                            ui.text(self._t("categories_title"), "titleMedium"),
                            ui.segmented_list(category_rows),
                        ]
                    ),
                    ui.card(
                        [
                            ui.text(self._t("defensive_tools"), "titleMedium"),
                            ui.text(self._t("defensive_tools_body"), "bodySmall"),
                        ]
                    ),
                    ui.button(self._t("open_source_official"), self._open_source, fill_max_width=True),
                    ui.button(self._t("back"), self._back, style="text", fill_max_width=True),
                    ui.text(self.notice, "bodySmall", color="primary"),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )
