        "en": "Reference for Wi-Fi security; execution is disabled.",
        "ru": "Справка по безопасности Wi-Fi; запуск отключён.",
    },
}

RECON_EXAMPLES = {
    "nmap": "nmap -sV --version-light <target>",
    "masscan": "masscan -p80,443 <target> --rate 100",
    "whatweb": "whatweb https://example.com",
    "wafw00f": "wafw00f https://example.com",
    "sslscan": "sslscan example.com:443",
    "dnsrecon": "dnsrecon -d example.com",
    "amass": "amass enum -d example.com",
    "theHarvester": "theHarvester -d example.com -b all",
    "gobuster": "gobuster dir -u https://example.com -w <wordlist>",
    "nikto": "nikto -h https://example.com",
    "dirb": "dirb https://example.com",
    "enum4linux": "enum4linux -a <target>",
    "enum4linux-ng": "enum4linux-ng -A <target>",
}


def device_language():
    """Best-effort locale detection; the Java bridge exists only inside Dolphy."""
    try:
        from java import jclass

        code = str(jclass("java.util.Locale").getDefault().getLanguage()).lower()
        if code.startswith("ar"):
            return "ar"
        if code.startswith("ru"):
            return "ru"
        return "en"
    except Exception:
        return "ar"


