_DATA = json.loads(r'''{"source":"https://www.kali.org/tools/","updated":"2026-11-05","categories":[{"id":"reconnaissance","ar":"الاستطلاع","en":"Reconnaissance","count":87},{"id":"resource-development","ar":"تطوير الموارد","en":"Resource Development","count":40},{"id":"initial-access","ar":"الوصول الأولي","en":"Initial Access","count":11},{"id":"execution","ar":"التنفيذ","en":"Execution","count":7},{"id":"persistence","ar":"الاستمرارية","en":"Persistence","count":8},{"id":"privilege-escalation","ar":"رفع الصلاحيات","en":"Privilege Escalation","count":7},{"id":"defense-evasion","ar":"التهرّب الدفاعي","en":"Defense Evasion","count":25},{"id":"credential-access","ar":"الوصول إلى بيانات الاعتماد","en":"Credential Access","count":68},{"id":"discovery","ar":"الاستكشاف","en":"Discovery","count":88},{"id":"lateral-movement","ar":"الحركة الجانبية","en":"Lateral Movement","count":13},{"id":"collection","ar":"الجمع","en":"Collection","count":16},{"id":"command-and-control","ar":"القيادة والتحكم","en":"Command and Control","count":45},{"id":"exfiltration","ar":"تسريب البيانات","en":"Exfiltration","count":3},{"id":"impact","ar":"التأثير","en":"Impact","count":11},{"id":"forensics","ar":"التحقيق الجنائي","en":"Forensics","count":76},{"id":"services-and-other-tools","ar":"خدمات وأدوات أخرى","en":"Services and Other Tools","count":42}],"tools":[{"name":"metagoofil","cat":"reconnaissance","sub":"Host Information","url":"https://www.kali.org/tools/metagoofil/#metagoofil-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"metagoofil","version":"1:1.2.0+git20221009-0kali1","arch":"all","homepage":"https://github.com/opsdisk/metagoofil","repo":"https://gitlab.com/kalilinux/packages/metagoofil","summary":"Tool designed for extracting metadata of public documents","desc":"Metagoofil is an information gathering tool designed for extracting metadata of public documents (pdf,doc,xls,ppt,docx,pptx,xlsx) belonging to a target company. Metagoofil will perform a search in Google to identify and download the documents to local disk. Metagoofil does no longer extract the metadata. See /usr/share/doc/metagoofil/README.md.gz.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"spiderfoot","cat":"reconnaissance","sub":"Host Information","url":"https://www.kali.org/tools/spiderfoot/#spiderfoot-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"spiderfoot","version":"4.0-0kali5","arch":"all","homepage":"https://www.spiderfoot.net","repo":"https://gitlab.com/kalilinux/packages/spiderfoot","summary":"OSINT collection and reconnaissance tool","desc":"This package contains an open source intelligence (OSINT) automation tool. Its goal is to automate the process of gathering intelligence about a given target, which may be an IP address, domain name, hostname, network subnet, ASN, e-mail address or person's name. SpiderFoot can be used offensively, i.e. as part of a black-box penetration test to gather information about the target, or defensively to identify what information you or your organisation are freely providing for attackers to use against you.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"spiderfoot-cli","cat":"reconnaissance","sub":"Host Information","url":"https://www.kali.org/tools/spiderfoot/#spiderfoot-cli","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"spiderfoot","version":"4.0-0kali5","arch":"all","homepage":"https://www.spiderfoot.net","repo":"https://gitlab.com/kalilinux/packages/spiderfoot","summary":"OSINT collection and reconnaissance tool","desc":"This package contains an open source intelligence (OSINT) automation tool. Its goal is to automate the process of gathering intelligence about a given target, which may be an IP address, domain name, hostname, network subnet, ASN, e-mail address or person's name. SpiderFoot can be used offensively, i.e. as part of a black-box penetration test to gather information about the target, or defensively to identify what information you or your organisation are freely providing for attackers to use against you.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"email2phonenumber","cat":"reconnaissance","sub":"Identity Information","url":"https://www.kali.org/tools/email2phonenumber/#email2phonenumber-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"email2phonenumber","version":"0~git20220216-0kali2","arch":"all","homepage":"https://github.com/martinvigo/email2phonenumber","repo":"https://gitlab.com/kalilinux/packages/email2phonenumber","summary":"OSINT tool to obtain a target's phone number by having their email address","desc":"This package contains an OSINT tool that allows you to obtain a target's phone number just by having their email address. This tool helps automate discovering someone's phone number by abusing password reset design weaknesses and publicly available data. It supports 3 main functions: password reset using the target's email address. Phone Numbering Plan publicly available information. password reset on different websites to obtain associated masked emails and correlate it to the victim's one.","features":["\"scrape\" - scrapes websites for phone number digits by initiating","\"generate\" - creates a list of valid phone numbers based on the country's","\"bruteforce\" - iterates over a list of phone numbers and initiates"]},{"name":"emailharvester","cat":"reconnaissance","sub":"Identity Information","url":"https://www.kali.org/tools/emailharvester/#emailharvester-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"emailharvester","version":"1.3.2+git20191005-0kali3","arch":"all","homepage":"https://github.com/maldevel/EmailHarvester","repo":"https://gitlab.com/kalilinux/packages/emailharvester","summary":"Email addresses harvester","desc":"This package contains EmailHarvester, a tool to retrieve Domain email addresses from Search Engines. Features: Yahoo, ASK, Baidu, Dogpile, Exalead) Google+, Github, Instagram, Reddit, Youtube)","features":["Retrieve Domain email addresses from popular Search engines (Google, Bing,","Export results to txt and xml files","Limit search results","Define your own User-Agent string","Use proxy server","Plugins system","Search in popular web sites using Search engines (Twitter, LinkedIn,"]},{"name":"instaloader","cat":"reconnaissance","sub":"Identity Information","url":"https://www.kali.org/tools/instaloader/#instaloader-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"instaloader","version":"4.15.1+ds-1","arch":"all","homepage":"https://github.com/instaloader/instaloader","repo":"https://salsa.debian.org/debian/instaloader","summary":"Instagram automatic photo downloader","desc":"Instaloader downloads photos from Instagram, including public and private profiles, hashtags, user stories, feeds and saved media. How as well as comments, geotags and captions for each post. It automatically detects profile name changes and renames the target directory accordingly. It also allows for refined customization of filters and where to store downloaded media be able to detect automatically stop previously interrupted download interactions.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"linkedin2username","cat":"reconnaissance","sub":"Identity Information","url":"https://www.kali.org/tools/linkedin2username/#linkedin2username-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"linkedin2username","version":"0.30-0kali1","arch":"all","homepage":"https://github.com/initstring/linkedin2username","repo":"https://gitlab.com/kalilinux/packages/linkedin2username","summary":"Generate username lists for companies on LinkedIn","desc":"OSINT Tool: Generate username lists from companies on LinkedIn. This is a pure web-scraper, no API key required. You use your valid LinkedIn username and password to login, it will create several lists of possible username formats for all employees of a company you point it at.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"photon","cat":"reconnaissance","sub":"Identity Information","url":"https://www.kali.org/tools/photon/#photon-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"photon","version":"1.3.0-0kali2","arch":"all","homepage":"https://github.com/s0md3v/Photon","repo":"https://gitlab.com/kalilinux/packages/photon","summary":"Incredibly fast crawler designed for open source intelligence","desc":"This package includes a fast and flexible crawler designed for open source intelligence (OSINT). Photon can extract the following data while crawling: The extracted information is saved in an organized manner or can be exported as json.","features":["URLs (in-scope & out-of-scope)","URLs with parameters (example.com/gallery.php?id=2)","Intel (emails, social media accounts, amazon buckets etc.)","Files (pdf, png, xml etc.)","Secret keys (auth/API keys & hashes)","JavaScript files & Endpoints present in them","Strings matching custom regex pattern","Subdomains & DNS related data"]},{"name":"sherlock","cat":"reconnaissance","sub":"Identity Information","url":"https://www.kali.org/tools/sherlock/#sherlock-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"sherlock","version":"0.16.0-3","arch":"all","homepage":"https://github.com/sherlock-project/sherlock","repo":"https://salsa.debian.org/pkg-security-team/sherlock","summary":"Find usernames across social networks","desc":"Sherlock relies on the site's designers providing a unique URL for a registered username. To determine if a username is available, Sherlock queries that URL, and uses to response to understand if there is a claimed username already there. Currently, the tool is capable of locating users on more than 300 social networks: Apple Developer, Arduino, Docker Hub, GitHub, GitLab, Facebook, BitCoinForum, CNET, IFTTT, Instagram, PlayStore PyPI, Scribd, Telegram, TikTok, Tinder etc.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"tookie-osint","cat":"reconnaissance","sub":"Identity Information","url":"https://www.kali.org/tools/tookie-osint/#tookie-osint-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"tookie-osint","version":"4.1fix-0kali1","arch":"all","homepage":"https://github.com/Alfredredbird/tookie-osint","repo":"https://gitlab.com/kalilinux/packages/tookie-osint","summary":"OSINT information gathering tool for finding social media accounts","desc":"Tookie-osint has a simple-to-use UI and is really straightforward. The main idea of Tookie-osint is to discover usernames that are requested from an input. Tookie-osint is similar to the tool called Sherlock. It discovers all the user accounts across different websites and Tookie-osint is successful at this task almost 80% of the time.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"amass","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/amass/#amass-1","cats":["reconnaissance","discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"amass","version":"5.1.1-0kali3","arch":"any","homepage":"https://github.com/OWASP/Amass","repo":"https://gitlab.com/kalilinux/packages/amass","summary":"In-depth DNS Enumeration and Network Mapping","desc":"This package contains a tool to help information security professionals perform network mapping of attack surfaces and perform external asset discovery using open source information gathering and active reconnaissance techniques. Information Gathering Techniques Used: sweeping, Subdomain name alterations/permutations, Zone transfers (upon request) Google, HackerOne, IPv4Info, Netcraft, PTRArchive, Riddler, SiteDossier, ViewDNS, Yahoo Entrust, GoogleCT HackerTarget, Mnemonic, NetworksDB, PassiveTotal, RADb, Robtex, SecurityTrails, ShadowServer, Shodan, Spyse (CertDB & FindSubdomains), Sublist3rAPI, TeamCymru, ThreatCrowd, Twitter, Umbrella, URLScan, VirusTotal OpenUKArchive, UKGovArchive, Wayback This package contains the command amass.","features":["DNS: Basic enumeration, Brute forcing (upon request), Reverse DNS","Scraping: Ask, Baidu, Bing, DNSDumpster, DNSTable, Dogpile, Exalead,","Certificates: Active pulls (upon request), Censys, CertSpotter, Crtsh,","APIs: AlienVault, BinaryEdge, BufferOver, CIRCL, CommonCrawl, DNSDB,","Web Archives: ArchiveIt, ArchiveToday, Arquivo, LoCArchive,"]},{"name":"autorecon","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/autorecon/#autorecon-1","cats":["reconnaissance","discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"autorecon","version":"0.0~git20251116.e7e98f6-0kali1","arch":"any","homepage":"https://github.com/Tib3rius/AutoRecon","repo":"https://gitlab.com/kalilinux/packages/autorecon","summary":"Multi-threaded network reconnaissance tool","desc":"AutoRecon is a multi-threaded network reconnaissance tool which performs automated enumeration of services. It is intended as a time-saving tool for use in CTFs and other penetration testing environments (e.g. OSCP). It may also be useful in real-world engagements.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"dmitry","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/dmitry/#dmitry-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"dmitry","version":"1.3a-8","arch":"any","homepage":"https://mor-pah.net/software/dmitry-deepmagic-information-gathering-tool/","repo":"https://salsa.debian.org/debian/dmitry","summary":"Deepmagic Information Gathering Tool","desc":"DMitry is a UNIX/(GNU)Linux command line application written in C. DMitry can find possible subdomains, email addresses, uptime information, perform tcp port scan, whois lookups, and more.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"legion","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/legion/#legion-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"legion","version":"0.7.0-0kali2","arch":"any","homepage":"https://github.com/Hackman238/legion","repo":"https://gitlab.com/kalilinux/packages/legion","summary":"Semi-automated network penetration testing tool","desc":"This package contains an open source, easy-to-use, super-extensible and semi-automated network penetration testing tool that aids in discovery, reconnaissance and exploitation of information systems. Legion is a fork of SECFORCE's Sparta.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"nmap","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/nmap/#nmap-1","cats":["reconnaissance","discovery"],"status":"استطلاع — مصرّح فقط","equiv":"فحص المنافذ والخدمات في Captive Portal Auditor","slug":"nmap","version":"7.99+dfsg-1kali1","arch":"any all","homepage":"https://nmap.org/","repo":"https://gitlab.com/kalilinux/packages/nmap","summary":"The Network Mapper","desc":"Nmap is a utility for network exploration or security auditing. It supports ping scanning (determine which hosts are up), many port scanning techniques, version detection (determine service protocols and application versions listening behind ports), and TCP/IP fingerprinting (remote host OS or device identification). Nmap also offers flexible target and port specification, decoy/stealth scanning, sunRPC scanning, and more. Most Unix and Windows platforms are supported in both GUI and commandline modes. Several popular handheld devices are also supported, including the Sharp Zaurus and the iPAQ.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"zenmap","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/nmap/#zenmap-1","cats":["reconnaissance","discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"nmap","version":"7.99+dfsg-1kali1","arch":"any all","homepage":"https://nmap.org/","repo":"https://gitlab.com/kalilinux/packages/nmap","summary":"The Network Mapper","desc":"Nmap is a utility for network exploration or security auditing. It supports ping scanning (determine which hosts are up), many port scanning techniques, version detection (determine service protocols and application versions listening behind ports), and TCP/IP fingerprinting (remote host OS or device identification). Nmap also offers flexible target and port specification, decoy/stealth scanning, sunRPC scanning, and more. Most Unix and Windows platforms are supported in both GUI and commandline modes. Several popular handheld devices are also supported, including the Sharp Zaurus and the iPAQ.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"theHarvester","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/theharvester/#theharvester-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"theharvester","version":"4.11.1-0kali1","arch":"all","homepage":"https://github.com/laramies/theHarvester","repo":"https://gitlab.com/kalilinux/packages/theharvester","summary":"Tool for gathering e-mail accounts and subdomain names from public sources","desc":"The package contains a tool for gathering subdomain names, e-mail addresses, virtual hosts, open ports/ banners, and employee names from different public sources (search engines, pgp key servers).","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"unicornscan","cat":"reconnaissance","sub":"Network Information","url":"https://www.kali.org/tools/unicornscan/#unicornscan-1","cats":["reconnaissance","discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"unicornscan","version":"0.4.7-1kali7","arch":"any","homepage":"http://www.unicornscan.org/","repo":"https://gitlab.com/kalilinux/packages/unicornscan","summary":"Userland distributed TCP/IP stack","desc":"Unicornscan is a new information gathering and correlation engine built for and by members of the security research and testing communities. It was designed to provide an engine that is Scalable, Accurate, Flexible, and Efficient. It is released for the community to use under the terms of the GPL license. Benefits: Unicornscan is an attempt at a User-land Distributed TCP/IP stack. It is intended to provide a researcher a superior interface for introducing a stimulus into and measuring a response from a TCP/IP enabled device or network. Although it currently has hundreds of individual features, a main set of abilities include: to elicit a response). by analyzing responses.","features":["Asynchronous stateless TCP scanning with all variations of TCP Flags.","Asynchronous stateless TCP banner grabbing","Asynchronous protocol specific UDP Scanning (sending enough of a signature","Active and Passive remote OS, application, and component identification","PCAP file logging and filtering","Relational database output","Custom module support","Customized data-set views"]},{"name":"dnsmap","cat":"reconnaissance","sub":"Network Information: DNS","url":"https://www.kali.org/tools/dnsmap/#dnsmap-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"استطلاع DNS عبر DoH في Captive Portal Auditor","slug":"dnsmap","version":"0.36-4","arch":"any","homepage":"https://github.com/resurrecting-open-source-projects/dnsmap","repo":"https://salsa.debian.org/pkg-security-team/dnsmap","summary":"DNS domain name brute forcing tool","desc":"dnsmap scans a domain for common subdomains using a built-in or an external wordlist (if specified using -w option). The internal wordlist has around 1000 words in English and Spanish as ns1, firewall servicios and smtp. So will be possible search for smtp.example.com inside example.com automatically. Results can be saved in CSV and human-readable format for further processing. dnsmap does NOT require root privileges to be run, and should NOT be run with such privileges for security reasons. dnsmap was originally released back in 2006 and was inspired by the fictional story \"The Thief No One Saw\" by Paul Craig, which can be found in the book \"Stealing the Network - How to 0wn the Box\". dnsmap is mainly meant to be used by pentesters during the information gathering/enumeration phase of infrastructure security assessments. During the enumeration stage, the security consultant would typically discover the target company's IP netblocks, domain names, phone numbers, etc. Subdomain brute-forcing is another technique that should be used in the enumeration stage, as it's especially useful when other domain enumeration techniques such as zone transfers don't work (I rarely see zone transfers being publicly allowed these days by the way). Fun things that can happen: 1) Finding interesting remote access servers (e.g.: https:://extranet.example.com). 2) Finding badly configured and/or unpatched servers (e.g.: test.example.com). 3) Finding new domain names which will allow you to map non-obvious/hard-to-find netblocks of your target organization (registry lookups - aka whois is your friend). 4) Sometimes you find that some bruteforced subdomains resolve to internal IP addresses (RFC 1918). This is great as sometimes they are real up-to-date \"A\" records which means that it is possible to enumerate internal servers of a target organization from the Internet by only using standard DNS resolving (as opposed to zone transfers for instance). 5) Discover embedded devices configured using Dynamic DNS services (e.g.: IP Cameras). This method is an alternative to finding devices via Google hacking techniques. This package provides two possible commands: dnsmap and dnsmap-bulk. This program is useful for pentesters, ethical hackers and forensics experts. It also can be used for security tests.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"dnsrecon","cat":"reconnaissance","sub":"Network Information: DNS","url":"https://www.kali.org/tools/dnsrecon/#dnsrecon-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"استطلاع DNS عبر DoH في Captive Portal Auditor","slug":"dnsrecon","version":"1.6.0-1","arch":"all","homepage":"https://github.com/darkoperator/dnsrecon","repo":"https://salsa.debian.org/pkg-security-team/dnsrecon","summary":"Powerful DNS enumeration script","desc":"DNSRecon is a Python script that provides the ability to perform: (MX, SOA, NS, A, AAAA, SPF and TXT). given a domain and a wordlist.","features":["Check all NS Records for Zone Transfers.","Enumerate General DNS Records for a given Domain","Perform common SRV Record Enumeration.","Top Level Domain (TLD) Expansion.","Check for Wildcard Resolution.","Brute Force subdomain and host A and AAAA records","Perform a PTR Record lookup for a given IP Range or CIDR.","Check a DNS Server Cached records for A, AAAA and CNAME","Records provided a list of host records in a text file to check.","Enumerate Hosts and Subdomains using Google"]},{"name":"dnsenum","cat":"reconnaissance","sub":"Network Information: DNS","url":"https://www.kali.org/tools/dnsenum/#dnsenum-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"استطلاع DNS عبر DoH في Captive Portal Auditor","slug":"dnsenum","version":"1.3.2-1","arch":"all","homepage":"https://github.com/SparrowOchon/dnsenum2","repo":"https://salsa.debian.org/pkg-security-team/dnsenum","summary":"Tool to enumerate domain DNS information","desc":"Dnsenum is a multithreaded perl script to enumerate DNS information of a domain and to discover non-contiguous ip blocks. The main purpose of Dnsenum is to gather as much information as possible about a domain. The program currently performs the following operations: \"allinurl: -www site:domain\"). that have NS records (all threaded). (threaded). (threaded). This program is useful for pentesters, ethical hackers and forensics experts. It also can be used for security tests.","features":["Get the host's addresses (A record).","Get the namservers (threaded).","Get the MX record (threaded).","Perform axfr queries on nameservers and get BIND versions(threaded).","Get extra names and subdomains via google scraping (google query =","Brute force subdomains from file, can also perform recursion on subdomain","Calculate C class domain network ranges and perform whois queries on them","Perform reverse lookups on netranges (C class or/and whois netranges)","Write to domain_ips.txt file ip-blocks."]},{"name":"massdns","cat":"reconnaissance","sub":"Network Information: DNS","url":"https://www.kali.org/tools/massdns/#massdns-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"massdns","version":"1.1.0-0kali2","arch":"amd64 arm64","homepage":"https://github.com/blechschmidt/massdns","repo":"https://gitlab.com/kalilinux/packages/massdns","summary":"High-performance DNS stub resolver","desc":"This package contains a simple high-performance DNS stub resolver targeting those who seek to resolve a massive amount of domain names in the order of millions or even billions. Without special configuration, MassDNS is capable of resolving over 350,000 names per second using publicly available resolvers.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"dnstracer","cat":"reconnaissance","sub":"Network Information: DNS","url":"https://www.kali.org/tools/dnstracer/#dnstracer-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"dnstracer","version":"1.10-1","arch":"any","homepage":"http://www.mavetju.org/unix/dnstracer.php","repo":"https://salsa.debian.org/creekorful/dnstracer","summary":"Trace DNS queries to the source","desc":"dnstracer determines where a given Domain Name Server (DNS) gets its information from for a given hostname, and follows the chain of DNS servers back to the authoritative answer.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"dnswalk","cat":"reconnaissance","sub":"Network Information: DNS","url":"https://www.kali.org/tools/dnswalk/#dnswalk-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"dnswalk","version":"2.0.2.dfsg.1-3","arch":"all","homepage":"https://github.com/davebarr/dnswalk","repo":"https://salsa.debian.org/debian/dnswalk","summary":"Checks dns zone information using nameserver lookups","desc":"dnswalk is a DNS debugger. It performs zone transfers of specified domains, and checks the database in numerous ways for internal consistency, as well as accuracy.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"assetfinder","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/assetfinder/#assetfinder-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"assetfinder","version":"0.1.1-1","arch":"any","homepage":"https://github.com/tomnomnom/assetfinder","repo":"https://salsa.debian.org/pkg-security-team/assetfinder","summary":"Find domains and subdomains related to a given domain","desc":"assetfinder is a command-line tool designed to find domains and subdomains associated with a specific domain. The main objective of the tool is to help security researchers and IT professionals discover and understand how the domains and sub-domains of a given organization are distributed, trying to find possible security flaws and vulnerabilities. assetfinder uses multiple data sources to perform its research, including: This expands coverage and increases the accuracy of results.","features":["crt.sh","certspotter","hackertarget","threatcrowd","Wayback Machine","dns.bufferover.run","Facebook Graph API","Virustotal","findsubdomains"]},{"name":"arjun","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/arjun/#arjun-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"arjun","version":"2.2.7-1","arch":"all","homepage":"https://github.com/s0md3v/Arjun","repo":"https://salsa.debian.org/pkg-security-team/arjun","summary":"HTTP parameter discovery suite","desc":"This package can find query parameters for URL endpoints. Web applications use parameters (or queries) to accept user input, take the following example into consideration. http://api.example.com/v1/userinfo?id=751634589 This URL seems to load user information for a specific user id, but what if there exists a parameter named admin which when set to True makes the endpoint provide more information about the user? This is what Arjun does, it finds valid HTTP parameters with a huge default dictionary of 25,890 parameter names. It takes less than 10 seconds to go through this huge list while making just 50-60 requests to the target. Some features: Arjun is useful for penetration testing (PENTEST) and network security analysis, serving as OSINT.","features":["Supports GET/POST/POST-JSON/POST-XML requests;","Automatically handles rate limits and timeouts;","Export results to: BurpSuite, text or JSON file;","Import targets from: BurpSuite, text file or a raw request file;","Can passively extract parameters from JS or 3 external sources."]},{"name":"dirb","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/dirb/#dirb-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"dirb","version":"2.22+dfsg-7","arch":"any","homepage":"https://dirb.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/dirb","summary":"URL bruteforcing tool","desc":"DIRB is a Web Content Scanner. It looks for existing (and/or hidden) Web Objects. It basically works by launching a dictionary based attack against a web server and analyzing the responses. DIRB comes with a set of preconfigured attack wordlists for easy usage but you can use your custom wordlists. Also DIRB sometimes can be used as a classic CGI scanner, but remember that it is a content scanner not a vulnerability scanner. DIRB's main purpose is to help in professional web application auditing. Specially in security related testing. It covers some holes not covered by classic web vulnerability scanners. DIRB looks for specific web objects that other generic CGI scanners can't look for. It doesn't search vulnerabilities nor does it look for web contents that can be vulnerable.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"dirbuster","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/dirbuster/#dirbuster-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"dirbuster","version":"1.0-1kali6","arch":"all","homepage":"https://www.owasp.org/index.php/Category:OWASP_DirBuster_Project","repo":"https://gitlab.com/kalilinux/packages/dirbuster","summary":"Web server directory brute-forcer","desc":"DirBuster is a multi threaded java application designed to brute force directories and files names on web/application servers. Often is the case now of what looks like a web server in a state of default installation is actually not, and has pages and applications hidden within. DirBuster attempts to find these. However tools of this nature are often as only good as the directory and file list they come with. A different approach was taken to generating this. The list was generated from scratch, by crawling the Internet and collecting the directory and files that are actually used by developers! DirBuster comes a total of 9 different lists, this makes DirBuster extremely effective at finding those hidden files and directories. And if that was not enough DirBuster also has the option to perform a pure brute force, which leaves the hidden directories and files nowhere to hide.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"dirsearch","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/dirsearch/#dirsearch-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"dirsearch","version":"0.4.3-1","arch":"all","homepage":"https://github.com/maurosoria/dirsearch","repo":"https://salsa.debian.org/pkg-security-team/dirsearch","summary":"Web path scanner","desc":"This package contains is a command-line tool designed to brute force directories and files in webservers. As a feature-rich tool, dirsearch gives users the opportunity to perform a complex web content discovering, with many vectors for the wordlist, high accuracy, impressive performance, advanced connection/request settings, modern brute-force techniques and nice output.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"feroxbuster","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/feroxbuster/#feroxbuster-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"feroxbuster","version":"2.13.1-0kali3","arch":"any","homepage":"https://github.com/epi052/feroxbuster","repo":"https://gitlab.com/kalilinux/packages/feroxbuster","summary":"Fast, simple, recursive content discovery tool written in Rust","desc":"feroxbuster is a tool designed to perform Forced Browsing. Forced browsing is an attack where the aim is to enumerate and access resources that are not referenced by the web application, but are still accessible by an attacker. feroxbuster uses brute force combined with a wordlist to search for unlinked content in target directories. These resources may store sensitive information about web applications and operational systems, such as source code, credentials, internal network addressing, etc... This attack is also known as Predictable Resource Location, File Enumeration, Directory Enumeration, and Resource Enumeration.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"ffuf","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/ffuf/#ffuf-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"ffuf","version":"2.2.1-1","arch":"any","homepage":"https://github.com/ffuf/ffuf","repo":"https://salsa.debian.org/debian/ffuf/","summary":"Fast web fuzzer written in Go (program)","desc":"ffuf is a fast web fuzzer written in Go that allows typical directory discovery, virtual host discovery (without DNS records) and GET and POST parameter fuzzing. This program is useful for pentesters, ethical hackers and forensics experts. It also can be used for security tests.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"finalrecon","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/finalrecon/#finalrecon-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"finalrecon","version":"1.1.8-0kali1","arch":"all","homepage":"https://github.com/thewhiteh4t/FinalRecon","repo":"https://gitlab.com/kalilinux/packages/finalrecon","summary":"Fast and simple Python script for web reconnaissance","desc":"A fast and simple Python script for web reconnaissance that follows a modular structure and provides detailed information on various areas.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"findomain","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/findomain/#findomain-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"findomain","version":"10.0.1-0kali1","arch":"amd64 arm64 armhf i386","homepage":"https://github.com/Findomain/Findomain","repo":"https://gitlab.com/kalilinux/packages/findomain","summary":"Fastest and most complete solution for domain recognition","desc":"Findomain is fastest and most complete solution for domain recognition. It supports screenshoting, port scanning, HTTP checks, data imports from other tools, subdomain monitoring, alerts via Discord, Slack & Telegram, multiple API Keys for sourcing and much more.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"gobuster","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/gobuster/#gobuster-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"gobuster","version":"3.8.2-1","arch":"any","homepage":"https://github.com/OJ/gobuster","repo":"https://salsa.debian.org/pkg-security-team/gobuster","summary":"High-performance discovery tool for directories, DNS and cloud storage","desc":"Gobuster is a high-performance tool used to brute-force and discover: Gobuster is designed for penetration testers, security professionals, and forensics experts to perform security assessments and reconnaissance.","features":["URIs (directories and files) in web sites","DNS subdomains (with wildcard support)","Virtual Host names on target web servers","Open Amazon S3 and Google Cloud Storage (GCS) buckets","Open TFTP servers","Custom fuzzing with customizable parameters"]},{"name":"gospider","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/gospider/#gospider-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"gospider","version":"1.1.6-0kali1","arch":"any","homepage":"https://github.com/jaeles-project/gospider","repo":"https://gitlab.com/kalilinux/packages/gospider","summary":"Fast web spider written in Go","desc":"This package contains a Fast web spider written in Go. The features are:","features":["Fast web crawling","Brute force and parse sitemap.xml","Parse robots.txt","Generate and verify link from JavaScript files","Link Finder","Find AWS-S3 from response source","Find subdomains from response source","Get URLs from Wayback Machine, Common Crawl, Virus Total, Alien Vault","Format output easy to Grep","Support Burp input"]},{"name":"lbd","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/lbd/#lbd-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"lbd","version":"0.4-1kali3","arch":"all","homepage":"http://ge.mine.nu/code/","repo":"https://gitlab.com/kalilinux/packages/lbd","summary":"Load balancer detector","desc":"Checks if a given domain uses load-balancing.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"parsero","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/parsero/#parsero-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"parsero","version":"0.81~git20140929-0kali2","arch":"all","homepage":"https://github.com/behindthefirewalls/Parsero","repo":"https://gitlab.com/kalilinux/packages/parsero","summary":"Robots.txt audit tool","desc":"Parsero is a free script written in Python which reads the Robots.txt file of a web server and looks at the Disallow entries. The Disallow entries tell the search engines what directories or files hosted on a web server mustn't be indexed. For example, \"Disallow: /portal/login\" means that the content on www.example.com/portal/login it's not allowed to be indexed by crawlers like Google, Bing, Yahoo... This is the way the administrator have to not share sensitive or private information with the search engines.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"recon-ng","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/recon-ng/#recon-ng-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"recon-ng","version":"5.1.2-2","arch":"all","homepage":"https://github.com/lanmaster53/recon-ng","repo":"https://salsa.debian.org/pkg-security-team/recon-ng","summary":"Web Reconnaissance framework written in Python","desc":"Recon-ng is a full-featured Web Reconnaissance framework written in Python. Complete with independent modules, database interaction, built in convenience functions, interactive help, and command completion, Recon-ng provides a powerful environment in which open source web-based reconnaissance can be conducted quickly and thoroughly. Recon-ng has a look and feel similar to the Metasploit Framework, reducing the learning curve for leveraging the framework. However, it is quite different. Recon-ng is not intended to compete with existing frameworks, as it is designed exclusively for web-based open source reconnaissance. If you want to exploit, use the Metasploit Framework. If you want to Social Engineer, use the Social Engineer Toolkit.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"subfinder","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/subfinder/#subfinder-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"subfinder","version":"2.16.0-0kali1","arch":"any","homepage":"https://github.com/projectdiscovery/subfinder","repo":"https://gitlab.com/kalilinux/packages/subfinder","summary":"Subdomain discovery tool","desc":"This package contains a subdomain discovery tool that discovers valid subdomains for websites by using passive online sources. It has a simple modular architecture and is optimized for speed. subfinder is built for doing one thing only - passive subdomain enumeration, and it does that very well.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"sublist3r","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/sublist3r/#sublist3r-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"sublist3r","version":"1.1-5","arch":"all","homepage":"https://github.com/aboul3la/Sublist3r","repo":"https://salsa.debian.org/pkg-security-team/sublist3r","summary":"Fast subdomains enumeration tool for penetration testers","desc":"This package contains a Python security tool designed to enumerate subdomains of websites using OSINT. It helps penetration testers and bug hunters collect and gather subdomains for the domain they are targeting over the network. Sublist3r enumerates subdomains using many search engines such as Google, Yahoo, Bing, Baidu, and Ask. Sublist3r also enumerates subdomains using Netcraft, Virustotal, ThreatCrowd, DNSdumpster, and ReverseDNS. Subbrute was integrated with Sublist3r to increase the possibility of finding more subdomains using bruteforce with an improved wordlist.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"uniscan-gui","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/uniscan/#uniscan-gui","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"uniscan","version":"6.3-0kali3","arch":"all","homepage":"https://sourceforge.net/projects/uniscan/","repo":"https://gitlab.com/kalilinux/packages/uniscan","summary":"LFI, RFI, and RCE vulnerability scanner","desc":"Uniscan is a simple Remote File Include, Local File Include and Remote Command Execution vulnerability scanner.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"urlcrazy","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/urlcrazy/#urlcrazy-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"urlcrazy","version":"0.8.2-0kali1","arch":"all","homepage":"https://www.morningstarsecurity.com/research/urlcrazy","repo":"https://gitlab.com/kalilinux/packages/urlcrazy","summary":"Domain typo generator","desc":"Generate and test domain typos and variations to detect and perform typo squatting, URL hijacking, phishing, and corporate espionage.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"uro","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/uro/#uro-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"uro","version":"1.0.2-0kali1","arch":"all","homepage":"https://github.com/s0md3v/uro","repo":"https://gitlab.com/kalilinux/packages/uro","summary":"Declutter URLs for crawling/pentesting","desc":"Uro declutters a list of URLs by removing","features":["Incremental URLs,","Blog posts and other similar human-written content,","URLs with the same path but parameter value differences,","Images, JS, CSS, and other \"useless\" files."]},{"name":"wfuzz","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/wfuzz/#wfuzz-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"wfuzz","version":"3.1.0-6","arch":"all","homepage":"http://www.edge-security.com/wfuzz.php","repo":"https://salsa.debian.org/pkg-security-team/wfuzz","summary":"Web application bruteforcer","desc":"Wfuzz is a tool designed for bruteforcing Web Applications, it can be used for finding resources not linked directories, servlets, scripts, etc, bruteforce GET and POST parameters for checking different kind of injections (SQL, XSS, LDAP,etc), bruteforce Forms parameters (User/Password), Fuzzing, etc.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"wpprobe","cat":"reconnaissance","sub":"Web Scanning","url":"https://www.kali.org/tools/wpprobe/#wpprobe-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"wpprobe","version":"0.12.11-0kali1","arch":"any","homepage":"https://github.com/Chocapikk/wpprobe","repo":"https://gitlab.com/kalilinux/packages/wpprobe","summary":"Fast WordPress plugin enumeration tool","desc":"A fast WordPress plugin scanner that detects installed plugins via REST API enumeration and maps them to known vulnerabilities. Over 3000 plugins detectable without brute-force, thousands more with it.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"CAT","cat":"reconnaissance","sub":"Vulnerability Scanning","url":"https://www.kali.org/tools/cisco-auditing-tool/#cat","cats":["reconnaissance","credential-access"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"cisco-auditing-tool","version":"1.0-1kali6","arch":"all","homepage":"http://www.scrypt.net/","repo":"https://gitlab.com/kalilinux/packages/cisco-auditing-tool","summary":"Scans Cisco routers for vulnerabilities","desc":"Perl script which scans cisco routers for common vulnerabilities.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"gvm-start","cat":"reconnaissance","sub":"Vulnerability Scanning","url":"https://www.kali.org/tools/gvm/#gvm-start","cats":["reconnaissance","services-and-other-tools"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"gvm","version":"25.04.3","arch":"all","homepage":"https://www.greenbone.net/","repo":"https://salsa.debian.org/pkg-security-team/gvm","summary":"Remote network security auditor - metapackage and useful scripts","desc":"The Greenbone Vulnerability Manager is a modular security auditing tool, used for testing remote systems for vulnerabilities that should be fixed. This package installs all the required packages. It provides scripts to setup, start and stop the GVM services. The tool was previously named OpenVAS.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"heartleech","cat":"reconnaissance","sub":"Vulnerability Scanning","url":"https://www.kali.org/tools/heartleech/#heartleech-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"heartleech","version":"0~git20140607.3ab1d60-0kali4","arch":"any","homepage":"https://github.com/robertdavidgraham/heartleech","repo":"https://gitlab.com/kalilinux/packages/heartleech","summary":"Scanner detecting systems vulnerable to the heartbleed OpenSSL bug","desc":"This is a typical \"heartbleed\" tool. It can scan for systems vulnerable to the bug, and then be used to download them. Some important features: processing using many threads","features":["conclusive/inconclusive verdicts as to whether the target is vulnerable","bulk/fast download of heartbleed data into a large files for offline","automatic retrieval of private keys with no additional steps","some limited IDS evasion","STARTTLS support","IPv6 support","Tor/Socks5n proxy support","extensive connection diagnostic information"]},{"name":"owasp-mantra-ff","cat":"reconnaissance","sub":"Vulnerability Scanning","url":"https://www.kali.org/tools/owasp-mantra-ff/#owasp-mantra-ff-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"owasp-mantra-ff","version":"0.9-1kali5","arch":"amd64 i386","homepage":"https://www.owasp.org/index.php/OWASP_Mantra_-_Security_Framework","repo":"https://gitlab.com/kalilinux/packages/owasp-mantra-ff","summary":"Web application security testing framework built on top of Firefox","desc":"Mantra is a browser especially designed for web application security testing. By having such a product, more people will come to know the easiness and flexibility of being able to follow basic testing procedures within the browser. Mantra believes that having such a portable, easy to use and yet powerful platform can be helpful for the industry. Mantra has many built in tools to modify headers, manipulate input strings, replay GET/POST requests, edit cookies, quickly switch between multiple proxies, control forced redirects etc. This makes it a good software for performing basic security checks and sometimes, exploitation. Thus, Mantra can be used to solve basic levels of various web based CTFs, showcase security issues in vulnerable web applications etc.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"burpsuite","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/burpsuite/#burpsuite-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"burpsuite","version":"2026.8-0kali1","arch":"amd64 arm64","homepage":"https://portswigger.net","repo":"https://gitlab.com/kalilinux/packages/burpsuite","summary":"Platform for security testing of web applications","desc":"Burp Suite is an integrated platform for performing security testing of web applications. Its various tools work seamlessly together to support the entire testing process, from initial mapping and analysis of an application's attack surface, through to finding and exploiting security vulnerabilities. Burp gives you full control, letting you combine advanced manual techniques with state-of-the-art automation, to make your work faster, more effective, and more fun.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"caido","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/caido/#caido-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"caido","version":"0.58.3-0kali1","arch":"amd64 arm64","homepage":"https://github.com/caido/caido","repo":"https://gitlab.com/kalilinux/packages/caido","summary":"Security auditing toolkit (desktop)","desc":"This package contains caido desktop, a security auditing toolkit.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"caido-cli","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/caido-cli/#caido-cli-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"caido-cli","version":"0.58.3-0kali1","arch":"amd64 arm64","homepage":"https://github.com/caido/caido","repo":"https://gitlab.com/kalilinux/packages/caido-cli","summary":"Security auditing toolkit (CLI)","desc":"This package contains caido CLI, a security auditing toolkit.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"crlfuzz","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/crlfuzz/#crlfuzz-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"crlfuzz","version":"1.4.1-0kali1","arch":"any","homepage":"https://github.com/dwisiswant0/crlfuzz","repo":"https://gitlab.com/kalilinux/packages/crlfuzz","summary":"Fast tool to scan CRLF vulnerability written in Go","desc":"CRLFuzz is a tool to scan for CRLF vulnerabilities in a fast way using Go","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"davtest","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/davtest/#davtest-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"davtest","version":"1.2+git20230307.34d31db-0kali1","arch":"all","homepage":"https://github.com/cldrn/davtest","repo":"https://gitlab.com/kalilinux/packages/davtest","summary":"Testing tool for WebDAV servers","desc":"DAVTest tests WebDAV enabled servers by uploading test executable files, and then (optionally) uploading files which allow for command execution or other actions directly on the target. It is meant for penetration testers to quickly and easily determine if enabled DAV services are exploitable.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"joomscan","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/joomscan/#joomscan-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"joomscan","version":"0.0.7-0kali2","arch":"all","homepage":"https://www.owasp.org/index.php/Category:OWASP_Joomla_Vulnerability_Scanner_Project","repo":"https://gitlab.com/kalilinux/packages/joomscan","summary":"OWASP Joomla Vulnerability Scanner Project","desc":"This package contains JoomScan, short for [Joom]la Vulnerability [Scan]ner. It's a project in perl programming language to detect Joomla CMS vulnerabilities and analysis them.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"nikto","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/nikto/#nikto-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"فحص المسارات والرؤوس الحساسة في Captive Portal Auditor","slug":"nikto","version":"1:2.6.1-0kali1","arch":"all","homepage":"https://github.com/sullo/nikto","repo":"https://gitlab.com/kalilinux/packages/nikto","summary":"Web server security scanner","desc":"Nikto is a pluggable web server and CGI scanner written in Perl, using rfp's LibWhisker to perform fast security or informational checks. Features:","features":["Easily updatable CSV-format checks database","Output reports in plain text or HTML","Available HTTP versions automatic switching","Generic as well as specific server software checks","SSL support (through libnet-ssleay-perl)","Proxy support (with authentication)","Cookies support"]},{"name":"nuclei","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/nuclei/#nuclei-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"nuclei","version":"3.11.1-0kali1","arch":"any","homepage":"https://github.com/projectdiscovery/nuclei","repo":"https://gitlab.com/kalilinux/packages/nuclei","summary":"Fast and customizable vulnerability scanner based on simple YAML based DSL","desc":"This package contains a fast tool for configurable targeted scanning based on templates offering massive extensibility and ease of use. Nuclei is used to send requests across targets based on a template leading to zero false positives and providing fast scanning on large number of hosts. Nuclei offers scanning for a variety of protocols including TCP, DNS, HTTP, File, etc. With powerful and flexible templating, all kinds of security checks can be modelled with Nuclei.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"paros","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/paros/#paros-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"paros","version":"3.2.13-1kali6","arch":"all","homepage":"http://www.parosproxy.org/index.shtml","repo":"https://gitlab.com/kalilinux/packages/paros","summary":"Web application proxy","desc":"Lightweight web application testing proxy","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"skipfish","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/skipfish/#skipfish-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"skipfish","version":"2.10b-2kali8","arch":"any","homepage":"","repo":"https://gitlab.com/kalilinux/packages/skipfish","summary":"Fully automated, active web application security reconnaissance tool","desc":"Skipfish is an active web application security reconnaissance tool. It prepares an interactive sitemap for the targeted site by carrying out a recursive crawl and dictionary-based probes. The resulting map is then annotated with the output from a number of active (but hopefully non-disruptive) security checks. The final report generated by the tool is meant to serve as a foundation for professional web application security assessments.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"sstimap","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/sstimap/#sstimap-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"sstimap","version":"1.4-0kali1","arch":"all","homepage":"https://github.com/vladko312/SSTImap","repo":"https://gitlab.com/kalilinux/packages/sstimap","summary":"Automatic SSTI detection tool with interactive interface","desc":"SSTImap is a penetration testing software that can check websites for Code Injection and Server-Side Template Injection vulnerabilities and exploit them, giving access to the operating system itself.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"subjack","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/subjack/#subjack-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"subjack","version":"2.1-0kali2","arch":"any","homepage":"https://github.com/haccer/subjack","repo":"https://gitlab.com/kalilinux/packages/subjack","summary":"Subdomain Takeover tool","desc":"This package contains a Subdomain Takeover tool written in Go designed to scan a list of subdomains concurrently and identify ones that are able to be hijacked. With Go's speed and efficiency, this tool really stands out when it comes to mass-testing. Always double check the results manually to rule out false positives. Subjack will also check for subdomains attached to domains that don't exist (NXDOMAIN) and are available to be registered.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"tinja","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/tinja/#tinja-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"tinja","version":"1.2.0-0kali1","arch":"any","homepage":"https://github.com/Hackmanit/TInjA","repo":"https://gitlab.com/kalilinux/packages/tinja","summary":"CLI tool for testing web pages for template injection","desc":"TInjA is a CLI tool for testing web pages for template injection vulnerabilities and supports 44 of the most relevant template engines for eight different programming languages.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"wapiti","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/wapiti/#wapiti-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"wapiti","version":"3.2.10+dfsg-4","arch":"all","homepage":"https://wapiti.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/wapiti","summary":"Web application vulnerability scanner","desc":"Wapiti allows you to audit the security of your web applications. It performs \"black-box\" scans, i.e. it does not study the source code of the application but will scan the web pages of the deployed web applications, looking for scripts and forms where it can inject data. Once it gets this list, Wapiti acts like a fuzzer, injecting payloads to see if a script is vulnerable. Wapiti can detect the following vulnerabilities: readfile...)","features":["Database Injection (PHP/ASP/JSP SQL Injections and XPath Injections)","Cross Site Scripting (XSS) reflected and permanent","File disclosure detection (local and remote include, require, fopen,","Command Execution detection (eval(), system(), passtru()...)","XXE (Xml eXternal Entity) injection","CRLF Injection","Search for potentially dangerous files on the server (thank to the Nikto db)","Bypass of weak htaccess configurations","Search for copies (backup) of scripts on the server","Shellshock"]},{"name":"watobo","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/watobo/#watobo-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"watobo","version":"1.0.1-0kali2","arch":"any","homepage":"https://sourceforge.net/projects/watobo/","repo":"https://gitlab.com/kalilinux/packages/watobo","summary":"Semi-automated web application scanner","desc":"WATOBO is intended to enable security professionals to perform highly efficient (semi-automated) web application security audits. It works like a local web proxy.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"wcvs","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/web-cache-vulnerability-scanner/#wcvs","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"web-cache-vulnerability-scanner","version":"2.0.0-0kali1","arch":"amd64 arm64","homepage":"https://github.com/Hackmanit/Web-Cache-Vulnerability-Scanner","repo":"https://gitlab.com/kalilinux/packages/web-cache-vulnerability-scanner","summary":"Go-based CLI tool for testing for web cache poisoning","desc":"Web Cache Vulnerability Scanner (WCVS) is a fast and versatile CLI scanner for web cache poisoning and web cache deception developed by Hackmanit and Maximilian Hildebrand. The scanner supports many different web cache poisoning and web cache deception techniques, includes a crawler to identify further URLs to test, and can adapt to a specific web cache for more efficient testing. It is highly customizable and can be easily integrated into existing CI/CD pipelines.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"webscarab","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/webscarab/#webscarab-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"webscarab","version":"20200519-d22bd60-0kali2","arch":"all","homepage":"https://github.com/OWASP/OWASP-WebScarab","repo":"https://gitlab.com/kalilinux/packages/webscarab","summary":"Web application review tool","desc":"WebScarab is designed to be a tool for anyone who needs to expose the workings of an HTTP(S) based application, whether to allow the developer to debug otherwise difficult problems, or to allow a security specialist to identify vulnerabilities in the way that the application has been designed or implemented.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"whatweb","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/whatweb/#whatweb-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"بصمة الخادم وWAF في Captive Portal Auditor","slug":"whatweb","version":"0.6.4-1","arch":"all","homepage":"https://github.com/urbanadventurer/WhatWeb","repo":"","summary":"Next generation web scanner","desc":"WhatWeb identifies websites. It recognises web technologies including content management systems (CMS), blogging platforms, statistic/analytics packages, JavaScript libraries, web servers, and embedded devices. WhatWeb has over 900 plugins, each to recognise something different. It also identifies version numbers, email addresses, account IDs, web framework modules, SQL errors, and more.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"wpscan","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/wpscan/#wpscan-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"wpscan","version":"4.1.0-0kali1","arch":"all","homepage":"https://wpscan.com/wordpress-security-scanner","repo":"https://gitlab.com/kalilinux/packages/wpscan","summary":"Black box WordPress vulnerability scanner","desc":"WPScan scans remote WordPress installations to find security issues.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"zaproxy","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/zaproxy/#zaproxy-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"zaproxy","version":"2.17.0-0kali1","arch":"all","homepage":"https://github.com/zaproxy/zaproxy","repo":"https://gitlab.com/kalilinux/packages/zaproxy","summary":"Testing tool for finding vulnerabilities in web applications","desc":"The OWASP Zed Attack Proxy (ZAP) is an easy to use integrated penetration testing tool for finding vulnerabilities in web applications. It is designed to be used by people with a wide range of security experience and as such is ideal for developers and functional testers who are new to penetration testing as well as being a useful addition to an experienced pen testers toolbox.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"bettercap","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/bettercap/#bettercap-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"bettercap","version":"2.41.5-0kali1","arch":"any","homepage":"https://www.bettercap.org","repo":"https://gitlab.com/kalilinux/packages/bettercap","summary":"Complete, modular, portable and easily extensible MITM framework","desc":"The Swiss Army knife for 802.11, BLE, IPv4 and IPv6 networks reconnaissance and MITM attacks. bettercap is a powerful, easily extensible and portable framework written in Go which aims to offer to security researchers, red teamers and reverse engineers an easy to use, all-in-one solution with all the features they might possibly need for performing reconnaissance and attacking WiFi networks, Bluetooth Low Energy devices, wireless HID devices and Ethernet networks. Main Features: association attack and automatic WPA/WPA2 client handshakes capture. reading and writing. over-the-air HID frames injection (with DuckyScript support). based networks. fully scriptable with easy to implement javascript plugins. used as a network protocol fuzzer. on websocket to orchestrate your attacks easily. This package contains a Swiss Army knife for 802.11, BLE and Ethernet networks reconnaissance and attacks.","features":["WiFi networks scanning, deauthentication attack, clientless PMKID","Bluetooth Low Energy devices scanning, characteristics enumeration,","2.4Ghz wireless devices scanning and MouseJacking attacks with","Passive and active IP network hosts probing and recon.","ARP, DNS, NDP and DHCPv6 spoofers for MITM attacks on IPv4 and IPv6","Proxies at packet level, TCP level and HTTP/HTTPS application level","A powerful network sniffer for credentials harvesting which can also be","A very fast port scanner.","A powerful REST API with support for asynchronous events notification","A very convenient web UI."]},{"name":"bluelog","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/bluelog/#bluelog-1","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"bluelog","version":"1.1.2-1kali3","arch":"any","homepage":"http://www.digifail.com/software/bluelog.shtml","repo":"https://gitlab.com/kalilinux/packages/bluelog","summary":"Bluetooth scanner and logger","desc":"Bluelog is a Bluetooth scanner designed to tell you how many discoverable devices there are in an area as quickly as possible. It is intended to be used as a site survey tool, identifying the number of possible Bluetooth targets there are in the surrounding environment.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"bluesnarfer","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/bluesnarfer/#bluesnarfer-1","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"bluesnarfer","version":"0.1-1kali4","arch":"any","homepage":"http://www.alighieri.org/","repo":"https://gitlab.com/kalilinux/packages/bluesnarfer","summary":"Bluesnarfing utility","desc":"A bluetooth bluesnarfing utility","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"btscanner","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/btscanner/#btscanner-1","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"btscanner","version":"2.1-10","arch":"any","homepage":"https://salsa.debian.org/pkg-security-team/btscanner","repo":"https://salsa.debian.org/pkg-security-team/btscanner","summary":"Ncurses-based scanner for Bluetooth devices","desc":"btscanner is a tool designed specifically to extract as much information as possible from a Bluetooth device without the requirement to pair. A detailed information screen extracts HCI and SDP information, and maintains an open connection to monitor the RSSI and link quality. btscanner is based on the BlueZ Bluetooth stack, which is included with recent Linux kernels, and the BlueZ toolset. btscanner also contains a complete listing of the IEEE OUI numbers and class lookup tables. Using the information gathered from these sources it is possible to make educated guesses as to the host device type.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"blueranger","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/blueranger/#blueranger-1","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"blueranger","version":"0.1-1kali7","arch":"any","homepage":"http://www.hackfromacave.com/projects/blueranger.html","repo":"https://gitlab.com/kalilinux/packages/blueranger","summary":"Simple Bash script to locate Bluetooth devices","desc":"BlueRanger is a simple Bash script which uses Link Quality to locate Bluetooth device radios. It sends l2cap (Bluetooth) pings to create a connection between Bluetooth interfaces, since most devices allow pings without any authentication or authorization. The higher the link quality, the closer the device (in theory). Use a Bluetooth Class 1 adapter for long range location detection. Switch to a Class 3 adapter for more precise short range locating. The precision and accuracy depend on the build quality of the Bluetooth adapter, interference, and response from the remote device. Fluctuations may occur even when neither device is in motion.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"fang","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/redfang/#fang","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"redfang","version":"2.5-1kali5","arch":"any","homepage":"","repo":"https://gitlab.com/kalilinux/packages/redfang","summary":"Locates non-discoverable bluetooth devices","desc":"fang is a small proof-of-concept application to find non discoveredable bluetooth devices. This is done by brute forcing the last six (6) bytes of the bluetooth address of the device and doing a read_remote_name().","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"spooftooph","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/spooftooph/#spooftooph-1","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"spooftooph","version":"0.5.2-1kali4","arch":"any","homepage":"http://www.hackfromacave.com/projects/spooftooph.html","repo":"https://gitlab.com/kalilinux/packages/spooftooph","summary":"Automates spoofing or cloning Bluetooth devices","desc":"Spooftooph is designed to automate spoofing or cloning Bluetooth device Name, Class, and Address. Cloning this information effectively allows Bluetooth device to hide in plain site. Bluetooth scanning software will only list one of the devices if more than one device in range shares the same device information when the devices are in Discoverable Mode (specificaly the same Address).","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"ubertooth-util","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/ubertooth/#ubertooth-util","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"ubertooth","version":"2020.12.R1-2","arch":"any all","homepage":"http://ubertooth.sourceforge.net/","repo":"https://salsa.debian.org/debian/ubertooth","summary":"2.4 GHz wireless development platform for Bluetooth experimentation","desc":"Project Ubertooth is an open source wireless development platform suitable for Bluetooth experimentation. This package contains everything necessary to use the hardware dongle. Ubertooth is capable of sniffing BLE (Bluetooth Smart) connections and it also has some ability to sniff some data from Basic Rate (BR) Bluetooth Classic connections. In addition to the Bluetooth specific capabilities, there is also a simple spectrum analyzer for the 2.4 GHz band included (ubertooth-specan-ui) which can be used to also observe other things in this frequency band.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"asleap","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/asleap/#asleap-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"asleap","version":"2.5-1","arch":"any","homepage":"https://www.willhackforsushi.com/","repo":"https://gitlab.com/kalilinux/packages/asleap","summary":"A tool for exploiting Cisco LEAP networks","desc":"Demonstrates a serious deficiency in proprietary Cisco LEAP networks.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"kismet","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/kismet/#kismet-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"استطلاع Wi-Fi وكشف AP المزيّف في Captive Portal Auditor","slug":"kismet","version":"2025.09.R1-0kali3","arch":"any all","homepage":"https://www.kismetwireless.net/","repo":"https://gitlab.com/kalilinux/packages/kismet","summary":"Wireless network and device detector (metapackage)","desc":"Kismet is a wireless network and device detector, sniffer, wardriving tool, and WIDS (wireless intrusion detection) framework. Kismet works with Wi-Fi interfaces, Bluetooth interfaces, some SDR (software defined radio) hardware like the RTLSDR, and other specialized capture hardware. This is a metapackage containing the kismet tools.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"sparrow-wifi","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/sparrow-wifi/#sparrow-wifi-1","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"استطلاع Wi-Fi في Captive Portal Auditor","slug":"sparrow-wifi","version":"2.0-0kali1","arch":"all","homepage":"https://github.com/ghostop14/sparrow-wifi","repo":"https://gitlab.com/kalilinux/packages/sparrow-wifi","summary":"Graphical Wi-Fi Analyzer for Linux","desc":"This package contains a graphical Wi-Fi analyzer for Linux. It provides a more comprehensive GUI-based replacement for tools like inSSIDer and linssid that runs specifically on Linux. In its most comprehensive use cases, sparrow-wifi integrates Wi-Fi, software-defined radio (hackrf), advanced bluetooth tools (traditional and Ubertooth), traditional GPS (via gpsd), and drone/rover GPS via mavlink in one solution.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"wash","cat":"reconnaissance","sub":"Web Vulnerability Scanning","url":"https://www.kali.org/tools/reaver/#wash","cats":["reconnaissance"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"reaver","version":"1.6.6-2","arch":"any","homepage":"https://github.com/t6x/reaver-wps-fork-t6x","repo":"https://salsa.debian.org/pkg-security-team/reaver","summary":"Brute force attack tool against Wi-Fi Protected Setup PIN number","desc":"Reaver performs a brute force attack against an access point's Wi-Fi Protected Setup pin number. Once the WPS pin is found, the WPA PSK can be recovered and alternately the AP's wireless settings can be reconfigured. This package also provides the Wash executable, an utility for identifying WPS enabled access points. See documentation in /usr/share/doc/reaver/README.WASH.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"hackrf_info","cat":"reconnaissance","sub":"Radio Frequency","url":"https://www.kali.org/tools/hackrf/#hackrf_info","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"hackrf","version":"2026.01.3-1","arch":"any all","homepage":"http://greatscottgadgets.com/hackrf/","repo":"https://salsa.debian.org/bottoms/pkg-hackrf","summary":"Software defined radio peripheral - utilities","desc":"HackRF is an open source Software Defined Radio that can receive and transmit between 30 MHz and 6 GHz. HackRF has a 20 MHz bandwidth. It is a High Speed USB device powered by the USB bus. This package contains a set of command line utilities:","features":["hackrf_clock: HackRF clock configuration utility","hackrf_cpldjtag: program CLPD","hackrf_debug: chip register read/write/config tool","hackrf_info: probe device and show configuration","hackrf_operacake: control of operacake board via hackrf","hackrf_spiflash: read and write flash data from file.","hackrf_sweep: control frequency sweep of hackrf","hackrf_transfer: file based transmit and receive sdr"]},{"name":"gnuradio","cat":"reconnaissance","sub":"Radio Frequency","url":"https://www.kali.org/tools/gnuradio/#gnuradio","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"gnuradio","version":"3.10.12.0-6","arch":"any all","homepage":"https://www.gnuradio.org/","repo":"https://salsa.debian.org/bottoms/pkg-gnuradio","summary":"GNU Radio Software Radio Toolkit","desc":"GNU Radio provides signal processing blocks to implement software radios. It can be used with readily-available low-cost external RF hardware to create software-defined radios, or without hardware in a simulation-like environment. It is widely used in hobbyist, academic and commercial environments to support both wireless communications research and real-world radio systems. GNU Radio applications are primarily written using the Python programming language, while the supplied performance-critical signal processing path is implemented in C++ using processor floating-point extensions, where available. Thus, the developer is able to implement real-time, high-throughput radio systems in a simple-to-use, rapid-application-development environment. While not primarily a simulation tool, GNU Radio does support development of signal processing algorithms using pre-recorded or generated data, avoiding the need for actual RF hardware. This package contains the gnuradio-companion, a graphical tool for creating signal flow graphs and generating flow-graph source code. Also included are a variety of tools and utility programs.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"gqrx","cat":"reconnaissance","sub":"Radio Frequency","url":"https://www.kali.org/tools/gqrx-sdr/#gqrx","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"gqrx-sdr","version":"2.17.7-1","arch":"any","homepage":"https://gqrx.dk/","repo":"https://salsa.debian.org/bottoms/pkg-gqrx-sdr","summary":"Software defined radio receiver","desc":"Gqrx works with hardware supported by gr-osmosdr, including Funcube Dongle, RTL-SDR, Airspy, HackRF, BladeRF, RFSpace, USRP and SoapySDR. Gqrx can operate as an AM/FM/SSB receiver with audio output or as an FFT-only instrument. The built-in Gqrx AFSK1200 decoder can decode and display AX.25 packets. There are also various hooks for interacting with external applications using network sockets. Wideband FM mode has mono, stereo, and RDS (Radio Data System) modes. Displays FFT plot and spectrum waterfall. It is powered by GNU Radio and the Qt GUI toolkit.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"chirp","cat":"reconnaissance","sub":"Radio Frequency","url":"https://www.kali.org/tools/chirp/#chirp","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"chirp","version":"1:20251108-1","arch":"all","homepage":"https://chirpmyradio.com/","repo":"https://salsa.debian.org/debian-hamradio-team/chirp","summary":"Configuration tool for amateur radios","desc":"CHIRP is a free, open-source tool for programming your amateur radio. It supports a large number of manufacturers and models, as well as provides a way to interface with multiple data sources and formats. CHIRP can handle data in the following formats: Most popular modern amateur radios are supported by CHIRP via their interface cables.","features":["Comma Separated Values (.csv)","Comma Separated Values generated by RT Systems (.csv)","EVE for Yaesu VX-5 (.eve)","Kenwood HMK format (.hmk)","Kenwood commercial ITM format (.itm)","Icom Data Files (.icf)","ARRL TravelPlus (.tpe)","VX5 Commander Files (.vx5)","VX7 Commander Files (.vx7)"]},{"name":"rfcat","cat":"reconnaissance","sub":"Radio Frequency","url":"https://www.kali.org/tools/rfcat/#rfcat-1","cats":["reconnaissance"],"status":"يتطلب عتادًا","equiv":"","slug":"rfcat","version":"1:3.0.0-0kali1","arch":"any","homepage":"https://github.com/atlas0fd00m/rfcat","repo":"https://gitlab.com/kalilinux/packages/rfcat","summary":"Swiss army knife of sub-GHz radio","desc":"Rfcat is a sub GHz analysis tool. The goals of the project are to reduce the time for security researchers to create needed tools for analyzing unknown targets, to aid in reverse-engineering of hardware.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"maltego","cat":"reconnaissance","sub":"Radio Frequency","url":"https://www.kali.org/tools/maltego/#maltego-1","cats":["reconnaissance","services-and-other-tools"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"maltego","version":"4.12.1-0kali1","arch":"all","homepage":"https://www.maltego.com","repo":"https://gitlab.com/kalilinux/packages/maltego","summary":"Open source intelligence and forensics application","desc":"Maltego is an open source intelligence and forensics application. It will offer you timous mining and gathering of information as well as the representation of this information in a easy to understand format. This package replaces previous packages matlegoce and casefile.","features":["جمع معلومات علنية","تعداد النطاقات والخدمات","بصمة سطح الهجوم"]},{"name":"code-oss","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/code-oss/#code-oss-1","cats":["resource-development","services-and-other-tools"],"status":"تطوير","equiv":"","slug":"code-oss","version":"1.101.1+ds+really1.99.3-0kali1","arch":"amd64 arm64","homepage":"https://github.com/microsoft/vscode","repo":"https://gitlab.com/kalilinux/packages/code-oss","summary":"Open Source package of vscode","desc":"This package contains code-oss, a code editor with what developers need for their core edit-build-debug cycle. It provides comprehensive code editing, navigation, and understanding support along with lightweight debugging, a rich extensibility model, and lightweight integration with existing tools. This package is built from Microsoft open source code named code-oss.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"donut","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/donut-shellcode/#donut-1","cats":["resource-development","defense-evasion"],"status":"تطوير","equiv":"","slug":"donut-shellcode","version":"1.1-0kali3","arch":"any all","homepage":"https://github.com/TheWover/donut","repo":"https://gitlab.com/kalilinux/packages/donut-shellcode","summary":"Generates position-independent shellcode from memory and runs them","desc":"Donut is a position-independent code that enables in-memory execution of VBScript, JScript, EXE, DLL files and dotNET assemblies. A module created by Donut can either be staged from a HTTP server or embedded directly in the loader itself. The module is optionally encrypted using the Chaskey block cipher and a 128-bit randomly generated key. After the file is loaded and executed in memory, the original reference is erased to deter memory scanners. The generator and loader support the following features: via RtlCompressBuffer. (WLDP). Hexadecimal.","features":["Compression of input files with aPLib and LZNT1, Xpress, Xpress Huffman","Using entropy for API hashes and generation of strings.","128-bit symmetric encryption of files.","Patching Antimalware Scan Interface (AMSI) and Windows Lockdown Policy","Patching command line for EXE files.","Patching exit-related API to avoid termination of host process.","Multiple output formats: C, Ruby, Python, PowerShell, Base64, C#,"]},{"name":"sickle-pdk","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/sickle-pdk/#sickle-pdk-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"sickle-pdk","version":"4.1.1-0kali2","arch":"all","homepage":"https://github.com/wetw0rk/sickle-pdk","repo":"https://gitlab.com/kalilinux/packages/sickle-pdk","summary":"Payload development kit","desc":"Sickle is a payload development kit originally created to aid in crafting shellcode, however it can be used in crafting payloads for other exploit types as well (non-binary). Although the current modules are mostly aimed towards assembly this tool is not limited to shellcode.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"wixl","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/msitools/#wixl-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"msitools","version":"0.106+repack-3","arch":"any all","homepage":"https://wiki.gnome.org/msitools","repo":"https://salsa.debian.org/debian/msitools","summary":"Windows Installer file manipulation tool","desc":"msitools contains a number of programs to create, inspect and extract Windows Installer (.msi) files. The following tools are included:","features":["msiinfo: inspects MSI packages","msibuild: builds MSI packages","msidiff: compares two MSI packages' contents","msidump: dumps raw MSI tables and stream contents","msiextract: extracts files contained in MSI packages"]},{"name":"wmic","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/wmi/#wmic","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"wmi","version":"1.3.16-0kali12","arch":"any","homepage":"","repo":"https://gitlab.com/kalilinux/packages/wmi","summary":"DCOM/WMI client implementation","desc":"This DCOM/WMI client implementation is based on Samba4 sources. It uses RPC/DCOM mechanisms to interact with WMI services on Windows 2000/XP/2003 machines. This package contains the command line client to perform remote command execution on Windows systems.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"wmis","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/wmi/#wmis","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"wmi","version":"1.3.16-0kali12","arch":"any","homepage":"","repo":"https://gitlab.com/kalilinux/packages/wmi","summary":"DCOM/WMI client implementation","desc":"This DCOM/WMI client implementation is based on Samba4 sources. It uses RPC/DCOM mechanisms to interact with WMI services on Windows 2000/XP/2003 machines. This package contains the command line client to perform remote command execution on Windows systems.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"pyinstaller","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/pyinstaller/#pyinstaller-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"pyinstaller","version":"6.22.2+ds-2","arch":"any all","homepage":"https://pyinstaller.org/en/stable/","repo":"https://salsa.debian.org/python-team/packages/pyinstaller","summary":"Utility to bundle a Python application into a single package","desc":"PyInstaller reads a Python script written by you. It analyzes your code to discover every other module and library your script needs in order to execute. Then it collects copies of all those files and puts them with your script in a single folder, or optionally in a single executable file. This package contains the executables. It depends on 'python3-pyinstaller', which contains the Python modules.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"olevba","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/oletools/#olevba","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"oletools","version":"0.60.2-0kali1","arch":"all","homepage":"https://github.com/decalage2/oletools","repo":"https://gitlab.com/kalilinux/packages/oletools","summary":"Analyze MS OLE2 files and MS Office documents","desc":"Tools to analyze Microsoft OLE2 files (also called Structured Storage, Compound File Binary Format or Compound Document File Format), such as Microsoft Office 97-2003 documents, MSI files or Outlook messages, mainly for malware analysis, forensics and debugging. It is based on the olefile parser.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"olefile","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/oletools/#olefile","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"oletools","version":"0.60.2-0kali1","arch":"all","homepage":"https://github.com/decalage2/oletools","repo":"https://gitlab.com/kalilinux/packages/oletools","summary":"Analyze MS OLE2 files and MS Office documents","desc":"Tools to analyze Microsoft OLE2 files (also called Structured Storage, Compound File Binary Format or Compound Document File Format), such as Microsoft Office 97-2003 documents, MSI files or Outlook messages, mainly for malware analysis, forensics and debugging. It is based on the olefile parser.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"afl-fuzz","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/aflplusplus/#afl-fuzz","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"aflplusplus","version":"5.02c-0.5","arch":"any all","homepage":"https://github.com/AFLplusplus/AFLplusplus","repo":"https://salsa.debian.org/pkg-security-team/aflplusplus","summary":"(unknown subject)","desc":"(unknown subject)","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"bed","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/bed/#bed-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"bed","version":"0.5-1kali8","arch":"any","homepage":"http://www.snake-basket.de","repo":"https://gitlab.com/kalilinux/packages/bed","summary":"A network protocol fuzzer","desc":"BED is a program which is designed to check daemons for potential buffer overflows, format strings et. al.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"generic_chunked","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/spike/#generic_chunked","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"spike","version":"2.9-1kali11","arch":"any","homepage":"http://www.immunitysec.com/resources-freesoftware.shtml","repo":"https://gitlab.com/kalilinux/packages/spike","summary":"Network protocol fuzzer","desc":"When you need to analyze a new network protocol for buffer overflows or similar weaknesses, the SPIKE is the tool of choice for professionals. While it requires a strong knowledge of C to use, it produces results second to none in the field.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"generic_listen_tcp","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/spike/#generic_listen_tcp","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"spike","version":"2.9-1kali11","arch":"any","homepage":"http://www.immunitysec.com/resources-freesoftware.shtml","repo":"https://gitlab.com/kalilinux/packages/spike","summary":"Network protocol fuzzer","desc":"When you need to analyze a new network protocol for buffer overflows or similar weaknesses, the SPIKE is the tool of choice for professionals. While it requires a strong knowledge of C to use, it produces results second to none in the field.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"generic_send_tcp","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/spike/#generic_send_tcp","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"spike","version":"2.9-1kali11","arch":"any","homepage":"http://www.immunitysec.com/resources-freesoftware.shtml","repo":"https://gitlab.com/kalilinux/packages/spike","summary":"Network protocol fuzzer","desc":"When you need to analyze a new network protocol for buffer overflows or similar weaknesses, the SPIKE is the tool of choice for professionals. While it requires a strong knowledge of C to use, it produces results second to none in the field.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"generic_send_udp","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/spike/#generic_send_udp","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"spike","version":"2.9-1kali11","arch":"any","homepage":"http://www.immunitysec.com/resources-freesoftware.shtml","repo":"https://gitlab.com/kalilinux/packages/spike","summary":"Network protocol fuzzer","desc":"When you need to analyze a new network protocol for buffer overflows or similar weaknesses, the SPIKE is the tool of choice for professionals. While it requires a strong knowledge of C to use, it produces results second to none in the field.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"sfuzz","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/sfuzz/#sfuzz-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"sfuzz","version":"0.7.0-1kali4","arch":"any","homepage":"http://aconole.brad-x.com/programs/sfuzz.html","repo":"https://gitlab.com/kalilinux/packages/sfuzz","summary":"Black Box testing utilities","desc":"In the same vein as the Generic Protocol Framework, sfuzz is a really simple to use black box testing suite called Simple Fuzzer (what else would you expect?). The goal is to provide a simple to use, but fairly powerful and flexible black box testing utility.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"msf-nasm_shell","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/metasploit-framework/#msf-nasm_shell","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"metasploit-framework","version":"6.5.3-0kali1","arch":"any","homepage":"https://www.metasploit.com/","repo":"https://gitlab.com/kalilinux/packages/metasploit-framework","summary":"Framework for exploit development and vulnerability research","desc":"The Metasploit Framework is an open source platform that supports vulnerability research, exploit development, and the creation of custom security tools.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"msfvenom","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/metasploit-framework/#msfvenom","cats":["resource-development","defense-evasion"],"status":"تطوير","equiv":"","slug":"metasploit-framework","version":"6.5.3-0kali1","arch":"any","homepage":"https://www.metasploit.com/","repo":"https://gitlab.com/kalilinux/packages/metasploit-framework","summary":"Framework for exploit development and vulnerability research","desc":"The Metasploit Framework is an open source platform that supports vulnerability research, exploit development, and the creation of custom security tools.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"msfpc","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/msfpc/#msfpc-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"msfpc","version":"1.4.5-0kali3","arch":"any","homepage":"https://github.com/g0tmi1k/msfpc","repo":"https://gitlab.com/kalilinux/packages/msfpc","summary":"MSFvenom Payload Creator (MSFPC)","desc":"A quick way to generate various \"basic\" Meterpreter payloads using msfvenom which is part of the Metasploit framework.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"shellnoob","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/shellnoob/#shellnoob-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"shellnoob","version":"2.1+git20170425-0kali5","arch":"amd64 armel armhf i386","homepage":"https://github.com/reyammer/shellnoob","repo":"https://gitlab.com/kalilinux/packages/shellnoob","summary":"Shellcode writing toolkit","desc":"Features: currently supported: asm, bin, hex, obj, exe, C, Python, ruby, pretty, safeasm, completec, shellstorm. (All details in the \"Formats description\" section.) useful when you cannot use specific bytes in the shellcode and you want to figure out if a specific assembly instruction will cause problems. the --64 switch. Python) And it just one self-contained Python script! architecture FreeBSD/x86_64. as a library\" section. debug / understand / learn vm-patch, --fork-nopper options","features":["convert shellcode between different formats and sources. Formats","interactive asm-to-opcode conversion (and viceversa) mode. This is","support for both ATT & Intel syntax. Check the --intel switch.","support for 32 and 64 bits (when playing on x86_64 machine). Check","resolve syscall numbers, constants, and error numbers","portable and easily deployable (it only relies on gcc/as/objdump and","in-place development: you run ShellNoob directly on the target","built-in support for Linux/x86, Linux/x86_64, Linux/ARM, FreeBSD/x86,","\"*prepend breakpoint*\" option. Check the -c switch.","read from stdin / write to stdout support (use \"-\" as filename)"]},{"name":"clang","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/llvm-defaults/#clang-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"llvm-defaults","version":"0.71","arch":"amd64 arm64 armel armhf hurd-amd64 hurd-i386 i386 loong64 m68k mips64el mipsel powerpc ppc64 ppc64el riscv64 s390x sparc sparc64 x32","homepage":"","repo":"https://salsa.debian.org/pkg-llvm-team/llvm-defaults/","summary":"C, C++ and Objective-C compiler (LLVM based), clang binary","desc":"Clang project is a C, C++, Objective C and Objective C++ front-end for the LLVM compiler. Its goal is to offer a replacement to the GNU Compiler Collection (GCC). Clang implements all of the ISO C++ 1998, 11, 14 and 17 standards and also provides most of the support of C++20. This is a dependency package providing the default clang compiler.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"clang++","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/llvm-defaults/#clang-2","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"llvm-defaults","version":"0.71","arch":"amd64 arm64 armel armhf hurd-amd64 hurd-i386 i386 loong64 m68k mips64el mipsel powerpc ppc64 ppc64el riscv64 s390x sparc sparc64 x32","homepage":"","repo":"https://salsa.debian.org/pkg-llvm-team/llvm-defaults/","summary":"C, C++ and Objective-C compiler (LLVM based), clang binary","desc":"Clang project is a C, C++, Objective C and Objective C++ front-end for the LLVM compiler. Its goal is to offer a replacement to the GNU Compiler Collection (GCC). Clang implements all of the ISO C++ 1998, 11, 14 and 17 standards and also provides most of the support of C++20. This is a dependency package providing the default clang compiler.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"edb","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/edb-debugger/#edb","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"edb-debugger","version":"1.3.0-2.2","arch":"amd64 i386","homepage":"https://github.com/eteran/edb-debugger","repo":"https://salsa.debian.org/debian/edb-debugger","summary":"Cross platform x86/x86-64 debugger","desc":"edb is a graphical cross platform x86/x86-64 debugger. It was inspired by Ollydbg, but aims to function on x86 and x86-64 as well as multiple OS's. Linux is the only officially supported platform at the moment, but FreeBSD, OpenBSD, OSX and Windows ports are underway with varying degrees of functionality.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"ollydbg","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/ollydbg/#ollydbg-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"ollydbg","version":"1.10-1kali5","arch":"all","homepage":"http://www.ollydbg.de/","repo":"https://gitlab.com/kalilinux/packages/ollydbg","summary":"32-bit assembler level analysing debugger","desc":"OllyDbg is a 32-bit assembler level analysing debugger for Microsoft Windows. Emphasis on binary code analysis makes it particularly useful in cases where source is unavailable.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"gef","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/gef/#gef-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"gef","version":"2026.01-0kali2","arch":"all","homepage":"https://github.com/hugsy/gef","repo":"https://gitlab.com/kalilinux/packages/gef","summary":"Modern experience for GDB with advanced debugging capabilities","desc":"GEF is a set of commands for x86/64, ARM, MIPS, PowerPC and SPARC to assist exploit developers and reverse-engineers when using old school GDB. It provides additional features to GDB using the Python API to assist during the process of dynamic analysis and exploit development. Application developers will also benefit from it, as GEF lifts a great part of regular GDB obscurity, avoiding repeating traditional commands, or bringing out the relevant information from the debugging runtime.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"gdb","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/gdb/#gdb-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"gdb","version":"17.2-1","arch":"any all","homepage":"https://www.gnu.org/s/gdb/","repo":"https://salsa.debian.org/gdb-team/gdb","summary":"GNU Debugger","desc":"GDB is a source-level debugger, capable of breaking programs at any specific line, displaying variable values, and determining where errors occurred. Currently, gdb supports C, C++, D, Objective-C, Fortran, Java, OpenCL C, Pascal, assembly, Modula-2, Go, and Ada. A must-have for any serious programmer.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"cstool","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/capstone/#cstool","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"capstone","version":"5.0.9-1","arch":"any","homepage":"https://www.capstone-engine.org/","repo":"https://salsa.debian.org/pkg-security-team/capstone","summary":"Lightweight multi-architecture disassembly framework - command line tool","desc":"Capstone is a lightweight multi-platform, multi-architecture disassembly framework. This package contains cstool, a command-line tool to disassemble hexadecimal strings.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"ghidra","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/ghidra/#ghidra-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"ghidra","version":"12.1.3+ds-0kali1","arch":"amd64 arm64","homepage":"https://github.com/NationalSecurityAgency/ghidra","repo":"https://gitlab.com/kalilinux/packages/ghidra","summary":"Software Reverse Engineering Framework","desc":"This package contains a software reverse engineering (SRE) framework created and maintained by the National Security Agency Research Directorate. This framework includes a suite of full-featured, high-end software analysis tools that enable users to analyze compiled code on a variety of platforms including Windows, macOS, and Linux. Capabilities include disassembly, assembly, decompilation, graphing, and scripting, along with hundreds of other features. Ghidra supports a wide variety of processor instruction sets and executable formats and can be run in both user-interactive and automated modes. Users may also develop their own Ghidra extension components and/or scripts using Java or Python. In support of NSA's Cybersecurity mission, Ghidra was built to solve scaling and teaming problems on complex SRE efforts, and to provide a customizable and extensible SRE research platform. NSA has applied Ghidra SRE capabilities to a variety of problems that involve analyzing malicious code and generating deep insights for SRE analysts who seek a better understanding of potential vulnerabilities in networks and systems.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"radare2","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/radare2/#radare2-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"radare2","version":"6.0.4+dfsg-1","arch":"any all","homepage":"https://www.radare.org","repo":"https://salsa.debian.org/pkg-security-team/radare2","summary":"Free and advanced command line hexadecimal editor","desc":"The project aims to create a complete, portable, multi-architecture, unix-like toolchain for reverse engineering. It is composed by an hexadecimal editor (radare) with a wrapped IO layer supporting multiple backends for local/remote files, debugger (OS X, BSD, Linux, W32), stream analyzer, assembler/disassembler (rasm) for x86, ARM, PPC, m68k, Java, MSIL, SPARC, code analysis modules and scripting facilities. A bindiffer named radiff, base converter (rax), shellcode development helper (rasc), a binary information extractor supporting PE, mach0, ELF, class, etc. named rabin, and a block-based hash utility called rahash.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"rizin","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/rizin/#rizin-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"rizin","version":"0.9.1-0kali1","arch":"any all","homepage":"https://rizin.re/","repo":"https://gitlab.com/kalilinux/packages/rizin","summary":"Reverse engineering framework and command-line toolset","desc":"Rizin is a fork of the radare2 reverse engineering framework with a focus on usability, working features and code cleanliness. Rizin is portable and it can be used to analyze binaries, disassemble code, debug programs, as a forensics tool, as a scriptable command-line hexadecimal editor able to open disk files, and much more!","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"cutter","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/rizin-cutter/#cutter","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"rizin-cutter","version":"2.5.0-0kali1","arch":"any","homepage":"https://cutter.re","repo":"https://gitlab.com/kalilinux/packages/rizin-cutter","summary":"Reverse engineering platform powered by rizin","desc":"Cutter is a free and open-source reverse engineering platform powered by rizin. It aims at being an advanced and customizable reverse engineering platform while keeping the user experience in mind. Cutter is created by reverse engineers for reverse engineers.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"apktool","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/apktool/#apktool-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"apktool","version":"2.7.0+dfsg-7.2","arch":"any","homepage":"https://ibotpeaches.github.io/Apktool/","repo":"https://salsa.debian.org/android-tools-team/apktool","summary":"Tool for reverse engineering Android apk files","desc":"A tool for reverse engineering 3rd party, closed, binary Android apps. It can decode resources to nearly original form and rebuild them after making some modifications; it makes possible to debug smali code step by step. Also it makes working with an app easier because of project-like file structure and automation of some repetitive tasks like building apk.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"bytecode-viewer","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/bytecode-viewer/#bytecode-viewer-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"bytecode-viewer","version":"2.13.2-0kali1","arch":"all","homepage":"https://github.com/Konloch/bytecode-viewer","repo":"https://gitlab.com/kalilinux/packages/bytecode-viewer","summary":"Java 8+ Jar & Android APK Reverse Engineering Suite","desc":"This package contains Bytecode Viewer (BCV). It is an Advanced Lightweight Java Bytecode Viewer, GUI Java Decompiler, GUI Bytecode Editor, GUI Smali, GUI Baksmali, GUI APK Editor, GUI Dex Editor, GUI APK Decompiler, GUI DEX Decompiler, GUI Procyon Java Decompiler, GUI Krakatau, GUI CFR Java Decompiler, GUI FernFlower Java Decompiler, GUI DEX2Jar, GUI Jar2DEX, GUI Jar-Jar, Hex Viewer, Code Searcher, Debugger and more. There is also a plugin system that will allow you to interact with the loaded classfiles, for example you can write a String deobfuscator, a malicious code searcher, or something else you can think of. You can either use one of the pre-written plugins, or write your own. It supports groovy scripting. Once a plugin is activated, it will execute the plugin with a ClassNode ArrayList of every single class loaded in BCV, this allows the user to handle it completely using ASM. It's currently being maintained and developed by Konloch.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"jadx-gui","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/jadx/#jadx-gui","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"jadx","version":"1.5.6-0kali1","arch":"all","homepage":"https://github.com/skylot/jadx","repo":"https://gitlab.com/kalilinux/packages/jadx","summary":"Dex to Java decompiler","desc":"This package contains a Dex to Java decompiler. It contains a command line and GUI tools for produce Java source code from Android Dex and Apk files. Main features: jadx-gui features:","features":["decompile Dalvik bytecode to java classes from APK, dex, aar and zip files","decode AndroidManifest.xml and other resources from resources.arsc","deobfuscator included","view decompiled code with highlighted syntax","jump to declaration","find usage","full text search"]},{"name":"javasnoop","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/javasnoop/#javasnoop-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"javasnoop","version":"1.1-rc2-1kali4","arch":"all","homepage":"","repo":"https://gitlab.com/kalilinux/packages/javasnoop","summary":"Intercept Java applications locally","desc":"Normally, without access to the original source code, testing the security of a Java client is unpredictable at best and unrealistic at worst. With access the original source, you can run a simple Java program and attach a debugger to it remotely, stepping through code and changing variables where needed. Doing the same with an applet is a little bit more difficult. JavaSnoop attempts to solve this problem by allowing you attach to an existing process (like a debugger) and instantly begin tampering with method calls, run custom code, or just watch what's happening on the system.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"jd-gui","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/jd-gui/#jd-gui-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"jd-gui","version":"1.6.6-0kali1","arch":"all","homepage":"http://jd.benow.ca/","repo":"https://gitlab.com/kalilinux/packages/jd-gui","summary":"GUI Java .class decompiler","desc":"JD-GUI is a standalone graphical utility that displays Java source codes of \".class\" files. You can browse the reconstructed source code with the JD-GUI for instant access to methods and fields.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"d2j-dex2jar","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/dex2jar/#d2j-dex2jar","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"dex2jar","version":"2.1~nightly-28-0kali2","arch":"all","homepage":"https://github.com/pxb1988/dex2jar/tree/2.x","repo":"https://gitlab.com/kalilinux/packages/dex2jar","summary":"Tools to work with android .dex and java .class files","desc":"dex2jar contains 4 compments: dex-reader is designed to read the Dalvik Executable (.dex/.odex) format. It has a light weight API similar with ASM. An example here dex-translator is designed to do the convert job. It reads the dex instruction to dex-ir format, after some optimize, convert to ASM format. dex-ir used by dex-translator, is designed to represent the dex instruction dex-tools tools to work with .class files.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"pompem","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/pompem/#pompem-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"pompem","version":"0.2.0-8","arch":"all","homepage":"https://github.com/rfunix/Pompem","repo":"https://salsa.debian.org/pkg-security-team/pompem","summary":"Exploit and Vulnerability Finder","desc":"Find exploit with a system of advanced search, designed to automate the search for Exploits and Vulnerability in the most important databases facilitating the work of pentesters, ethical hackers and forensics expert. Performs searches in databases: PacketStorm security, CXSecurity, ZeroDay, Vulners, National Vulnerability Database, WPScan Vulnerability Database. This tool is essential in the security of networks and systems. The search results can be exported to HTML or text format.","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"searchsploit","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/exploitdb/#searchsploit","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"exploitdb","version":"20260904-0kali1","arch":"all","homepage":"https://www.exploit-db.com","repo":"https://gitlab.com/kalilinux/packages/exploitdb","summary":"Searchable Exploit Database archive","desc":"Searchable archive from The Exploit Database. https://www.exploit-db.com/","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"exploitdb-papers","cat":"resource-development","sub":"General","url":"https://www.kali.org/tools/exploitdb-papers/#exploitdb-papers-1","cats":["resource-development"],"status":"تطوير","equiv":"","slug":"exploitdb-papers","version":"20221122-0kali1","arch":"all","homepage":"https://www.exploit-db.com","repo":"https://gitlab.com/kalilinux/packages/exploitdb-papers","summary":"The Exploit Database's archive of papers & ezines","desc":"Searchable papers & ezines archives from The Exploit Database. https://www.exploit-db.com/papers","features":["تطوير موارد وأدوات","بناء وأتمتة","إدارة التبعيات"]},{"name":"dns-rebind","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/rebind/#dns-rebind","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rebind","version":"0.3.4-1kali10","arch":"any","homepage":"","repo":"https://gitlab.com/kalilinux/packages/rebind","summary":"DNS rebinding tool","desc":"Rebind is a tool that implements the multiple A record DNS rebinding attack. Although this tool was originally written to target home routers, it can be used to target any public (non RFC1918) IP address. Rebind provides an external attacker access to a target router's internal Web interface. This tool works on routers that implement the weak end system model in their IP stack, have specifically configured firewall rules, and who bind their Web service to the router's WAN interface. Note that remote administration does not need to be enabled for this attack to work. All that is required is that a user inside the target network surf to a Web site that is controlled, or has been compromised, by the attacker.","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"gophish-start","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/gophish/#gophish-start","cats":["initial-access","services-and-other-tools"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"gophish","version":"0.12.1-0kali6","arch":"any","homepage":"https://getgophish.com/","repo":"https://gitlab.com/kalilinux/packages/gophish","summary":"Open-Source Phishing Toolkit","desc":"This package contains an open-source phishing toolkit designed for businesses and penetration testers. It provides the ability to quickly and easily setup and execute phishing engagements and security awareness training.","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"setoolkit","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/set/#setoolkit","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"set","version":"8.1.3+git20260604-0kali1","arch":"all","homepage":"https://www.trustedsec.com/downloads/social-engineer-toolkit/","repo":"https://gitlab.com/kalilinux/packages/set","summary":"Social-Engineer Toolkit","desc":"The Social-Engineer Toolkit (SET) is an open-source Python-driven tool aimed at penetration testing around Social-Engineering.","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"metasploit-framework","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/metasploit-framework/#metasploit-framework","cats":["initial-access","execution","privilege-escalation","command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"metasploit-framework","version":"6.5.3-0kali1","arch":"any","homepage":"https://www.metasploit.com/","repo":"https://gitlab.com/kalilinux/packages/metasploit-framework","summary":"Framework for exploit development and vulnerability research","desc":"The Metasploit Framework is an open source platform that supports vulnerability research, exploit development, and the creation of custom security tools.","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"sqlmap","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/sqlmap/#sqlmap-1","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sqlmap","version":"1.10.9-1","arch":"all","homepage":"https://sqlmap.org/","repo":"https://salsa.debian.org/pkg-security-team/sqlmap","summary":"Automatic SQL injection tool","desc":"sqlmap goal is to detect and take advantage of SQL injection vulnerabilities in web applications. Once it detects one or more SQL injections on the target host, the user can choose among a variety of options to perform an extensive back-end database management system fingerprint, retrieve DBMS session user and database, enumerate users, password hashes, privileges, databases, dump entire or user's specific DBMS tables/columns, run his own SQL statement, read specific files on the file system and more.","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"sqlninja","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/sqlninja/#sqlninja-1","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sqlninja","version":"0.2.6-r1-1kali3","arch":"all","homepage":"https://sqlninja.sourceforge.net/","repo":"https://gitlab.com/kalilinux/packages/sqlninja","summary":"SQL server injection and takeover tool","desc":"Fancy going from a SQL Injection on Microsoft SQL Server to a full GUI access on the DB? Take a few new SQL Injection tricks, add a couple of remote shots in the registry to disable Data Execution Prevention, mix with a little Perl that automatically generates a debug script, put all this in a shaker with a Metasploit wrapper, shake well and you have just one of the attack modules of sqlninja!","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"sqlsus","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/sqlsus/#sqlsus-1","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sqlsus","version":"0.7.2-1kali3","arch":"all","homepage":"https://sqlsus.sourceforge.net/","repo":"https://gitlab.com/kalilinux/packages/sqlsus","summary":"MySQL injection tool","desc":"sqlsus is an open source MySQL injection and takeover tool, written in perl. Via a command line interface, you can retrieve the database(s) structure, inject your own SQL queries (even complex ones), download files from the web server, crawl the website for writable directories, upload and control a backdoor, clone the database(s), and much more... Whenever relevant, sqlsus will mimic a MySQL console output.","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"jsql","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/jsql/#jsql","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"jsql","version":"0.115-0kali1","arch":"all","homepage":"https://github.com/ron190/jsql-injection","repo":"https://gitlab.com/kalilinux/packages/jsql","summary":"Java tool for automatic database injection","desc":"jSQL Injection is a lightweight application used to find database information from a distant server. jSQL is free, open source and cross-platform (Windows, Linux, Mac OS X, Solaris).","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"commix","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/commix/#commix-1","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"commix","version":"4.1-0kali1","arch":"all","homepage":"https://commixproject.com","repo":"https://gitlab.com/kalilinux/packages/commix","summary":"Automated All-in-One OS Command Injection and Exploitation Tool","desc":"This package contains Commix (short for [comm]and [i]njection e[x]ploiter). It has a simple environment and it can be used, from web developers, penetration testers or even security researchers to test web applications with the view to find bugs, errors or vulnerabilities related to command injection attacks. By using this tool, it is very easy to find and exploit a command injection vulnerability in a certain vulnerable parameter or string. Commix is written in Python programming language.","features":["تقييم سطح الدخول","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"jboss-linux","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/jboss-autopwn/#jboss-linux","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"jboss-autopwn","version":"0.1-1kali2","arch":"all","homepage":"https://github.com/SpiderLabs/jboss-autopwn","repo":"https://gitlab.com/kalilinux/packages/jboss-autopwn","summary":"JBoss script for obtaining remote shell access","desc":"This JBoss script deploys a JSP shell on the target JBoss AS server. Once deployed, the script uses its upload and command execution capability to provide an interactive session. Features include:","features":["Multiplatform support - tested on Windows, Linux and Mac targets","Support for bind and reverse bind shells","Meterpreter shells and VNC support for Windows targets"]},{"name":"jboss-win","cat":"initial-access","sub":"General","url":"https://www.kali.org/tools/jboss-autopwn/#jboss-win","cats":["initial-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"jboss-autopwn","version":"0.1-1kali2","arch":"all","homepage":"https://github.com/SpiderLabs/jboss-autopwn","repo":"https://gitlab.com/kalilinux/packages/jboss-autopwn","summary":"JBoss script for obtaining remote shell access","desc":"This JBoss script deploys a JSP shell on the target JBoss AS server. Once deployed, the script uses its upload and command execution capability to provide an interactive session. Features include:","features":["Multiplatform support - tested on Windows, Linux and Mac targets","Support for bind and reverse bind shells","Meterpreter shells and VNC support for Windows targets"]},{"name":"armitage","cat":"execution","sub":"General","url":"https://www.kali.org/tools/armitage/#armitage-1","cats":["execution","command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"armitage","version":"20221206-0kali1","arch":"all","homepage":"https://github.com/r00t0v3rr1d3/armitage","repo":"https://gitlab.com/kalilinux/packages/armitage","summary":"Cyber attack management for Metasploit","desc":"Armitage is a scriptable red team collaboration tool for Metasploit that visualizes targets, recommends exploits, and exposes the advanced post exploitation features in the framework.","features":["تنفيذ مكوّنات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"evilgrade","cat":"execution","sub":"General","url":"https://www.kali.org/tools/isr-evilgrade/#evilgrade","cats":["execution"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"isr-evilgrade","version":"2.0.9-0kali2","arch":"all","homepage":"https://github.com/infobyte/evilgrade","repo":"https://gitlab.com/kalilinux/packages/isr-evilgrade","summary":"Evilgrade framework","desc":"Evilgrade is a modular framework that allows the user to take advantage of poor upgrade implementations by injecting fake updates. It comes with pre-made binaries (agents), a working default configuration for fast pentests, and has it's own WebServer and DNSServer modules. Easy to set up new settings, and has an autoconfiguration when new binary agents are set.","features":["تنفيذ مكوّنات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"beef-xss-start","cat":"execution","sub":"General","url":"https://www.kali.org/tools/beef-xss/#beef-xss-start","cats":["execution","services-and-other-tools"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"beef-xss","version":"0.6.0.0-0kali6","arch":"any","homepage":"https://beefproject.com/","repo":"https://gitlab.com/kalilinux/packages/beef-xss","summary":"Browser Exploitation Framework (BeEF)","desc":"BeEF is short for The Browser Exploitation Framework. It is a penetration testing tool that focuses on the web browser. Amid growing concerns about web-born attacks against clients, including mobile clients, BeEF allows the professional penetration tester to assess the actual security posture of a target environment by using client-side attack vectors. Unlike other security frameworks, BeEF looks past the hardened network perimeter and client system, and examines exploitability within the context of the one open door: the web browser. BeEF will hook one or more web browsers and use them as beachheads for launching directed command modules and further attacks against the system from within the browser context.","features":["تنفيذ مكوّنات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"xsser","cat":"execution","sub":"General","url":"https://www.kali.org/tools/xsser/#xsser-1","cats":["execution"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"xsser","version":"1.8.4-0kali3","arch":"all","homepage":"https://xsser.03c8.net/","repo":"https://gitlab.com/kalilinux/packages/xsser","summary":"XSS testing framework","desc":"Cross Site \"Scripter\" (aka XSSer) is an automatic framework- to detect, exploit and report XSS vulnerabilities in web-based applications. It contains several options to try to bypass certain filters, and various special techniques of code injection.","features":["تنفيذ مكوّنات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"nishang","cat":"execution","sub":"General","url":"https://www.kali.org/tools/nishang/#nishang-1","cats":["execution"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"nishang","version":"0.7.6+git20210724.414ee11-0kali1","arch":"all","homepage":"https://github.com/samratashok/nishang","repo":"https://gitlab.com/kalilinux/packages/nishang","summary":"Collection of PowerShell scripts and payloads","desc":"Nishang is a framework and collection of scripts and payloads which enables usage of PowerShell for offensive security and post exploitation during Penetration Tests. The scripts are written on the basis of requirement by the author during real Penetration Tests.","features":["تنفيذ مكوّنات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"powersploit","cat":"execution","sub":"General","url":"https://www.kali.org/tools/powersploit/#powersploit-1","cats":["execution"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"powersploit","version":"3.0.0+git20200817.d943001-0kali1","arch":"all","homepage":"https://github.com/PowerShellMafia/PowerSploit","repo":"https://gitlab.com/kalilinux/packages/powersploit","summary":"PowerShell Post-Exploitation Framework","desc":"PowerSploit is a series of Microsoft PowerShell scripts that can be used in post-exploitation scenarios during authorized penetration tests.","features":["تنفيذ مكوّنات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"laudanum","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/laudanum/#laudanum-1","cats":["persistence"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"laudanum","version":"1.0+r36-0kali6","arch":"all","homepage":"https://sourceforge.net/projects/laudanum/","repo":"https://gitlab.com/kalilinux/packages/laudanum","summary":"Collection of injectable web files","desc":"Laudanum is a collection of injectable files, designed to be used in a pentest when SQL injection flaws are found and are in multiple languages for different environments.They provide functionality such as shell, DNS query, LDAP retrieval and others.","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"phpggc","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/phpggc/#phpggc-1","cats":["persistence"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"phpggc","version":"0.20230428-0kali1","arch":"all","homepage":"https://github.com/ambionics/phpggc","repo":"https://gitlab.com/kalilinux/packages/phpggc","summary":"Generate payloads that exploit unsafe object deserialization","desc":"PHPGGC is a library of payloads exploiting unsafe object deserialization. It also provides a command-line tool to generate them.","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"seclists","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/seclists/#seclists-1","cats":["persistence","credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"seclists","version":"2025.3-0kali1","arch":"all","homepage":"https://github.com/danielmiessler/SecLists","repo":"https://gitlab.com/kalilinux/packages/seclists","summary":"Collection of multiple types of security lists","desc":"SecLists is a collection of multiple types of lists used during security assessments. List types include usernames, passwords, URLs, sensitive data grep strings, fuzzing payloads, and many more. The goal is to enable a security tester to pull this repo onto a new testing box and have access to every type of list that may be needed.","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"webacoo","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/webacoo/#webacoo-1","cats":["persistence"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"webacoo","version":"0.2.3-1kali3","arch":"all","homepage":"https://github.com/anestisb/WeBaCoo","repo":"https://gitlab.com/kalilinux/packages/webacoo","summary":"Web backdoor cookie script kit","desc":"Scripts for creating Web backdoors using cookies, with module support","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"webshells","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/webshells/#webshells-1","cats":["persistence"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"webshells","version":"1.1+kali8","arch":"all","homepage":"https://www.kali.org","repo":"https://gitlab.com/kalilinux/packages/webshells","summary":"Collection of webshells","desc":"A collection of webshells for ASP, ASPX, CFM, JSP, Perl, and PHP servers.","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"weevely","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/weevely/#weevely-1","cats":["persistence"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"weevely","version":"4.0.2-1","arch":"all","homepage":"https://github.com/epinna/weevely3/","repo":"https://salsa.debian.org/pkg-security-team/weevely","summary":"Stealth tiny web shell","desc":"Weevely is a stealth PHP web shell that simulate telnet-like connection. It is an essential tool for web application post exploitation, and can be used as stealth backdoor or as a web shell to manage legit web accounts, even free hosted ones.","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"backdoor-factory","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/backdoor-factory/#backdoor-factory-1","cats":["persistence"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"backdoor-factory","version":"3.4.2+dfsg-5","arch":"all","homepage":"https://github.com/secretsquirrel/the-backdoor-factory","repo":"https://salsa.debian.org/pkg-security-team/backdoor-factory","summary":"Injects shellcode into win32/64 PE files, 32/64bits ELF binaries, to continue normal file execution (if the shellcode supports it), by patching the exe/dll dire","desc":"Injects shellcode into win32/64 PE files, 32/64bits ELF binaries, to continue normal file execution (if the shellcode supports it), by patching the exe/dll directly. Some executables have built in protections, as such this will not work on all ELF/PE files. It is advisable that you test target ELF/PE files before deploying them to clients or using them in exercises","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"cymothoa","cat":"persistence","sub":"General","url":"https://www.kali.org/tools/cymothoa/#cymothoa-1","cats":["persistence"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cymothoa","version":"1-beta-1kali4","arch":"i386 amd64","homepage":"https://cymothoa.sourceforge.net/","repo":"https://gitlab.com/kalilinux/packages/cymothoa","summary":"Stealth backdooring tool","desc":"Cymothoa is a stealth backdooring tool, that inject backdoor's shellcode into an existing process. The tool uses the ptrace library (available on nearly all * nix), to manipulate processes and infect them.","features":["تحليل الاستمرارية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"lynis","cat":"privilege-escalation","sub":"General","url":"https://www.kali.org/tools/lynis/#lynis-1","cats":["privilege-escalation"],"status":"دفاعي","equiv":"تدقيق التصلّب وإصلاحات البوابة في Captive Portal Auditor","slug":"lynis","version":"3.1.6-1","arch":"all","homepage":"https://cisofy.com/lynis/","repo":"https://salsa.debian.org/debian/lynis","summary":"Security auditing tool for Unix based systems","desc":"Lynis is an auditing tool for hardening GNU/Linux and Unix based systems. It scans the system configuration and creates an overview of system information and security issues usable by professional auditors. It can assist in automated audits. Lynis can be used in addition to other software, like security scanners, system benchmarking and fine-tuning tools.","features":["تحليل الصلاحيات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"peass","cat":"privilege-escalation","sub":"General","url":"https://www.kali.org/tools/peass-ng/#peass-1","cats":["privilege-escalation"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"peass-ng","version":"20260905.ffbc2342-0kali1","arch":"all","homepage":"https://github.com/carlospolop/PEASS-ng","repo":"https://gitlab.com/kalilinux/packages/peass-ng","summary":"Privilege Escalation Awesome Scripts SUITE","desc":"Privilege escalation tools for Windows and Linux/Unix* and MacOS. These tools search for possible local privilege escalation paths that you could exploit and print them to you with nice colors so you can recognize the misconfigurations easily.","features":["تحليل الصلاحيات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"linpeas","cat":"privilege-escalation","sub":"General","url":"https://www.kali.org/tools/peass-ng/#linpeas","cats":["privilege-escalation"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"peass-ng","version":"20260905.ffbc2342-0kali1","arch":"all","homepage":"https://github.com/carlospolop/PEASS-ng","repo":"https://gitlab.com/kalilinux/packages/peass-ng","summary":"Privilege Escalation Awesome Scripts SUITE","desc":"Privilege escalation tools for Windows and Linux/Unix* and MacOS. These tools search for possible local privilege escalation paths that you could exploit and print them to you with nice colors so you can recognize the misconfigurations easily.","features":["تحليل الصلاحيات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"winpeas","cat":"privilege-escalation","sub":"General","url":"https://www.kali.org/tools/peass-ng/#winpeas","cats":["privilege-escalation"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"peass-ng","version":"20260905.ffbc2342-0kali1","arch":"all","homepage":"https://github.com/carlospolop/PEASS-ng","repo":"https://gitlab.com/kalilinux/packages/peass-ng","summary":"Privilege Escalation Awesome Scripts SUITE","desc":"Privilege escalation tools for Windows and Linux/Unix* and MacOS. These tools search for possible local privilege escalation paths that you could exploit and print them to you with nice colors so you can recognize the misconfigurations easily.","features":["تحليل الصلاحيات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"unix-privesc-check","cat":"privilege-escalation","sub":"General","url":"https://www.kali.org/tools/unix-privesc-check/#unix-privesc-check-1","cats":["privilege-escalation"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"unix-privesc-check","version":"1.6+git20170904.00e0d54-0kali1","arch":"all","homepage":"https://pentestmonkey.net/tools/audit/unix-privesc-check","repo":"https://gitlab.com/kalilinux/packages/unix-privesc-check","summary":"Script to check for simple privilege escalation vectors","desc":"Unix-privesc-checker is a script that runs on Unix systems (tested on Solaris 9, HPUX 11, Various Linuxes, FreeBSD 6.2). It tries to find misconfigurations that could allow local unprivileged users to escalate privileges to other users or to access local apps (e.g. databases). It is written as a single shell script so it can be easily uploaded and run (as opposed to un-tarred, compiled and installed). It can run either as a normal user or as root (obviously it does a better job when running as root because it can read more files).","features":["تحليل الصلاحيات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"bloodyad","cat":"privilege-escalation","sub":"General","url":"https://www.kali.org/tools/bloodyad/#bloodyad-1","cats":["privilege-escalation"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"bloodyad","version":"2.5.5-0kali1","arch":"amd64 arm64","homepage":"https://github.com/CravateRouge/bloodyAD","repo":"https://gitlab.com/kalilinux/packages/bloodyAD","summary":"Active Directory privilege escalation framework","desc":"bloodyAD can perform specific LDAP calls to a domain controller in order to perform AD privesc. It supports authentication using cleartext passwords, pass-the-hash, pass-the-ticket or certificates and binds to LDAP services of a domain controller to perform AD privesc. Exchange of sensitive information without LDAPS is supported. It is also designed to be used transparently with a SOCKS proxy.","features":["تحليل الصلاحيات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"crackmapexec","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/crackmapexec/#crackmapexec-1","cats":["defense-evasion","credential-access","discovery","lateral-movement","command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"crackmapexec","version":"5.4.0-0kali7","arch":"all","homepage":"https://github.com/mpgn/CrackMapExec","repo":"https://gitlab.com/kalilinux/packages/crackmapexec","summary":"Swiss army knife for pentesting networks","desc":"This package is a swiss army knife for pentesting Windows/Active Directory environments. From enumerating logged on users and spidering SMB shares to executing psexec style attacks, auto-injecting Mimikatz/Shellcode/DLL's into memory using Powershell, dumping the NTDS.dit and more. The biggest improvements over the above tools are: SAM hashes etc... shellcode etc...) Additionally, a database is used to store used/dumped credentals. It also automatically correlates Admin credentials to hosts and vice-versa allowing you to easily keep track of credential sets and gain additional situational awareness in large environments.","features":["Pure Python script, no external tools required","Fully concurrent threading","Uses ONLY native WinAPI calls for discovering sessions, users, dumping","Opsec safe (no binaries are uploaded to dump clear-text credentials, inject"]},{"name":"evil-winrm","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/evil-winrm/#evil-winrm-1","cats":["defense-evasion","lateral-movement","command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"evil-winrm","version":"4.1-0kali1","arch":"all","homepage":"https://github.com/Hackplayers/evil-winrm","repo":"https://gitlab.com/kalilinux/packages/evil-winrm","summary":"Ultimate WinRM shell for hacking/pentesting","desc":"This package contains the ultimate WinRM shell for hacking/pentesting. WinRM (Windows Remote Management) is the Microsoft implementation of WS-Management Protocol. A standard SOAP based protocol that allows hardware and operating systems from different vendors to interoperate. Microsoft included it in their Operating Systems in order to make life easier to system administrators. This program can be used on any Microsoft Windows Servers with this feature enabled (usually at port 5985), of course only if you have credentials and permissions to use it. So it could be used in a post-exploitation hacking/pentesting phase. The purpose of this program is to provide nice and easy-to-use features for hacking. It can be used with legitimate purposes by system administrators as well but the most of its features are focused on hacking/pentesting stuff. It is using PSRP (Powershell Remoting Protocol) for initializing runspace pools as well as creating and processing pipelines.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"evil-winrm-py","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/evil-winrm-py/#evil-winrm-py-1","cats":["defense-evasion","lateral-movement"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"evil-winrm-py","version":"1.6.0-0kali1","arch":"all","homepage":"https://github.com/adityatelange/evil-winrm-py","repo":"https://gitlab.com/kalilinux/packages/evil-winrm-py","summary":"Execute commands on remote Windows machines using WinRM","desc":"Python-based tool for executing commands on remote Windows machines using the WinRM (Windows Remote Management) protocol. It provides an interactive shell with enhanced features like file upload/download, command history, and colorized output. It supports various authentication methods including NTLM, Pass-the-Hash, Certificate, and Kerberos.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"impacket-scripts","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/impacket-scripts/#impacket-scripts","cats":["defense-evasion","lateral-movement","command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"impacket-scripts","version":"1.10","arch":"all","homepage":"","repo":"https://gitlab.com/kalilinux/packages/impacket-scripts","summary":"Links to useful impacket scripts examples","desc":"This package contains links to useful impacket scripts. It's a separate package to keep impacket package from Debian and have the useful scripts in the path for Kali.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"mimikatz","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/mimikatz/#mimikatz-1","cats":["defense-evasion","credential-access","lateral-movement"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"mimikatz","version":"2.2.0-git20220919-0kali1","arch":"all","homepage":"https://blog.gentilkiwi.com/mimikatz","repo":"https://gitlab.com/kalilinux/packages/mimikatz","summary":"Uses admin rights on Windows to display passwords in plaintext","desc":"Mimikatz uses admin rights on Windows to display passwords of currently logged in users in plaintext.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"netexec","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/netexec/#netexec-1","cats":["defense-evasion","credential-access","discovery","lateral-movement","command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"netexec","version":"1.5.1-0kali2","arch":"all","homepage":"https://github.com/Pennyw0rth/NetExec","repo":"https://gitlab.com/kalilinux/packages/netexec","summary":"Network Execution Tool","desc":"NetExec (AKA nxc) is a network service exploitation tool that helps automate assessing the security of large networks. NetExec is the continuation of CrackMapExec, which was maintained by mpgn over the years, but discontinued upon mpgn's retirement.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"passing-the-hash","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/passing-the-hash/#passing-the-hash","cats":["defense-evasion","lateral-movement"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"passing-the-hash","version":"0~2015.12.37","arch":"any","homepage":"http://passing-the-hash.blogspot.fr","repo":"https://gitlab.com/kalilinux/packages/passing-the-hash","summary":"Patched tools to use password hashes as authentication input","desc":"This package contains modified versions of Curl, Iceweasel, FreeTDS, Samba 4, WinEXE and WMI. They are installed as executables starting with the \"pth-\" string.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"rubeus","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/rubeus/#rubeus-1","cats":["defense-evasion","credential-access","lateral-movement"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rubeus","version":"1.6.4-0kali1","arch":"all","homepage":"https://github.com/GhostPack/Rubeus","repo":"https://gitlab.com/kalilinux/packages/rubeus","summary":"Raw Kerberos interaction and abuses","desc":"Rubeus is a C# toolset for raw Kerberos interaction and abuses. It is heavily adapted from Benjamin Delpy's Kekeo project and Vincent LE TOUX's MakeMeEnterpriseAdmin project.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"smbmap","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/smbmap/#smbmap-1","cats":["defense-evasion","discovery","lateral-movement"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"smbmap","version":"1.10.7-1","arch":"all","homepage":"https://github.com/ShawnDEvans/smbmap","repo":"https://salsa.debian.org/pkg-security-team/smbmap","summary":"Handy SMB enumeration tool","desc":"SMBMap allows users to enumerate samba share drives across an entire domain. List share drives, drive permissions, share contents, upload/download functionality, file name auto-download pattern matching, and even execute remote commands. This tool was designed with pen testing in mind, and is intended to simplify searching for potentially sensitive data across large networks. Features: Pass-the-Hash Support File upload/download/delete Permission enumeration (writable share, meet Metasploit) Remote Command Execution Distrubted file content searching (beta!) File name matching (with an auto downoad capability) Host file parser supports IPs, host names, and CIDR SMB sigining detection Server version output Kerberos support! (super beta)","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"xfreerdp3","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/freerdp3/#xfreerdp3","cats":["defense-evasion","lateral-movement","command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"freerdp3","version":"3.31.1+dfsg-1","arch":"any all","homepage":"https://www.freerdp.com/","repo":"https://salsa.debian.org/debian-remote-team/freerdp3","summary":"FreeRDP X11 client","desc":"FreeRDP X11 client","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"sniffjoke","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/sniffjoke/#sniffjoke-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sniffjoke","version":"0.4.1-1kali2","arch":"any","homepage":"https://github.com/vecna/sniffjoke","repo":"https://gitlab.com/kalilinux/packages/sniffjoke","summary":"Transparent TCP connection scrambler","desc":"SniffJoke is an application for Linux that handle transparently your TCP connection, delaying, modifyng and inject fake packets inside your transmission, make them almost impossible to be correctly readed by a passive wiretapping technology (IDS or sniffer).","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ftest","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/ftester/#ftest","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ftester","version":"1.0-1kali3","arch":"all","homepage":"https://dev.inversepath.com/ftester/","repo":"https://gitlab.com/kalilinux/packages/ftester","summary":"Tool for testing firewalls and Intrusion Detection System (IDS)","desc":"The Firewall Tester (FTester) is a tool designed for testing firewall filtering policies and Intrusion Detection System (IDS) capabilities. Features:","features":["firewall testing","IDS testing","simulation of real tcp connections for stateful inspection firewalls and IDS","TCP connection spoofing","IP fragmentation / TCP segmentation","IDS evasion techniques"]},{"name":"fragrouter","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/fragrouter/#fragrouter-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"fragrouter","version":"1.7-3kali6","arch":"any","homepage":"http://www.anzen.com/research/nidsbench/fragrouter.html","repo":"https://gitlab.com/kalilinux/packages/fragrouter","summary":"IDS evasion toolkit","desc":"Fragrouter is a network intrusion detection evasion toolkit.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"macchanger","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/macchanger/#macchanger-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"macchanger","version":"1.7.0-6","arch":"linux-any","homepage":"https://github.com/alobbs/macchanger","repo":"https://salsa.debian.org/debian/macchanger","summary":"Utility for manipulating the MAC address of network interfaces","desc":"GNU MAC Changer is an utility that makes the maniputation of MAC addresses of network interfaces easier. MAC addresses are unique identifiers on networks, they only need to be unique, they can be changed on most network hardware. MAC addresses have started to be abused by unscrupulous marketing firms, government agencies, and others to provide an easy way to track a computer across multiple networks. By changing the MAC address regularly, this kind of tracking can be thwarted, or at least made a lot more difficult. Features:","features":["set specific MAC address of a network interface","set the MAC randomly","set a MAC of another vendor","set another MAC of the same vendor","set a MAC of the same kind (eg: wireless card)","display a vendor MAC list (today, 6200 items) to choose from"]},{"name":"outguess","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/outguess/#outguess-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"outguess","version":"1:0.4-2","arch":"any","homepage":"https://github.com/resurrecting-open-source-projects/outguess","repo":"https://salsa.debian.org/pkg-security-team/outguess","summary":"OutGuess is a universal tool for steganography that allows the insertion of hidden information into the redundant bits of data sources.","desc":"OutGuess is a universal tool for steganography that allows the insertion of hidden information into the redundant bits of data sources. The nature of the data source is irrelevant to the core of OutGuess. The program relies on data specific handlers that will extract redundant bits and write them back after modification. The supported formats are JPEG, PPM and PNM. This package is useful in forensics investigations and security actions.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"steghide","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/steghide/#steghide-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"steghide","version":"0.5.1+git20240220-2","arch":"any all","homepage":"https://steghide.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/steghide","summary":"Steganography hiding tool","desc":"Steghide is steganography program which hides bits of a data file in some of the least significant bits of another file in such a way that the existence of the data file is not visible and cannot be proven. Steghide is designed to be portable and configurable and features hiding data in bmp, jpeg, wav and au files, blowfish encryption, MD5 hashing of passphrases to blowfish keys, and pseudo-random distribution of hidden bits in the container data. Steghide is useful in digital forensics investigations.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"stegosuite","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/stegosuite/#stegosuite-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"stegosuite","version":"0.9.0-1","arch":"all","homepage":"https://codeberg.org/tob/stegosuite","repo":"https://salsa.debian.org/java-team/stegosuite","summary":"Steganography tool to hide information in image files","desc":"Stegosuite is a graphical steganography tool to easily hide information in image files. It allows the embedding of text messages and multiple files of any type. In addition, the embedded data is encrypted using AES. Currently supported file types are BMP, GIF, JPG and PNG. Stegosuite is written in Java and utilizes the SWT toolkit for its interface.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"stegsnow","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/stegsnow/#stegsnow-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"stegsnow","version":"20130616-8","arch":"any","homepage":"https://www.darkside.com.au/snow","repo":"https://salsa.debian.org/pkg-security-team/stegsnow","summary":"Steganography using ASCII files","desc":"This utility can conceal messages in ASCII text by appending whitespaces to the end of lines. Because spaces and tabs are generally not visible in text viewers, the message is effectively hidden from casual observers. And if the built-in encryption is used, the message cannot be read even if it is detected. About the name: locating trailing whitespace in text is like finding a polar bear in a snowstorm. And it uses the ICE encryption algorithm, so the name is thematically consistent. This package is useful for personal security, forensics investigations and other actions.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"exe2hex","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/exe2hexbat/#exe2hex","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"exe2hexbat","version":"1.5.1-0kali2","arch":"all","homepage":"https://github.com/g0tmi1k/exe2hex/","repo":"https://gitlab.com/kalilinux/packages/exe2hexbat","summary":"Convert EXE to bat","desc":"A Python script to convert a Windows PE executable file to a batch file and vice versa.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"shellter","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/shellter/#shellter-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"shellter","version":"7.2-0kali3","arch":"i386 amd64","homepage":"https://www.shellterproject.com/","repo":"https://gitlab.com/kalilinux/packages/shellter","summary":"Dynamic shellcode injection tool and dynamic PE infector","desc":"Shellter is a dynamic shellcode injection tool aka dynamic PE infector. It can be used in order to inject shellcode into native Windows applications (currently 32-bit apps only). The shellcode can be something yours or something generated through a framework, such as Metasploit. Shellter takes advantage of the original structure of the PE file and doesn't apply any modification such as changing memory access permissions in sections (unless the user wants to), adding an extra section with RWE access, and whatever would look dodgy under an AV scan.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"veil","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/veil/#veil-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"veil","version":"3.1.14-0kali2","arch":"i386 amd64 all","homepage":"https://github.com/Veil-Framework/Veil","repo":"https://gitlab.com/kalilinux/packages/veil","summary":"Generates payloads to bypass anti-virus solutions","desc":"Veil is a tool designed to generate metasploit payloads that bypass common anti-virus solutions. It replaces the package veil-evasion.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ccrypt","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/ccrypt/#ccrypt-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ccrypt","version":"1.11-7","arch":"any all","homepage":"https://ccrypt.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/ccrypt","summary":"Secure encryption and decryption of files and streams","desc":"ccrypt is a utility for encrypting and decrypting files and streams. It was designed as a replacement for the standard unix crypt utility, which is notorious for using a very weak encryption algorithm. ccrypt is based on the Rijndael cipher, which is the U.S. government's chosen candidate for the Advanced Encryption Standard (AES, see http://www.nist.gov/aes). This cipher is believed to provide very strong security.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"padbuster","cat":"defense-evasion","sub":"General","url":"https://www.kali.org/tools/padbuster/#padbuster-1","cats":["defense-evasion"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"padbuster","version":"0.3.3+git20210818.50e4a3e-1kali1","arch":"all","homepage":"https://github.com/GDSSecurity/PadBuster","repo":"https://gitlab.com/kalilinux/packages/padbuster","summary":"Script for performing Padding Oracle attacks","desc":"PadBuster is a Perl script for automating Padding Oracle Attacks. PadBuster provides the capability to decrypt arbitrary ciphertext, encrypt arbitrary plaintext, and perform automated response analysis to determine whether a request is vulnerable to padding oracle attacks.","features":["تحليل التهرب","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"chntpw","cat":"credential-access","sub":"OS Credential Dumping","url":"https://www.kali.org/tools/chntpw/#chntpw-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"chntpw","version":"140201-1.3","arch":"any","homepage":"http://pogostick.net/~pnh/ntpasswd/","repo":"https://salsa.debian.org/debian/chntpw","summary":"NT SAM password recovery utility","desc":"This little program provides a way to view information and change user passwords in a Windows NT/2000 user database file. Old passwords need not be known since they are overwritten. In addition it also contains a simple registry editor (same size data writes) and an hex-editor which enables you to fiddle around with bits and bytes in the file as you wish. If you want GNU/Linux bootdisks for offline password recovery you can add this utility to custom image disks or use those provided at the tools homepage.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"creddump7","cat":"credential-access","sub":"OS Credential Dumping","url":"https://www.kali.org/tools/creddump7/#creddump7-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"creddump7","version":"0.1+git20190429-1.1","arch":"all","homepage":"https://github.com/CiscoCXSecurity/creddump7","repo":"https://salsa.debian.org/pkg-security-team/creddump7","summary":"Python tool to extract credentials and secrets from Windows registry hives","desc":"This package contains a Python tool to extract various credentials and secrets from Windows registry hives. It's based on the creddump program. Many patches and fixes have been applied by Ronnie Flathers.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"samdump2","cat":"credential-access","sub":"OS Credential Dumping","url":"https://www.kali.org/tools/samdump2/#samdump2-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"samdump2","version":"3.0.0-8","arch":"any","homepage":"https://ophcrack.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/samdump2","summary":"Dump Windows 2k/NT/XP password hashes","desc":"This tool is designed to dump Windows 2k/NT/XP password hashes from a SAM file, using the syskey bootkey from the system hive. This package also provides the functionality of bkhive, which recovers the syskey bootkey from a Windows NT/2K/XP system hive. Syskey is a Windows feature that adds an additional encryption layer to the password hashes stored in the SAM database.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"hashid","cat":"credential-access","sub":"Hash Identification","url":"https://www.kali.org/tools/hashid/#hashid-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"hashid","version":"3.1.4-5","arch":"all","homepage":"https://psypanda.github.io/hashID/","repo":"https://salsa.debian.org/pkg-security-team/hashid","summary":"Identify the different types of hashes used to encrypt data","desc":"Identify the different types of hashes used to encrypt data and especially passwords. hashID is a tool written in Python 3.x which supports the identification of over 175 unique hash types using regular expressions. It is able to identify a single hash or parse a file and identify the hashes within it. There is also a nodejs version of hashID available which is easily set up to provide online hash identification.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"hash-identifier","cat":"credential-access","sub":"Hash Identification","url":"https://www.kali.org/tools/hash-identifier/#hash-identifier-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"hash-identifier","version":"1.2+git20180314-0kali3","arch":"all","homepage":"https://github.com/blackploit/hash-identifier","repo":"https://gitlab.com/kalilinux/packages/hash-identifier","summary":"Tool to identify hash types","desc":"Software to identify the different types of hashes used to encrypt data and especially passwords.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"bopscrk","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/bopscrk/#bopscrk-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"bopscrk","version":"2.4.7+lyricpass-0kali1","arch":"all","homepage":"https://github.com/r3nt0n/bopscrk/","repo":"https://gitlab.com/kalilinux/packages/bopscrk","summary":"Generate smart and powerful wordlists","desc":"Targeted-attack wordlist creator: introduce personal info related to target, combines every word and transforms results into possible passwords. The lyricpass module allows one to search lyrics related to artists and include them to the wordlists.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"cewl","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/cewl/#cewl-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cewl","version":"6.2.1-1","arch":"all","homepage":"https://github.com/digininja/CeWL","repo":"https://salsa.debian.org/pkg-security-team/cewl","summary":"Custom word list generator","desc":"CeWL (Custom Word List generator) is a ruby app which spiders a given URL, up to a specified depth, and returns a list of words which can then be used for password crackers such as John the Ripper. Optionally, CeWL can follow external links. CeWL can also create a list of email addresses found in mailto links. These email addresses can be used as usernames in brute force actions. Another tool provided by CeWL project is FAB (Files Already Bagged). FAB extracts the content of the author/creator fields, from metadata of the some files, to create lists of possible usernames. These usernames can be used in association with the password list generated by CeWL. FAB uses the same metadata extraction techniques that CeWL. Currently, FAB process Office pre 2007, Office 2007 and PDF formats. CeWL is useful in security tests and forensics investigations. CeWL is pronounced \"cool\".","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"crunch","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/crunch/#crunch-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"crunch","version":"3.6-3.1","arch":"any","homepage":"http://sourceforge.net/projects/crunch-wordlist/","repo":"https://salsa.debian.org/debian/crunch","summary":"Tool for creating wordlist","desc":"Crunch is a wordlist generator where you can specify a standard character set or any set of characters to be used in generating the wordlists. The wordlists are created through combination and permutation of a set of characters. You can determine the amount of characters and list size. This program supports numbers and symbols, upper and lower case characters separately and Unicode.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"maskgen","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/pack/#maskgen","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"pack","version":"0.0.4+git20191128.fd779b2-0kali3","arch":"all","homepage":"https://github.com/Hydraze/pack","repo":"https://gitlab.com/kalilinux/packages/pack","summary":"Password analysis and cracking kit","desc":"PACK was developed in order to aid in a password cracking competition \"Crack Me If You Can\" that occurred during Defcon 2010. The goal of this toolkit is to aid in preparation for the \"better than bruteforce\" password attacks by analyzing common ways that people create passwords. After the analysis stage, the statistical database can be used to generate attack masks for tools such as oclHashcat. NOTE: This tool itself can not crack passwords, but helps other tools crack more passwords faster.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"policygen","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/pack/#policygen","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"pack","version":"0.0.4+git20191128.fd779b2-0kali3","arch":"all","homepage":"https://github.com/Hydraze/pack","repo":"https://gitlab.com/kalilinux/packages/pack","summary":"Password analysis and cracking kit","desc":"PACK was developed in order to aid in a password cracking competition \"Crack Me If You Can\" that occurred during Defcon 2010. The goal of this toolkit is to aid in preparation for the \"better than bruteforce\" password attacks by analyzing common ways that people create passwords. After the analysis stage, the statistical database can be used to generate attack masks for tools such as oclHashcat. NOTE: This tool itself can not crack passwords, but helps other tools crack more passwords faster.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"rsmangler","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/rsmangler/#rsmangler-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rsmangler","version":"1.5-0kali3","arch":"all","homepage":"https://digi.ninja/projects/rsmangler.php","repo":"https://gitlab.com/kalilinux/packages/rsmangler","summary":"Wordlist mangling tool","desc":"RSMangler will take a wordlist and perform various manipulations on it similar to those done by John the Ripper the main difference being that it will first take the input words and generate all permutations and the acronym of the words (in order they appear in the file) before it applies the rest of the mangles.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"statsgen","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/pack/#statsgen","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"pack","version":"0.0.4+git20191128.fd779b2-0kali3","arch":"all","homepage":"https://github.com/Hydraze/pack","repo":"https://gitlab.com/kalilinux/packages/pack","summary":"Password analysis and cracking kit","desc":"PACK was developed in order to aid in a password cracking competition \"Crack Me If You Can\" that occurred during Defcon 2010. The goal of this toolkit is to aid in preparation for the \"better than bruteforce\" password attacks by analyzing common ways that people create passwords. After the analysis stage, the statistical database can be used to generate attack masks for tools such as oclHashcat. NOTE: This tool itself can not crack passwords, but helps other tools crack more passwords faster.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"twofi","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/twofi/#twofi-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"twofi","version":"2.0-0kali2","arch":"all","homepage":"https://www.digininja.org/projects/twofi.php","repo":"https://gitlab.com/kalilinux/packages/twofi","summary":"Twitter words of interest","desc":"When attempting to crack passwords custom word lists are very useful additions to standard dictionaries. An interesting idea originally released on the \"7 Habits of Highly Effective Hackers\" blog was to use Twitter to help generate those lists based on searches for keywords related to the list that is being cracked. I've expanded this idea into twofi which will take multiple search terms and return a word list sorted by most common first.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"wordlists","cat":"credential-access","sub":"Password Profiling & Wordlists","url":"https://www.kali.org/tools/wordlists/#wordlists-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"wordlists","version":"2026.2.0","arch":"all","homepage":"https://www.kali.org","repo":"https://gitlab.com/kalilinux/packages/wordlists","summary":"Contains the rockyou wordlist","desc":"This package contains the rockyou.txt wordlist and has an installation size of 134 MB.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"crowbar","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/crowbar/#crowbar-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"crowbar","version":"4.2-0kali3","arch":"all","homepage":"https://github.com/galkan/crowbar","repo":"https://gitlab.com/kalilinux/packages/crowbar","summary":"Brute forcing tool","desc":"This package contains Crowbar (formally known as Levye). It is a brute forcing tool that can be used during penetration tests. It was developed to brute force some protocols in a different manner according to other popular brute forcing tools. As an example, while most brute forcing tools use username and password for SSH brute force, Crowbar uses SSH key(s). This allows for any private keys that have been obtained during penetration tests, to be used to attack other SSH servers. Currently Crowbar supports:","features":["OpenVPN (-b openvpn)","Remote Desktop Protocol (RDP) with NLA support (-b rdp)","SSH private key authentication (-b sshkey)","VNC key authentication (-b vpn)"]},{"name":"hydra","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/hydra/#hydra-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"hydra","version":"9.7-1","arch":"any","homepage":"https://github.com/vanhauser-thc/thc-hydra","repo":"https://salsa.debian.org/pkg-security-team/hydra","summary":"Very fast network logon cracker","desc":"Hydra is a parallelized login cracker which supports numerous protocols to attack. It is very fast and flexible, and new modules are easy to add. This tool makes it possible for researchers and security consultants to show how easy it would be to gain unauthorized access to a system remotely. It supports: Cisco AAA, Cisco auth, Cisco enable, CVS, FTP, HTTP(S)-FORM-GET, HTTP(S)-FORM-POST, HTTP(S)-GET, HTTP(S)-HEAD, HTTP-Proxy, ICQ, IMAP, IRC, LDAP, MS-SQL, MySQL, NNTP, Oracle Listener, Oracle SID, PC-Anywhere, PC-NFS, POP3, PostgreSQL, RDP, Rexec, Rlogin, Rsh, SIP, SMB(NT), SMTP, SMTP Enum, SNMP v1+v2+v3, SOCKS5, SSH (v1 and v2), SSHKEY, Subversion, Teamspeak (TS2), Telnet, VMware-Auth, VNC and XMPP.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"hydra-gtk","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/hydra/#hydra-gtk","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"hydra","version":"9.7-1","arch":"any","homepage":"https://github.com/vanhauser-thc/thc-hydra","repo":"https://salsa.debian.org/pkg-security-team/hydra","summary":"Very fast network logon cracker","desc":"Hydra is a parallelized login cracker which supports numerous protocols to attack. It is very fast and flexible, and new modules are easy to add. This tool makes it possible for researchers and security consultants to show how easy it would be to gain unauthorized access to a system remotely. It supports: Cisco AAA, Cisco auth, Cisco enable, CVS, FTP, HTTP(S)-FORM-GET, HTTP(S)-FORM-POST, HTTP(S)-GET, HTTP(S)-HEAD, HTTP-Proxy, ICQ, IMAP, IRC, LDAP, MS-SQL, MySQL, NNTP, Oracle Listener, Oracle SID, PC-Anywhere, PC-NFS, POP3, PostgreSQL, RDP, Rexec, Rlogin, Rsh, SIP, SMB(NT), SMTP, SMTP Enum, SNMP v1+v2+v3, SOCKS5, SSH (v1 and v2), SSHKEY, Subversion, Teamspeak (TS2), Telnet, VMware-Auth, VNC and XMPP.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"legba","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/legba/#legba-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"legba","version":"1.3.0-0kali1","arch":"any","homepage":"https://github.com/evilsocket/legba","repo":"https://gitlab.com/kalilinux/packages/legba","summary":"Multiprotocol credentials bruteforcer / password sprayer and enumerator","desc":"Legba is a multiprotocol credentials bruteforcer / password sprayer and enumerator built with Rust and the Tokio asynchronous runtime in order to achieve better performances and stability while consuming less resources than similar tools.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"medusa","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/medusa/#medusa-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"medusa","version":"2.3-3","arch":"any","homepage":"http://foofus.net/?page_id=51","repo":"https://salsa.debian.org/pkg-security-team/medusa","summary":"Fast, parallel, modular, login brute-forcer for network services","desc":"Medusa is intended to be a speedy, massively parallel, modular, login brute-forcer. The goal is to support as many services which allow remote authentication as possible. The author considers following items as some of the key features of this application: performed against multiple hosts, users or passwords concurrently. be specified in a variety of ways. For example, each item can be either a single entry or a file containing multiple entries. Additionally, a combination file format allows the user to refine their target listing. independent .mod file. This means that no modifications are necessary to the core application in order to extend the supported list of services for brute-forcing.","features":["Thread-based parallel testing. Brute-force testing can be","Flexible user input. Target information (host/user/password) can","Modular design. Each service module exists as an"]},{"name":"ncrack","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/ncrack/#ncrack-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ncrack","version":"0.7+debian-6","arch":"any","homepage":"https://nmap.org/ncrack/","repo":"https://salsa.debian.org/pkg-security-team/ncrack","summary":"High-speed network authentication cracking tool","desc":"Ncrack is a high-speed network authentication cracking tool. It was built to help companies secure their networks by proactively testing all their hosts and networking devices for poor passwords. Security professionals also rely on Ncrack when auditing their clients. Ncrack was designed using a modular approach, a command-line syntax similar to Nmap and a dynamic engine that can adapt its behaviour based on network feedback. It allows for rapid, yet reliable large-scale auditing of multiple hosts. Ncrack's features include a very flexible interface granting the user full control of network operations, allowing for very sophisticated bruteforcing attacks, timing templates for ease of use, runtime interaction similar to Nmap's and many more. Protocols supported include RDP, SSH, http(s), SMB, pop3(s), VNC, FTP, and telnet. Be sure to read the Ncrack man page (https://nmap.org/ncrack/man.html) to fully understand Ncrack usage.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"patator","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/patator/#patator-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"patator","version":"1.1.0-1","arch":"all","homepage":"https://github.com/lanjelot/patator","repo":"https://salsa.debian.org/pkg-security-team/patator","summary":"Multi-purpose brute-forcer","desc":"Patator is a multi-purpose brute-forcer, with a modular design and a flexible usage. Currently it supports the following modules: + ftp_login : Brute-force FTP + ssh_login : Brute-force SSH + telnet_login : Brute-force Telnet + smtp_login : Brute-force SMTP + smtp_vrfy : Enumerate valid users using SMTP VRFY + smtp_rcpt : Enumerate valid users using SMTP RCPT TO + finger_lookup : Enumerate valid users using Finger + http_fuzz : Brute-force HTTP + ajp_fuzz : Brute-force AJP + pop_login : Brute-force POP3 + pop_passd : Brute-force poppassd (http://netwinsite.com/poppassd/) + imap_login : Brute-force IMAP4 + ldap_login : Brute-force LDAP + dcom_login : Brute-force DCOM + smb_login : Brute-force SMB + smb_lookupsid : Brute-force SMB SID-lookup + rlogin_login : Brute-force rlogin + vmauthd_login : Brute-force VMware Authentication Daemon + mssql_login : Brute-force MSSQL + mysql_login : Brute-force MySQL + mysql_query : Brute-force MySQL queries + rdp_login : Brute-force RDP (NLA) + pgsql_login : Brute-force PostgreSQL + vnc_login : Brute-force VNC + dns_forward : Forward DNS lookup + dns_reverse : Reverse DNS lookup + snmp_login : Brute-force SNMP v1/2/3 + ike_enum : Enumerate IKE transforms + unzip_pass : Brute-force the password of encrypted ZIP files + keystore_pass : Brute-force the password of Java keystore files + umbraco_crack : Crack Umbraco HMAC-SHA1 password hashes + tcp_fuzz : Fuzz TCP services + dummy_test : Testing module","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"sqldict","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/sqldict/#sqldict-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sqldict","version":"2.1-1kali6","arch":"all","homepage":"https://ntsecurity.nu/toolbox/sqldict/","repo":"https://gitlab.com/kalilinux/packages/sqldict","summary":"Dictionary attack tool for SQL Server","desc":"SQLdict is a dictionary attack tool for SQL Server.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"thc-pptp-bruter","cat":"credential-access","sub":"Brute Force","url":"https://www.kali.org/tools/thc-pptp-bruter/#thc-pptp-bruter-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"thc-pptp-bruter","version":"0.1.4-1kali5","arch":"any","homepage":"http://www.thc.org/releases.php","repo":"https://gitlab.com/kalilinux/packages/thc-pptp-bruter","summary":"THC PPTP Brute Force","desc":"Brute force program against pptp vpn endpoints (tcp port 1723). Fully standalone. Supports latest MSChapV2 authentication. Tested against Windows and Cisco gateways. Exploits a weakness in Microsoft's anti-brute force implementation which makes it possible to try 300 passwords the second.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"cmospwd","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/cmospwd/#cmospwd-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cmospwd","version":"5.0+dfsg-3kali5","arch":"amd64 i386","homepage":"https://www.cgsecurity.org/wiki/CmosPwd","repo":"https://gitlab.com/kalilinux/packages/cmospwd","summary":"Decrypt BIOS passwords from CMOS","desc":"CmosPwd is a cross-platform tool to decrypt password stored in CMOS used to access a computer's BIOS setup. This application should work out of the box on most modern systems, but some more esoteric BIOSes may not be supported or may require additional steps.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"crackle","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/crackle/#crackle-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"crackle","version":"0.1~git01282014-0kali4","arch":"any","homepage":"https://github.com/mikeryan/crackle","repo":"https://gitlab.com/kalilinux/packages/crackle","summary":"Crack and decrypt BLE encryption","desc":"crackle exploits a flaw in the BLE pairing process that allows an attacker to guess or very quickly brute force the TK (Temporary Key). With the TK and other data collected from the pairing process, the STK (Short Term Key) and later the LTK (Long Term Key) can be collected. With the STK and LTK, all communications between the master and the slave can be decrypted","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"fcrackzip","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/fcrackzip/#fcrackzip-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"fcrackzip","version":"1.0-12","arch":"any","homepage":"http://oldhome.schmorp.de/marc/fcrackzip.html","repo":"https://salsa.debian.org/pkg-security-team/fcrackzip","summary":"Password cracker for zip archives","desc":"fcrackzip is a fast password cracker partly written in assembler. It is able to crack password protected zip files with brute force or dictionary based attacks, optionally testing with unzip its results. It can also crack cpmask'ed images. This package is useful for pentesters, ethical hackers and forensics experts.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"hashcat","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/hashcat/#hashcat-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"مختبر تجزئة وقوة كلمات المرور بدون كسر","slug":"hashcat","version":"7.1.2+ds1-4","arch":"kfreebsd-any amd64 arm64 armhf i386 all","homepage":"https://hashcat.net/hashcat/","repo":"https://salsa.debian.org/pkg-security-team/hashcat","summary":"World's fastest and most advanced password recovery utility","desc":"Hashcat supports five unique modes of attack for over 300 highly-optimized hashing algorithms. hashcat currently supports CPUs, GPUs, and other hardware accelerators on Linux, and has facilities to help enable distributed password cracking. Examples of hashcat supported hashing algorithms are: MD5, HMAC-MD5, SHA1, HMAC-SHA1, MySQL323, MySQL4.1/MySQL5, phpass, MD5(Wordpress), MD5(phpBB3), MD5(Joomla), md5crypt, MD5(Unix), FreeBSD MD5, Cisco-IOS, MD4, NTLM, Domain Cached Credentials (DCC), MS Cache, SHA256, HMAC-SHA256, md5apr1, MD5(APR), Apache MD5, SHA512, HMAC-SHA512, Cisco-PIX, Cisco-ASA, WPA/WPA2, Double MD5, bcrypt, Blowfish(OpenBSD), MD5(Sun), Double SHA1, SHA-3(Keccak), Half MD5, Password Safe SHA-256, IKE-PSK MD5, IKE-PSK SHA1, NetNTLMv1-VANILLA/NetNTLMv1-ESS, NetNTLMv2, Cisco-IOS SHA256, Android PIN, AIX {smd5}, AIX {ssha256}, AIX {ssha512}, AIX {ssha1}, GOST, GOST R 34, Fortigate (FortiOS), OS X v10.8+, GRUB 2, IPMI2, RAKP, HMAC-SHA1, sha256crypt, SHA256(Unix), Drupal7, WBB3, scrypt, Cisco $8$, Cisco $9$, Radmin2, Django (PBKDF2-SHA256), Cram MD5, SAP, iSSHA-1, PrestaShop, PostgreSQL, Challenge-Response Authentication (MD5), MySQL Challenge-Response, Authentication (SHA1), SIP digest authentication (MD5), Plaintext, Joomla < 2.5.18, PostgreSQL, osCommerce, xt:Commerce, Skype, nsldap, Netscape, LDAP, nsldaps, SSHA-1(Base64), Oracle S: Type (Oracle 11+), SMF > v1.1, OS X v10.4, v10.5, v10.6, EPi, Django (SHA-1), MSSQL(2000), MSSQL(2005), PeopleSoft, EPiServer 6.x < v4, hMailServer, SSHA-512(Base64), LDAP {SSHA512}, OS X v10.7, MSSQL(2012 & 2014), vBulletin < v3.8.5, PHPS, vBulletin > v3.8.5, IPB2+, MyBB1.2+, Mediawiki B type, WebEdition CMS, Redmine. Hashcat offers multiple attack modes for obtaining effective and complex coverage over a hash's keyspace. These modes are:","features":["Brute-Force attack","Combinator attack","Dictionary attack","Fingerprint attack","Hybrid attack","Mask attack","Permutation attack","Rule-based attack","Table-Lookup attack","Toggle-Case attack"]},{"name":"john","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/john/#john-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"مختبر تجزئة وقوة كلمات المرور بدون كسر","slug":"john","version":"1.9.0-Jumbo-1+git20211102-0kali11","arch":"any all","homepage":"https://github.com/openwall/john","repo":"https://gitlab.com/kalilinux/packages/john","summary":"Active password cracking tool","desc":"John the Ripper is a tool designed to help systems administrators to find weak (easy to guess or crack through brute force) passwords, and even automatically mail users warning them about it, if it is desired. Besides several crypt(3) password hash types most commonly found on various Unix flavors, supported out of the box are Kerberos AFS and Windows NT/2000/XP/2003 LM hashes, plus several more with contributed patches.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"johnny","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/johnny/#johnny-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"johnny","version":"2.2+git20160807-0kali2","arch":"any","homepage":"https://openwall.info/wiki/john/johnny","repo":"https://gitlab.com/kalilinux/packages/johnny","summary":"GUI for John the Ripper","desc":"Johnny is provides a GUI for the John the Ripper password cracking tool.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"ophcrack","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/ophcrack/#ophcrack-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ophcrack","version":"3.8.0-4","arch":"any","homepage":"https://ophcrack.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/ophcrack","summary":"Microsoft Windows password cracker using rainbow tables (gui)","desc":"Ophcrack is a Windows password cracker based on a time-memory trade-off using rainbow tables. This is a new variant of Hellman's original trade-off, with better performance. It recovers 99.9% of alphanumeric passwords in seconds. It works for Windows NT/2000/XP/Vista/7. This package contains ophcrack with Qt-based graphical UI. Please note that it can be used in command line as well.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"ophcrack-cli","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/ophcrack/#ophcrack-cli-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ophcrack","version":"3.8.0-4","arch":"any","homepage":"https://ophcrack.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/ophcrack","summary":"Microsoft Windows password cracker using rainbow tables (gui)","desc":"Ophcrack is a Windows password cracker based on a time-memory trade-off using rainbow tables. This is a new variant of Hellman's original trade-off, with better performance. It recovers 99.9% of alphanumeric passwords in seconds. It works for Windows NT/2000/XP/Vista/7. This package contains ophcrack with Qt-based graphical UI. Please note that it can be used in command line as well.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"rcrack","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/rainbowcrack/#rcrack","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rainbowcrack","version":"1.8-0kali3","arch":"amd64","homepage":"https://project-rainbowcrack.com/index.htm","repo":"https://gitlab.com/kalilinux/packages/rainbowcrack","summary":"Rainbow table password cracker","desc":"RainbowCrack is a general propose implementation of Philippe Oechslin's faster time-memory trade-off technique. It crack hashes with rainbow tables. RainbowCrack uses time-memory tradeoff algorithm to crack hashes. It differs from the hash crackers that use brute force algorithm.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"rcracki_mt","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/rcracki-mt/#rcracki_mt","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rcracki-mt","version":"0.7.0-1kali5","arch":"any","homepage":"https://freerainbowtables.com/","repo":"https://gitlab.com/kalilinux/packages/rcracki-mt","summary":"Version of rcrack that supports hybrid and indexed tables","desc":"rcracki_mt is our modified version of rcrack which supports hybrid and indexed tables. In addition to that, it also adds multi-core support","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"sipcrack","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/sipcrack/#sipcrack-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipcrack","version":"0.2-4","arch":"any","homepage":"http://www.remote-exploit.org/codes_sipcrack.html","repo":"https://salsa.debian.org/debian/sipcrack","summary":"SIP login dumper/cracker","desc":"The tools contained in this package offer support for pcap files, wordlists and many more to extract all needed information and bruteforce the passwords for the sniffed accounts. generated by sipdump.","features":["sipdump - Dump SIP digest authentications to a file.","sipcrack - Bruteforce the user password using the dump file"]},{"name":"sucrack","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/sucrack/#sucrack-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sucrack","version":"1.2.3-8","arch":"any","homepage":"https://labs.portcullis.co.uk/tools/sucrack/","repo":"https://salsa.debian.org/pkg-security-team/sucrack","summary":"Multithreaded su bruteforcer","desc":"sucrack is a multithreaded Linux/UNIX tool for cracking local user accounts via wordlist bruteforcing su. This tool comes in handy when you've gained access to a low-privilege user account but are allowed to su to other users. Many su implementations require a pseudo terminal to be attached in order to take the password from the user. This can't be easily achieved with a simple shell script. This tool, written in C, is highly efficient and can attempt multiple logins at the same time.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"truecrack","cat":"credential-access","sub":"Password Cracking","url":"https://www.kali.org/tools/truecrack/#truecrack-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"truecrack","version":"3.6+git20150326-0kali6","arch":"any","homepage":"https://github.com/lvaccaro/truecrack","repo":"https://gitlab.com/kalilinux/packages/truecrack","summary":"Bruteforce password cracker for TrueCrypt volumes","desc":"TrueCrack is a bruteforce password cracker for TrueCrypt (Copyright) volume. It is optimazed with Nvidia Cuda technology. It works with PBKDF2 (defined in PKCS5 v2.0) based on RIPEMD160 Key derivation function and XTS block cipher mode of operation used for hard disk encryption based on AES.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"gitxray","cat":"credential-access","sub":"Unsecured Credentials","url":"https://www.kali.org/tools/gitxray/#gitxray-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"gitxray","version":"1.0.20-0kali1","arch":"all","homepage":"https://kulkansecurity.github.io/gitxray/","repo":"https://gitlab.com/kalilinux/packages/gitxray","summary":"Scan GitHub repositories and contributors to collect data","desc":"Gitxray (short for Git X-Ray) is a multifaceted security tool designed for use on GitHub repositories. It can serve many purposes, including OSINT and Forensics. gitxray leverages public GitHub REST APIs to gather information that would otherwise be very time-consuming to obtain manually. Additionally, it seeks out information in unconventional places.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"trufflehog","cat":"credential-access","sub":"Unsecured Credentials","url":"https://www.kali.org/tools/trufflehog/#trufflehog-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"trufflehog","version":"3.94.3-0kali1","arch":"amd64 arm64","homepage":"https://github.com/trufflesecurity/truffleHog","repo":"https://gitlab.com/kalilinux/packages/trufflehog","summary":"Searches through git repositories for secrets","desc":"This package contains a utitlity to search through git repositories for secrets, digging deep into commit history and branches. This is effective at finding secrets accidentally committed.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"aircrack-ng","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/aircrack-ng/#aircrack-ng-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"aircrack-ng","version":"1:1.7+git20230807.4bf83f1a-3","arch":"any all","homepage":"https://www.aircrack-ng.org/","repo":"https://salsa.debian.org/pkg-security-team/aircrack-ng","summary":"Wireless WEP/WPA cracking utilities","desc":"aircrack-ng is an 802.11a/b/g WEP/WPA cracking program that can recover a 40-bit, 104-bit, 256-bit or 512-bit WEP key once enough encrypted packets have been gathered. Also it can attack WPA1/2 networks with some advanced methods or simply by brute force. It implements the standard FMS attack along with some optimizations, thus making the attack much faster compared to other WEP cracking tools. It can also fully use a multiprocessor system to its full power in order to speed up the cracking process. aircrack-ng is a fork of aircrack, as that project has been stopped by the upstream maintainer.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"airgeddon","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/airgeddon/#airgeddon-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"airgeddon","version":"12.02-0kali1","arch":"any","homepage":"https://github.com/v1s1t0r1sh3r3/airgeddon","repo":"https://gitlab.com/kalilinux/packages/airgeddon","summary":"Multi-use bash script for Linux systems to audit wireless networks","desc":"airgeddon is a menu driven 3rd party tools wrapper to audit wireless networks with many features.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"bully","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/bully/#bully-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"bully","version":"1.4.00-2","arch":"any","homepage":"https://github.com/kimocoder/bully","repo":"https://salsa.debian.org/pkg-security-team/bully","summary":"Implementation of the WPS brute force attack, written in C","desc":"Bully is a new implementation of the WPS brute force attack, written in C. It is conceptually identical to other programs, in that it exploits the (now well known) design flaw in the WPS specification. It has several advantages over the original reaver code. These include fewer dependencies, improved memory and cpu performance, correct handling of endianness, and a more robust set of options.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"cowpatty","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/cowpatty/#cowpatty-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cowpatty","version":"4.8-4","arch":"any","homepage":"https://www.willhackforsushi.com/?page_id=50","repo":"https://salsa.debian.org/pkg-security-team/cowpatty","summary":"Brute-force WPA dictionary attack","desc":"If you are auditing WPA-PSK or WPA2-PSK networks, you can use this tool to identify weak passphrases that were used to generate the PMK. Supply a libpcap capture file that includes the 4-way handshake, a dictionary file of passphrases to guess with, and the SSID for the network.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"eapmd5pass","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/eapmd5pass/#eapmd5pass-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"eapmd5pass","version":"1.5-0kali1","arch":"any","homepage":"https://www.willhackforsushi.com/?page_id=67","repo":"https://gitlab.com/kalilinux/packages/eapmd5pass","summary":"Tool for extracting and cracking EAP-MD5","desc":"EAP-MD5 is a legacy authentication mechanism that does not provide sufficient protection for user authentication credentials. Users who authenticate using EAP-MD5 subject themselves to an offline dictionary attack vulnerability. This tool reads from a live network interface in monitor-mode, or from a stored libpcap capture file, and extracts the portions of the EAP-MD5 authentication exchange. Once the challenge and response portions have been collected from this exchange, eapmd5pass will mount an offline dictionary attack against the user's password.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"fern-wifi-cracker","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/fern-wifi-cracker/#fern-wifi-cracker-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"fern-wifi-cracker","version":"3.6-0kali1","arch":"all","homepage":"https://github.com/savio-code/fern-wifi-cracker","repo":"https://gitlab.com/kalilinux/packages/fern-wifi-cracker","summary":"Automated Wi-Fi cracker","desc":"This package contains a Wireless security auditing and attack software program written using the Python Programming Language and the Python Qt GUI library, the program is able to crack and recover WEP/WPA/WPS keys and also run other network based attacks on wireless or ethernet based networks.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"freeradius","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/freeradius/#freeradius-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"freeradius","version":"3.2.10+dfsg-2","arch":"any all","homepage":"http://www.freeradius.org/","repo":"https://salsa.debian.org/debian/freeradius","summary":"High-performance and highly configurable RADIUS server","desc":"FreeRADIUS is a high-performance RADIUS server with support for: and lots more.","features":["Authentication by local files, SQL, Kerberos, LDAP, PAM, and more.","Powerful policy configuration language.","Proxying and replicating requests by any criteria.","Support for many EAP types; TLS, PEAP, TTLS, etc.","Many vendor-specific attributes.","Regexp matching in string attributes."]},{"name":"pixiewps","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/pixiewps/#pixiewps-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"pixiewps","version":"1.4.2-5","arch":"any","homepage":"https://github.com/wiire/pixiewps","repo":"https://salsa.debian.org/pkg-security-team/pixiewps","summary":"Offline WPS bruteforce tool","desc":"Pixiewps is a tool written in C used to bruteforce offline the WPS pin exploiting the low or non-existing entropy of some APs (pixie dust attack). It is meant for educational purposes only.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"reaver","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/reaver/#reaver-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"reaver","version":"1.6.6-2","arch":"any","homepage":"https://github.com/t6x/reaver-wps-fork-t6x","repo":"https://salsa.debian.org/pkg-security-team/reaver","summary":"Brute force attack tool against Wi-Fi Protected Setup PIN number","desc":"Reaver performs a brute force attack against an access point's Wi-Fi Protected Setup pin number. Once the WPS pin is found, the WPA PSK can be recovered and alternately the AP's wireless settings can be reconfigured. This package also provides the Wash executable, an utility for identifying WPS enabled access points. See documentation in /usr/share/doc/reaver/README.WASH.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"wifi-honey","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/wifi-honey/#wifi-honey-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"wifi-honey","version":"1.0-1kali3","arch":"all","homepage":"https://www.digininja.org/projects/wifi_honey.php","repo":"https://gitlab.com/kalilinux/packages/wifi-honey","summary":"Wi-Fi honeypot","desc":"In the case of WPA/WPA2, by running airodump-ng along side this you also end up capturing the first two packets of the four way handshake and so can attempt to crack the key with either aircrack-ng or coWPAtty. What this script does is to automate the setup process, it creates five monitor mode interfaces, four are used as APs and the fifth is used for airodump-ng. To make things easier, rather than having five windows all this is done in a screen session which allows you to switch between screens to see what is going on. All sessions are labelled so you know which is which.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"wifiphisher","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/wifiphisher/#wifiphisher-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"wifiphisher","version":"1.4+git20260522-0kali1","arch":"all","homepage":"https://github.com/sophron/wifiphisher","repo":"https://gitlab.com/kalilinux/packages/wifiphisher","summary":"Automated phishing attacks against Wi-Fi networks","desc":"This package contains a security tool that mounts automated phishing attacks against Wi-Fi networks in order to obtain secret passphrases or other credentials. It is a social engineering attack that unlike other methods it does not include any brute forcing. It is an easy way for obtaining credentials from captive portals and third party login pages or WPA/WPA2 secret passphrases.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"wifite","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/wifite/#wifite-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"wifite","version":"2.8.2-1","arch":"all","homepage":"https://github.com/kimocoder/wifite2","repo":"https://salsa.debian.org/pkg-security-team/wifite","summary":"Python script to automate wireless auditing using aircrack-ng tools","desc":"Wifite is a tool to audit WEP or WPA encrypted wireless networks. It uses aircrack-ng, pyrit, reaver, tshark tools to perform the audit. This tool is customizable to be automated with only a few arguments and can be trusted to run without supervision.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"xspy","cat":"credential-access","sub":"WiFi Credential Access","url":"https://www.kali.org/tools/xspy/#xspy-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"xspy","version":"1.1-1kali5","arch":"any","homepage":"https://www.kali.org","repo":"https://gitlab.com/kalilinux/packages/xspy","summary":"X server sniffer","desc":"Sniffs keystrokes on remote or local X-Windows servers.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"svcrack","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/sipvicious/#svcrack","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipvicious","version":"0.3.3-2.1","arch":"all","homepage":"https://github.com/EnableSecurity/sipvicious","repo":"https://salsa.debian.org/debian/sipvicious","summary":"Tools to audit SIP based VoIP systems","desc":"SIPVicious suite is a set of tools that can be used to audit SIP based VoIP systems. This suite has five tools: svmap, svwar, svcrack, svreport, svcrash. svmap is a sip scanner. When launched against ranges of ip address space, it will identify any SIP servers which it finds on the way. svwar identifies working extension lines on a PBX. Also tells you if extension line requires authentication or not. svcrack is a password cracker making use of digest authentication. It is able to crack passwords on both registrar servers and proxy servers. svreport is able to manage sessions created by the rest of the tools and export to pdf, xml, csv and plain text. svcrash responds to svwar and svcrack SIP messages with a message that causes old versions to crash.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"enumiax","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/enumiax/#enumiax-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"enumiax","version":"0.4a-1kali4","arch":"any","homepage":"https://enumiax.sourceforge.net/","repo":"https://gitlab.com/kalilinux/packages/enumiax","summary":"IAX protocol username enumerator","desc":"enumIAX is an Inter Asterisk Exchange protocol username brute-force enumerator. enumIAX may operate in two distinct modes; Sequential Username Guessing or Dictionary Attack.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"mfcuk","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/mfcuk/#mfcuk-1","cats":["credential-access"],"status":"يتطلب عتادًا","equiv":"","slug":"mfcuk","version":"0.3.8+git20180720-2","arch":"any","homepage":"https://github.com/nfc-tools/mfcuk","repo":"https://salsa.debian.org/pkg-security-team/mfcuk","summary":"MiFare Classic Universal toolKit","desc":"Toolkit containing samples and various tools based on and around libnfc and crapto1, with emphasis on Mifare Classic NXP/Philips RFID cards. Special emphasis of the toolkit is on the following: 1) mifare classic weakness demonstration/exploitation 2) demonstrate use of libnfc (and ACR122 readers) 3) demonstrate use of Crapto1 implementation to confirm internal workings and to verify theoretical/practical weaknesses/attacks.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"mfoc","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/mfoc/#mfoc-1","cats":["credential-access"],"status":"يتطلب عتادًا","equiv":"","slug":"mfoc","version":"0.10.7+git20180724-2","arch":"any","homepage":"https://github.com/nfc-tools/mfoc","repo":"https://salsa.debian.org/pkg-security-team/mfoc","summary":"MIFARE Classic offline cracker","desc":"MFOC is an open source implementation of \"offline nested\" attack by Nethemba. This program allow one to recover authentication keys from MIFARE Classic card. Please note that MFOC is able to recover keys from target only if it have a known key: default one (hardcoded in MFOC) or custom one (user provided using command line).","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"mfterm","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/mfterm/#mfterm-1","cats":["credential-access"],"status":"يتطلب عتادًا","equiv":"","slug":"mfterm","version":"1.0.7+git20190127-0kali3","arch":"any","homepage":"https://github.com/4ZM/mfterm","repo":"https://gitlab.com/kalilinux/packages/mfterm","summary":"Terminal for working with Mifare Classic 1-4k Tags","desc":"mfterm is a terminal interface for working with Mifare Classic tags. Tab completion on commands is available. Also, commands that have file name arguments provide tab completion on files. There is also a command history, like in most normal shells.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"mifare-classic-format","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/libfreefare/#mifare-classic-format","cats":["credential-access"],"status":"يتطلب عتادًا","equiv":"","slug":"libfreefare","version":"0.4.0-2.3","arch":"any all","homepage":"https://code.google.com/p/libfreefare/","repo":"http://anonscm.debian.org/gitweb/?p=collab-maint/libfreefare.git;a=summary","summary":"MIFARE card manipulations binaries","desc":"The libfreefare project aims to provide a convenient API for MIFARE card manipulations. This package includes some binaries that are useful for development purposes.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"nfc-list","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/libnfc/#nfc-list","cats":["credential-access"],"status":"يتطلب عتادًا","equiv":"","slug":"libnfc","version":"1.8.0-3.1","arch":"any","homepage":"http://www.nfc-tools.org/","repo":"https://salsa.debian.org/debian/libnfc","summary":"List NFC targets","desc":"List NFC targets","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"nfc-mfclassic","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/libnfc/#nfc-mfclassic","cats":["credential-access"],"status":"يتطلب عتادًا","equiv":"","slug":"libnfc","version":"1.8.0-3.1","arch":"any","homepage":"http://www.nfc-tools.org/","repo":"https://salsa.debian.org/debian/libnfc","summary":"MIFARE Classic command line tool","desc":"MIFARE Classic command line tool","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"kerberoast","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/kerberoast/#kerberoast-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"kerberoast","version":"0.0~git20221231.cc5aa6e-0kali1","arch":"all","homepage":"https://github.com/nidem/kerberoast","repo":"https://gitlab.com/kalilinux/packages/kerberoast","summary":"Tools for attacking MS Kerberos implementations","desc":"This package contains a series of tools for attacking MS Kerberos implementations:","features":["extract all accounts in use as SPN using built in MS tools","extract the acquired tickets from ram with Mimikatz","crack with tgsrepcrack","request Ticket(s)"]},{"name":"krbrelayx","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/krbrelayx/#krbrelayx-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"krbrelayx","version":"0.0~git20260311.10b45a3-0kali1","arch":"all","homepage":"https://github.com/dirkjanm/krbrelayx","repo":"https://gitlab.com/kalilinux/packages/krbrelayx","summary":"Kerberos relaying and unconstrained delegation abuse toolkit","desc":"Kerberos relaying and unconstrained delegation abuse toolkit. This tool can add/remove/modify Service Principal Names on accounts in AD over LDAP.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"responder","cat":"credential-access","sub":"VoIP Credential Access","url":"https://www.kali.org/tools/responder/#responder-1","cats":["credential-access"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"responder","version":"3.2.2.0-0kali2","arch":"all","homepage":"https://github.com/lgandx/Responder","repo":"https://gitlab.com/kalilinux/packages/responder","summary":"LLMNR/NBT-NS/mDNS Poisoner","desc":"This package contains Responder/MultiRelay, an LLMNR, NBT-NS and MDNS poisoner. It will answer to specific NBT-NS (NetBIOS Name Service) queries based on their name suffix (see: http://support.microsoft.com/kb/163409). By default, the tool will only answer to File Server Service request, which is for SMB. The concept behind this is to target your answers, and be stealthier on the network. This also helps to ensure that you don't break legitimate NBT-NS behavior. You can set the -r option via command line if you want to answer to the Workstation Service request name suffix.","features":["تدقيق قوة بيانات الاعتماد","تحليل سياسات الحسابات","بدون كسر كلمات مرور"]},{"name":"masscan","cat":"discovery","sub":"Network Service Discovery","url":"https://www.kali.org/tools/masscan/#masscan-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"فحص المنافذ والخدمات في Captive Portal Auditor","slug":"masscan","version":"2:1.3.2+ds1-2","arch":"any","homepage":"https://github.com/robertdavidgraham/masscan","repo":"https://salsa.debian.org/pkg-security-team/masscan","summary":"TCP port scanner","desc":"MASSCAN is TCP port scanner which transmits SYN packets asynchronously and produces results similar to nmap, the most famous port scanner. Internally, it operates more like scanrand, unicornscan, and ZMap, using asynchronous transmission. It's a flexible utility that allows arbitrary address and port ranges.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sctpscan","cat":"discovery","sub":"Network Service Discovery","url":"https://www.kali.org/tools/sctpscan/#sctpscan-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sctpscan","version":"0.1-1kali5","arch":"any","homepage":"https://github.com/philpraxis/sctpscan","repo":"https://gitlab.com/kalilinux/packages/sctpscan","summary":"SCTP network scanner for discovery and security","desc":"SCTP network scanner for discovery and security","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"ike-scan","cat":"discovery","sub":"Network Service Discovery","url":"https://www.kali.org/tools/ike-scan/#ike-scan-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ike-scan","version":"1.9.5-2","arch":"any","homepage":"https://github.com/royhills/ike-scan","repo":"https://salsa.debian.org/pkg-security-team/ike-scan","summary":"Discover and fingerprint IKE hosts (IPsec VPN Servers)","desc":"ike-scan discovers IKE hosts and can also fingerprint them using the retransmission backoff pattern. ike-scan does two things: a) Discovery: Determine which hosts are running IKE. This is done by displaying those hosts which respond to the IKE requests sent by ike-scan. b) Fingerprinting: Determine which IKE implementation the hosts are using. This is done by recording the times of the IKE response packets from the target hosts and comparing the observed retransmission backoff pattern against known patterns. The retransmission backoff fingerprinting concept is discussed in more detail in the UDP backoff fingerprinting paper which should be included in the ike-scan kit as udp-backoff-fingerprinting-paper.txt.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sslscan","cat":"discovery","sub":"SSL / TLS","url":"https://www.kali.org/tools/sslscan/#sslscan-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"فحص TLS والشهادات في Captive Portal Auditor","slug":"sslscan","version":"2.1.5-1","arch":"any","homepage":"https://github.com/rbsec/sslscan","repo":"https://salsa.debian.org/debian/sslscan","summary":"Tests SSL/TLS enabled services to discover supported cipher suites","desc":"This tool allow queries SSL/TLS services (such as HTTPS) and reports the protocol versions, cipher suites, key exchanges, signature algorithms, and certificates in use. This helps the user understand which parameters are weak from a security standpoint. sslscan can also output results into an XML file for easy consumption by external programs.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sslyze","cat":"discovery","sub":"SSL / TLS","url":"https://www.kali.org/tools/sslyze/#sslyze-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"فحص TLS والشهادات في Captive Portal Auditor","slug":"sslyze","version":"6.3.1-0kali4","arch":"all","homepage":"https://github.com/nabla-c0d3/sslyze","repo":"https://gitlab.com/kalilinux/packages/sslyze","summary":"Fast and full-featured SSL scanner","desc":"SSLyze is a Python tool that can analyze the SSL configuration of a server by connecting to it. It is designed to be fast and comprehensive, and should help organizations and testers identify misconfigurations affecting their SSL servers.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"tlssled","cat":"discovery","sub":"SSL / TLS","url":"https://www.kali.org/tools/tlssled/#tlssled-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"tlssled","version":"1.3-0kali2","arch":"all","homepage":"http://www.taddong.com/en/lab.html","repo":"https://gitlab.com/kalilinux/packages/tlssled","summary":"Evaluates the security of a target SSL/TLS (HTTPS) server","desc":"TLSSLed is a Linux shell script whose purpose is to evaluate the security of a target SSL/TLS (HTTPS) web server implementation. It is based on sslscan, a thorough SSL/TLS scanner that is based on the openssl library, and on the \"openssl s_client\" command line tool. The current tests include checking if the target supports the SSLv2 protocol, the NULL cipher, weak ciphers based on their key length (40 or 56 bits), the availability of strong ciphers (like AES), if the digital certificate is MD5 signed, and the current SSL/TLS renegotiation capabilities.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"snmp-check","cat":"discovery","sub":"SSL / TLS","url":"https://www.kali.org/tools/snmpcheck/#snmp-check","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"snmpcheck","version":"1.9-0kali2","arch":"all","homepage":"http://www.nothink.org/codes/snmpcheck/index.php","repo":"https://gitlab.com/kalilinux/packages/snmpcheck","summary":"SNMP service enumeration tool","desc":"Like to snmpwalk, snmpcheck allows you to enumerate the SNMP devices and places the output in a very human readable friendly format. It could be useful for penetration testing or systems monitoring.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"braa","cat":"discovery","sub":"SSL / TLS","url":"https://www.kali.org/tools/braa/#braa-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"braa","version":"0.90.1-1","arch":"any","homepage":"https://github.com/mteg/braa","repo":"https://salsa.debian.org/pkg-security-team/braa","summary":"Mass SNMP scanner","desc":"Braa is a mass snmp scanner. The intended usage of such a tool is of course making SNMP queries - but unlike snmpget or snmpwalk from net-snmp, it is able to query dozens or hundreds of hosts simultaneously, and in a single process. Thus, it consumes very few system resources and does the scanning VERY fast. Braa implements its OWN snmp stack, so it does NOT need any SNMP libraries like net-snmp. The implementation is very dirty, supports only several data types, and in any case cannot be stated 'standard-conforming'! It was designed to be fast, and it is fast. For this reason (well, and also because of author laziness ;), there is no ASN.1 parser in braa - the user HAVE to know the numerical values of OID's (for instance .1.3.6.1.2.1.1.5.0 instead of system.sysName.0).","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"onesixtyone","cat":"discovery","sub":"SSL / TLS","url":"https://www.kali.org/tools/onesixtyone/#onesixtyone-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"onesixtyone","version":"0.3.4-1","arch":"any","homepage":"https://github.com/trailofbits/onesixtyone","repo":"https://salsa.debian.org/pkg-security-team/onesixtyone","summary":"Fast and simple SNMP scanner","desc":"onesixtyone is a simple SNMP scanner which sends SNMP requests for the sysDescr value asynchronously with user-adjustable sending times and then logs the responses which gives the description of the software running on the device. Running onesixtyone on a class B network (switched 100Mbs with 1Gbs backbone) with -w 10 gives a performance of 3 seconds per class C, with no dropped packets, and all 65536 IP addresses were scanned in less than 13 minutes.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"above","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/above/#above-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"above","version":"2.8.1-0kali2","arch":"all","homepage":"https://github.com/caster0x00/Above","repo":"https://gitlab.com/kalilinux/packages/above","summary":"Network security sniffer for finding vulnerabilities in the network","desc":"This package contains a network security sniffer for finding vulnerabilities in the network, designed for pentesters and security professionals. It is based entirely on network traffic analysis, so it does not make any noise on the air. Above allows pentesters to automate the process of finding vulnerabilities in network hardware. Discovery protocols, dynamic routing, FHRP, STP, LLMNR/NBT-NS, etc. The tool can also both listen to traffic on the interface and analyze already existing pcap files.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"arpspoof","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/dsniff/#arpspoof","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dsniff","version":"2.5a2-1","arch":"any","homepage":"https://github.com/hackerschoice/dsniff","repo":"https://salsa.debian.org/pkg-security-team/dsniff","summary":"Various tools to sniff network traffic for cleartext insecurities","desc":"This package contains several tools to listen to and create network traffic: on the Local Area Network. traffic shaping. (requires libx11-6 installed). Please do not abuse this software.","features":["arpspoof - Send out unrequested (and possibly forged) arp replies.","dnsspoof - forge replies to arbitrary DNS address / pointer queries","dsniff - password sniffer for several protocols.","filesnarf - saves selected files sniffed from NFS traffic.","macof - flood the local network with random MAC addresses.","mailsnarf - sniffs mail on the LAN and stores it in mbox format.","msgsnarf - record selected messages from different Instant Messengers.","sshmitm - SSH monkey-in-the-middle. proxies and sniffs SSH traffic.","sshow - SSH traffic analyser.","tcpkill - kills specified in-progress TCP connections."]},{"name":"darkstat","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/darkstat/#darkstat-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"darkstat","version":"3.0.722-1","arch":"any","homepage":"https://unix4lyfe.org/darkstat/","repo":"https://salsa.debian.org/salvage-team/darkstat","summary":"Network traffic analyzer","desc":"It is a packet sniffer which runs as a background process and serves its statistics to a web browser: It is known to be smaller (in terms of memory footprint) and stabler than ntop.","features":["input and output IP traffic by machines, ports and protocols,","last minute, hourly, daily and monthly global input and output graphics."]},{"name":"dnschef","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/dnschef/#dnschef-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dnschef","version":"0.4+git20190327-0kali4","arch":"all","homepage":"https://github.com/iphelix/dnschef","repo":"https://gitlab.com/kalilinux/packages/dnschef","summary":"DNS proxy for penetration testers","desc":"DNSChef is a highly configurable DNS proxy for Penetration Testers and Malware Analysts. A DNS proxy (aka \"Fake DNS\") is a tool used for application network traffic analysis among other uses. For example, a DNS proxy can be used to fake requests for \"badguy.com\" to point to a local machine for termination or interception instead of a real host somewhere on the Internet.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"driftnet","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/driftnet/#driftnet-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"driftnet","version":"1.5.0-0.3","arch":"any","homepage":"https://github.com/deiv/driftnet","repo":"https://github.com/deiv/driftnet","summary":"Picks out and displays images from network traffic","desc":"Inspired by EtherPEG, Driftnet is a program which listens to network traffic and picks out images from TCP streams it observes. It is interesting to run it on a host which sees a lot of web traffic. (Obviously, this is an invasion of privacy of a fairly blatant sort. Also, if you are possessed of Victorian sensibilities, and share an unswitched network with others who are not, you should probably not use it.)","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"dsniff","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/dsniff/#dsniff-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dsniff","version":"2.5a2-1","arch":"any","homepage":"https://github.com/hackerschoice/dsniff","repo":"https://salsa.debian.org/pkg-security-team/dsniff","summary":"Various tools to sniff network traffic for cleartext insecurities","desc":"This package contains several tools to listen to and create network traffic: on the Local Area Network. traffic shaping. (requires libx11-6 installed). Please do not abuse this software.","features":["arpspoof - Send out unrequested (and possibly forged) arp replies.","dnsspoof - forge replies to arbitrary DNS address / pointer queries","dsniff - password sniffer for several protocols.","filesnarf - saves selected files sniffed from NFS traffic.","macof - flood the local network with random MAC addresses.","mailsnarf - sniffs mail on the LAN and stores it in mbox format.","msgsnarf - record selected messages from different Instant Messengers.","sshmitm - SSH monkey-in-the-middle. proxies and sniffs SSH traffic.","sshow - SSH traffic analyser.","tcpkill - kills specified in-progress TCP connections."]},{"name":"hexinject","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/hexinject/#hexinject-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"hexinject","version":"1.6-0kali3","arch":"any","homepage":"https://hexinject.sourceforge.net/","repo":"https://gitlab.com/kalilinux/packages/hexinject","summary":"Versatile packet injector and sniffer","desc":"HexInject is a very versatile packet injector and sniffer, that provide a command-line framework for raw network access. It's designed to work together with others command-line utilities, and for this reason it facilitates the creation of powerful shell scripts capable of reading, intercepting and modifying network traffic in a transparent manner.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"netsniff-ng","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/netsniff-ng/#netsniff-ng-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"netsniff-ng","version":"0.6.9-2","arch":"any","homepage":"http://netsniff-ng.org/","repo":"https://salsa.debian.org/debian/netsniff-ng","summary":"Linux network packet sniffer toolkit","desc":"netsniff-ng is a high performance Linux network sniffer for packet inspection. It can be used for protocol analysis, reverse engineering or network debugging. The gain of performance is reached by 'zero-copy' mechanisms, so that the kernel does not need to copy packets from kernelspace to userspace. netsniff-ng toolkit currently consists of the following utilities:","features":["netsniff-ng: a zero-copy packet analyzer, pcap capturing/replaying tool","trafgen: a multithreaded low-level zero-copy network packet generator","mausezahn: high-level packet generator for appliances with Cisco-CLI","ifpps: a top-like kernel networking and system statistics tool","curvetun: a lightweight curve25519-based multiuser IP tunnel","astraceroute: an autonomous system trace route and DPI testing utility","flowtop: a top-like netfilter connection tracking tool","bpfc: a [seccomp-]BPF (Berkeley packet filter) compiler, JIT disassembler"]},{"name":"wireshark","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/wireshark/#wireshark-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"فحص الرؤوس وحركة HTTPS المصرّح بها في Captive Portal Auditor","slug":"wireshark","version":"4.6.6-1","arch":"any all","homepage":"https://www.wireshark.org/","repo":"https://salsa.debian.org/debian/wireshark","summary":"Network traffic analyzer - graphical interface","desc":"Wireshark is a network \"sniffer\" - a tool that captures and analyzes packets off the wire. Wireshark can decode too many protocols to list here.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"scapy","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/scapy/#scapy","cats":["discovery","impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"scapy","version":"2.7.0+dfsg1-1","arch":"all","homepage":"https://scapy.net/","repo":"https://salsa.debian.org/pkg-security-team/scapy","summary":"Interactive packet manipulation tool","desc":"Interactive packet manipulation tool","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"tcpdump","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/tcpdump/#tcpdump-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"مراجعة اتصالات البوابة في Captive Portal Auditor","slug":"tcpdump","version":"4.99.6-2","arch":"any","homepage":"https://www.tcpdump.org/","repo":"https://salsa.debian.org/debian/tcpdump","summary":"Command-line network traffic analyzer","desc":"This program allows you to dump the traffic on a network. tcpdump is able to examine IPv4, ICMPv4, IPv6, ICMPv6, UDP, TCP, SNMP, AFS BGP, RIP, PIM, DVMRP, IGMP, SMB, OSPF, NFS and many other packet types. It can be used to print out the headers of packets on a network interface, filter packets that match a certain expression. You can use this tool to track down network problems, to detect attacks or to monitor network activities.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"tcpflow","cat":"discovery","sub":"Network Sniffing","url":"https://www.kali.org/tools/tcpflow/#tcpflow-3","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"tcpflow","version":"1.6.1-3","arch":"any","homepage":"https://github.com/simsong/tcpflow","repo":"https://salsa.debian.org/debian/tcpflow","summary":"TCP flow recorder","desc":"tcpflow is a program that captures data transmitted as part of TCP connections (flows), and stores the data in a way that is convenient for protocol analysis or debugging. A program like 'tcpdump' shows a summary of packets seen on the wire, but usually doesn't store the data that's actually being transmitted. In contrast, tcpflow reconstructs the actual data streams and stores each flow in a separate file for later analysis. tcpflow understands sequence numbers and will correctly reconstruct data streams regardless of retransmissions or out-of-order delivery. However, it currently does not understand IP fragments; flows containing IP fragments will not be recorded properly. tcpflow is based on the LBL Packet Capture Library and therefore supports the same rich filtering expressions that programs like 'tcpdump' support. tcpflow can also rebuild flows from data captured with 'tcpdump -w'.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"arping","cat":"discovery","sub":"Remote System Discovery","url":"https://www.kali.org/tools/arping/#arping-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"arping","version":"2.29-1","arch":"any","homepage":"https://www.habets.pp.se/synscan/programs.php?prog=arping","repo":"https://salsa.debian.org/debian/arping","summary":"Sends IP and/or ARP pings (to the MAC address)","desc":"The arping utility sends ARP and/or ICMP requests to the specified host and displays the replies. The host may be specified by its hostname, its IP address, or its MAC address.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"arpwatch","cat":"discovery","sub":"Remote System Discovery","url":"https://www.kali.org/tools/arpwatch/#arpwatch-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"arpwatch","version":"2.1a15-11","arch":"any","homepage":"https://ee.lbl.gov/","repo":"https://salsa.debian.org/pkg-security-team/arpwatch","summary":"Ethernet/FDDI station activity monitor","desc":"Arpwatch maintains a database of Ethernet MAC addresses seen on the network, with their associated IP pairs. Alerts the system administrator via e-mail if any change happens, such as new station/activity, flip-flops, changed and re-used old addresses. If you want to maintain a list authorized MAC addresses manually, take a look at the arpalert package which may fit your needs better.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"atk6-thcping6","cat":"discovery","sub":"Remote System Discovery","url":"https://www.kali.org/tools/thc-ipv6/#atk6-thcping6","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"thc-ipv6","version":"3.8-2","arch":"linux-any","homepage":"http://www.thc.org/thc-ipv6/","repo":"https://salsa.debian.org/pkg-security-team/thc-ipv6","summary":"The Hacker Choice's IPv6 Attack Toolkit","desc":"Attack toolkit for testing IPv6 and ICMPv6 protocol weaknesses. Some of the tools included: alive6: an effective alive scanning. denial6: try a collection of denial-of-service tests against a target. detect-new-ip6: detect new ip6 devices which join the network. dnsdict6: parallelized dns ipv6 dictionary bruteforcer. dos-new-ip6: detect new ip6 devices and tell them that their chosen IP collides on the network (DOS). exploit6: test known ipv6 vulnerabilities against a target. fake_mld6: announce yourself in a multicast group of your choice on the net. fake_router6: announce yourself as a router on the network. flood_advertise6: flood a target with random neighbor advertisements. flood_router6: flood a target with random router advertisements. implementation6: performs various implementation checks on ipv6. parasite6: icmp neighbor solitication/advertisement spoofer. redir6: redirect traffic to you intelligently (man-in-the-middle) with a clever icmp6 redirect spoofer. rsmurf6: remote smurfer (known to work only against Linux at the moment). thcping6: sends a hand crafted ping6 packet. toobig6: mtu decreaser with the same intelligence as redir6.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"fierce","cat":"discovery","sub":"Remote System Discovery","url":"https://www.kali.org/tools/fierce/#fierce-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"fierce","version":"1.6.0-2","arch":"all","homepage":"https://github.com/mschwager/fierce","repo":"https://salsa.debian.org/pkg-security-team/fierce","summary":"Domain DNS scanner","desc":"Fierce is a semi-lightweight scanner that helps locate non-contiguous IP space and hostnames against specified domains. It's really meant as a pre-cursor to nmap, unicornscan, nessus, nikto, etc, since all of those require that you already know what IP space you are looking for. This does not perform exploitation and does not scan the whole internet indiscriminately. It is meant specifically to locate likely targets both inside and outside a corporate network. Because it uses DNS primarily you will often find mis-configured networks that leak internal address space. That's especially useful in targeted malware. Originally written by RSnake along with others at http://ha.ckers.org/. This is simply a conversion to Python 3 to simplify and modernize the codebase.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"fping","cat":"discovery","sub":"Remote System Discovery","url":"https://www.kali.org/tools/fping/#fping-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"fping","version":"5.1-1","arch":"any","homepage":"https://www.fping.org/","repo":"https://salsa.debian.org/debian/fping","summary":"Sends ICMP ECHO_REQUEST packets to network hosts","desc":"fping is a ping like program which uses the Internet Control Message Protocol (ICMP) echo request to determine if a target host is responding. fping differs from ping in that you can specify any number of targets on the command line, or specify a file containing the lists of targets to ping. Instead of sending to one target until it times out or replies, fping will send out a ping packet and move on to the next target in a round-robin fashion.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"hping3","cat":"discovery","sub":"Remote System Discovery","url":"https://www.kali.org/tools/hping3/#hping3-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"hping3","version":"3.a2.ds2-11~kali1","arch":"any","homepage":"http://www.hping.org/","repo":"https://salsa.debian.org/debian/hping3","summary":"Active Network Smashing Tool","desc":"hping3 is a network tool able to send custom ICMP/UDP/TCP packets and to display target replies like ping does with ICMP replies. It handles fragmentation and arbitrary packet body and size, and can be used to transfer files under supported protocols. Using hping3, you can test firewall rules, perform (spoofed) port scanning, test network performance using different protocols, do path MTU discovery, perform traceroute-like actions under different protocols, fingerprint remote operating systems, audit TCP/IP stacks, etc. hping3 is scriptable using the Tcl language.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"p0f","cat":"discovery","sub":"Remote System Discovery","url":"https://www.kali.org/tools/p0f/#p0f-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"p0f","version":"3.09b-4","arch":"any","homepage":"https://lcamtuf.coredump.cx/p0f3/","repo":"https://salsa.debian.org/pkg-security-team/p0f","summary":"Passive OS fingerprinting tool","desc":"p0f performs passive OS detection based on SYN packets. Unlike nmap and queso, p0f does recognition without sending any data. Additionally, it is able to determine the distance to the remote host, and can be used to determine the structure of a foreign or local network. When running on the gateway of a network it is able to gather huge amounts of data and provide useful statistics. On a user-end computer it could be used as powerful IDS add-on. p0f supports full tcpdump-style filtering expressions, and has an extensible and detailed fingerprinting database.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"apache-users","cat":"discovery","sub":"Account Discovery","url":"https://www.kali.org/tools/apache-users/#apache-users-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"apache-users","version":"2.1-1kali6","arch":"any","homepage":"https://labs.portcullis.co.uk/downloads/","repo":"https://gitlab.com/kalilinux/packages/apache-users","summary":"Enumerate usernames on systems with Apache UserDir module","desc":"This Perl script will enumerate the usernames on any system that uses Apache with the UserDir module.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"smtp-user-enum","cat":"discovery","sub":"Account Discovery","url":"https://www.kali.org/tools/smtp-user-enum/#smtp-user-enum-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"smtp-user-enum","version":"1.2-1kali4","arch":"all","homepage":"http://pentestmonkey.net/tools/user-enumeration/smtp-user-enum","repo":"https://gitlab.com/kalilinux/packages/smtp-user-enum","summary":"Username guessing tool for the SMTP service","desc":"Username guessing tool primarily for use against the default Solaris SMTP service. Can use either EXPN, VRFY or RCPT TO.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"enum4linux","cat":"discovery","sub":"Network Share Discovery","url":"https://www.kali.org/tools/enum4linux/#enum4linux-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"enum4linux","version":"0.9.1-0kali2","arch":"all","homepage":"https://labs.portcullis.co.uk/tools/enum4linux/","repo":"https://gitlab.com/kalilinux/packages/enum4linux","summary":"Enumerates info from Windows and Samba systems","desc":"Enum4linux is a tool for enumerating information from Windows and Samba systems. It attempts to offer similar functionality to enum.exe formerly available from www.bindview.com. It is written in PERL and is basically a wrapper around the Samba tools smbclient, rpclient, net and nmblookup. The samba package is therefore a dependency. Features include: RID Cycling (When RestrictAnonymous is set to 1 on Windows 2000) User Listing (When RestrictAnonymous is set to 0 on Windows 2000) Listing of Group Membership Information Share Enumeration Detecting if host is in a Workgroup or a Domain Identifying the remote Operating System Password Policy Retrieval (using polenum)","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"enum4linux-ng","cat":"discovery","sub":"Network Share Discovery","url":"https://www.kali.org/tools/enum4linux-ng/#enum4linux-ng-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"enum4linux-ng","version":"1.3.10-0kali1","arch":"all","homepage":"https://github.com/cddmp/enum4linux-ng","repo":"https://gitlab.com/kalilinux/packages/enum4linux-ng","summary":"Next generation version of enum4linux","desc":"Next generation version of enum4linux (a Windows/Samba enumeration tool) with additional features like JSON/YAML export. Aimed for security professionals and CTF players.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"nbtscan","cat":"discovery","sub":"Network Share Discovery","url":"https://www.kali.org/tools/nbtscan/#nbtscan-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"nbtscan","version":"1.7.2-3","arch":"any","homepage":"https://github.com/resurrecting-open-source-projects/nbtscan","repo":"https://salsa.debian.org/pkg-security-team/nbtscan","summary":"Scan networks searching for NetBIOS information","desc":"NBTscan is a program for scanning IP networks for NetBIOS name information. It sends NetBIOS status query to each address in supplied range and lists received information in human readable form. For each responded host it lists IP address, NetBIOS computer name, logged-in user name and MAC address (such as Ethernet). This program is useful for security checks, network discovery and forensics investigations.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"smbclient","cat":"discovery","sub":"Network Share Discovery","url":"https://www.kali.org/tools/samba/#smbclient-1","cats":["discovery","command-and-control"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"samba","version":"2:4.24.6+dfsg-1","arch":"any all","homepage":"https://www.samba.org","repo":"https://salsa.debian.org/samba-team/samba","summary":"SMB/CIFS file, print, and login server for Unix","desc":"Samba is an implementation of the SMB/CIFS protocol for Unix systems, providing support for cross-platform file and printer sharing with Microsoft Windows, OS X, and other Unix systems. Samba can also function as an Active Directory or NT4-style domain controller, and can integrate with Active Directory realms or NT4 domains as a member server. This package provides the components necessary to use Samba as a stand-alone file and print server or as an NT4 domain controller. For use in an NT4 domain or Active Directory realm, you will also need the winbind package. To use samba as an Active Directory domain controller (AD DC), please install samba-ad-dc package. This package is not required for connecting to existing SMB/CIFS servers (see smbclient) or for mounting remote filesystems (see cifs-utils).","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"pspy","cat":"discovery","sub":"Process Discovery","url":"https://www.kali.org/tools/pspy/#pspy-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"pspy","version":"1.2.1-0kali1","arch":"amd64 i386","homepage":"https://github.com/DominicBreuker/pspy","repo":"https://gitlab.com/kalilinux/packages/pspy","summary":"Monitor Linux processes without root permissions","desc":"pspy is a command line tool designed to snoop on processes without need for root permissions. It allows you to see commands run by other users, cron jobs, etc. as they execute. Great for enumeration of Linux systems in CTFs. Also great to demonstrate your colleagues why passing secrets as arguments on the command line is a bad idea.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"pspy-binaries","cat":"discovery","sub":"Process Discovery","url":"https://www.kali.org/tools/pspy/#pspy-binaries","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"pspy","version":"1.2.1-0kali1","arch":"amd64 i386","homepage":"https://github.com/DominicBreuker/pspy","repo":"https://gitlab.com/kalilinux/packages/pspy","summary":"Monitor Linux processes without root permissions","desc":"pspy is a command line tool designed to snoop on processes without need for root permissions. It allows you to see commands run by other users, cron jobs, etc. as they execute. Great for enumeration of Linux systems in CTFs. Also great to demonstrate your colleagues why passing secrets as arguments on the command line is a bad idea.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"0trace.sh","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/0trace/#0tracesh","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"0trace","version":"0.01-3kali6","arch":"any","homepage":"https://lcamtuf.coredump.cx","repo":"https://gitlab.com/kalilinux/packages/0trace","summary":"Traceroute tool that can run within an existing TCP connection","desc":"The package is traceroute tool that can be run within an existing, open TCP connection, therefore bypassing some types of stateful packet filters with ease.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"ass","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/irpas/#ass","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"irpas","version":"0.10-10","arch":"any","homepage":"https://web.archive.org/web/20200208113522fw_/http://phenoelit.org/fr/tools.html","repo":"https://salsa.debian.org/pkg-security-team/irpas","summary":"Internetwork Routing Protocol Attack Suite","desc":"This package contains a collection of programs used for advanced network operations, testing, and debugging. CDP and the route injectors can be useful in a production network. Several other tools are useful for security and firewall testing. Finally some tools such as netenum are useful for general admin scripting. Like all powerful tools, it could cause great damage, so be careful.","features":["cdp - Cisco discovery protocol packet sender","igrp - IGRP route injector","ass - Autonomous system scanner","irdp - IRDP sender","irdpresponder - IRDP responder","itrace - ICMP based traceroute","tctrace - TCP SYN based traceroute","protos - ICMP based port scanner","netmask - Asks for netmask via ICMP","file2cable - Dumps any binary file direct to ethernet"]},{"name":"cdp","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/irpas/#cdp","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"irpas","version":"0.10-10","arch":"any","homepage":"https://web.archive.org/web/20200208113522fw_/http://phenoelit.org/fr/tools.html","repo":"https://salsa.debian.org/pkg-security-team/irpas","summary":"Internetwork Routing Protocol Attack Suite","desc":"This package contains a collection of programs used for advanced network operations, testing, and debugging. CDP and the route injectors can be useful in a production network. Several other tools are useful for security and firewall testing. Finally some tools such as netenum are useful for general admin scripting. Like all powerful tools, it could cause great damage, so be careful.","features":["cdp - Cisco discovery protocol packet sender","igrp - IGRP route injector","ass - Autonomous system scanner","irdp - IRDP sender","irdpresponder - IRDP responder","itrace - ICMP based traceroute","tctrace - TCP SYN based traceroute","protos - ICMP based port scanner","netmask - Asks for netmask via ICMP","file2cable - Dumps any binary file direct to ethernet"]},{"name":"intrace","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/intrace/#intrace-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"intrace","version":"1.6-0kali2","arch":"any","homepage":"https://github.com/robertswiecki/intrace","repo":"https://gitlab.com/kalilinux/packages/intrace","summary":"Traceroute-like application piggybacking on existing TCP connections","desc":"InTrace is a traceroute-like application that enables users to enumerate IP hops exploiting existing TCP connections, both initiated from local network (local system) or from remote hosts. It could be useful for network reconnaissance and firewall bypassing.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"netdiscover","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/netdiscover/#netdiscover-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"netdiscover","version":"0.21-1","arch":"any","homepage":"https://github.com/netdiscover-scanner/netdiscover","repo":"https://salsa.debian.org/debian/netdiscover","summary":"Active/passive network address scanner using ARP requests","desc":"Netdiscover is an active/passive address reconnaissance tool, mainly developed for those wireless networks without dhcp server, when you are wardriving. It can be also used on hub/switched networks. Built on top of libnet and libpcap, it can passively detect online hosts, or search for them, by actively sending ARP requests. Netdiscover can also be used to inspect your network ARP traffic, or find network addresses using auto scan mode, which will scan for common local networks. Netdiscover uses the OUI table to show the vendor of the each MAC address discovered and is very useful for security checks or in pentests.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"netmask","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/netmask/#netmask-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"netmask","version":"2.5.0-1","arch":"any","homepage":"https://github.com/tlby/netmask","repo":"https://salsa.debian.org/debian/netmask","summary":"Helps determine network masks","desc":"This is a tiny program handy if you work with firewalls or routers occasionally (possibly using this as a helper for shell scripts). It can determine the smallest set of network masks to specify a range of hosts. It can also convert between common IP netmask and address formats.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sara","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/sara/#sara-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sara","version":"1.3.1-0kali1","arch":"all","homepage":"https://github.com/caster0x00/sara","repo":"https://gitlab.com/kalilinux/packages/sara","summary":"RouterOS Security Inspector","desc":"This package contains an autonomous RouterOS configuration analyzer for finding security issues on MikroTik hardware.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"yersinia","cat":"discovery","sub":"System Network Configuration Discovery","url":"https://www.kali.org/tools/yersinia/#yersinia-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"yersinia","version":"0.8.2-2.4","arch":"any","homepage":"https://github.com/tomac/yersinia","repo":"https://salsa.debian.org/debian/yersinia","summary":"Network vulnerabilities check software","desc":"Yersinia is a framework for performing layer 2 attacks. It is designed to take advantage of some weakeness in different network protocols. It pretends to be a solid framework for analyzing and testing the deployed networks and systems. Attacks for the following network protocols are implemented in this particular release:","features":["Spanning Tree Protocol (STP).","Cisco Discovery Protocol (CDP).","Dynamic Trunking Protocol (DTP).","Dynamic Host Configuration Protocol (DHCP).","Hot Standby Router Protocol (HSRP).","802.1q.","802.1x.","Inter-Switch Link Protocol (ISL).","VLAN Trunking Protocol (VTP)."]},{"name":"firewalk","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/firewalk/#firewalk-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"firewalk","version":"5.0-6","arch":"any","homepage":"http://packetfactory.openwall.net/projects/firewalk/","repo":"https://salsa.debian.org/pkg-security-team/firewalk","summary":"Active reconnaissance network security tool","desc":"Firewalk is an active reconnaissance network security tool that attempts to determine what layer 4 protocols a given IP forwarding device will pass. It works by sending out TCP or UDP packets with a TTL one hop greater than the targeted gateway. If the gateway allows the traffic, it will forward the packets to the next hop where they will expire and elicit an ICMP_TIME_EXCEEDED message. Otherwise, it will likely drop the packets and there will be no response. To get the correct IP TTL that will result in packets expiring one hop beyond the gateway, Firewalk needs to ramp up hop counts. It does this in the same manner that traceroute works. Once the scan is bound (that is, Firewalk knows the gateway hop count), it begins the scan. The ultimate destination host does not have to be reached, it only needs to be somewhere downstream, on the other side of the gateway, from the scanning host. Firewalk helps in assessing the security configuration of packet filtering devices, such as those used in firewall systems. It is relevant for network security assessments, like network penetration tests (pentests).","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"tcpreplay","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/tcpreplay/#tcpreplay-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"tcpreplay","version":"4.5.4-1","arch":"any","homepage":"http://tcpreplay.appneta.com/","repo":"https://git.in-ulm.de/cbiedl/tcpreplay","summary":"Tool to replay saved tcpdump files at arbitrary speeds","desc":"Tcpreplay is aimed at testing the performance of a NIDS by replaying real background network traffic in which to hide attacks. Tcpreplay allows you to control the speed at which the traffic is replayed, and can replay arbitrary tcpdump traces. Unlike programmatically-generated artificial traffic which doesn't exercise the application/protocol inspection that a NIDS performs, and doesn't reproduce the real-world anomalies that appear on production networks (asymmetric routes, traffic bursts/lulls, fragmentation, retransmissions, etc.), tcpreplay allows for exact replication of real traffic seen on real networks. It included the following executables tcpprep, tcprewrite, tcpreplay-edit, tcpbridge and pcap based captures are possible.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"wafw00f","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/wafw00f/#wafw00f-1","cats":["discovery"],"status":"استطلاع — مصرّح فقط","equiv":"كشف WAF في Captive Portal Auditor","slug":"wafw00f","version":"2.4.2-1","arch":"all","homepage":"https://github.com/EnableSecurity/wafw00f","repo":"https://salsa.debian.org/pkg-security-team/wafw00f","summary":"Identify and fingerprint Web Application Firewall products","desc":"This package identifies and fingerprints Web Application Firewall (WAF) products using the following logic: number of WAF solutions. HTTP requests and uses simple logic to deduce which WAF it is. returned and uses another simple algorithm to guess if a WAF or security solution is actively responding to the attacks.","features":["Sends a _normal_ HTTP request and analyses the response; this identifies a","If that is not successful, it sends a number of (potentially malicious)","If that is also not successful, it analyses the responses previously"]},{"name":"impacket-mssqlclient","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/impacket-scripts/#impacket-mssqlclient","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"impacket-scripts","version":"1.10","arch":"all","homepage":"","repo":"https://gitlab.com/kalilinux/packages/impacket-scripts","summary":"Links to useful impacket scripts examples","desc":"This package contains links to useful impacket scripts. It's a separate package to keep impacket package from Debian and have the useful scripts in the path for Kali.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"mdb-sql","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/mdbtools/#mdb-sql","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"mdbtools","version":"1.0.1-0.1","arch":"any all","homepage":"https://github.com/mdbtools/mdbtools","repo":"https://salsa.debian.org/debian/mdbtools","summary":"JET / MS Access database (MDB) tools","desc":"These are various tools for manipulating JET / MS Access database (MDB) files: and data, show file versions, and other useful stuff. get results.","features":["utils - provides command line utilities to list tables, export schema,","mdb-sql - a command line SQL tool that allows one to type SQL queries and"]},{"name":"oscanner","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/oscanner/#oscanner-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"oscanner","version":"1.0.6-1kali4","arch":"all","homepage":"http://www.cqure.net/wp/tools/database/oscanner/","repo":"https://gitlab.com/kalilinux/packages/oscanner","summary":"Oracle assessment framework","desc":"Oscanner is an Oracle assessment framework developed in Java. It has a plugin-based architecture and comes with a couple of plugins that currently do: The results are given in a graphical java tree.","features":["Sid Enumeration","Passwords tests (common & dictionary)","Enumerate Oracle version","Enumerate account roles","Enumerate account privileges","Enumerate account hashes","Enumerate audit information","Enumerate password policies","Enumerate database links"]},{"name":"sidguess","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/sidguesser/#sidguess","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sidguesser","version":"1.0.5-1kali4","arch":"any","homepage":"http://www.cqure.net/wp/tools/database/sidguesser/","repo":"https://gitlab.com/kalilinux/packages/sidguesser","summary":"Guesses sids against an Oracle database","desc":"Guesses sids/instances against an Oracle database according to a predefined dictionary file. The speed is slow (80-100 guesses per second) but it does the job.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sqlitebrowser","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/sqlitebrowser/#sqlitebrowser-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sqlitebrowser","version":"3.13.1-1","arch":"any","homepage":"https://sqlitebrowser.org/","repo":"https://salsa.debian.org/sqlitebrowser-team/sqlitebrowser","summary":"GUI editor for SQLite databases","desc":"SQLite Database Browser is a visual tool used to create, design and edit database files compatible with SQLite. Its interface is based on QT, and is meant to be used for users and developers that want to create databases, edit and search data using a familiar spreadsheet-like interface, without the need to learn complicated SQL commands. Controls and wizards are available for users to: SQLite Database Browser is not a visual shell for the sqlite command line tool. It does not require familiarity with SQL commands.","features":["Create and compact database files","Create, define, modify and delete tables","Create, define and delete indexes","Browse, edit, add and delete records","Search records","Import and export records as text","Import and export tables from/to CSV files","Import and export databases from/to SQL dump files","Issue SQL queries and inspect the results","Examine a log of all SQL commands issued by the application"]},{"name":"tnscmd10g","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/tnscmd10g/#tnscmd10g-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"tnscmd10g","version":"1.3-1kali3","arch":"all","homepage":"http://www.red-database-security.com/","repo":"https://gitlab.com/kalilinux/packages/tnscmd10g","summary":"Tool to prod the oracle tnslsnr process","desc":"A tool to prod the oracle tnslsnr process on port 1521/tcp.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"mxcheck","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/mxcheck/#mxcheck-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"mxcheck","version":"2.0.0-0kali1","arch":"any","homepage":"https://github.com/steffenfritz/mxcheck","repo":"https://gitlab.com/kalilinux/packages/mxcheck","summary":"Info and security scanner for e-mail servers","desc":"mxcheck is an info scanner for e-mail servers, checking:","features":["DNS records: A, MX, PTR, SPF, MTA-STS, DKIM, DMARC","AS Number and AS Country","The support of StartTLS and the certificate","Open ports: 25, 465, 587","If the service is listed by blacklists","If it leaks information by server string and VRFY command","If the server is an open relay"]},{"name":"swaks","cat":"discovery","sub":"Network Security Appliances","url":"https://www.kali.org/tools/swaks/#swaks-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"swaks","version":"20240103.0-2","arch":"all","homepage":"https://www.jetmore.org/john/code/swaks/","repo":"https://salsa.debian.org/debian/swaks","summary":"SMTP command-line test tool","desc":"swaks (Swiss Army Knife SMTP) is a command-line tool written in Perl for testing SMTP setups; it supports STARTTLS and SMTP AUTH (PLAIN, LOGIN, CRAM-MD5, SPA, and DIGEST-MD5). swaks allows one to stop the SMTP dialog at any stage, e.g to check RCPT TO: without actually sending a mail. If you are spending too much time iterating \"telnet foo.example 25\" swaks is for you.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"cge.pl","cat":"discovery","sub":"Cisco Tools","url":"https://www.kali.org/tools/cisco-global-exploiter/#cgepl","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cisco-global-exploiter","version":"13-1kali6","arch":"all","homepage":"http://www.blackangels.it","repo":"https://gitlab.com/kalilinux/packages/cisco-global-exploiter","summary":"Simple and fast Cisco exploitation tool","desc":"Cisco Global Exploiter (CGE), is an advanced, simple and fast security testing tool.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"cisco-ocs","cat":"discovery","sub":"Cisco Tools","url":"https://www.kali.org/tools/cisco-ocs/#cisco-ocs-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cisco-ocs","version":"0.2-1kali4","arch":"any","homepage":"http://hacklab.altervista.org/","repo":"https://gitlab.com/kalilinux/packages/cisco-ocs","summary":"Mass Cisco scanner","desc":"A mass Cisco scanning tool.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"cisco-torch","cat":"discovery","sub":"Cisco Tools","url":"https://www.kali.org/tools/cisco-torch/#cisco-torch-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cisco-torch","version":"0.4b-1kali6","arch":"all","homepage":"","repo":"https://gitlab.com/kalilinux/packages/cisco-torch","summary":"Cisco device scanner","desc":"The main feature that makes cisco-torch different from similar tools is the extensive use of forking to launch multiple scanning processes on the background for maximum scanning efficiency. Also, it uses several methods of application layer fingerprinting simultaneoulsy, if needed. We wanted something fast to discover remote Cisco hosts running Telnet, SSH, Web, NTP, TFTP and SNMP services and launch dicitionary attacks against the services discovered, including SNMP community attack (you would like the community.txt list :-) and TFTP servers (configuration file name bruteforcing with following config leeching). The tool can also get device configurationfiles automatically if SNMP RW community is found.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"copy-router-config.pl","cat":"discovery","sub":"Cisco Tools","url":"https://www.kali.org/tools/copy-router-config/#copy-router-configpl","cats":["discovery","collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"copy-router-config","version":"1.0-1kali5","arch":"all","homepage":"https://www.offsec.com","repo":"https://gitlab.com/kalilinux/packages/copy-router-config","summary":"Copies Cisco configs via SNMP","desc":"This package copies configuration files from Cisco devices running SNMP.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"merge-router-config.pl","cat":"discovery","sub":"Cisco Tools","url":"https://www.kali.org/tools/copy-router-config/#merge-router-configpl","cats":["discovery","collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"copy-router-config","version":"1.0-1kali5","arch":"all","homepage":"https://www.offsec.com","repo":"https://gitlab.com/kalilinux/packages/copy-router-config","summary":"Copies Cisco configs via SNMP","desc":"This package copies configuration files from Cisco devices running SNMP.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"azurehound","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/azurehound/#azurehound-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"azurehound","version":"3.1.0-0kali1","arch":"any","homepage":"https://github.com/SpecterOps/AzureHound","repo":"https://gitlab.com/kalilinux/packages/azurehound","summary":"BloodHound data collector for Microsoft Azure (program)","desc":"This package contains the BloodHound data collector for Microsoft Azure.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"bloodhound","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/bloodhound/#bloodhound-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"bloodhound","version":"9.7.0~rc4-0kali1","arch":"amd64 arm64","homepage":"https://github.com/SpecterOps/BloodHound","repo":"https://gitlab.com/kalilinux/packages/bloodhound","summary":"Six Degrees of Domain Admin, BloodHound CE","desc":"This package contains BloodHound Community Edition, a single page Javascript web application. BloodHound uses graph theory to reveal the hidden and often unintended relationships within an Active Directory environment. Attackers can use BloodHound to easily identify highly complex attack paths that would otherwise be impossible to quickly identify. Defenders can use BloodHound to identify and eliminate those same attack paths. Both blue and red teams can use BloodHound to easily gain a deeper understanding of privilege relationships in an Active Directory environment.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"bloodhound-python","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/bloodhound.py/#bloodhound-python","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"bloodhound.py","version":"1.9.0-0kali1","arch":"all","homepage":"https://github.com/dirkjanm/bloodhound.py","repo":"https://gitlab.com/kalilinux/packages/bloodhound.py","summary":"Ingestor for BloodHound, based on Impacket (Python 3)","desc":"This package contains a Python based ingestor for BloodHound, based on Impacket. BloodHound.py currently has the following limitations: missing features are GPO local groups and some differences in session resolution between BloodHound and SharpHound. the updatedkerberos branch. This package installs the library for Python 3.","features":["Supports most, but not all BloodHound (SharpHound) features. Primary","Kerberos authentication support is not yet complete, but can be used from"]},{"name":"bloodhound-ce-python","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/bloodhound-ce-python/#bloodhound-ce-python-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"bloodhound-ce-python","version":"1.9.1-0kali1","arch":"all","homepage":"https://github.com/dirkjanm/BloodHound.py/tree/bloodhound-ce","repo":"https://gitlab.com/kalilinux/packages/bloodhound-ce-python","summary":"Python based ingestor for BloodHound CE","desc":"This package contains a Python based ingestor for BloodHound CE, based on Impacket. This tool is only compatible with BloodHound CE. For legacy Bloodhound (<= 4.3.1) use bloodhound-python package.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"ldeep","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/ldeep/#ldeep-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ldeep","version":"2.0.3-0kali1","arch":"all","homepage":"https://github.com/franc-pentest/ldeep","repo":"https://gitlab.com/kalilinux/packages/ldeep","summary":"In-depth ldap enumeration utility","desc":"ldeep is an in-depth ldap enumeration utility that can either run against an Active Directory LDAP server or locally on saved files.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sharphound","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sharphound/#sharphound-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sharphound","version":"2.14.0-0kali1","arch":"all","homepage":"https://github.com/SpecterOps/SharpHound","repo":"https://gitlab.com/kalilinux/packages/sharphound","summary":"C# Data Collector for BloodHound","desc":"This package contains the pre-built SharpHound.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"protos-sip","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/protos-sip/#protos-sip-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"protos-sip","version":"1.0-1kali6","arch":"all","homepage":"https://www.ee.oulu.fi/research/ouspg/PROTOS_Test-Suite_c07-sip","repo":"https://gitlab.com/kalilinux/packages/protos-sip","summary":"SIP test suite","desc":"The purpose of this test-suite is to evaluate implementation level security and robustness of Session Initiation Protocol (SIP) implementations.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"rtpbreak","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/rtpbreak/#rtpbreak-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rtpbreak","version":"1.3a-1kali5","arch":"any","homepage":"http://dallachiesa.com/code/rtpbreak/","repo":"https://gitlab.com/kalilinux/packages/rtpbreak","summary":"Detects, reconstructs, and analyzes RTP sessions","desc":"With rtpbreak you can detect, reconstruct and analyze any RTP session. It doesn't require the presence of RTCP packets and works independently form the used signaling protocol (SIP, H.323, SCCP, ...). The input is a sequence of packets, the output is a set of files you can use as input for other tools (wireshark/tshark, sox, grep/awk/cut/ cat/sed, ...). It supports also wireless (AP_DLT_IEEE802_11) networks.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"rtpinsertsound","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/rtpinsertsound/#rtpinsertsound-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rtpinsertsound","version":"3.0-1kali4","arch":"any","homepage":"http://www.hackingvoip.com/sec_tools.html","repo":"https://gitlab.com/kalilinux/packages/rtpinsertsound","summary":"Inserts audio into a specified stream","desc":"A tool to insert audio into a specified audio (i.e. RTP) stream was created in the August - September 2006 timeframe. The tool is named rtpinsertsound. It was tested on a Linux Red Hat Fedora Core 4 platform (Pentium IV, 2.5 GHz), but it is expected this tool will successfully build and execute on a variety of Linux distributions.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"rtpmixsound","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/rtpmixsound/#rtpmixsound-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rtpmixsound","version":"3.0-1kali5","arch":"any","homepage":"http://www.hackingvoip.com/sec_tools.html","repo":"https://gitlab.com/kalilinux/packages/rtpmixsound","summary":"Mixes pre-recorded audio in real-time","desc":"A tool to mix pre-recorded audio in real-time with the audio (i.e. RTP) in the specified target audio stream.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"siparmyknife","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/siparmyknife/#siparmyknife-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"siparmyknife","version":"11232011-1kali3","arch":"all","homepage":"https://packetstormsecurity.com/files/107301/SIP-Army-Knife-Fuzzer-11232011.html","repo":"https://gitlab.com/kalilinux/packages/siparmyknife","summary":"SIP fuzzing tool","desc":"SIP Army Knife is a fuzzer that searches for cross site scripting, SQL injection, log injection, format strings, buffer overflows, and more.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sipp","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sipp/#sipp-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipp","version":"3.3-1kali6","arch":"any","homepage":"https://sipp.sourceforge.net/","repo":"https://gitlab.com/kalilinux/packages/sipp","summary":"Traffic generator for the SIP protocol","desc":"SIPp is a free Open Source test tool / traffic generator for the SIP protocol. It includes a few basic SipStone user agent scenarios (UAC and UAS) and establishes and releases multiple calls with the INVITE and BYE methods. It can also reads custom XML scenario files describing from very simple to complex call flows. It features the dynamic display of statistics about running tests (call rate, round trip delay, and message statistics), periodic CSV statistics dumps, TCP and UDP over multiple sockets or multiplexed with retransmission management and dynamically adjustable call rates.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sippts","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sippts/#sippts-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sippts","version":"4.1.2-0kali1","arch":"all","homepage":"https://github.com/Pepelux/sippts","repo":"https://gitlab.com/kalilinux/packages/sippts","summary":"Set of tools to audit SIP based VoIP Systems","desc":"Sippts is a set of tools to audit VoIP servers and devices using SIP protocol. Sippts is programmed in Python and it allows pentesters to check the security of a VoIP server using SIP protocol.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"sipsak","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sipsak/#sipsak-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipsak","version":"0.9.8.1-1.1","arch":"any","homepage":"https://github.com/nils-ohlmeier/sipsak","repo":"https://salsa.debian.org/pkg-voip-team/sipsak","summary":"SIP Swiss army knife","desc":"sipsak is a small command line tool for developers and administrators of Session Initiation Protocol (SIP) applications. It can be used for some simple tests on SIP applications and devices.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"svcrash","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sipvicious/#svcrash","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipvicious","version":"0.3.3-2.1","arch":"all","homepage":"https://github.com/EnableSecurity/sipvicious","repo":"https://salsa.debian.org/debian/sipvicious","summary":"Tools to audit SIP based VoIP systems","desc":"SIPVicious suite is a set of tools that can be used to audit SIP based VoIP systems. This suite has five tools: svmap, svwar, svcrack, svreport, svcrash. svmap is a sip scanner. When launched against ranges of ip address space, it will identify any SIP servers which it finds on the way. svwar identifies working extension lines on a PBX. Also tells you if extension line requires authentication or not. svcrack is a password cracker making use of digest authentication. It is able to crack passwords on both registrar servers and proxy servers. svreport is able to manage sessions created by the rest of the tools and export to pdf, xml, csv and plain text. svcrash responds to svwar and svcrack SIP messages with a message that causes old versions to crash.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"svmap","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sipvicious/#svmap","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipvicious","version":"0.3.3-2.1","arch":"all","homepage":"https://github.com/EnableSecurity/sipvicious","repo":"https://salsa.debian.org/debian/sipvicious","summary":"Tools to audit SIP based VoIP systems","desc":"SIPVicious suite is a set of tools that can be used to audit SIP based VoIP systems. This suite has five tools: svmap, svwar, svcrack, svreport, svcrash. svmap is a sip scanner. When launched against ranges of ip address space, it will identify any SIP servers which it finds on the way. svwar identifies working extension lines on a PBX. Also tells you if extension line requires authentication or not. svcrack is a password cracker making use of digest authentication. It is able to crack passwords on both registrar servers and proxy servers. svreport is able to manage sessions created by the rest of the tools and export to pdf, xml, csv and plain text. svcrash responds to svwar and svcrack SIP messages with a message that causes old versions to crash.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"svreport","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sipvicious/#svreport","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipvicious","version":"0.3.3-2.1","arch":"all","homepage":"https://github.com/EnableSecurity/sipvicious","repo":"https://salsa.debian.org/debian/sipvicious","summary":"Tools to audit SIP based VoIP systems","desc":"SIPVicious suite is a set of tools that can be used to audit SIP based VoIP systems. This suite has five tools: svmap, svwar, svcrack, svreport, svcrash. svmap is a sip scanner. When launched against ranges of ip address space, it will identify any SIP servers which it finds on the way. svwar identifies working extension lines on a PBX. Also tells you if extension line requires authentication or not. svcrack is a password cracker making use of digest authentication. It is able to crack passwords on both registrar servers and proxy servers. svreport is able to manage sessions created by the rest of the tools and export to pdf, xml, csv and plain text. svcrash responds to svwar and svcrack SIP messages with a message that causes old versions to crash.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"svwar","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/sipvicious/#svwar","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sipvicious","version":"0.3.3-2.1","arch":"all","homepage":"https://github.com/EnableSecurity/sipvicious","repo":"https://salsa.debian.org/debian/sipvicious","summary":"Tools to audit SIP based VoIP systems","desc":"SIPVicious suite is a set of tools that can be used to audit SIP based VoIP systems. This suite has five tools: svmap, svwar, svcrack, svreport, svcrash. svmap is a sip scanner. When launched against ranges of ip address space, it will identify any SIP servers which it finds on the way. svwar identifies working extension lines on a PBX. Also tells you if extension line requires authentication or not. svcrack is a password cracker making use of digest authentication. It is able to crack passwords on both registrar servers and proxy servers. svreport is able to manage sessions created by the rest of the tools and export to pdf, xml, csv and plain text. svcrash responds to svwar and svcrack SIP messages with a message that causes old versions to crash.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"voiphopper","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/voiphopper/#voiphopper-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"voiphopper","version":"2.04-1kali7","arch":"any","homepage":"https://sourceforge.net/projects/voiphopper","repo":"https://gitlab.com/kalilinux/packages/voiphopper","summary":"Runs a VLAN hop security test","desc":"VoIP Hopper is a GPLv3 licensed security tool, written in C that rapidly runs a VLAN Hop security test. VoIP Hopper is a VoIP infrastructure security testing tool but also a tool that can be used to test the (in)security of VLANs.","features":["استكشاف مصرّح به","تعداد الخدمات","تحليل الشبكة"]},{"name":"ohrwurm","cat":"discovery","sub":"Active Directory","url":"https://www.kali.org/tools/ohrwurm/#ohrwurm-1","cats":["discovery"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ohrwurm","version":"0.1-1kali4","arch":"any","homepage":"http://mazzoo.de/blog/2006/08/25#ohrwurm","repo":"https://gitlab.com/kalilinux/packages/ohrwurm","summary":"RTP fuzzer","desc":"ohrwurm is a small and simple RTP fuzzer that has been successfully tested on a small number of SIP phones. Features: numbers numbers, sothat any RTP traffic can be fuzzed operation only works partially)","features":["reads SIP messages to get information of the RTP port","reading SIP can be omitted by providing the RTP port","RTCP traffic can be suppressed to avoid that codecs","learn about the \"noisy line\"","special care is taken to break RTP handling itself","the RTP payload is fuzzed with a constant BER","the BER is configurable","requires arpspoof from dsniff to do the MITM attack","requires both phones to be in a switched LAN (GW"]},{"name":"impacket-smbexec","cat":"lateral-movement","sub":"General","url":"https://www.kali.org/tools/impacket-scripts/#impacket-smbexec","cats":["lateral-movement"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"impacket-scripts","version":"1.10","arch":"all","homepage":"","repo":"https://gitlab.com/kalilinux/packages/impacket-scripts","summary":"Links to useful impacket scripts examples","desc":"This package contains links to useful impacket scripts. It's a separate package to keep impacket package from Debian and have the useful scripts in the path for Kali.","features":["تحليل الحركة الجانبية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"impacket-psexec","cat":"lateral-movement","sub":"General","url":"https://www.kali.org/tools/impacket-scripts/#impacket-psexec","cats":["lateral-movement"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"impacket-scripts","version":"1.10","arch":"all","homepage":"","repo":"https://gitlab.com/kalilinux/packages/impacket-scripts","summary":"Links to useful impacket scripts examples","desc":"This package contains links to useful impacket scripts. It's a separate package to keep impacket package from Debian and have the useful scripts in the path for Kali.","features":["تحليل الحركة الجانبية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"rdesktop","cat":"lateral-movement","sub":"General","url":"https://www.kali.org/tools/rdesktop/#rdesktop-1","cats":["lateral-movement"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rdesktop","version":"1.9.0-3","arch":"any","homepage":"https://www.rdesktop.org/","repo":"https://salsa.debian.org/debian/rdesktop","summary":"RDP client for Windows NT/2000 Terminal Server and Windows Servers","desc":"rdesktop is an open source client for Windows NT/2000 Terminal Server and Windows Server 2003/2008. Capable of natively speaking its Remote Desktop Protocol (RDP) in order to present the user's Windows desktop. Unlike Citrix ICA, no server extensions are required. Rdesktop is in need of a new upstream maintainter. Please see the home page for more details.","features":["تحليل الحركة الجانبية","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"httrack","cat":"collection","sub":"General","url":"https://www.kali.org/tools/httrack/#httrack-1","cats":["collection"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"httrack","version":"3.50.3-1","arch":"any all","homepage":"https://www.httrack.com","repo":"https://github.com/xroche/httrack","summary":"Copy websites to your computer (Offline browser)","desc":"HTTrack is an offline browser utility, allowing you to download a World Wide website from the Internet to a local directory, building recursively all directories, getting html, images, and other files from the server to your computer. HTTrack arranges the original site's relative link-structure. Simply open a page of the \"mirrored\" website in your browser, and you can browse the site from link to link, as if you were viewing it online. HTTrack can also update an existing mirrored site, and resume interrupted downloads. HTTrack is fully configurable, and has an integrated help system.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"ettercap-text-only","cat":"collection","sub":"General","url":"https://www.kali.org/tools/ettercap/#ettercap-text-only","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ettercap","version":"1:0.8.4.1-2","arch":"any","homepage":"https://ettercap.github.io/ettercap/","repo":"https://salsa.debian.org/pkg-security-team/ettercap","summary":"Ettercap console-mode executable","desc":"Ettercap supports active and passive dissection of many protocols (even encrypted ones) and includes many feature for network and host analysis. Data injection in an established connection and filtering (substitute or drop a packet) on the fly is also possible, keeping the connection synchronized. Many sniffing modes are implemented, for a powerful and complete sniffing suite. It is possible to sniff in four modes: IP Based, MAC Based, ARP Based (full-duplex) and PublicARP Based (half-duplex). Ettercap also has the ability to detect a switched LAN, and to use OS fingerprints (active or passive) to find the geometry of the LAN. This package contains the ettercap text-mode-only executable.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"ettercap","cat":"collection","sub":"General","url":"https://www.kali.org/tools/ettercap/#ettercap-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ettercap","version":"1:0.8.4.1-2","arch":"any","homepage":"https://ettercap.github.io/ettercap/","repo":"https://salsa.debian.org/pkg-security-team/ettercap","summary":"Multipurpose sniffer/content filter for man in the middle attacks","desc":"Multipurpose sniffer/content filter for man in the middle attacks","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"evilginx2","cat":"collection","sub":"General","url":"https://www.kali.org/tools/evilginx2/#evilginx2-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"evilginx2","version":"3.3.0+ds1-0kali1","arch":"any","homepage":"https://github.com/kgretzky/evilginx2","repo":"https://gitlab.com/kalilinux/packages/evilginx2","summary":"Man-in-the-middle attack framework","desc":"This package contains a man-in-the-middle attack framework used for phishing login credentials along with session cookies, which in turn allows to bypass 2-factor authentication protection. This tool is a successor to Evilginx, released in 2017, which used a custom version of nginx HTTP server to provide man-in-the-middle functionality to act as a proxy between a browser and phished website. Present version is fully written in GO as a standalone application, which implements its own HTTP and DNS server, making it extremely easy to set up and use.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"fiked","cat":"collection","sub":"General","url":"https://www.kali.org/tools/fiked/#fiked-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"fiked","version":"0.0.5-1kali8","arch":"any","homepage":"https://www.roe.ch/FakeIKEd","repo":"https://gitlab.com/kalilinux/packages/fiked","summary":"Cisco VPN attack tool","desc":"FakeIKEd, or fiked for short, is a fake IKE daemon supporting just enough of the standards and Cisco extensions to attack commonly found insecure Cisco VPN PSK+XAUTH based IPsec authentication setups in what could be described as a semi MitM attack. Fiked can impersonate a VPN gateway’s IKE responder in order to capture XAUTH login credentials; it doesn’t currently do the client part of full MitM.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"fluxion","cat":"collection","sub":"General","url":"https://www.kali.org/tools/fluxion/#fluxion-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"fluxion","version":"6.32-0kali1","arch":"all","homepage":"https://github.com/FluxionNetwork/fluxion","repo":"https://gitlab.com/kalilinux/packages/fluxion","summary":"Security auditing and social-engineering research tool","desc":"Fluxion is a security auditing and social-engineering research tool. It is a remake of linset by vk496 with (hopefully) fewer bugs and more functionality. The script attempts to retrieve the WPA/WPA2 key from a target access point by means of a social engineering (phishing) attack. It's compatible with the latest release of Kali (rolling). Fluxion's attacks' setup is mostly manual, but experimental auto-mode handles some of the attacks' setup parameters. Read the FAQ before requesting issues.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"mitmproxy","cat":"collection","sub":"General","url":"https://www.kali.org/tools/mitmproxy/#mitmproxy-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"mitmproxy","version":"12.2.3-0kali5","arch":"all","homepage":"https://mitmproxy.org","repo":"https://gitlab.com/kalilinux/packages/mitmproxy","summary":"SSL-capable man-in-the-middle HTTP proxy","desc":"mitmproxy is an interactive man-in-the-middle proxy for HTTP and HTTPS. It provides a console interface that allows traffic flows to be inspected and edited on the fly. Also shipped is mitmdump, the command-line version of mitmproxy, with the same functionality but without the frills. Think tcpdump for HTTP. Features: on the fly This package contains the python-pathod module (previously provided by other source package). The python-netlib module was also included but it has been dropped by upstream in version 1.0.","features":["intercept and modify HTTP and HTTPS requests and responses and modify them","save HTTP conversations for later replay and analysis","replay the client-side of an HTTP conversation","reverse proxy mode to forward traffic to a specified server","transparent proxy mode on OSX and Linux","make scripted changes to HTTP traffic using Python","SSL/TLS certificates for interception are generated on the fly"]},{"name":"mitm6","cat":"collection","sub":"General","url":"https://www.kali.org/tools/mitm6/#mitm6-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"mitm6","version":"0.3.0-0kali1","arch":"all","homepage":"https://github.com/dirkjanm/mitm6","repo":"https://gitlab.com/kalilinux/packages/mitm6","summary":"Pwning IPv4 via IPv6","desc":"mitm6 is a pentesting tool that exploits the default configuration of Windows to take over the default DNS server. It does this by replying to DHCPv6 messages, providing victims with a link-local IPv6 address and setting the attackers host as default DNS server.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"ssldump","cat":"collection","sub":"General","url":"https://www.kali.org/tools/ssldump/#ssldump-1","cats":["collection"],"status":"استطلاع — مصرّح فقط","equiv":"","slug":"ssldump","version":"1.9-2","arch":"any","homepage":"https://github.com/adulau/ssldump","repo":"https://salsa.debian.org/pkg-security-team/ssldump","summary":"SSLv3/TLS network protocol analyzer","desc":"This program will dump the traffic on a network and analyze it for SSLv3/TLS network traffic, typically used to secure TCP connections. When it identifies this traffic, it decodes the results. When provided with the appropriate keying material, it will also decrypt the connections and display the application data traffic. ssldump is based on tcpdump, a network monitoring and data acquisition tool.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"sslsplit","cat":"collection","sub":"General","url":"https://www.kali.org/tools/sslsplit/#sslsplit-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sslsplit","version":"0.5.5-3","arch":"any","homepage":"https://www.roe.ch/SSLsplit","repo":"https://salsa.debian.org/debian/sslsplit","summary":"Transparent and scalable SSL/TLS interception","desc":"SSLsplit is a tool for man-in-the-middle attacks against SSL/TLS encrypted network connections. Connections are transparently intercepted through a network address translation engine and redirected to SSLsplit. SSLsplit terminates SSL/TLS and initiates a new SSL/TLS connection to the original destination address, while logging all data transmitted. SSLsplit is intended to be useful for network forensics and penetration testing.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"sslsniff","cat":"collection","sub":"General","url":"https://www.kali.org/tools/sslsniff/#sslsniff-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sslsniff","version":"0.8+git20111017-4","arch":"any","homepage":"https://github.com/moxie0/sslsniff","repo":"https://salsa.debian.org/pkg-security-team/sslsniff","summary":"SSL/TLS man-in-the-middle attack tool","desc":"sslsniff is designed to create man-in-the-middle (MITM) attacks for SSL/TLS connections, and dynamically generates certs for the domains that are being accessed on the fly. The new certificates are constructed in a certificate chain that is signed by any certificate that is provided. sslsniff also supports other attacks like null-prefix or OCSP attacks to achieve silent interceptions of connections when possible.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"wifipumpkin3","cat":"collection","sub":"General","url":"https://www.kali.org/tools/wifipumpkin3/#wifipumpkin3-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"wifipumpkin3","version":"1.1.7-0kali3","arch":"all","homepage":"https://github.com/P0cL4bs/wifipumpkin3","repo":"https://gitlab.com/kalilinux/packages/wifipumpkin3","summary":"Powerful framework for rogue access point attack","desc":"This package contains a powerful framework for rogue access point attack, written in Python, that allow and offer to security researchers, red teamers and reverse engineers to mount a wireless network to conduct a man-in-the-middle attack.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"ferret-sidejack","cat":"collection","sub":"General","url":"https://www.kali.org/tools/ferret-sidejack/#ferret-sidejack-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ferret-sidejack","version":"3.0.1-1kali11","arch":"any","homepage":"https://github.com/robertdavidgraham/ferret","repo":"https://gitlab.com/kalilinux/packages/ferret-sidejack","summary":"Monitors data and extracts interesting data","desc":"This tool extracts interesting bits from network traffic. One use is to feed the \"hamster\" tool. Another use is to dump the output intoa text file, then use indexers and grep programs to analyze it.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"hamster-sidejack","cat":"collection","sub":"General","url":"https://www.kali.org/tools/hamster-sidejack/#hamster-sidejack-1","cats":["collection"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"hamster-sidejack","version":"2.0-1kali6","arch":"any","homepage":"http://www.erratasec.com/research.html","repo":"https://gitlab.com/kalilinux/packages/hamster-sidejack","summary":"Sidejacking tool","desc":"Hamster is tool or \"sidejacking\". It acts as a proxy server that replaces your cookies with session cookies stolen from somebody else, allowing you to hijack their sessions. Cookies are sniffed using the Ferret program. You need a copy of that as well.","features":["جمع أدلة مصرّح بها","تحليل البيانات","سلسلة حفظ الأدلة"]},{"name":"cadaver","cat":"command-and-control","sub":"Application Layer Protocol","url":"https://www.kali.org/tools/cadaver/#cadaver-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"cadaver","version":"0.28+dfsg-2","arch":"any","homepage":"https://github.com/notroj/cadaver","repo":"https://salsa.debian.org/debian/cadaver","summary":"Command-line WebDAV client","desc":"cadaver supports file upload, download, on-screen display, in-place editing, namespace operations (move/copy), collection creation and deletion, property manipulation, and resource locking. Its operation is similar to the standard BSD ftp(1) client and the Samba Project's smbclient(1). This package includes GnuTLS (HTTPS) support. WebDAV (Web-based Distributed Authoring and Versioning) is a set of extensions to the HTTP protocol which allow users to collaboratively edit and manage files on remote web servers.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"minicom","cat":"command-and-control","sub":"Application Layer Protocol","url":"https://www.kali.org/tools/minicom/#minicom-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"minicom","version":"2.11.1-2","arch":"any","homepage":"https://salsa.debian.org/minicom-team/minicom","repo":"","summary":"Menu-driven serial communication program","desc":"Minicom is a text-mode serial communications program modelled on the MS-DOS program Telix. It drives modems and serial consoles through a full-screen, menu-driven interface and emulates ANSI and VT102 terminals. A dialling directory with auto-redial, a scripting language for automating log-ins and other exchanges, capture-to-file logging, remappable key bindings and a configurable status line are included. File transfers rely on external X-, Y- and ZMODEM helpers such as those in the lrzsz package.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"dbd","cat":"command-and-control","sub":"Non-Application Layer Protocol","url":"https://www.kali.org/tools/dbd/#dbd-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dbd","version":"1.50-1kali7","arch":"any","homepage":"https://github.com/gitdurandal/dbd","repo":"https://gitlab.com/kalilinux/packages/dbd","summary":"Netcat clone with encryption","desc":"dbd is a Netcat-clone, designed to be portable and offer strong encryption. It runs on Unix-like operating systems and on Microsoft Win32. dbd features AES-CBC-128 + HMAC-SHA1 encryption (by Christophe Devine), program execution (-e option), choosing source port, continuous reconnection with delay, and some other nice features. dbd supports TCP/IP communication only. Source code and binaries are distributed under the GNU General Public License.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ncat","cat":"command-and-control","sub":"Non-Application Layer Protocol","url":"https://www.kali.org/tools/nmap/#ncat-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"nmap","version":"7.99+dfsg-1kali1","arch":"any all","homepage":"https://nmap.org/","repo":"https://gitlab.com/kalilinux/packages/nmap","summary":"NMAP netcat reimplementation","desc":"ncat is a reimplementation of Netcat by the NMAP project, providing most of the features present in the original implementations, along with some new features such as IPv6 and SSL support. Port scanning support has been removed.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"penelope","cat":"command-and-control","sub":"Non-Application Layer Protocol","url":"https://www.kali.org/tools/penelope/#penelope-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"penelope","version":"0.21.0-1","arch":"all","homepage":"https://github.com/brightio/penelope","repo":"https://salsa.debian.org/pkg-security-team/penelope","summary":"Advanced shell handler for penetration testing and CTFs","desc":"Penelope is a modern shell handler designed for penetration testers and CTF players. It provides a highly capable alternative to basic netcat listeners, streamlining reverse and bind shell management during post-exploitation. It operates entirely using the Python standard library, requiring no external dependencies. Key features include:","features":["Automatic PTY upgrades for fully interactive terminal sessions.","Multi-session management to control multiple targets simultaneously.","Native session logging and interaction tracking.","Seamless file transfer capabilities between host and target.","Helper modules for local privilege escalation and enumeration."]},{"name":"powercat","cat":"command-and-control","sub":"Non-Application Layer Protocol","url":"https://www.kali.org/tools/powercat/#powercat-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"powercat","version":"0.0~git20240305.4e33fdf-0kali1","arch":"all","homepage":"https://github.com/besimorhino/powercat","repo":"https://gitlab.com/kalilinux/packages/powercat","summary":"Netcat features all in powershell v2","desc":"This package contains a netcat powershell version. It's a simple utility which reads and writes data across network connections using DNS or UDP protocol.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"sbd","cat":"command-and-control","sub":"Non-Application Layer Protocol","url":"https://www.kali.org/tools/sbd/#sbd-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sbd","version":"1.37-1kali6","arch":"any","homepage":"https://mirrors.kernel.org/gentoo/distfiles/sbd-1.37.tar.gz","repo":"https://gitlab.com/kalilinux/packages/sbd","summary":"Secure backdoor for Linux and Windows","desc":"sbd is a Netcat-clone, designed to be portable and offer strong encryption. It runs on Unix-like operating systems and on Microsoft Win32. sbd features AES-CBC-128 + HMAC-SHA1 encryption (by Christophe Devine), program execution (-e option), choosing source port, continuous reconnection with delay, and some other nice features. sbd supports TCP/IP communication only.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"socat","cat":"command-and-control","sub":"Non-Application Layer Protocol","url":"https://www.kali.org/tools/socat/#socat-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"socat","version":"1.8.1.3-2","arch":"linux-any","homepage":"http://www.dest-unreach.org/socat/","repo":"","summary":"Multipurpose relay for bidirectional data transfer","desc":"Socat (for SOcket CAT) establishes two bidirectional byte streams and transfers data between them. Data channels may be files, pipes, devices (terminal or modem, etc.), or sockets (Unix, IPv4, IPv6, raw, UDP, TCP, SSL). It provides forking, logging and tracing, different modes for interprocess communication and many more options. It can be used, for example, as a TCP relay (one-shot or daemon), as an external socksifier, as a shell interface to Unix sockets, as an IPv6 relay, as a netcat and rinetd replacement, to redirect TCP-oriented programs to a serial line, or to establish a relatively secure environment (su and chroot) for running client or server shell scripts inside network connections. Socat supports sctp as of 1.7.0.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"termineter","cat":"command-and-control","sub":"Non-Application Layer Protocol","url":"https://www.kali.org/tools/termineter/#termineter-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"termineter","version":"1.0.6-1","arch":"all","homepage":"https://github.com/rsmusllp/termineter","repo":"https://salsa.debian.org/pkg-security-team/termineter","summary":"Smart meter testing framework","desc":"This package contains a Python framework which provides a platform for the security testing of smart meters. It implements the C1218 and C1219 protocols for communication over an optical interface. Currently supported are Meters using C1219-2007 with 7-bit character sets. This is the most common configuration found in North America. Termineter communicates with Smart Meters via a connection using an ANSI type-2 optical probe with a serial interface.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"chisel","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/chisel/#chisel-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"chisel","version":"1.12.1-0kali2","arch":"any","homepage":"https://github.com/jpillora/chisel","repo":"https://gitlab.com/kalilinux/packages/chisel","summary":"Fast TCP/UDP tunnel over HTTP (program)","desc":"This package contains a fast TCP/UDP tunnel, transported over HTTP, secured via SSH. Single executable including both client and server. Chisel is mainly useful for passing through firewalls, though it can also be used to provide a secure endpoint into your network.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"chisel-common-binaries","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/chisel-common-binaries/#chisel-common-binaries-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"chisel-common-binaries","version":"1.12.0-0kali1","arch":"all","homepage":"https://github.com/jpillora/chisel","repo":"https://gitlab.com/kalilinux/packages/chisel","summary":"Prebuilt binaries for chisel","desc":"This package contains a fast TCP/UDP tunnel, transported over HTTP, secured via SSH. Single executable including both client and server. Chisel is mainly useful for passing through firewalls, though it can also be used to provide a secure endpoint into your network.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"dns2tcpc","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/dns2tcp/#dns2tcpc","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dns2tcp","version":"0.5.2-4","arch":"any","homepage":"","repo":"https://salsa.debian.org/debian/dns2tcp","summary":"TCP-over-DNS tunnel server and client","desc":"dns2tcp is a set of tools to encapsulate a TCP session in DNS packets. This type of encapsulation generates smaller packets than IP-over-DNS, improving throughput. The client does not need root privileges.1","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"dns2tcpd","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/dns2tcp/#dns2tcpd","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dns2tcp","version":"0.5.2-4","arch":"any","homepage":"","repo":"https://salsa.debian.org/debian/dns2tcp","summary":"TCP-over-DNS tunnel server and client","desc":"dns2tcp is a set of tools to encapsulate a TCP session in DNS packets. This type of encapsulation generates smaller packets than IP-over-DNS, improving throughput. The client does not need root privileges.1","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"dnscat","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/dnscat2/#dnscat","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dnscat2","version":"0.07-0kali2","arch":"any all","homepage":"https://github.com/iagox86/dnscat2","repo":"https://gitlab.com/kalilinux/packages/dnscat2","summary":"DNS tunnel (metapackage)","desc":"This tool is designed to create an encrypted command-and-control (C&C) channel over the DNS protocol, which is an effective tunnel out of almost every network.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"iodine-client-start","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/iodine/#iodine-client-start","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"iodine","version":"0.7.0-13","arch":"any","homepage":"https://code.kryo.se/iodine","repo":"https://salsa.debian.org/debian/iodine","summary":"Tool for tunneling IPv4 data through a DNS server","desc":"This is a piece of software that lets you tunnel IPv4 data through a DNS server. This can be usable in different situations where internet access is firewalled, but DNS queries are allowed.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ligolo-agent","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/ligolo-ng/#ligolo-agent","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ligolo-ng","version":"0.9.1-0kali1","arch":"amd64 arm64","homepage":"https://github.com/nicocha30/ligolo-ng","repo":"https://gitlab.com/kalilinux/packages/ligolo-ng","summary":"Advanced, yet simple, tunneling/pivoting tool that uses a TUN interface","desc":"Ligolo-ng is a simple, lightweight and fast tool that allows pentesters to establish tunnels from a reverse TCP/TLS connection using a tun interface (without the need of SOCKS).","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ligolo-proxy","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/ligolo-ng/#ligolo-proxy","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ligolo-ng","version":"0.9.1-0kali1","arch":"amd64 arm64","homepage":"https://github.com/nicocha30/ligolo-ng","repo":"https://gitlab.com/kalilinux/packages/ligolo-ng","summary":"Advanced, yet simple, tunneling/pivoting tool that uses a TUN interface","desc":"Ligolo-ng is a simple, lightweight and fast tool that allows pentesters to establish tunnels from a reverse TCP/TLS connection using a tun interface (without the need of SOCKS).","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ligolo-mp","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/ligolo-mp/#ligolo-mp-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ligolo-mp","version":"2.2.1-0kali1","arch":"amd64 arm64","homepage":"https://github.com/ttpreport/ligolo-mp","repo":"https://gitlab.com/kalilinux/packages/ligolo-mp","summary":"Multiplayer pivoting solution","desc":"Ligolo-MP is an advanced version of Ligolo-ng, with client-server architecture, enabling pentesters to play with multiple concurrent tunnels collaboratively. It manages all your TUNs automatically, while also providing a clean GUI to track everything.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ligolo-mp-client","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/ligolo-mp/#ligolo-mp-client","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ligolo-mp","version":"2.2.1-0kali1","arch":"amd64 arm64","homepage":"https://github.com/ttpreport/ligolo-mp","repo":"https://gitlab.com/kalilinux/packages/ligolo-mp","summary":"Multiplayer pivoting solution","desc":"Ligolo-MP is an advanced version of Ligolo-ng, with client-server architecture, enabling pentesters to play with multiple concurrent tunnels collaboratively. It manages all your TUNs automatically, while also providing a clean GUI to track everything.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ligolo-ng-common-binaries","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/ligolo-ng-common-binaries/#ligolo-ng-common-binaries-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ligolo-ng-common-binaries","version":"0.9.1-0kali1","arch":"all","homepage":"https://github.com/nicocha30/ligolo-ng","repo":"https://gitlab.com/kalilinux/packages/ligolo-ng","summary":"Prebuilt binaries for Advanced ligolo-ng","desc":"Ligolo-ng is a simple, lightweight and fast tool that allows pentesters to establish tunnels from a reverse TCP/TLS connection using a tun interface (without the need of SOCKS).","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"miredo","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/miredo/#miredo-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"miredo","version":"1.2.6-7.2","arch":"any","homepage":"http://www.remlab.net/miredo/","repo":"https://salsa.debian.org/debian/miredo","summary":"Teredo IPv6 tunneling through NATs","desc":"The Teredo IPv6 tunneling protocol encapsulates IPv6 packets into UDP/IPv4 datagrams, to allow hosts behind NAT devices to access the IPv6 Internet. Miredo is a Teredo client (as per RFC 4380): it can provide IPv6 connectivity to a dual-stack IPv6/IPv4 host even if it is located behind a NAT. It can also operate as a Teredo relay which forwards IPv6 packets between the IPv6 Internet and remote Teredo clients.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"proxychains4","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/proxychains-ng/#proxychains4-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"proxychains-ng","version":"4.17-4","arch":"any","homepage":"https://github.com/rofl0r/proxychains-ng","repo":"https://salsa.debian.org/debian/proxychains-ng","summary":"Redirect connections through socks/http proxies (proxychains-ng)","desc":"Proxychains is a UNIX program, that hooks network-related libc functions in dynamically linked programs via a preloaded DLL (dlsym(), LD_PRELOAD) and redirects the connections through SOCKS4a/5 or HTTP proxies. It supports TCP only (no UDP/ICMP etc). This project, proxychains-ng, is the continuation of the unmaintained proxychains project (known as proxychains package in Debian).","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"proxytunnel","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/proxytunnel/#proxytunnel-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"proxytunnel","version":"1.13.0-2","arch":"any","homepage":"https://proxytunnel.sourceforge.io/","repo":"https://salsa.debian.org/pkg-security-team/proxytunnel","summary":"Help SSH and other protocols through HTTP(S) proxies","desc":"Proxytunnel creates tunnels through HTTP(S) proxies for any TCP based protocol. It comes in handy when one sits behind a firewall that allows for HTTP(S) traffic only. The program connects stdin and stdout to an origin server somewhere in the Internet through an industry standard HTTP or HTTPS proxy. It was originally written as an extension to SSH, to be used to SSH to a box at home. It's possible to use proxytunnel along with other applications as well, by running it from inetd or as daemon listening on a local port to be forwarded through the tunnel.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"ptunnel","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/ptunnel/#ptunnel-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"ptunnel","version":"0.72-4","arch":"any","homepage":"http://www.mit.edu/afs.new/sipb/user/golem/tmp/ptunnel-0.61.orig/web/","repo":"https://salsa.debian.org/alteholz/ptunnel","summary":"Tunnel TCP connections over ICMP packets","desc":"ptunnel is an application that allows you to reliably tunnel TCP connections to a remote host using ICMP echo request and reply packets, commonly known as ping requests and replies. It acts as a proxy and can handle sockets and secured identification. Those features can be very handy when working in a closed networking environment with firewalls and proxies.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"pwnat","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/pwnat/#pwnat-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"pwnat","version":"0.3.0-0kali2","arch":"any","homepage":"https://samy.pl/pwnat/","repo":"https://gitlab.com/kalilinux/packages/pwnat","summary":"NAT to NAT client-server communication","desc":"pwnat, pronounced \"poe-nat\", is a tool that allows any number of clients behind NATs to communicate with a server behind a separate NAT with *no* port forwarding and *no* DMZ setup on any routers in order to directly communicate with each other. The server does not need to know anything about the clients trying to connect.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"sshuttle","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/sshuttle/#sshuttle-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sshuttle","version":"1.3.2-1","arch":"all","homepage":"https://github.com/sshuttle/sshuttle","repo":"https://salsa.debian.org/debian/sshuttle","summary":"Transparent proxy server for VPN over SSH","desc":"Sshuttle makes it possible to access remote networks using SSH. It creates a transparent proxy server, using iptables, that will forward all the traffic through an SSH tunnel to a remote copy of sshuttle. It does not require installation on the remote server, which just needs to have Python installed.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"sslh","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/sslh/#sslh-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"sslh","version":"2.3.1-1","arch":"any","homepage":"http://www.rutschle.net/tech/sslh/README.html","repo":"https://salsa.debian.org/debian/sslh.git","summary":"Applicative protocol multiplexer","desc":"sslh lets one accept HTTPS, SSH, OpenVPN, tinc and XMPP connections on the same port. This makes it possible to connect to any of these servers on port 443 (e.g. from inside a corporate firewall, which almost never block port 443) while still serving HTTPS on that port.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"stunnel4","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/stunnel4/#stunnel4-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"stunnel4","version":"3:5.78-2","arch":"any","homepage":"https://www.stunnel.org/","repo":"https://salsa.debian.org/debian/stunnel/","summary":"Universal SSL tunnel for network daemons","desc":"The stunnel program is designed to work as SSL encryption wrapper between remote client and local (inetd-startable) or remote server. The concept is that having non-SSL aware daemons running on your system you can easily setup them to communicate with clients over secure SSL channel. stunnel can be used to add SSL functionality to commonly used inetd daemons like POP-2, POP-3 and IMAP servers without any changes in the programs' code. This package contains a wrapper script for compatibility with stunnel 3.x","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"udptunnel","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/udptunnel/#udptunnel-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"udptunnel","version":"1.1-12","arch":"any","homepage":"http://www1.cs.columbia.edu/~lennox/udptunnel/","repo":"https://salsa.debian.org/debian/udptunnel","summary":"Tunnel UDP packets over a TCP connection","desc":"UDPTunnel is a small program which can tunnel UDP packets bi-directionally over a TCP connection. Its primary purpose (and original motivation) is to allow multi-media conferences to traverse a firewall which allows only outgoing TCP connections. UDPTunnel also can be used for security tests in networks.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"adaptixclient","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/adaptixc2/#adaptixclient","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"adaptixc2","version":"1.1~git20260208.6605760-0kali1","arch":"any","homepage":"https://github.com/Adaptix-Framework/AdaptixC2","repo":"https://gitlab.com/kalilinux/packages/adaptixc2","summary":"Extensible post-exploitation and adversarial emulation framework","desc":"Adaptix is an extensible post-exploitation and adversarial emulation framework made for authorized penetration testing. The Adaptix server is written in Golang and to allow operator flexibility.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"adaptixserver","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/adaptixc2/#adaptixserver","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"adaptixc2","version":"1.1~git20260208.6605760-0kali1","arch":"any","homepage":"https://github.com/Adaptix-Framework/AdaptixC2","repo":"https://gitlab.com/kalilinux/packages/adaptixc2","summary":"Extensible post-exploitation and adversarial emulation framework","desc":"Adaptix is an extensible post-exploitation and adversarial emulation framework made for authorized penetration testing. The Adaptix server is written in Golang and to allow operator flexibility.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"havoc","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/havoc/#havoc-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"havoc","version":"0.6~git20251218.c84f775-0kali1","arch":"amd64","homepage":"https://github.com/HavocFramework/Havoc","repo":"https://gitlab.com/kalilinux/packages/havoc","summary":"Modern and malleable post-exploitation C2 framework","desc":"Havoc is a modern, malleable post-exploitation command and control framework made for penetration testers, red teams, and blue teams.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"hoaxshell","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/hoaxshell/#hoaxshell-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"hoaxshell","version":"0.0~git20250119.e1bba89-0kali2","arch":"all","homepage":"https://github.com/t3l3machus/hoaxshell/","repo":"https://gitlab.com/kalilinux/packages//hoaxshell","summary":"Windows reverse shell payload generator and handler that abuses http(s)","desc":"Hoaxshell is a Windows reverse shell payload generator and handler that abuses the http(s) protocol to establish a beacon-like reverse shell","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"koadic","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/koadic/#koadic-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"koadic","version":"0~git20210412-0kali5","arch":"all","homepage":"https://github.com/zerosum0x0/koadic","repo":"https://gitlab.com/kalilinux/packages/koadic","summary":"Windows post-exploitation rootkit","desc":"This package contains Koadic, or COM Command & Control. It is a Windows post-exploitation rootkit similar to other penetration testing tools such as Meterpreter and Powershell Empire. The major difference is that Koadic does most of its operations using Windows Script Host (a.k.a. JScript/VBScript), with compatibility in the core to support a default installation of Windows 2000 with no service packs (and potentially even versions of NT4) all the way through Windows 10. It is possible to serve payloads completely in memory from stage 0 to beyond, as well as use cryptographically secure communications over SSL and TLS (depending on what the victim OS has enabled).","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"powershell-empire","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/powershell-empire/#powershell-empire-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"powershell-empire","version":"6.6.0-0kali1","arch":"all","homepage":"https://github.com/BC-SECURITY/Empire","repo":"https://gitlab.com/kalilinux/packages/powershell-empire","summary":"PowerShell and Python post-exploitation agent","desc":"This package contains a post-exploitation framework that includes a pure-PowerShell2.0 Windows agent, and a pure Python Linux/OS X agent. It is the merge of the previous PowerShell Empire and Python EmPyre projects. The framework offers cryptologically-secure communications and a flexible architecture. On the PowerShell side, Empire implements the ability to run PowerShell agents without needing powershell.exe, rapidly deployable post-exploitation modules ranging from key loggers to Mimikatz, and adaptable communications to evade network detection, all wrapped up in a usability-focused framework.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"starkiller-start","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/powershell-empire/#starkiller-start","cats":["command-and-control","services-and-other-tools"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"powershell-empire","version":"6.6.0-0kali1","arch":"all","homepage":"https://github.com/BC-SECURITY/Empire","repo":"https://gitlab.com/kalilinux/packages/powershell-empire","summary":"PowerShell and Python post-exploitation agent","desc":"This package contains a post-exploitation framework that includes a pure-PowerShell2.0 Windows agent, and a pure Python Linux/OS X agent. It is the merge of the previous PowerShell Empire and Python EmPyre projects. The framework offers cryptologically-secure communications and a flexible architecture. On the PowerShell side, Empire implements the ability to run PowerShell agents without needing powershell.exe, rapidly deployable post-exploitation modules ranging from key loggers to Mimikatz, and adaptable communications to evade network detection, all wrapped up in a usability-focused framework.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"villain","cat":"command-and-control","sub":"Protocol Tunneling","url":"https://www.kali.org/tools/villain/#villain-1","cats":["command-and-control"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"villain","version":"2.2.1-0kali1","arch":"all","homepage":"https://github.com/t3l3machus/Villain","repo":"https://gitlab.com/kalilinux/packages/villain","summary":"High level C2 framework","desc":"Villain is a C2 framework that can handle multiple TCP socket & HoaxShell-based reverse shells, enhance their functionality with additional features and share them among connected sibling servers.","features":["تحليل قنوات التحكم","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"impacket-smbserver","cat":"exfiltration","sub":"General","url":"https://www.kali.org/tools/impacket-scripts/#impacket-smbserver","cats":["exfiltration"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"impacket-scripts","version":"1.10","arch":"all","homepage":"","repo":"https://gitlab.com/kalilinux/packages/impacket-scripts","summary":"Links to useful impacket scripts examples","desc":"This package contains links to useful impacket scripts. It's a separate package to keep impacket package from Debian and have the useful scripts in the path for Kali.","features":["تحليل تسريب البيانات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"goshs","cat":"exfiltration","sub":"General","url":"https://www.kali.org/tools/goshs/#goshs-1","cats":["exfiltration"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"goshs","version":"2.1.6-0kali1","arch":"any","homepage":"https://github.com/patrickhener/goshs","repo":"https://gitlab.com/kalilinux/packages/goshs","summary":"SimpleHTTPServer written in Go","desc":"This tool provides a SimpleHTTPServer written in Go, enhanced with features and security. This package contains a simple http server like the Python SimpleHTTPServer but enhanced with a lot of helpful features and security in mind.","features":["تحليل تسريب البيانات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"raven","cat":"exfiltration","sub":"General","url":"https://www.kali.org/tools/raven/#raven-1","cats":["exfiltration"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"raven","version":"1.1.0-1","arch":"all","homepage":"https://github.com/gh0x0st/raven","repo":"https://salsa.debian.org/pkg-security-team/raven","summary":"Python tool that extends the capabilities of the http.server Python module","desc":"This package contains a Python tool that extends the capabilities of the http.server Python module by offering a self-contained file upload web server. While the common practice is to use python3 -m http.server 80 to serve files for remote client downloads, Raven addresses the need for a similar solution when you need the ability to receive files from remote clients. This becomes especially valuable in scenarios such as penetration testing and incident response procedures when protocols such as SMB may not be a viable option.","features":["تحليل تسريب البيانات","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"dhcpig","cat":"impact","sub":"General","url":"https://www.kali.org/tools/dhcpig/#dhcpig-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"dhcpig","version":"1.6-3","arch":"all","homepage":"https://github.com/kamorin/DHCPig","repo":"https://salsa.debian.org/pkg-security-team/dhcpig","summary":"DHCP exhaustion script using scapy network library","desc":"DHCPig initiates an advanced DHCP exhaustion attack. It will consume all IPs on the LAN, stop new users from obtaining IPs, release any IPs in use, then for good measure send gratuitous ARP and knock all windows hosts offline. It is based on the scapy library and requests admin privileges to execute. It has been tested on multiple Linux distributions and multiple DHCP servers (ISC, Windows 2k3/2k8, ...).","features":["تحليل التأثير","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"goldeneye","cat":"impact","sub":"General","url":"https://www.kali.org/tools/goldeneye/#goldeneye-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"goldeneye","version":"1.2.0+git20191230-2","arch":"all","homepage":"https://github.com/jseidl/GoldenEye","repo":"https://salsa.debian.org/pkg-security-team/goldeneye","summary":"HTTP DoS test tool","desc":"GoldenEye is a HTTP DoS Test Tool. This tool can be used to test if a site is susceptible to Deny of Service (DoS) attacks. Is possible to open several parallel connections against a URL to check if the web server can be compromised. The program tests the security in networks and uses 'HTTP Keep Alive + NoCache' as attack vector. This package is useful for pentesters.","features":["تحليل التأثير","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"iaxflood","cat":"impact","sub":"General","url":"https://www.kali.org/tools/iaxflood/#iaxflood-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"iaxflood","version":"0.1-1kali5","arch":"any","homepage":"http://www.hackingexposedvoip.com/sec_tools.html","repo":"https://gitlab.com/kalilinux/packages/iaxflood","summary":"VoIP flooder tool","desc":"A UDP Inter-Asterisk_eXchange (i.e. IAX) packet was captured from an IAX channel between two Asterisk IP PBX's. The content of that packet is the source of the payload for the attack embodied by this tool. While the IAX protocol header might not match the Asterisk PBX you'll attack with this tool, it may require more processing on the part of the PBX than a simple udpflood without any payload that even resembles an IAX payload.","features":["تحليل التأثير","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"inviteflood","cat":"impact","sub":"General","url":"https://www.kali.org/tools/inviteflood/#inviteflood-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"inviteflood","version":"2.0-1kali4","arch":"any","homepage":"http://www.hackingvoip.com/sec_tools.html","repo":"https://gitlab.com/kalilinux/packages/inviteflood","summary":"SIP/SDP INVITE message flooding over UDP/IP","desc":"A tool to perform SIP/SDP INVITE message flooding over UDP/IP. It was tested on a Linux Red Hat Fedora Core 4 platform (Pentium IV, 2.5 GHz), but it is expected this tool will successfully build and execute on a variety of Linux distributions.","features":["تحليل التأثير","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"mdk3","cat":"impact","sub":"General","url":"https://www.kali.org/tools/mdk3/#mdk3-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"mdk3","version":"6.0-9","arch":"linux-any","homepage":"https://github.com/aircrack-ng/mdk3","repo":"https://salsa.debian.org/pkg-security-team/mdk3","summary":"Wireless attack tool for IEEE 802.11 networks","desc":"MDK is a proof-of-concept tool to exploit common IEEE 802.11 (Wi-Fi) protocol weaknesses. Features: some buggy drivers) Disassociation packets.","features":["Bruteforce MAC Filters.","Bruteforce hidden SSIDs (some small SSID wordlists included).","Probe networks to check if they can hear you.","Intelligent Authentication-DoS to freeze APs (with success checks).","FakeAP - Beacon Flooding with channel hopping (can crash NetStumbler and","Disconnect everything (aka AMOK-MODE) with Deauthentication and","WPA TKIP Denial-of-Service.","WDS Confusion - Shuts down large scale multi-AP installations."]},{"name":"rtpflood","cat":"impact","sub":"General","url":"https://www.kali.org/tools/rtpflood/#rtpflood-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"rtpflood","version":"1.0-1kali3","arch":"any","homepage":"http://www.hackingvoip.com/sec_tools.html","repo":"https://gitlab.com/kalilinux/packages/rtpflood","summary":"Tool to flood any RTP device","desc":"A command line tool used to flood any device that is processing RTP.","features":["تحليل التأثير","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"siege","cat":"impact","sub":"General","url":"https://www.kali.org/tools/siege/#siege-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"siege","version":"4.1.7-1","arch":"any","homepage":"https://www.joedog.org/JoeDog/Siege","repo":"https://salsa.debian.org/debian/siege","summary":"HTTP regression testing and benchmarking utility","desc":"Siege is an regression test and benchmark utility. It can stress test a single URL with a user defined number of simulated users, or it can read many URLs into memory and stress them simultaneously. The program reports the total number of hits recorded, bytes transferred, response time, concurrency, and return status. Siege supports HTTP/1.0 and 1.1 protocols, the GET and POST directives, cookies, transaction logging, and basic authentication. Its features are configurable on a per user basis. Note: this package contains siege with HTTPS support turned on, thus it obsoletes siege-ssl package now.","features":["تحليل التأثير","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"slowhttptest","cat":"impact","sub":"General","url":"https://www.kali.org/tools/slowhttptest/#slowhttptest-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"slowhttptest","version":"1.9.0-1","arch":"any","homepage":"https://github.com/shekyan/slowhttptest","repo":"https://salsa.debian.org/debian/slowhttptest","summary":"Application layer Denial of Service attacks simulation tool","desc":"SlowHTTPTest is a highly configurable tool that simulates some application layer Denial of Service attacks. It implements most common low-bandwidth application layer Denial of Service attacks, such as concurrent connections pool usage on the server.","features":["Slowloris","Slow HTTP POST","Slow Read attack (based on TCP persist timer exploit) by draining","Apache Range Header attack by causing very significant memory and CPU"]},{"name":"t50","cat":"impact","sub":"General","url":"https://www.kali.org/tools/t50/#t50-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"t50","version":"5.8.7c-2","arch":"linux-any","homepage":"https://gitlab.com/fredericopissarra/t50","repo":"https://salsa.debian.org/pkg-security-team/t50","summary":"Multi-protocol packet injector tool","desc":"Multi-protocol packet injector tool for *nix systems, actually supporting 15 protocols. Features: RIPv2, GRE, ESP, AH, EIGRP and OSPF support.","features":["Flooding","CIDR support","TCP, UDP, ICMP, IGMPv2, IGMPv3, EGP, DCCP, RSVP, RIPv1,","TCP Options.","High performance.","Can hit about 1.000.000 packets per second."]},{"name":"thc-ssl-dos","cat":"impact","sub":"General","url":"https://www.kali.org/tools/thc-ssl-dos/#thc-ssl-dos-1","cats":["impact"],"status":"هجومي — غير قابل للتشغيل","equiv":"","slug":"thc-ssl-dos","version":"1.4-1kali6","arch":"any","homepage":"http://www.thc.org/thc-ssl-dos/","repo":"https://gitlab.com/kalilinux/packages/thc-ssl-dos","summary":"Stress tester for the SSL handshake","desc":"THC-SSL-DOS is a tool to verify the performance of SSL. Establishing a secure SSL connection requires 15x more processing power on the server than on the client. THC-SSL-DOS exploits this asymmetric property by overloading the server and knocking it off the Internet. This problem affects all SSL implementations today. The vendors are aware of this problem since 2003 and the topic has been widely discussed. This attack further exploits the SSL secure Renegotiation feature to trigger thousands of renegotiations via single TCP connection.","features":["تحليل التأثير","اختبار الضوابط","مرجع غير قابل للتشغيل"]},{"name":"dc3dd","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/dc3dd/#dc3dd-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"dc3dd","version":"7.3.1-4","arch":"any","homepage":"https://sourceforge.net/projects/dc3dd/","repo":"https://salsa.debian.org/pkg-security-team/dc3dd","summary":"Patched version of GNU dd with forensic features","desc":"dc3dd is a patched version of GNU dd with added features for computer forensics:","features":["on the fly hashing (md5, sha-1, sha-256, and sha-512);","possibility to write errors to a file;","group errors in the error log;","pattern wiping;","progress report;","possibility to split output."]},{"name":"dcfldd","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/dcfldd/#dcfldd-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"dcfldd","version":"1.9.3-2","arch":"any","homepage":"https://github.com/resurrecting-open-source-projects/dcfldd","repo":"https://salsa.debian.org/debian/dcfldd","summary":"Enhanced version of dd for forensics and security","desc":"dcfldd was initially developed at Department of Defense Computer Forensics Lab (DCFL). This tool is based on the dd program with the following additional features: transferred, helping to ensure data integrity. amount of data transferred and how much longer operation will take. known pattern if desired. match of the specified input file or pattern. time. configurability than the split command. commands as well as files natively. 32768 bytes (32 KiB) which is HUGELY more efficient. errlog, hash, hashconv, hashformat, hashlog, hashlog:, hashwindow, limit, of:, pattern, sizeprobe, split, splitformat, statusinterval, textpattern, totalhashformat, verifylog, verifylog:, vf.","features":["Hashing on-the-fly: dcfldd can hash the input data as it is being","Status output: dcfldd can update the user of its progress in terms of the","Flexible disk wipes: dcfldd can be used to wipe disks quickly and with a","Image/wipe verify: dcfldd can verify that a target drive is a bit-for-bit","Multiple outputs: dcfldd can output to multiple files or disks at the same","Split output: dcfldd can split output to multiple files with more","Piped output and logs: dcfldd can send all its log data and output to","When dd uses a default block size (bs, ibs, obs) of 512 bytes, dcfldd uses","The following options are present in dcfldd but not in dd: ALGORITHMlog:,"]},{"name":"hexwalk","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/hexwalk/#hexwalk-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"hexwalk","version":"1.7.1-1","arch":"any","homepage":"https://www.hexwalk.com","repo":"https://salsa.debian.org/gcarmix/hexwalk","summary":"Hex analyzer, editor and viewer","desc":"HexWalk is an Hex editor, viewer, analyzer based on opensource projects like qhexedit2, binwalk and QT It is cross platform and has plenty of features:","features":["Advanced find patterns in binary files based on HEX, UTF8, UTF16 and regex","Binwalk integration","Entropy Analysis","Byte Map","Hash Calculator","Bin/Dec/Hex Converter","Hex file editing","Diff file analysis","Byte Patterns to parse headers"]},{"name":"missidentify","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/missidentify/#missidentify-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"missidentify","version":"1.0-12","arch":"any","homepage":"https://missidentify.sf.net","repo":"https://salsa.debian.org/pkg-security-team/missidentify","summary":"Find win32 applications","desc":"Miss Identify (missidentify) is a program to find MS Windows type win32 applications. By default, it displays the filename of any executable that does not have an extension, as exe, dll, com, sys, cpl, hxs, hxi, olb, rll or tlb. It can also display all the executables regardless the extension. Miss Identify is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"readpst","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/libpst/#readpst","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"libpst","version":"0.6.76-1.3","arch":"any","homepage":"https://www.five-ten-sg.com/libpst/","repo":"https://salsa.debian.org/debian/libpst","summary":"Convert PST (MS Outlook Personal Folders) files to mbox and other formats","desc":"Convert PST (MS Outlook Personal Folders) files to mbox and other formats","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"reglookup","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/reglookup/#reglookup-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"reglookup","version":"1.0.1+svn296-2","arch":"any all","homepage":"https://web.archive.org/web/20240804024044/http://projects.sentinelchicken.org/reglookup/","repo":"https://salsa.debian.org/pkg-security-team/reglookup","summary":"Utility to analysis for Windows NT-based registry","desc":"RegLookup is a system to direct analysis of Windows NT-based registry files providing command line tools, a C API, and a Python module for accessing registry data structures. The project has a focus on providing tools for digital forensics investigations (though is useful for many purposes), and includes algorithms for retrieving deleted data structures from registry hives. Currently the program allows one to read an entire registry and output it in a (mostly) standardized, quoted format. It also provides features for filtering of results based on registry path and data type. The package provides the following commands: reglookup, reglookup-recover and reglookup-timeline.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"regripper","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/regripper/#regripper-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"regripper","version":"3.0~git20260527.ec96dd4+dfsg-1","arch":"all","homepage":"https://github.com/keydet89/RegRipper3.0","repo":"https://salsa.debian.org/pkg-security-team/regripper","summary":"Perform forensic analysis of registry hives","desc":"Regripper's CLI tool can be used to surgically extract, translate, and display information (both data and metadata) from Registry-formatted files via plugins in the form of Perl-scripts. It allows the analyst to select a hive-file to parse and a plugin or a profile, which is a list of plugins to run against the given hive. The results go to STDOUT and can be redirected to a file, that the analyst designates.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"undbx","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/undbx/#undbx-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"undbx","version":"0.21-4","arch":"any","homepage":"https://github.com/ZungBang/undbx","repo":"https://salsa.debian.org/pkg-security-team/undbx","summary":"Tool to extract, recover and undelete e-mail messages from .dbx files","desc":"UnDBX is a tool to extract, recover and undelete e-mail messages from MS Outlook Express .dbx files (or similar e-mail programs in MS Windows). Corrupted .dbx files can be parsed to try to recover messages from it. It can also try to undelete messages, not only from Deleted Items but also from fragments of deleted messages that were not overwritten. UnDBX is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"vinetto","cat":"forensics","sub":"Digital Forensics","url":"https://www.kali.org/tools/vinetto/#vinetto-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"vinetto","version":"1:0.9.15+dfsg-1","arch":"any","homepage":"https://github.com/AtesComp/Vinetto","repo":"https://salsa.debian.org/pkg-security-team/vinetto","summary":"Forensics tool to examine Thumbs.db files","desc":"vinetto is a console program to extract thumbnail pictures and their metadata from Thumbs.db files, that are generated under Microsoft Windows. vinetto can help *nix-based forensics investigators to:","features":["easily preview thumbnails of deleted pictures on Windows systems;","obtain information (dates, path, ...) about deleted pictures."]},{"name":"ext3grep","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/ext3grep/#ext3grep-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"ext3grep","version":"0.10.2-6","arch":"alpha amd64 arm64 armel armhf hurd-i386 i386 ia64 kfreebsd-amd64 kfreebsd-i386 loong64 mips64el mipsel ppc64el riscv64 sh4 x32","homepage":"","repo":"https://salsa.debian.org/pkg-security-team/ext3grep","summary":"Tool to help recover deleted files on ext3 filesystems","desc":"ext3grep is a simple tool intended to aid anyone who accidentally deletes a file on an ext3 filesystem, only to find that they wanted it shortly thereafter. This package is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"ext4magic","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/ext4magic/#ext4magic-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"ext4magic","version":"0.3.2-15","arch":"any","homepage":"http://ext4magic.sf.net/ext4magic_en.html","repo":"https://salsa.debian.org/pkg-security-team/ext4magic","summary":"Recover deleted files from ext3 or ext4 partitions","desc":"ext4magic is a file carver (or file carving). It can be used when recovering from disasters or in digital forensics activities. The deletion of files in ext3/4 filesystems can not be easily reversed. Zero out of the block references in the inodes makes that impossible. Experiences with other programs have proved that is possible restore sufficient information for a recover of many data files, directly from the filesystem journal. ext4magic can extract the information from the journal and restore files in an entire directory tree, if the information in the journal are sufficient. This tool can recover the most file types, with original filename, owner and group, file mode bits and also the old atime/mtime stamps.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"extundelete","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/extundelete/#extundelete-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"extundelete","version":"0.2.4-3","arch":"any","homepage":"http://extundelete.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/extundelete","summary":"Utility to recover deleted files from ext3/ext4 partition","desc":"extundelete uses the information stored in the partition's journal to attempt to recover a file that has been deleted. There is no guarantee that any particular file will be able to be undeleted.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"foremost","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/foremost/#foremost-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"foremost","version":"1.5.7-12","arch":"any","homepage":"https://sourceforge.net/projects/foremost/","repo":"https://salsa.debian.org/rul/foremost/tree/debian/sid","summary":"Forensic program to recover lost files","desc":"Foremost is a forensic program to recover lost files based on their headers, footers, and internal data structures. Foremost can work on image files, such as those generated by dd, Safeback, Encase, etc, or directly on a drive. The headers and footers can be specified by a configuration file or you can use command line switches to specify built-in file types. These built-in types look at the data structures of a given file format allowing for a more reliable and faster recovery.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"magicrescue","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/magicrescue/#magicrescue-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"magicrescue","version":"1.1.10+dfsg-3","arch":"any","homepage":"https://github.com/jbj/magicrescue","repo":"https://salsa.debian.org/pkg-security-team/magicrescue","summary":"Recover files by looking for magic bytes","desc":"Magic Rescue scans a block device for file types it knows how to recover and calls an external program to extract them. It looks at \"magic bytes\" (file patterns) in file contents, so it can be used both as an undelete utility and for recovering a corrupted drive or partition. As long as the file data is there, it will find it. Magic Rescue uses files called 'recipes'. These files have strings and commands to identify and extract data from devices or forensics images. So, you can write your own recipes. Currently, there are the following recipes: avi, canon-cr2, elf, flac, gpl, gzip, jpeg-exif, jpeg-jfif, mbox, mbox-mozilla-inbox, mbox-mozilla-sent, mp3-id3v1, mp3-id3v2, msoffice, nikon-raw, perl, png, ppm, sqlite and zip. This package provides magicrescue, dupemap and magicsort commands. magicrescue is a carver and it is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"myrescue","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/myrescue/#myrescue-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"myrescue","version":"0.9.8-4","arch":"any","homepage":"https://myrescue.sf.net","repo":"https://salsa.debian.org/pkg-security-team/myrescue","summary":"Rescue data from damaged disks","desc":"myrescue is a program to rescue the still-readable data from a damaged harddisk, CD-ROM, DVD, flash drives, etc. It is similar in purpose to dd_rescue (or ddrescue), but it tries to quickly get out of damaged areas to first handle the not yet damaged part of the disk and return later. This package is useful to recover data from any media and for forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"pasco","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/pasco/#pasco-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"pasco","version":"20040505-4","arch":"any","homepage":"https://sf.net/projects/odessa","repo":"https://salsa.debian.org/pkg-security-team/pasco","summary":"Internet Explorer cache forensic analysis tool","desc":"Pasco is a forensic tool that examines the content of cache files (index.dat) produced by Microsoft Internet Explorer. It parses the file and outputs a field separated that can be loaded in a spreadsheet. This package is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"photorec","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/testdisk/#photorec-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"testdisk","version":"7.2-2","arch":"any","homepage":"https://www.cgsecurity.org/","repo":"https://salsa.debian.org/pkg-security-team/testdisk","summary":"File recovery tool","desc":"PhotoRec is file data recovery software designed to recover lost pictures from digital camera memory or even hard disks. It has been extended to search also for non audio/video headers. This package also ships fidentify, which identifies file types by their signatures using the same database as PhotoRec. PhotoRec searches for the following files and is able to undelete them:","features":["Sun/NeXT audio data (.au)","RIFF audio/video (.avi/.wav)","BMP bitmap (.bmp)","bzip2 compressed data (.bz2)","Source code written in C (.c)","Canon Raw picture (.crw)","Canon catalog (.ctg)","FAT subdirectory","Microsoft Office Document (.doc)","Nikon dsc (.dsc)"]},{"name":"readpe","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/pev/#readpe","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"pev","version":"0.81-10","arch":"any","homepage":"https://pev.sourceforge.net","repo":"https://salsa.debian.org/debian/pev","summary":"pev is a tool to get information of PE32/PE32+ executables (EXE, DLL, OCX etc) like headers, sections, resources and more.","desc":"pev is a tool to get information of PE32/PE32+ executables (EXE, DLL, OCX etc) like headers, sections, resources and more.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"recoverdm","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/recoverdm/#recoverdm-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"recoverdm","version":"0.20-9","arch":"any","homepage":"https://www.vanheusden.com/recoverdm","repo":"https://salsa.debian.org/pkg-security-team/recoverdm","summary":"Recover files on disks with damaged sectors","desc":"recoverdm recover disks with bad sectors. You can recover files as well complete devices. In case it finds sectors which simply cannot be recovered, it writes an empty sector to the output file and continues. When recovering a CD or a DVD and the program cannot read the sector in \"normal mode\", then the program will try to read the sector in \"RAW mode\" (without error-checking etc.). This toolkit also has a utility called 'mergebad' which merges multiple images into one. This package is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"recoverjpeg","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/recoverjpeg/#recoverjpeg-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"recoverjpeg","version":"2.6.3-7","arch":"any","homepage":"https://www.rfc1149.net/devel/recoverjpeg","repo":"https://salsa.debian.org/pkg-security-team/recoverjpeg","summary":"Recover JFIF (JPEG) pictures and MOV movies","desc":"recoverjpeg tries to recover JFIF (JPEG) pictures and MOV movies from a peripheral. This may be useful if you mistakenly overwrite a partition or if a device such as a digital camera memory card is bogus. This package provides these executables: recoverjpeg, recovermov, remove-duplicates and sort-pictures. The remove-duplicates is useful to remove duplicate files found. sort-pictures can be used to sort pictures according to exif date. This package acts as a carver (data carving) and is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"rifiuti","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/rifiuti/#rifiuti-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"rifiuti","version":"20040505-4","arch":"any","homepage":"https://sf.net/projects/odessa","repo":"https://salsa.debian.org/pkg-security-team/rifiuti","summary":"MS Windows recycle bin analysis tool","desc":"Rifiuti is a tool to examine the INFO2 files. The INFO2 file gives meta information about the files found in the MS Windows recycle bin. This package is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"rifiuti2","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/rifiuti2/#rifiuti2-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"rifiuti2","version":"0.8.2-1","arch":"any","homepage":"https://abelcheung.github.io/rifiuti2","repo":"https://salsa.debian.org/pkg-security-team/rifiuti2","summary":"Replacement for rifiuti, a MS Windows recycle bin analysis tool","desc":"Rifiuti2 analyses recycle bin files from Windows. Analysis of Windows recycle bin is usually carried out during Windows computer forensics. Rifiuti2 can extract file deletion time, original path and size of deleted files and whether the deleted files have been moved out from the recycle bin since they are trashed. Rifiuti2 is a rewrite of rifiuti, which is originally written for identical purpose. Then it was extended to cover more functionalities, such as: and legacy ones (using ANSI code page); Rifiuti2 is designed to be portable and runs on command line environment. Two programs rifiuti and rifiuti-vista are chosen depending on relevant Windows recycle bin format.","features":["Handles recycle bin up to Windows 10;","Handles ancient Windows like 95, NT4 and ME;","Supports all localized versions of Windows - both Unicode-based ones","Supports output in XML format as well as original tab-delimited text."]},{"name":"safecopy","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/safecopy/#safecopy-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"safecopy","version":"1.7-8","arch":"any","homepage":"http://safecopy.sf.net","repo":"https://salsa.debian.org/pkg-security-team/safecopy","summary":"Data recovery tool for problematic or damaged media","desc":"Safecopy tries to get as much data from SOURCE as possible, even resorting to device specific low level operations if applicable. This is achieved by identifying problematic or damaged areas, skipping over them and continuing reading afterwards. The corresponding area in the destination file is either skipped (on initial creation that means padded with zeros) or deliberately filled with a recognizable pattern to later find affected files on a corrupted device. The work is similar to ddrescue, generating an image of the original media. This media can be floppy disks, harddisk partitions, CDs, DVDs, tape devices, where other tools like dd would fail due to I/O errors. Safecopy uses an incremental algorithm to identify the exact beginning and end of bad areas, allowing the user to trade minimum accesses to bad areas for thorough data resurrection. Multiple passes over the same file are possible, to first retrieve as much data from a device as possible with minimum harm, and then trying to retrieve some of the remaining data with increasingly aggressive read attempts. Safecopy includes a low level I/O layer to read CDROM disks in raw mode, and issue device resets and other helpful low level operations on a number of other device classes. Safecopy is useful in forensics investigations and disaster recovery.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"scalpel","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/scalpel/#scalpel-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"scalpel","version":"1.60+git20240110.6960eb2-2","arch":"any","homepage":"https://github.com/nolaforensix/scalpel-1.60","repo":"https://salsa.debian.org/pkg-security-team/scalpel","summary":"Fast filesystem-independent file recovery","desc":"scalpel is a fast file carver that reads a database of header and footer definitions and extracts matching files from a set of image files or raw device files. scalpel is filesystem-independent and will carve files from FAT16, FAT32, exFAT, NTFS, Ext2, Ext3, Ext4, JFS, XFS, ReiserFS, raw partitions, etc. scalpel is a complete rewrite of the Foremost 0.69 file carver and is useful for both digital forensics investigations and file recovery.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"scrounge-ntfs","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/scrounge-ntfs/#scrounge-ntfs-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"scrounge-ntfs","version":"0.9-11","arch":"any","homepage":"http://thewalter.net/stef/software/scrounge/","repo":"https://salsa.debian.org/pkg-security-team/scrounge-ntfs","summary":"Data recovery program for NTFS filesystems","desc":"Scrounge NTFS is a data recovery program for NTFS filesystems. It reads each block of the hard disk and try to rebuild the original filesystem tree into a directory. This package is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"testdisk","cat":"forensics","sub":"Forensic Carving Tools","url":"https://www.kali.org/tools/testdisk/#testdisk-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"testdisk","version":"7.2-2","arch":"any","homepage":"https://www.cgsecurity.org/","repo":"https://salsa.debian.org/pkg-security-team/testdisk","summary":"Partition scanner and disk recovery tool","desc":"TestDisk checks the partition and boot sectors of your disks. It is very useful in forensics, recovering lost partitions. It works with : The companion file recovery tool PhotoRec is shipped in the photorec package, and its graphical interface in the qphotorec package.","features":["DOS/Windows FAT12, FAT16 and FAT32","NTFS ( Windows NT/2K/XP )","Linux Ext2 and Ext3","BeFS ( BeOS )","BSD disklabel ( FreeBSD/OpenBSD/NetBSD )","CramFS (Compressed File System)","HFS and HFS+, Hierarchical File System","JFS, IBM's Journaled File System","Linux Raid","Linux Swap (versions 1 and 2)"]},{"name":"affcat","cat":"forensics","sub":"Forensic Imaging Tools","url":"https://www.kali.org/tools/afflib/#affcat","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"afflib","version":"3.7.22-3","arch":"any","homepage":"https://github.com/sshock/AFFLIBv3","repo":"https://salsa.debian.org/pkg-security-team/afflib","summary":"Output contents of an image file to stdout.","desc":"Output contents of an image file to stdout.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"dd_rescue","cat":"forensics","sub":"Forensic Imaging Tools","url":"https://www.kali.org/tools/ddrescue/#dd_rescue","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"ddrescue","version":"1.99.13-0kali2","arch":"amd64 arm64","homepage":"http://www.garloff.de/kurt/linux/ddrescue/","repo":"https://gitlab.com/kalilinux/packages/ddrescue","summary":"Data recovery and protection tool","desc":"When your disk has crashed and you try to copy it over to another one, standard Unix tools like cp, cat, and dd will abort on every I/O error, dd_rescue does not. It optimizes copying by using large blocks as long as no errors occur and falls back to smaller blocks. It supports reverse direction copying (to approach a bad spot from the top), sparse copying, preallocating space, splice zerocopy, and bypassing the kernel pagecache with O_DIRECT. dd_rescue provides safe deletion of data by overwriting files (or better partitions/disks) multiple times with fast random numbers. With the ddr_hash plugin, it supports calculating a hash value (such as a sha256sum) or an HMAC during copying.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"ewfacquire","cat":"forensics","sub":"Forensic Imaging Tools","url":"https://www.kali.org/tools/libewf/#ewfacquire","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"libewf","version":"20140816-2","arch":"any","homepage":"https://github.com/libyal/libewf-legacy","repo":"https://salsa.debian.org/pkg-security-team/libewf","summary":"Acquires data in the EWF format","desc":"Acquires data in the EWF format","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"guymager","cat":"forensics","sub":"Forensic Imaging Tools","url":"https://www.kali.org/tools/guymager/#guymager-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"guymager","version":"0.8.13-3","arch":"any","homepage":"https://guymager.sourceforge.net/","repo":"https://salsa.debian.org/pkg-security-team/guymager","summary":"Forensic imaging tool based on Qt","desc":"The forensic imager contained in this package, guymager, was designed to support different image file formats, to be most user-friendly and to run really fast. It has a high speed multi-threaded engine using parallel compression for best performance on multi-processor and hyper-threading machines.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"pdfid","cat":"forensics","sub":"PDF Forensics Tools","url":"https://www.kali.org/tools/pdfid/#pdfid-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"pdfid","version":"0.2.10-0kali1","arch":"all","homepage":"https://blog.didierstevens.com/programs/pdf-tools/","repo":"https://gitlab.com/kalilinux/packages/pdfid","summary":"Scans PDF files for certain PDF keywords","desc":"This tool is not a PDF parser, but it will scan a file to look for certain PDF keywords, allowing you to identify PDF documents that contain (for example) JavaScript or execute an action when opened. PDFiD will also handle name obfuscation.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"pdf-parser","cat":"forensics","sub":"PDF Forensics Tools","url":"https://www.kali.org/tools/pdf-parser/#pdf-parser-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"pdf-parser","version":"0.7.14-0kali1","arch":"all","homepage":"https://blog.didierstevens.com/programs/pdf-tools/","repo":"https://gitlab.com/kalilinux/packages/pdf-parser","summary":"Parses PDF files to identify fundamental elements","desc":"This tool will parse a PDF document to identify the fundamental elements used in the analyzed file. It will not render a PDF document.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"autopsy","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/autopsy/#autopsy-1","cats":["forensics"],"status":"دفاعي","equiv":"","slug":"autopsy","version":"2.24-6kali1","arch":"all","homepage":"https://www.sleuthkit.org/autopsy/","repo":"https://salsa.debian.org/debian/autopsy","summary":"Graphical interface to SleuthKit","desc":"The Autopsy Forensic Browser is a graphical interface to the command line digital forensic analysis tools in The Sleuth Kit. Together, The Sleuth Kit and Autopsy provide many of the same features as commercial digital forensics tools for the analysis of Windows and UNIX file systems (NTFS, FAT, FFS, EXT2FS, and EXT3FS).","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"blkcalc","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#blkcalc","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"blkcat","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#blkcat","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"blkls","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#blkls","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"blkstat","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#blkstat","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"ffind","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#ffind","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"fls","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#fls","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"fsstat","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#fsstat","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"grokevt-addlog","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/grokevt/#grokevt-addlog","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"grokevt","version":"0.5.0-6.1","arch":"all","homepage":"http://projects.sentinelchicken.org/grokevt/","repo":"https://salsa.debian.org/pkg-security-team/grokevt","summary":"Scripts for reading Microsoft Windows event log files","desc":"GrokEVT is a collection of scripts built for reading Microsoft Windows NT/2000/XP/2003 event log files. Currently the scripts work together on one or more mounted Microsoft Windows partitions to extract all information needed (registry entries, message templates, and log files) to convert the logs to a human-readable format. This program is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"grokevt-builddb","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/grokevt/#grokevt-builddb","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"grokevt","version":"0.5.0-6.1","arch":"all","homepage":"http://projects.sentinelchicken.org/grokevt/","repo":"https://salsa.debian.org/pkg-security-team/grokevt","summary":"Scripts for reading Microsoft Windows event log files","desc":"GrokEVT is a collection of scripts built for reading Microsoft Windows NT/2000/XP/2003 event log files. Currently the scripts work together on one or more mounted Microsoft Windows partitions to extract all information needed (registry entries, message templates, and log files) to convert the logs to a human-readable format. This program is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"grokevt-findlogs","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/grokevt/#grokevt-findlogs","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"grokevt","version":"0.5.0-6.1","arch":"all","homepage":"http://projects.sentinelchicken.org/grokevt/","repo":"https://salsa.debian.org/pkg-security-team/grokevt","summary":"Scripts for reading Microsoft Windows event log files","desc":"GrokEVT is a collection of scripts built for reading Microsoft Windows NT/2000/XP/2003 event log files. Currently the scripts work together on one or more mounted Microsoft Windows partitions to extract all information needed (registry entries, message templates, and log files) to convert the logs to a human-readable format. This program is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"grokevt-parselog","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/grokevt/#grokevt-parselog","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"grokevt","version":"0.5.0-6.1","arch":"all","homepage":"http://projects.sentinelchicken.org/grokevt/","repo":"https://salsa.debian.org/pkg-security-team/grokevt","summary":"Scripts for reading Microsoft Windows event log files","desc":"GrokEVT is a collection of scripts built for reading Microsoft Windows NT/2000/XP/2003 event log files. Currently the scripts work together on one or more mounted Microsoft Windows partitions to extract all information needed (registry entries, message templates, and log files) to convert the logs to a human-readable format. This program is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"grokevt-ripdll","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/grokevt/#grokevt-ripdll","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"grokevt","version":"0.5.0-6.1","arch":"all","homepage":"http://projects.sentinelchicken.org/grokevt/","repo":"https://salsa.debian.org/pkg-security-team/grokevt","summary":"Scripts for reading Microsoft Windows event log files","desc":"GrokEVT is a collection of scripts built for reading Microsoft Windows NT/2000/XP/2003 event log files. Currently the scripts work together on one or more mounted Microsoft Windows partitions to extract all information needed (registry entries, message templates, and log files) to convert the logs to a human-readable format. This program is useful in forensics investigations.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"hfind","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#hfind","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"icat","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#icat","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"ifind","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#ifind","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"ils","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#ils","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"img_cat","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#img_cat","cats":["forensics"],"status":"تحقيق جنائي","equiv":"","slug":"sleuthkit","version":"4.14.0+dfsg-0kali1","arch":"any all","homepage":"https://www.sleuthkit.org/sleuthkit","repo":"https://gitlab.com/kalilinux/packages/sleuthkit","summary":"Tools for forensics analysis on volume and filesystem data","desc":"The Sleuth Kit, also known as TSK, is a collection of UNIX-based command line file and volume system forensic analysis tools. The filesystem tools allow you to examine filesystems of a suspect computer in a non-intrusive fashion. Because the tools do not rely on the operating system to process the filesystems, deleted and hidden content is shown. The volume system (media management) tools allow you to examine the layout of disks and other media. You can also recover deleted files, get information stored in slack spaces, examine filesystems journal, see partitions layout on disks or images etc. But is very important clarify that the TSK acts over the current filesystem only. The Sleuth Kit supports DOS partitions, BSD partitions (disk labels), Mac partitions, Sun slices (Volume Table of Contents), and GPT disks. With these tools, you can identify where partitions are located and extract them so that they can be analyzed with filesystem analysis tools. Currently, TSK supports several filesystems, as NTFS, FAT, exFAT, HFS+, Ext3, Ext4, UFS and YAFFS2. This package contains the set of command line tools in The Sleuth Kit.","features":["تحليل الأدلة الرقمية","استعادة الملفات","البيانات الوصفية"]},{"name":"img_stat","cat":"forensics","