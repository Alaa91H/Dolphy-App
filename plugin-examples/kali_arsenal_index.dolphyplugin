"cats":["forensics"],"status":"تحقيق جنائي","equiv":""},{"name":"tsk_recover","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/sleuthkit/#tsk_recover","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"binwalk","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/binwalk/#binwalk-1","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"binwalk3","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/binwalk3/#binwalk3-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":""},{"name":"bulk_extractor","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/bulk-extractor/#bulk_extractor","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"chkrootkit","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/chkrootkit/#chkrootkit-1","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"galleta","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/galleta/#galleta-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":""},{"name":"hashdeep","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/hashdeep/#hashdeep-1","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"rkhunter","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/rkhunter/#rkhunter-1","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"ssdeep","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/ssdeep/#ssdeep-1","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"unhide","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/unhide/#unhide-1","cats":["forensics"],"status":"تحقيق جنائي","equiv":""},{"name":"xplico-webui-start","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/xplico/#xplico-webui-start","cats":["forensics","services-and-other-tools"],"status":"تحقيق جنائي","equiv":""},{"name":"yara","cat":"forensics","sub":"Sleuth Kit Suite","url":"https://www.kali.org/tools/yara/#yara-1","cats":["forensics"],"status":"دفاعي","equiv":""},{"name":"cherrytree","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/cherrytree/#cherrytree-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"dradis-start","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/dradis/#dradis-start","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"faraday-start","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/python-faraday/#faraday-start","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"obsidian","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/obsidian/#obsidian-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"pipal","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/pipal/#pipal-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"recordmydesktop","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/recordmydesktop/#recordmydesktop-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"redeye-start","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/redeye/#redeye-start","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"cutycapt","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/cutycapt/#cutycapt-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"eyewitness","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/eyewitness/#eyewitness-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"witnessme","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/witnessme/#witnessme-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"juice-shop-start","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/juice-shop/#juice-shop-start","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"dvwa-start","cat":"services-and-other-tools","sub":"Reporting Tools","url":"https://www.kali.org/tools/dvwa/#dvwa-start","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"beef-xss-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/beef-xss/#beef-xss-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"defectdojo-start","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/defectdojo/#defectdojo-start","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"defectdojo-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/defectdojo/#defectdojo-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"dradis-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/dradis/#dradis-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"dvwa-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/dvwa/#dvwa-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"faraday-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/python-faraday/#faraday-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"gophish-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/gophish/#gophish-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"gvm-check-setup","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/gvm/#gvm-check-setup","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"gvm-setup","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/gvm/#gvm-setup","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"gvm-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/gvm/#gvm-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"juice-shop-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/juice-shop/#juice-shop-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"portspoof-start","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/portspoof/#portspoof-start","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"portspoof-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/portspoof/#portspoof-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"redeye-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/redeye/#redeye-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"starkiller-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/powershell-empire/#starkiller-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"xplico-webui-stop","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/xplico/#xplico-webui-stop","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"arsenal-ng","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/arsenal-ng/#arsenal-ng-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"gemini-cli","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/gemini-cli/#gemini-cli-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"hexstrike_server","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/hexstrike-ai/#hexstrike_server","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"kali-tweaks","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/kali-tweaks/#kali-tweaks-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"pwsh","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/powershell/#pwsh-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"shell-gpt","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/shell-gpt/#shell-gpt","cats":["services-and-other-tools"],"status":"خدمة","equiv":""},{"name":"tailscale","cat":"services-and-other-tools","sub":"System Services","url":"https://www.kali.org/tools/tailscale/#tailscale-1","cats":["services-and-other-tools"],"status":"خدمة","equiv":""}]}''')
CATEGORIES = _DATA["categories"]
TOOLS = _DATA["tools"]
CATEGORY_NAMES = {item["id"]: item["ar"] for item in CATEGORIES}
CATEGORY_EN = {item["id"]: item["en"] for item in CATEGORIES}
CATEGORY_OPTIONS = [["all", "كل التصنيفات"]] + [[item["id"], item["ar"] + " (%d)" % item["count"]] for item in CATEGORIES]
SHOW_LIMIT = 80


class KaliArsenalIndex(BasePlugin):
    def __init__(self):
        super().__init__()
        self.query = ""
        self.category = "all"
        self.selected = ""
        self.notice = ""

    def on_plugin_load(self):
        self.add_module(
            "Kali Arsenal Index",
            "فهرس مرجعي كامل لأدوات كالي مع التصنيف والوثائق وحالة التشغيل",
            "rounded:terminal",
            "main",
            "PLUGINS",
            160,
        )

    def _set_query(self, value):
        self.query = str(value or "")
        self.refresh()

    def _set_category(self, value):
        self.category = str(value or "all")
        self.refresh()

    def _filtered(self):
        query = self.query.strip().lower()
        result = []
        for tool in TOOLS:
            if self.category != "all" and self.category not in tool["cats"]:
                continue
            haystack = (
                tool["name"] + " " + tool["sub"] + " "
                + " ".join(CATEGORY_NAMES.get(cid, cid) + " " + CATEGORY_EN.get(cid, cid) for cid in tool["cats"])
            ).lower()
            if query and query not in haystack:
                continue
            result.append(tool)
        return result

    def _find(self, name):
        for tool in TOOLS:
            if tool["name"] == name:
                return tool
        return None

    def _open_tool(self, name):
        self.selected = str(name)
        self.notice = ""
        self.navigate("detail")
        self.refresh()

    def _tool_callback(self, name):
        def callback(value=None):
            self._open_tool(name)

        return callback

    def _open_docs(self):
        tool = self._find(self.selected)
        if not tool:
            return
        try:
            opened = bool(self.api.getAndroid().openUrl(tool["url"]))
        except Exception as error:
            opened = False
            self.notice = "تعذر فتح الرابط: " + str(error)
        if opened:
            self.notice = "تم فتح الوثائق الرسمية"
        elif not self.notice:
            self.notice = "لا يوجد تطبيق متصفح لفتح الرابط"
        self.refresh()

    def _copy_tool(self):
        tool = self._find(self.selected)
        if not tool:
            return
        try:
            self.api.getAndroid().clipboardSet(tool["name"] + " — " + tool["url"])
            self.notice = "تم نسخ الاسم والرابط"
        except Exception as error:
            self.notice = "تعذر النسخ: " + str(error)
        self.refresh()

    def _open_source(self):
        try:
            self.api.getAndroid().openUrl(_DATA["source"])
            self.notice = "تم فتح مصدر كالي الرسمي"
        except Exception as error:
            self.notice = "تعذر فتح المصدر: " + str(error)
        self.refresh()

    def _back(self):
        self.notice = ""
        self.navigate("main")
        self.refresh()

    def _status_color(self, status):
        if status.startswith("هجومي"):
            return "error"
        if status.startswith("دفاعي") or status.startswith("تحقيق"):
            return "primary"
        return None

    def _category_text(self, tool):
        names = [CATEGORY_NAMES.get(cid, cid) for cid in tool["cats"]]
        return "، ".join(names)

    def screen_main(self, ui, api, state):
        matches = self._filtered()
        shown = matches[:SHOW_LIMIT]
        rows = []
        for tool in shown:
            rows.append(
                ui.function_row(
                    tool["name"],
                    self._category_text(tool) + " · " + tool["sub"] + " · " + tool["status"],
                    "terminal",
                    icon_tint=self._status_color(tool["status"]),
                    on_click=self._tool_callback(tool["name"]),
                )
            )
        nodes = [
            ui.card(
                [
                    ui.row(
                        [
                            ui.icon("terminal", 36),
                            ui.column(
                                [
                                    ui.text("Kali Arsenal Index", "titleLarge"),
                                    ui.text("فهرس أدوات كالي الرسمية — مرجع فقط", "bodySmall"),
                                ],
                                spacing=2,
                            ),
                        ],
                        spacing=12,
                    ),
                    ui.row(
                        [
                            ui.chip("%d أداة" % len(TOOLS), True),
                            ui.chip("%d تصنيفًا" % len(CATEGORIES), False),
                            ui.chip("%d مدخلًا" % sum(len(tool["cats"]) for tool in TOOLS), False),
                        ],
                        spacing=6,
                    ),
                    ui.text(
                        "كل أداة لها صفحة رسمية وتصنيف وحالة تشغيل. "
                        "الأدوات الهجومية معروضة كمرجع ولا ينفذها Dolphy.",
                        "bodySmall",
                    ),
                ]
            ),
            ui.card(
                [
                    ui.text("بحث وتصفية", "titleMedium"),
                    ui.text_field(self.query, self._set_query, "ابحث بالاسم أو التصنيف الفرعي"),
                    ui.dropdown(CATEGORY_OPTIONS, self.category, self._set_category, "التصنيف"),
                    ui.text(
                        "النتائج: %d — يُعرض %d" % (len(matches), len(shown)),
                        "bodySmall",
                    ),
                ]
            ),
        ]
        if rows:
            nodes.append(ui.segmented_list(rows))
        else:
            nodes.append(ui.card([ui.text("لا توجد أدوات مطابقة. جرّب اسمًا آخر أو تصنيفًا مختلفًا.", "bodySmall")]))
        if len(matches) > SHOW_LIMIT:
            nodes.append(ui.text("هناك نتائج أكثر؛ استخدم البحث أو اختر تصنيفًا لتضييق القائمة.", "bodySmall"))
        nodes.extend(
            [
                ui.card(
                    [
                        ui.text("حدود الاستخدام", "titleMedium"),
                        ui.text(
                            "الفهرس لا يشغّل أي أداة هجومية ولا يقدّم تعليمات استغلال أو اعتراض. "
                            "أدوات الاستطلاع مسموحة فقط على شبكات وأجهزة تملك إذنًا صريحًا بفحصها.",
                            "bodySmall",
                        ),
                    ]
                ),
                ui.row(
                    [
                        ui.button("عن الفهرس", lambda value=None: (self.navigate("about"), self.refresh()), style="tonal", fill_max_width=True),
                        ui.button("فتح مصدر كالي", self._open_source, style="outlined", fill_max_width=True),
                    ],
                    spacing=8,
                ),
                ui.text("المصدر: " + _DATA["source"] + " · تحديث " + _DATA["updated"], "bodySmall"),
                ui.text(self.notice, "bodySmall", color="primary"),
            ]
        )
        return ui.scaffold(
            title="Kali Arsenal Index",
            content=ui.lazy_column(nodes, padding=16, spacing=12, fill_max_size=True),
        )

    def screen_detail(self, ui, api, state):
        tool = self._find(self.selected)
        if not tool:
            return self.screen_main(ui, api, state)
        nodes = [
            ui.card(
                [
                    ui.row(
                        [
                            ui.icon("terminal", 36, tint=self._status_color(tool["status"])),
                            ui.column(
                                [
                                    ui.text(tool["name"], "titleLarge"),
                                    ui.text(self._category_text(tool), "bodySmall"),
                                ],
                                spacing=2,
                            ),
                        ],
                        spacing=12,
                    ),
                    ui.row(
                        [
                            ui.chip(tool["status"], True),
                            ui.chip(tool["sub"], False),
                        ],
                        spacing=6,
                    ),
                ]
            ),
            ui.card(
                [
                    ui.text("الوصف", "titleMedium"),
                    ui.text(
                        "أداة ضمن تصنيف " + self._category_text(tool) + " / " + tool["sub"] + ". "
                        "هذه الصفحة مرجعية وتعرض الوثائق الرسمية فقط.",
                        "bodySmall",
                    ),
                    ui.settings_row("التصنيف", self._category_text(tool), "category"),
                    ui.settings_row("التصنيف الفرعي", tool["sub"], "label"),
                    ui.settings_row("الحالة", tool["status"], "info"),
                ]
            ),
        ]
        if tool["status"].startswith("هجومي"):
            nodes.append(
                ui.card(
                    [
                        ui.text("غير قابلة للتشغيل", "titleMedium", color="error"),
                        ui.text(
                            "هذه الأداة هجومية. لا يشغّلها Dolphy ولا يوفّر تعليمات استخدام أو استغلال. "
                            "وجودها هنا مرجعي لتعريف المهنيين بسطح أدوات كالي.",
                            "bodySmall",
                        ),
                    ]
                )
            )
        elif tool["status"].startswith("استطلاع"):
            nodes.append(
                ui.card(
                    [
                        ui.text("استخدام مصرّح فقط", "titleMedium", color="primary"),
                        ui.text(
                            "أداة استطلاع نشطة. استخدمها فقط على شبكة أو جهاز تملك إذنًا صريحًا بفحصه. "
                            "الفحص غير المصرّح قد يكون مخالفًا للقانون.",
                            "bodySmall",
                        ),
                    ]
                )
            )
        if tool["equiv"]:
            nodes.append(
                ui.card(
                    [
                        ui.text("بديل دفاعي في Dolphy", "titleMedium", color="primary"),
                        ui.text(tool["equiv"], "bodySmall"),
                    ]
                )
            )
        nodes.extend(
            [
                ui.button("فتح الوثائق الرسمية", self._open_docs, fill_max_width=True),
                ui.button("نسخ الاسم والرابط", self._copy_tool, style="tonal", fill_max_width=True),
                ui.button("رجوع إلى الفهرس", self._back, style="text", fill_max_width=True),
                ui.text(tool["url"], "bodySmall"),
                ui.text(self.notice, "bodySmall", color="primary"),
            ]
        )
        return ui.scaffold(
            title=tool["name"],
            content=ui.lazy_column(nodes, padding=16, spacing=12, fill_max_size=True),
        )

    def screen_about(self, ui, api, state):
        category_rows = []
        for item in CATEGORIES:
            category_rows.append(
                ui.settings_row(item["ar"], "%d أداة" % item["count"], "category")
            )
        return ui.scaffold(
            title="عن الفهرس",
            content=ui.lazy_column(
                [
                    ui.card(
                        [
                            ui.text("ما هذا الفهرس؟", "titleLarge"),
                            ui.text(
                                "فهرس مرجعي لأدوات Kali Linux الرسمية: %d أداة فريدة في %d تصنيفًا. "
                                "يجمع الاسم والتصنيف والوثائق الرسمية وحالة التشغيل في مكان واحد."
                                % (len(TOOLS), len(CATEGORIES)),
                                "bodySmall",
                            ),
                            ui.text(
                                "لا يحتوي الفهرس على تنفيذ للأدوات الهجومية، ولا على تعليمات استغلال أو اعتراض أو كسر كلمات مرور. "
                                "هذا قرار تصميم وليس نقصًا.",
                                "bodySmall",
                            ),
                        ]
                    ),
                    ui.card(
                        [
                            ui.text("التصنيفات", "titleMedium"),
                            ui.segmented_list(category_rows),
                        ]
                    ),
                    ui.card(
                        [
                            ui.text("الأدوات الدفاعية", "titleMedium"),
                            ui.text(
                                "الأدوات الدفاعية العملية متاحة في Captive Portal Auditor: استطلاع Wi-Fi، كشف AP مزيّف، TLS، بصمة الويب، المنافذ، DNS، والتجزئة.",
                                "bodySmall",
                            ),
                        ]
                    ),
                    ui.button("فتح مصدر كالي الرسمي", self._open_source, fill_max_width=True),
                    ui.button("رجوع", self._back, style="text", fill_max_width=True),
                    ui.text(self.notice, "bodySmall", color="primary"),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )
