import json
import time

__id__ = "nfc_toolkit"
__name__ = "NFC Toolkit"
__version__ = "1.1.0"
__author__ = "Dolphy"
__description__ = "NFC adapter status, live tag capture and technology inspection"
__icon__ = "rounded:nfc"
__permissions__ = ["nfc"]

# User-interface translations (Arabic, English and Russian).
