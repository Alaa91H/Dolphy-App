import json

__id__ = "device_inspector"
__name__ = "Device Inspector"
__version__ = "1.1.0"
__author__ = "Dolphy"
__description__ = "Build information, battery state, connectivity and hardware features"
__icon__ = "rounded:phone_android"
__permissions__ = []

# User-interface translations (Arabic, English and Russian).
__i18n__ = {"ar":{"Up":"أعلى","Validate":"تحقق","No":"لا","Supported":"مدعوم","Internet":"الإنترنت","No optional features reported":"لم يتم الإبلاغ عن ميزات اختيارية","None":"لا شيء","Snapshot loaded":"تم تحميل اللقطة","Security":"الأمان","Downstream":"التنزيل","Upstream":"الرفع","Device Inspector":"فاحص الجهاز","Build, battery, connectivity and hardware features":"البناء والبطارية والاتصال وميزات العتاد","Build":"البناء","Device":"الجهاز","Product":"المنتج","Board":"اللوحة","Hardware":"العتاد","ABI":"ABI","Security patch":"تحديث الأمان","App version":"إصدار التطبيق","Bluetooth name":"اسم البلوتوث","Bluetooth address":"عنوان البلوتوث","Connectivity":"الاتصال","Validated":"مُتحقق منه","Wi-Fi":"Wi-Fi","Cellular":"خلوي","VPN":"VPN","Ethernet":"إيثرنت","Bluetooth link":"رابط البلوتوث","Supported hardware":"العتاد المدعوم","supported":"مدعوم","Battery":"البطارية","unknown":"غير معروف","unavailable":"غير متاح","hidden":"مخفي","yes":"نعم","no":"لا","Charging":"قيد الشحن","On battery":"على البطارية","Offline":"غير متصل","Android":"Android","kbps":"كيلوبت/ث","max":"بحد أقصى"},"ru":{"Up":"Вверх","Validate":"Проверить","No":"Нет","Supported":"Поддерживается","Internet":"Интернет","No optional features reported":"Дополнительные функции не обнаружены","None":"Нет","Snapshot loaded":"Снимок загружен","Security":"Безопасность","Downstream":"Входящий трафик","Upstream":"Исходящий трафик","Device Inspector":"Инспектор устройства","Build, battery, connectivity and hardware features":"Сборка, батарея, подключение и оборудование","Build":"Сборка","Device":"Устройство","Product":"Продукт","Board":"Плата","Hardware":"Оборудование","ABI":"ABI","Security patch":"Патч безопасности","App version":"Версия приложения","Bluetooth name":"Имя Bluetooth","Bluetooth address":"Адрес Bluetooth","Connectivity":"Подключение","Validated":"Проверено","Wi-Fi":"Wi-Fi","Cellular":"Сотовая связь","VPN":"VPN","Ethernet":"Ethernet","Bluetooth link":"Связь Bluetooth","Supported hardware":"Поддерживаемое оборудование","supported":"поддерживается","Battery":"Батарея","unknown":"неизвестно","unavailable":"недоступно","hidden":"скрыто","yes":"да","no":"нет","Charging":"Заряжается","On battery":"От батареи","Offline":"Офлайн","Android":"Android","kbps":"Кбит/с","max":"макс."}}






class DeviceInspector(BasePlugin):
    def __init__(self):
        super().__init__()
        self.status = "Snapshot loaded"

    def on_plugin_load(self):
        self.add_module(
            "Device Inspector",
            "Build, battery, connectivity and hardware features",
            "phone",
            "main",
            "OTHER",
            70,
        )

    def read(self, method):
        try:
            return json.loads(str(method()))
        except Exception:
            return {}

    def screen_main(self, ui, api, state):
        android = api.getAndroid()
        info = self.read(android.deviceInfoExtendedJson)
        battery = self.read(android.batteryJson)
        connectivity = self.read(android.connectivityDetailJson)
        features = self.read(android.featuresJson)
        feature_rows = []
        for name in sorted(features.keys()):
            supported = bool(features.get(name))
            if supported:
                feature_rows.append(ui.settings_row(name, "supported", "check"))
        if not feature_rows:
            feature_rows = [ui.text("No optional features reported", "bodyMedium")]
        level = int(battery.get("level", -1))
        charging = bool(battery.get("charging"))
        return ui.scaffold(
            title="Device Inspector",
            content=ui.lazy_column(
                [
                    ui.card(
                        [
                            ui.row(
                                [
                                    ui.icon("phone", 40),
                                    ui.column(
                                        [
                                            ui.text(str(info.get("manufacturer", "")) + " " + str(info.get("model", "")), "titleLarge"),
                                            ui.text("Android " + str(info.get("release", "?")) + " · SDK " + str(info.get("sdk", "?")), "bodySmall"),
                                        ],
                                        spacing=2,
                                    ),
                                ],
                                spacing=12,
                            ),
                            ui.row(
                                [
                                    ui.chip("Battery " + (str(level) + "%" if level >= 0 else "unknown"), True),
                                    ui.chip("Charging" if charging else "On battery", charging),
                                    ui.chip("Internet" if connectivity.get("hasInternet") else "Offline", bool(connectivity.get("hasInternet"))),
                                ],
                                spacing=6,
                            ),
                            ui.linear_progress((level / 100.0) if level >= 0 else None),
                        ]
                    ),
                    ui.text("Build", "titleMedium"),
                    ui.segmented_list(
                        [
                            ui.settings_row("Device", str(info.get("device", "unavailable")), "memory"),
                            ui.settings_row("Product", str(info.get("product", "unavailable")), "info"),
                            ui.settings_row("Board", str(info.get("board", "unavailable")), "memory"),
                            ui.settings_row("Hardware", str(info.get("hardware", "unavailable")), "memory"),
                            ui.settings_row("ABI", str(info.get("abi", "unavailable")), "code"),
                            ui.settings_row("Security patch", str(info.get("securityPatch", "unavailable")), "security"),
                            ui.settings_row("App version", str(info.get("versionName", "")) + " (" + str(info.get("versionCode", "")) + ")", "extension"),
                            ui.settings_row("Bluetooth name", str(info.get("btName", "") or "unavailable"), "bluetooth"),
                            ui.settings_row("Bluetooth address", str(info.get("btAddress", "") or "hidden"), "bluetooth"),
                        ]
                    ),
                    ui.text("Connectivity", "titleMedium"),
                    ui.segmented_list(
                        [
                            ui.settings_row("Validated", "yes" if connectivity.get("validated") else "no", "check"),
                            ui.settings_row("Wi-Fi", "yes" if connectivity.get("wifi") else "no", "wifi"),
                            ui.settings_row("Cellular", "yes" if connectivity.get("cellular") else "no", "network"),
                            ui.settings_row("VPN", "yes" if connectivity.get("vpn") else "no", "security"),
                            ui.settings_row("Ethernet", "yes" if connectivity.get("ethernet") else "no", "lan"),
                            ui.settings_row("Bluetooth link", "yes" if connectivity.get("bluetooth") else "no", "bluetooth"),
                            ui.settings_row("Downstream", str(connectivity.get("downKbps", 0)) + " kbps", "speed"),
                            ui.settings_row("Upstream", str(connectivity.get("upKbps", 0)) + " kbps", "speed"),
                        ]
                    ),
                    ui.text("Supported hardware", "titleMedium"),
                    ui.segmented_list(feature_rows),
                    ui.text(self.status, "bodySmall"),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )
