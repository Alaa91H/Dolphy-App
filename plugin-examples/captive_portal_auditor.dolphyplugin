def device_language():
    try:
        from java import jclass

        code = str(jclass("java.util.Locale").getDefault().getLanguage()).lower()
        if code.startswith("ar"):
            return "ar"
        if code.startswith("ru"):
            return "ru"
        return "en"
    except Exception:
        return "ar"


def parse_forms(body):
    forms = []
    for attrs, inner in re.findall(r"<form\b([^>]*)>(.*?)</form>", body or "", re.S | re.I):
        form = {"action": "", "method": "get", "password": False, "csrf": False, "autocomplete": ""}
        for name, value in re.findall(r"([A-Za-z_:][-A-Za-z0-9_:.]*)\s*=\s*[\"']([^\"']*)[\"']", attrs):
            key = name.lower()
            if key == "action":
                form["action"] = value.strip()
            elif key == "method":
                form["method"] = (value.strip() or "get").lower()
            elif key == "autocomplete":
                form["autocomplete"] = value.strip().lower()
        for tag in re.findall(r"<input\b([^>]*)>", inner, re.S | re.I):
            fields = {}
            for name, value in re.findall(r"([A-Za-z_:][-A-Za-z0-9_:.]*)\s*=\s*[\"']([^\"']*)[\"']", tag):
                fields[name.lower()] = value
            if (fields.get("type", "text") or "text").lower() == "password":
                form["password"] = True
                if (fields.get("autocomplete", "") or "").lower() == "off":
                    form["autocomplete"] = "off"
            if CSRF_HINTS.search(fields.get("name", "") + " " + fields.get("id", "")):
                form["csrf"] = True
        forms.append(form)
    return forms


def parse_cookies(raw_headers):
    cookies = []
    for value in raw_headers.get("set-cookie", []) or []:
        for part in str(value).split(", "):
            head = part.split(";", 1)[0]
            if "=" not in head:
                continue
            name = head.split("=", 1)[0].strip()
            flags = [item.strip().lower() for item in part.split(";")[1:]]
            cookies.append(
                {
                    "name": name,
                    "secure": any(item == "secure" for item in flags),
                    "httponly": any(item == "httponly" for item in flags),
                    "samesite": any(item.startswith("samesite") for item in flags),
                }
            )
    return cookies


def severity_rank(name):
    return SEVERITY_ORDER.get(str(name), 5)


class CaptivePortalAuditor(BasePlugin):
    def __init__(self):
        super(CaptivePortalAuditor, self).__init__()
        self._consent = False
        self._busy = False
        self._alive = True
        self._ssid = ""
        self._bssid = ""
        self._gateway = ""
        self._portal_input = ""
        self._portal = ""
        self._findings = []
        self._checks = []
        self._tls = {}
        self._meta = {}
        self._report = ""
        self._status = ""
        self._log = ""
        self._gateway_ports = []
        self._fingerprint = {}
        self._dhcp = {}
        self._survey_summary = {}
        self._host = ""
        self._port_results = []
        self._dns_results = {}
        self._path_results = []
        self._hash_result = {}
        self._hash_input = ""
        self._tools_busy = False
        self._tool_status = ""
        self._target_ssid = ""
        self._saved_networks = []
        self._networks = []
        self._security = ""
        self._scan_at = ""
        self._scanning = False
        self._tls_protocols = []
        self._exposures = []

    # ------------------------------------------------------------------ setup

    def on_plugin_load(self):
        self.add_module(
            self._t("title"),
            self._t("subtitle"),
            "wifi",
            "main",
            "PLUGINS",
            46,
        )
        self.provide_service(SERVICE_ID)
        self._read_network()
        self._target_ssid = str(self.get_setting("target_ssid", "") or "") or self._ssid
        self._scan_networks(False)
        self._status = self._t("no_portal")

    def on_plugin_unload(self):
        self._alive = False

    # -------------------------------------------------------------- utilities

    def _lang(self):
        raw = str(self.get_setting("language", "") or "").strip().lower()
        if raw in STRINGS:
            return raw
        return device_language()

    def _t(self, key, *args):
        table = STRINGS.get(self._lang(), STRINGS["en"])
        text = table.get(key) or STRINGS["en"].get(key) or STRINGS["ru"].get(key) or key
        if args:
            try:
                return text.format(*args)
            except Exception:
                return text
        return text

    def _read_network(self):
        try:
            info = json.loads(str(self.api.getDevice().wifiConnectionInfoJson()))
        except Exception:
            info = {}
        if not isinstance(info, dict):
            info = {}
        self._ssid = str(info.get("ssid", "") or "")
        self._bssid = str(info.get("bssid", "") or "")
        self._gateway = str(info.get("gateway", "") or "")
        self._meta["ip"] = str(info.get("ip", "") or "")
        self._meta["dns1"] = str(info.get("dns1", "") or "")
        self._host = self._host or self._gateway
        self._dhcp = {}
        try:
            detail = json.loads(str(self.api.getAndroid().wifiDetailedInfoJson()))
            if isinstance(detail, dict) and detail:
                self._dhcp = detail
                self._gateway = str(detail.get("gateway", "") or self._gateway)
                self._meta["dns1"] = str(detail.get("dns1", "") or self._meta.get("dns1", ""))
                self._meta["dns2"] = str(detail.get("dns2", "") or "")
                self._meta["dhcp_server"] = str(detail.get("serverAddress", "") or "")
                self._meta["netmask"] = str(detail.get("netmask", "") or "")
        except Exception:
            pass

    def _portal_url(self):
        text = str(self._portal_input or "").strip()
        if text:
            if not text.lower().startswith(("http://", "https://")):
                text = "http://" + text
            return text
        return self._portal

    def _absolute(self, base, location):
        try:
            from java import jclass

            return str(jclass("java.net.URL")(jclass("java.net.URL")(base), location))
        except Exception:
            return urllib.parse.urljoin(base, location)

    def _http(self, url, method="GET", headers=None, limit=MAX_BODY):
        result = {
            "url": url,
            "code": -1,
            "headers": {},
            "raw_headers": {},
            "body": "",
            "error": "",
            "tls": None,
        }
        try:
            from java import jclass

            URL = jclass("java.net.URL")
            conn = URL(str(url)).openConnection()
            conn.setInstanceFollowRedirects(False)
            conn.setConnectTimeout(8000)
            conn.setReadTimeout(10000)
            conn.setRequestProperty("User-Agent", UA)
            conn.setRequestProperty("Accept", "text/html,application/xhtml+xml,*/*")
            for key, value in (headers or {}).items():
                conn.setRequestProperty(str(key), str(value))
            code = int(conn.getResponseCode())
            result["code"] = code
            fields = conn.getHeaderFields()
            iterator = fields.entrySet().iterator()
            raw = {}
            while iterator.hasNext():
                entry = iterator.next()
                name = entry.getKey()
                if name is None:
                    continue
                values = [str(item) for item in entry.getValue()]
                key = str(name).lower()
                result["headers"][key] = ", ".join(values)
                raw[key] = values
            result["raw_headers"] = raw
            stream = conn.getInputStream() if 200 <= code < 400 else conn.getErrorStream()
            if stream is not None:
                reader = jclass("java.io.BufferedReader")(jclass("java.io.InputStreamReader")(stream, "UTF-8"))
                lines = []
                total = 0
                while total < limit:
                    line = reader.readLine()
                    if line is None:
                        break
                    text = str(line)
                    lines.append(text)
                    total += len(text) + 1
                result["body"] = "\n".join(lines)
            try:
                cipher = str(conn.getCipherSuite())
            except Exception:
                cipher = ""
            if "https" in str(url).lower() or "Https" in conn.getClass().getName():
                tls = {"cipher": cipher, "subject": "", "issuer": "", "expires": "", "expired": False}
                try:
                    certs = conn.getServerCertificates()
                    if certs and len(certs) > 0:
                        cert = certs[0]
                        tls["subject"] = str(cert.getSubjectDN())
                        tls["issuer"] = str(cert.getIssuerDN())
                        try:
                            expiry = cert.getNotAfter()
                            tls["expires"] = str(expiry)
                            tls["expired"] = bool(expiry.getTime() < int(time.time() * 1000))
                        except Exception:
                            pass
                except Exception:
                    pass
                result["tls"] = tls
            try:
                conn.disconnect()
            except Exception:
                pass
        except Exception as error:
            result["error"] = str(error)
        return result

    def _follow(self, url, hops=4):
        chain = []
        current = url
        for _ in range(hops):
            response = self._http(current)
            chain.append(current)
            location = str(response.get("headers", {}).get("location", "") or "")
            if response.get("code") in (301, 302, 303, 307, 308) and location:
                current = self._absolute(current, location)
                if not current.lower().startswith(("http://", "https://")):
                    break
                continue
            response["chain"] = chain
            return response
        last = self._http(current)
        last["chain"] = chain + [current]
        return last

    def _add(self, finding_id, evidence=""):
        if finding_id not in FINDINGS:
            return
        for item in self._findings:
            if item["id"] == finding_id:
                return
        severity, fix_key = FINDINGS[finding_id]
        self._findings.append(
            {
                "id": finding_id,
                "severity": severity,
                "fixKey": fix_key,
                "evidence": str(evidence or "")[:300],
            }
        )

    def _check(self, key, ok, note=""):
        self._checks.append({"key": key, "ok": bool(ok), "note": str(note or "")[:160]})

    # ------------------------------------------------------------- discovery

    def _discover(self):
        self._read_network()
        self._findings = []
        self._checks = []
        self._tls = {}
        self._meta["discovery"] = []
        suspected = False
        candidate = ""
        for url, expected, key in PROBES:
            response = self._http(url)
            code = int(response.get("code", -1))
            location = str(response.get("headers", {}).get("location", "") or "")
            self._meta["discovery"].append({"url": url, "code": code, "location": location})
            intercepted = code not in (-1, expected) or (code == 200 and expected == 204)
            if intercepted:
                suspected = True
                if location and not candidate:
                    candidate = self._absolute(url, location)
            self._check(key, code == expected, "HTTP " + str(code))
        self._check("check_dns", True)
        addressed = self._dns_interception()
        if addressed:
            self._add("dns_rewrite", addressed)
        if suspected:
            if not candidate:
                candidate = self._guess_portal()
            self._portal = candidate
            self._add("portal", candidate)
            self._status = self._t("portal_found")
        else:
            self._portal = ""
            self._status = self._t("no_portal")
        self._build_report()
        self.refresh()

    def _dns_interception(self):
        host = "dolphy-probe-" + ("%08x" % random.getrandbits(32)) + ".invalid"
        try:
            from java import jclass

            address = jclass("java.net.InetAddress").getByName(host)
            resolved = str(address.getHostAddress())
            if resolved:
                self._check("check_dns", False, host + " → " + resolved)
                return host + " → " + resolved
        except Exception as error:
            self._check("check_dns", True, str(error)[:100])
            return ""
        self._check("check_dns", False, host)
        return ""

    def _guess_portal(self):
        if self._gateway:
            return "http://" + self._gateway + "/"
        return ""

    def _channel_of(self, frequency):
        freq = int(frequency or 0)
        if 2412 <= freq <= 2484:
            return max(1, (freq - 2407) // 5)
        if 5000 <= freq < 5900:
            return max(1, (freq - 5000) // 5)
        if freq >= 5955:
            return max(1, (freq - 5950) // 5)
        return 0

    def _width_of(self, width):
        return {0: "20", 1: "40", 2: "80", 3: "160", 4: "80+80"}.get(int(width), "?")

    def _vendor_of(self, bssid):
        return OUI_VENDORS.get(str(bssid or "").upper()[:8], "unknown")

    def _locally_administered(self, bssid):
        try:
            return bool(int(str(bssid).split(":")[0], 16) & 0x02)
        except Exception:
            return False

    def _risk_of(self, net):
        score = {"open": 40, "wep": 50, "wpa": 25, "wpa2": 5, "wpa3": 0, "enterprise": 0, "owe": 5}.get(net.get("security"), 10)
        if net.get("wps"):
            score += 15
        if net.get("tkip"):
            score += 10
        if net.get("security") in ("wpa2", "wpa3") and not net.get("pmf"):
            score += 10
        if net.get("locally_administered"):
            score += 15
        return min(100, score)

    def _security_of(self, capabilities):
        caps = str(capabilities or "").upper()
        if not caps:
            return "unknown"
        if "SAE" in caps:
            return "wpa3"
        if "EAP" in caps:
            return "enterprise"
        if "WEP" in caps:
            return "wep"
        if "WPA2" in caps:
            return "wpa2"
        if "WPA" in caps:
            return "wpa"
        if "OWE" in caps:
            return "owe"
        return "open"

    def _scan_networks(self, force=False):
        device = self.api.getDevice()
        if force:
            try:
                device.wifiStartScan(True)
            except Exception:
                pass
        rows = []
        try:
            rows = json.loads(str(device.wifiScanResultsJson(200, -95)))
        except Exception:
            rows = []
        if not isinstance(rows, list):
            rows = []
        networks = []
        seen = set()
        for row in rows:
            if not isinstance(row, dict):
                continue
            ssid = str(row.get("ssid", "") or "").strip()
            if not ssid:
                continue
            bssid = str(row.get("bssid", "") or "")
            identity = ssid + "|" + bssid
            if identity in seen:
                continue
            seen.add(identity)
            frequency = int(row.get("frequency", 0) or 0)
            caps = str(row.get("capabilities", "") or "")
            width = int(row.get("channelWidth", -1) or -1)
            networks.append(
                {
                    "ssid": ssid,
                    "bssid": bssid,
                    "rssi": int(row.get("rssi", -100) or -100),
                    "frequency": frequency,
                    "channelWidth": width,
                    "capabilities": caps,
                    "security": self._security_of(caps),
                    "band": "2.4" if 2400 <= frequency <= 2500 else ("5" if 5000 <= frequency < 5900 else ("6" if frequency >= 5900 else "")),
                    "channel": self._channel_of(frequency),
                    "width": self._width_of(width),
                    "vendor": self._vendor_of(bssid),
                    "pmf": ("MFPC" in caps.upper() or "MFPR" in caps.upper()),
                    "wps": "WPS" in caps.upper(),
                    "tkip": "TKIP" in caps.upper(),
                    "locally_administered": self._locally_administered(bssid),
                    "current": bool(bssid) and bssid == self._bssid,
                    "saved": False,
                }
            )
        saved = []
        try:
            saved = json.loads(str(device.wifiConfiguredNetworksJson()))
        except Exception:
            saved = []
        if isinstance(saved, list):
            self._saved_networks = [item for item in saved if isinstance(item, dict)]
            for item in self._saved_networks:
                ssid = str(item.get("ssid", "") or "").strip()
                if ssid and not any(net["ssid"] == ssid for net in networks):
                    networks.append(
                        {
                            "ssid": ssid,
                            "bssid": str(item.get("bssid", "") or ""),
                            "rssi": -100,
                            "frequency": 0,
                            "capabilities": "",
                            "security": "unknown",
                            "band": "",
                            "channel": 0,
                            "width": "?",
                            "vendor": "unknown",
                            "pmf": False,
                            "wps": False,
                            "tkip": False,
                            "locally_administered": False,
                            "current": ssid == self._ssid,
                            "saved": True,
                        }
                    )
        networks.sort(key=lambda net: net["rssi"], reverse=True)
        for net in networks:
            net["risk"] = self._risk_of(net)
        self._networks = networks
        self._scan_at = time.strftime("%H:%M:%S")
        self._security = ""
        for net in networks:
            if net.get("bssid") and net.get("bssid") == self._bssid:
                self._security = net.get("security", "")
                break
        if not self._security:
            for net in networks:
                if net.get("ssid") == self._ssid:
                    self._security = net.get("security", "")
                    break

    def _analyze_networks(self):
        current = None
        for net in self._networks:
            if net.get("bssid") and net.get("bssid") == self._bssid:
                current = net
                break
        if current is None:
            current = next((net for net in self._networks if net.get("ssid") == self._ssid), None)
        if current:
            self._security = current.get("security", "unknown")
        for net in self._networks:
            if net.get("wps"):
                self._add("wps_enabled", net["ssid"])
                break
        if current:
            caps = str(current.get("capabilities", "")).upper()
            if current.get("security") in ("wpa2", "wpa3") and not current.get("pmf"):
                self._add("pmf_missing", self._ssid)
            if "SAE" in caps and ("PSK" in caps or "WPA2" in caps):
                self._add("wpa3_transition", self._ssid)
        by_ssid = {}
        for net in self._networks:
            by_ssid.setdefault(net["ssid"], []).append(net)
        rogue = 0
        for ssid, group in by_ssid.items():
            kinds = {net["security"] for net in group}
            vendors = {net["vendor"] for net in group if net["vendor"] != "unknown"}
            if len(vendors) > 1:
                self._add("rogue_bssid", ssid + " · " + ", ".join(sorted(vendors)))
                rogue += 1
            if any(net.get("locally_administered") for net in group):
                self._add("rogue_bssid", ssid + " · locally administered BSSID")
                rogue += 1
            if "open" in kinds and kinds & {"wpa", "wpa2", "wpa3", "enterprise"}:
                self._add("evil_twin", ssid)
                self._add("ssid_downgrade", ssid)
                rogue += 1
        for net in self._networks:
            if net["security"] == "wep":
                self._add("wep_network", net["ssid"])
                break
        for net in self._networks:
            if net["security"] == "wpa":
                self._add("wpa_legacy", net["ssid"])
                break
        if self._security == "open":
            self._add("open_network", self._ssid)
        pmf_ok = not (current and current.get("security") in ("wpa2", "wpa3") and not current.get("pmf"))
        self._check("check_pmf", pmf_ok, "on" if (current and current.get("pmf")) else "off")
        self._survey_summary = {
            "aps": len(self._networks),
            "channels": len({net["channel"] for net in self._networks if net.get("channel")}),
            "open": sum(1 for net in self._networks if net.get("security") == "open"),
            "wps": sum(1 for net in self._networks if net.get("wps")),
            "rogue": rogue,
            "strongest": max([net.get("rssi", -100) for net in self._networks] or [-100]),
        }
        self._check("check_survey", bool(self._networks), "%d AP · %d channels" % (len(self._networks), self._survey_summary["channels"]))
        self._check("check_rogue_ap", rogue == 0, "%d suspicious" % rogue)
        self._check("check_networks", bool(self._networks), "%d network(s) · %s" % (len(self._networks), self._scan_at))

    def _origin(self, portal):
        parts = urllib.parse.urlsplit(str(portal))
        host = parts.hostname or ""
        port = ":" + str(parts.port) if parts.port else ""
        return (parts.scheme or "http") + "://" + host + port

    def _analyze_tls(self, portal):
        if not str(portal).lower().startswith("https://"):
            self._check("check_tls_versions", False, "HTTP only")
            return
        host = urllib.parse.urlsplit(str(portal)).hostname or ""
        supported = []
        try:
            from java import jclass

            context = jclass("javax.net.ssl.SSLContext").getInstance("TLS")
            context.init(None, None, None)
            factory = context.getSocketFactory()
            for protocol in ("TLSv1", "TLSv1.1", "TLSv1.2", "TLSv1.3"):
                try:
                    socket = factory.createSocket(host, 443)
                    socket.setSoTimeout(4000)
                    params = socket.getSSLParameters()
                    params.setProtocols([protocol])
                    socket.setSSLParameters(params)
                    socket.startHandshake()
                    supported.append(protocol)
                    socket.close()
                except Exception:
                    pass
        except Exception as error:
            self._check("check_tls_versions", False, str(error)[:100])
            return
        self._tls_protocols = supported
        self._check("check_tls_versions", bool(supported), ", ".join(supported) or "none")
        if "TLSv1" in supported or "TLSv1.1" in supported:
            self._add("tls_legacy", ", ".join(supported))
        cipher = str((self._tls or {}).get("cipher", "")).upper()
        if cipher and any(token in cipher for token in ("RC4", "3DES", "DES_", "NULL", "MD5")):
            self._add("weak_cipher", cipher)
        tls = self._tls or {}
        subject = str(tls.get("subject", "") or "")
        issuer = str(tls.get("issuer", "") or "")
        cert_bad = False
        if subject and issuer and subject == issuer:
            self._add("cert_selfsigned", subject[:160])
            cert_bad = True
        days = self._cert_days(tls.get("expires", ""))
        if days is not None and 0 <= days <= 30:
            self._add("cert_expiring", "%d day(s) left" % days)
            cert_bad = True
        self._check("check_cert", not cert_bad, ("%d days left" % days) if days is not None else "certificate parsed")

    def _check_exposures(self, portal):
        origin = self._origin(portal)
        exposed = []
        for path, signature in (
            ("/.git/HEAD", "ref:"),
            ("/.env", "app_"),
            ("/server-status", "server status"),
            ("/phpinfo.php", "phpinfo"),
        ):
            try:
                response = self._http(origin + path)
                body = str(response.get("body", "") or "").lower()
                if response.get("code") == 200 and signature in body:
                    exposed.append(path)
            except Exception:
                pass
        self._exposures = exposed
        self._check("check_exposure", not exposed, ", ".join(exposed) or "none")
        if exposed:
            self._add("exposed_file", ", ".join(exposed))

    def _check_cors(self, portal):
        response = self._http(portal, headers={"Origin": "https://audit.example"})
        headers = response.get("headers", {}) or {}
        allow = str(headers.get("access-control-allow-origin", "") or "")
        credentials = str(headers.get("access-control-allow-credentials", "") or "").lower()
        bad = allow == "*" or (allow == "https://audit.example" and credentials == "true")
        self._check("check_cors", not bad, (allow + " · credentials=" + credentials) if allow else "no ACAO")
        if bad:
            self._add("cors_misconfig", "ACAO " + allow + " · " + credentials)

    def _check_methods(self, portal):
        options = self._http(self._origin(portal), method="OPTIONS")
        allow = str((options.get("headers", {}) or {}).get("allow", "") or "")
        trace = self._http(self._origin(portal), method="TRACE")
        trace_ok = trace.get("code") == 200 and "TRACE" in str(trace.get("body", "")).upper()
        self._check("check_methods", not trace_ok, ("Allow: " + allow) if allow else "no Allow header")
        if trace_ok:
            self._add("trace_enabled", "TRACE returned 200")

    def _check_js(self, body, page_url):
        scripts = "\n".join(re.findall(r"<script[^>]*>(.*?)</script>", body or "", re.S | re.I))
        risky = []
        if re.search(r"\beval\s*\(", scripts):
            risky.append("eval")
        if re.search(r"document\.write\s*\(", scripts):
            risky.append("document.write")
        if re.search(r"\.innerHTML\s*=", scripts):
            risky.append("innerHTML")
        if re.search(r"<script[^>]+src=[\"']http://", body or "", re.I):
            risky.append("script over HTTP")
        self._check("check_js", not risky, ", ".join(risky) or "clean")
        if risky:
            self._add("js_risky", ", ".join(risky))

    def _check_cache(self, headers, has_login):
        cache = str(headers.get("cache-control", "") or "").lower()
        pragma = str(headers.get("pragma", "") or "").lower()
        safe = "no-store" in cache or "no-cache" in cache or "no-cache" in pragma
        self._check("check_cache", safe or not has_login, cache or "missing")
        if has_login and not safe:
            self._add("cache_missing", cache or "no Cache-Control")

    def _probe_port(self, host, port, timeout=350):
        socket = None
        try:
            from java import jclass

            socket = jclass("java.net.Socket")()
            socket.connect(jclass("java.net.InetSocketAddress")(str(host), int(port)), int(timeout))
            return True
        except Exception:
            return False
        finally:
            if socket is not None:
                try:
                    socket.close()
                except Exception:
                    pass

    def _scan_gateway(self):
        if not self._consent or not self._gateway:
            self._check("check_gateway_ports", False, "no gateway")
            return
        open_ports = []
        for port, _label in GATEWAY_PORTS:
            if self._probe_port(self._gateway, port):
                open_ports.append(port)
        self._gateway_ports = open_ports
        risky = [port for port in open_ports if port in (21, 23, 445, 7547)]
        self._check("check_gateway_ports", not risky, ", ".join(str(port) for port in open_ports) or "none")
        if risky:
            self._add("gateway_admin_exposed", ", ".join(str(port) for port in risky))

    def _private_ip(self, address):
        try:
            parts = [int(part) for part in str(address).split(".")]
            if len(parts) != 4:
                return True
            first, second = parts[0], parts[1]
            return first == 10 or (first == 172 and 16 <= second <= 31) or (first == 192 and second == 168) or first == 127 or (first == 169 and second == 254)
        except Exception:
            return True

    def _analyze_dhcp(self):
        dns = [str(self._meta.get("dns1", "") or ""), str(self._meta.get("dns2", "") or "")]
        dns = [item for item in dns if item and item != "0.0.0.0"]
        server = str(self._meta.get("dhcp_server", "") or "")
        mismatch = bool(server and self._gateway and server != self._gateway)
        public = [item for item in dns if not self._private_ip(item)]
        self._check("check_dhcp", not mismatch, ("server " + server) if server else "no DHCP detail")
        if mismatch:
            self._add("dhcp_mismatch", server + " vs gateway " + self._gateway)
        if public:
            self._add("dns_public", ", ".join(public))
        self._meta["dns_public"] = public

    def _fingerprint_page(self, headers, body):
        server = str(headers.get("server", "") or "")
        powered = str(headers.get("x-powered-by", "") or "")
        waf = []
        for key, name in (("cf-ray", "Cloudflare"), ("x-sucuri-id", "Sucuri"), ("x-akamai-transformed", "Akamai"), ("x-iinfo", "Imperva"), ("x-cache", "CDN cache"), ("via", "Proxy/CDN")):
            if headers.get(key):
                waf.append(name)
        text = str(body or "").lower()
        framework = []
        for marker, name in (("wp-content", "WordPress"), ("drupal", "Drupal"), ("joomla", "Joomla"), ("__viewstate", "ASP.NET"), ("csrf-token", "Laravel"), ("django", "Django"), ("_next/static", "Next.js"), ("data-reactroot", "React")):
            if marker in text:
                framework.append(name)
        generator = ""
        match = re.search(r'<meta[^>]+name=["\']generator["\'][^>]+content=["\']([^"\']+)', str(body or ""), re.I)
        if match:
            generator = match.group(1)[:80]
        self._fingerprint = {
            "server": server,
            "powered": powered,
            "waf": sorted(set(waf)),
            "framework": sorted(set(framework)),
            "generator": generator,
        }
        found = bool(server or powered or waf or framework or generator)
        self._check("check_fingerprint", found, " · ".join([item for item in [server, powered, generator] if item] + sorted(set(waf)))[:160] or "no fingerprint")

    def _cert_days(self, text):
        value = str(text or "").strip()
        if not value:
            return None
        try:
            from email.utils import parsedate_to_datetime

            return int((parsedate_to_datetime(value).timestamp() - time.time()) // 86400)
        except Exception:
            pass
        for fmt in ("%a %b %d %H:%M:%S %Z %Y", "%a %b %d %H:%M:%S %Z%z %Y", "%Y-%m-%dT%H:%M:%SZ"):
            try:
                return int((time.mktime(time.strptime(value, fmt)) - time.time()) // 86400)
            except Exception:
                pass
        return None

    def _set_host(self, value):
        self._host = str(value or "").strip()

    def _set_hash_input(self, value):
        self._hash_input = str(value or "")

    def _run_tool(self, fn):
        if self._tools_busy:
            return
        self._tools_busy = True
        self.refresh()

        def worker():
            try:
                fn()
            finally:
                self._tools_busy = False
                if self._alive:
                    try:
                        self.refresh()
                    except Exception:
                        pass

        threading.Thread(target=worker, daemon=True).start()

    def _port_scan_worker(self):
        host = self._host or self._gateway
        if not host:
            self._tool_status = self._t("host_hint")
            return
        results = []
        for port, service in TOP_PORTS:
            if self._probe_port(host, port, 220):
                results.append({"port": port, "service": service})
        self._port_results = results
        risky = [str(item["port"]) for item in results if item["port"] in RISKY_PORTS]
        self._check("check_ports", bool(results), host + " · " + str(len(results)) + " open")
        if risky:
            self._add("open_risky_port", host + ": " + ", ".join(risky))
        self._tool_status = host + " · " + str(len(results)) + " open"

    def _resolve_host(self, host):
        try:
            from java import jclass

            addresses = jclass("java.net.InetAddress").getAllByName(host)
            ips = [str(item.getHostAddress()) for item in addresses]
            reverse = str(addresses[0].getCanonicalHostName()) if ips else ""
            return ips, reverse
        except Exception:
            return [], ""

    def _doh_query(self, name, record):
        url = "https://cloudflare-dns.com/dns-query?name=" + urllib.parse.quote(str(name)) + "&type=" + str(record)
        response = self._http(url, headers={"accept": "application/dns-json"})
        try:
            data = json.loads(str(response.get("body", "") or "{}"))
        except Exception:
            return []
        return [str(item.get("data", "")) for item in (data.get("Answer") or []) if isinstance(item, dict)]

    def _dns_worker(self):
        host = self._host or self._gateway
        if not host:
            self._tool_status = self._t("host_hint")
            return
        ips, reverse = self._resolve_host(host)
        self._dns_results = {
            "host": host,
            "ips": ips,
            "reverse": reverse,
            "mx": self._doh_query(host, "MX"),
            "txt": self._doh_query(host, "TXT"),
            "subs": {},
        }
        for sub in SUBDOMAINS:
            found = self._doh_query(sub + "." + host, "A")
            if found:
                self._dns_results["subs"][sub] = found
        self._check("check_dns", bool(ips), host + " → " + (", ".join(ips) or "no A"))
        self._tool_status = host + " · DNS"

    def _path_scan_worker(self):
        portal = self._portal or self._portal_url() or (("http://" + self._gateway + "/") if self._gateway else "")
        origin = self._origin(portal) if portal else ""
        if not origin:
            self._tool_status = self._t("host_hint")
            return
        results = []
        for path in COMMON_PATHS:
            response = self._http(origin + path)
            code = int(response.get("code", -1))
            if code not in (-1, 404):
                results.append({"path": path, "code": code, "size": len(str(response.get("body", "") or ""))})
        self._path_results = results
        sensitive = [item["path"] for item in results if item["path"] in ("/.env", "/.git/HEAD", "/server-status") and item["code"] == 200]
        if sensitive:
            self._add("exposed_file", ", ".join(sensitive))
        if any(item["path"] == "/admin" and item["code"] == 200 for item in results):
            self._add("admin_panel", origin + "/admin")
        self._check("check_paths", not sensitive, ", ".join(item["path"] for item in results) or "none")
        self._tool_status = origin + " · " + str(len(results)) + " path(s)"

    def _hash_text(self, text):
        data = str(text).encode("utf-8")
        return {
            "md5": hashlib.md5(data).hexdigest(),
            "sha1": hashlib.sha1(data).hexdigest(),
            "sha256": hashlib.sha256(data).hexdigest(),
            "sha512": hashlib.sha512(data).hexdigest(),
        }

    def _password_strength(self, text):
        value = str(text or "")
        pool = 0
        if re.search(r"[a-z]", value):
            pool += 26
        if re.search(r"[A-Z]", value):
            pool += 26
        if re.search(r"[0-9]", value):
            pool += 10
        if re.search(r"[^A-Za-z0-9]", value):
            pool += 33
        entropy = len(value) * (math.log(pool, 2) if pool else 0)
        if len(value) >= 14 and entropy >= 80:
            label = "strong"
        elif len(value) >= 10 and entropy >= 50:
            label = "medium"
        else:
            label = "weak"
        return {"length": len(value), "entropy": round(entropy, 1), "label": label}

    def _compute_hash(self):
        self._hash_result = self._hash_text(self._hash_input)
        self._hash_result.update(self._password_strength(self._hash_input))
        self.refresh()

    def _pick_target(self, ssid):
        def callback(value=None):
            self.set_setting("target_ssid", str(ssid))
            self._target_ssid = str(ssid)
            self._status = self._t("target_set")
            self.refresh()
            self.navigate("main")

        return callback

    def _refresh_scan(self):
        if self._scanning:
            return
        self._scanning = True
        self.refresh()
        worker = threading.Thread(target=self._scan_worker, name="captive-portal-scan")
        worker.daemon = True
        worker.start()

    def _scan_worker(self):
        try:
            self._scan_networks(True)
            self._analyze_networks()
            self._build_report()
        finally:
            self._scanning = False
            if self._alive:
                try:
                    self.refresh()
                except Exception:
                    pass

    def _detect(self):
        self._busy = True
        self.refresh()
        try:
            self._discover()
        finally:
            self._busy = False
            self.refresh()

    # ----------------------------------------------------------------- audit

    def _start(self):
        if self._busy:
            return
        if not self._consent:
            self._status = self._t("consent_required")
            self.refresh()
            return
        self._busy = True
        self._status = self._t("busy")
        self.refresh()
        worker = threading.Thread(target=self._worker, name="captive-portal-audit")
        worker.daemon = True
        worker.start()

    def _worker(self):
        try:
            self._run_checks()
        except Exception as error:
            self._status = str(error)
        finally:
            self._busy = False
            if self._alive:
                try:
                    self.refresh()
                except Exception:
                    pass

    def _run_checks(self):
        self._read_network()
        target = self._target_ssid or self._ssid
        if target and self._ssid and target != self._ssid:
            self._findings = []
            self._checks = []
            self._status = self._t("target_mismatch", target, self._ssid)
            self.refresh()
            return
        if not self._portal:
            self._discover()
        self._findings = []
        self._checks = []
        self._tls = {}
        self._tls_protocols = []
        self._exposures = []
        self._scan_networks()
        self._analyze_networks()
        portal = self._portal_url()
        if not portal:
            self._status = self._t("manual_portal")
            self.refresh()
            return
        self._portal = portal
        self._add("portal", portal)

        page = self._follow(portal)
        page_url = str(page.get("url", portal))
        body = str(page.get("body", "") or "")
        headers = dict(page.get("headers", {}) or {})
        self._check("check_portal", page.get("code", -1) not in (-1,), "HTTP " + str(page.get("code", -1)))
        self._meta["portal_final"] = page_url
        self._meta["portal_code"] = page.get("code", -1)
        self._meta["portal_title"] = self._title(body)

        is_https = page_url.lower().startswith("https://")
        https_response = None
        if is_https:
            self._check("check_https", True)
            self._tls = page.get("tls") or {}
        else:
            https_url = "https://" + portal.split("://", 1)[-1]
            https_response = self._http(https_url)
            supported = https_response.get("code", -1) not in (-1,) and not https_response.get("error")
            self._check("check_https", supported, "HTTP " + str(https_response.get("code", -1)))
            self._tls = https_response.get("tls") or {}
            if not supported:
                self._add("http_portal", portal)
            else:
                self._meta["https_url"] = https_url
                location = str(https_response.get("headers", {}).get("location", "") or "")
                if location.lower().startswith("http://"):
                    self._add("http_portal", location)

        if not self._tls.get("cipher") and https_response is None:
            self._tls = page.get("tls") or {}
        cert = self._tls or {}
        if cert.get("expired"):
            self._add("cert_issue", "expired: " + str(cert.get("expires", "")))
        elif cert.get("issuer"):
            self._check("check_https", True, str(cert.get("issuer", ""))[:80])

        forms = parse_forms(body)
        self._check("check_forms", True, "%d form(s)" % len(forms))
        password_forms = [form for form in forms if form.get("password")]
        for form in password_forms:
            action = form.get("action", "") or page_url
            absolute = self._absolute(page_url, action)
            scheme = absolute.split("://", 1)[0].lower() if "://" in absolute else "http"
            if scheme == "http":
                self._add("login_http", absolute)
            if form.get("method", "get") == "get":
                self._add("password_get", absolute)
            if not form.get("csrf"):
                self._add("csrf_missing", absolute)
            if form.get("autocomplete") == "off":
                self._check("check_forms", True, "autocomplete=off")
        if body and page_url.lower().startswith("https://"):
            if re.search(r"(?:src|href)\s*=\s*[\"']http://", body, re.I):
                mixed = re.findall(r"(?:src|href)\s*=\s*[\"'](http://[^\"']+)", body, re.I)[:3]
                self._add("mixed_content", "; ".join(mixed))

        self._analyze_headers(headers, page_url, is_https)
        self._analyze_cookies(page.get("raw_headers", {}) or {}, is_https)
        self._analyze_redirects(page_url)
        self._analyze_reflection(page_url)
        self._analyze_garden()
        self._analyze_tls(portal)
        self._analyze_dhcp()
        self._scan_gateway()
        self._fingerprint_page(headers, body)
        self._check_exposures(page_url)
        self._check_cors(page_url)
        self._check_methods(page_url)
        self._check_js(body, page_url)
        self._check_cache(headers, bool(password_forms))

        self._findings.sort(key=lambda item: severity_rank(item.get("severity")))
        self._status = self._t("scan_done")
        self._build_report()
        self._publish()
        self.refresh()

    def _title(self, body):
        match = re.search(r"<title[^>]*>(.*?)</title>", body or "", re.S | re.I)
        return html.unescape(match.group(1)).strip()[:120] if match else ""

    def _analyze_headers(self, headers, page_url, is_https):
        server = str(headers.get("server", "") or "")
        powered = str(headers.get("x-powered-by", "") or "")
        if server or powered:
            self._add("banner", (server + " " + powered).strip())
        if is_https and not headers.get("strict-transport-security"):
            self._add("hsts_missing", page_url)
        missing = []
        if not headers.get("content-security-policy"):
            missing.append("Content-Security-Policy")
        if not headers.get("x-frame-options") and "frame-ancestors" not in str(headers.get("content-security-policy", "")):
            missing.append("X-Frame-Options")
        if not headers.get("referrer-policy"):
            missing.append("Referrer-Policy")
        if not headers.get("x-content-type-options"):
            missing.append("X-Content-Type-Options")
        self._check("check_headers", not missing, ", ".join(missing))
        if missing:
            self._add("headers_missing", ", ".join(missing))
        csp = str(headers.get("content-security-policy", "") or "")
        csp_weak = bool(csp) and ("unsafe-inline" in csp.lower() or "unsafe-eval" in csp.lower())
        self._check("check_csp", bool(csp) and not csp_weak, csp[:120] or "missing")
        if csp_weak:
            self._add("csp_weak", csp[:180])
        if is_https:
            hsts = str(headers.get("strict-transport-security", "") or "")
            age = re.search(r"max-age=(\d+)", hsts, re.I)
            hsts_weak = bool(hsts) and (not age or int(age.group(1)) < 15552000 or "includesubdomains" not in hsts.lower())
            self._check("check_hsts", bool(hsts) and not hsts_weak, hsts[:120] or "missing")
            if hsts_weak:
                self._add("hsts_weak", hsts[:180])

    def _analyze_cookies(self, raw_headers, is_https):
        cookies = parse_cookies(raw_headers)
        self._check("check_cookies", bool(cookies), "%d cookie(s)" % len(cookies))
        weak = []
        for cookie in cookies:
            missing = []
            if is_https and not cookie["secure"]:
                missing.append("Secure")
            if not cookie["httponly"]:
                missing.append("HttpOnly")
            if not cookie["samesite"]:
                missing.append("SameSite")
            if missing:
                weak.append(cookie["name"] + " (" + ", ".join(missing) + ")")
        if weak:
            self._add("cookie_flags", "; ".join(weak[:4]))

    def _query(self, url, key, value):
        separator = "&" if "?" in url else "?"
        return url + separator + urllib.parse.quote(str(key), safe="") + "=" + urllib.parse.quote(str(value), safe="")

    def _analyze_redirects(self, portal):
        found = []
        for param in REDIRECT_PARAMS:
            target = self._query(portal, param, "https://example.com/")
            response = self._http(target)
            location = str(response.get("headers", {}).get("location", "") or "")
            if response.get("code") in (301, 302, 303, 307, 308) and "example.com" in location.lower():
                found.append(param + " → " + location)
        self._check("check_redirect", not found, "; ".join(found)[:160])
        if found:
            self._add("open_redirect", "; ".join(found[:3]))

    def _analyze_reflection(self, portal):
        marker = "dolphyprobe" + ("%06x" % random.getrandbits(24))
        payload = "<" + marker + ">"
        response = self._http(self._query(portal, "dolphy_probe", payload))
        body = str(response.get("body", "") or "")
        reflected = payload in body
        escaped = ("&lt;" + marker + "&gt;") in body
        self._check("check_reflection", not reflected, "raw" if reflected else ("encoded" if escaped else "not reflected"))
        if reflected:
            self._add("reflection", "parameter dolphy_probe reflected verbatim")

    def _analyze_garden(self):
        results = []
        blocked = 0
        for url, key in GARDEN:
            response = self._http(url)
            code = int(response.get("code", -1))
            reachable = code not in (-1,)
            if not reachable:
                blocked += 1
            results.append(self._t(key) + ": " + ("HTTP " + str(code) if reachable else "blocked"))
        self._check("check_garden", blocked > 0, "; ".join(results)[:160])
        self._meta["garden"] = results
        if blocked == 0:
            self._add("garden_open", "; ".join(results))

    # ---------------------------------------------------------------- output

    def _risk_score(self):
        counts = self._counts()
        return min(100, counts["critical"] * 25 + counts["high"] * 15 + counts["medium"] * 8 + counts["low"] * 3)

    def _counts(self):
        counts = {"critical": 0, "high": 0, "medium": 0, "low": 0, "info": 0}
        for item in self._findings:
            key = item.get("severity", "info")
            counts[key] = counts.get(key, 0) + 1
        return counts

    def _build_report(self):
        counts = self._counts()
        lines = [
            self._t("title") + " — " + self._t("report_title"),
            self._t("generated") + ": " + time.strftime("%Y-%m-%d %H:%M"),
            "",
            self._t("ssid") + ": " + (self._ssid or "?"),
            "BSSID: " + (self._bssid or "?"),
            self._t("gateway") + ": " + (self._gateway or "?"),
            self._t("portal") + ": " + (self._portal or "?"),
            self._t("target") + ": " + (self._target_ssid or "?"),
            self._t("security") + ": " + self._t("security_" + (self._security or "unknown")),
            self._t("networks_count", len(self._networks)),
            self._t("risk_score") + ": " + str(self._risk_score()) + "/100",
            "",
            self._t("findings") + ": " + self._t("found_summary", len(self._findings), counts["critical"], counts["high"]),
        ]
        for item in self._findings:
            lines.append("")
            lines.append("[" + self._t("sev_" + item["severity"]).upper() + "] " + self._t("find_" + item["id"]))
            if item.get("evidence"):
                lines.append("  " + self._t("find_detail") + ": " + item["evidence"])
            if item.get("fixKey"):
                lines.append("  " + self._t("fix") + ": " + self._t(item["fixKey"]))
        lines.extend(["", self._t("checks") + ":"])
        for check in self._checks:
            mark = "OK" if check.get("ok") else "WARN"
            lines.append(" [" + mark + "] " + self._t(check["key"]) + (": " + check["note"] if check.get("note") else ""))
        if self._networks:
            lines.extend(["", self._t("survey_card") + ":"])
            for net in self._networks[:12]:
                lines.append(
                    " %s · ch %s (%s GHz, %s MHz) · %s · %s · risk %s"
                    % (net.get("ssid", "?"), net.get("channel", 0), net.get("band", "?"), net.get("width", "?"), self._t("security_" + net.get("security", "unknown")), net.get("vendor", "unknown"), net.get("risk", 0))
                )
        if self._gateway_ports:
            lines.append(self._t("open_ports") + ": " + ", ".join(str(port) for port in self._gateway_ports))
        if self._fingerprint:
            fp = [item for item in [self._fingerprint.get("server", ""), self._fingerprint.get("powered", ""), self._fingerprint.get("generator", "")] if item] + list(self._fingerprint.get("waf", []))
            if fp:
                lines.append(self._t("fingerprint_card") + ": " + " · ".join(fp))
        if self._meta.get("dhcp_server") or self._meta.get("dns2"):
            lines.append(self._t("dhcp_server") + ": " + str(self._meta.get("dhcp_server", "?")) + " · " + self._t("dns_servers") + ": " + ", ".join([item for item in [self._meta.get("dns1", ""), self._meta.get("dns2", "")] if item]))
        if self._port_results:
            lines.append(self._t("port_results") + ": " + ", ".join(str(item["port"]) for item in self._port_results))
        if self._dns_results.get("ips"):
            lines.append("DNS: " + ", ".join(self._dns_results.get("ips", [])))
        if self._path_results:
            lines.append(self._t("path_results") + ": " + ", ".join(item["path"] + " (" + str(item["code"]) + ")" for item in self._path_results))
        if self._meta.get("garden"):
            lines.append("")
            lines.append(self._t("check_garden") + ": " + "; ".join(self._meta["garden"]))
        tls = self._tls or {}
        if tls:
            lines.extend(
                [
                    "",
                    self._t("tls") + ":",
                    " " + self._t("cert_issuer") + ": " + str(tls.get("issuer", "?")),
                    " " + self._t("cert_expires") + ": " + str(tls.get("expires", "?")),
                    " " + self._t("cipher") + ": " + str(tls.get("cipher", "?")),
                ]
            )
        if self._tls_protocols:
            lines.append(self._t("tls_protocols") + ": " + ", ".join(self._tls_protocols))
        if self._exposures:
            lines.append(self._t("exposed_card") + ": " + ", ".join(self._exposures))
        lines.extend(["", self._t("limitations") + ": " + self._t("limitations_body")])
        self._report = "\n".join(lines)

    def _publish(self):
        counts = self._counts()
        try:
            self.export_java_object(
                EXPORT_KEY,
                json.dumps(
                    {
                        "portal": self._portal,
                        "ssid": self._ssid,
                        "target": self._target_ssid,
                        "security": self._security,
                        "scanned": len(self._networks),
                        "risk": self._risk_score(),
                        "rogue": self._survey_summary.get("rogue", 0),
                        "openPorts": self._gateway_ports,
                        "fingerprint": self._fingerprint,
                        "findings": [{"id": item["id"], "severity": item["severity"]} for item in self._findings],
                        "counts": counts,
                        "generatedAt": int(time.time()),
                    },
                    ensure_ascii=False,
                ),
            )
        except Exception:
            pass

    def _copy_report(self):
        if not self._report:
            self._build_report()
        try:
            self.api.getAndroid().clipboardSet(self._report)
            self._status = self._t("copied")
            self.toast(self._t("copied"))
        except Exception as error:
            self._status = str(error)
        self.refresh()

    def _share_report(self):
        if not self._report:
            self._build_report()
        try:
            self.api.getAndroid().filesShare(REPORT_PATH, "text/plain", self._t("report_title"))
            self._status = self._t("shared")
        except Exception as error:
            self._status = str(error)
        self.refresh()

    def _export_report(self):
        if not self._report:
            self._build_report()
        try:
            ok = bool(self.api.getAndroid().filesWrite(REPORT_PATH, self._report))
            self._status = self._t("exported") if ok else self._t("export_failed")
            if ok:
                self.toast(self._t("exported"))
        except Exception as error:
            self._status = self._t("export_failed") + ": " + str(error)
        self.refresh()

    def _go(self, screen):
        def callback(value=None):
            self.navigate(screen)

        return callback

    def _set_consent(self, value):
        self._consent = bool(value)
        self.refresh()

    def _set_portal(self, value):
        self._portal_input = str(value or "")
        self.refresh()

    def _set_language(self, value):
        raw = str(value or "").strip().lower()
        if raw == "auto":
            self.set_setting("language", "")
        elif raw in STRINGS:
            self.set_setting("language", raw)
        self._build_report()
        self.refresh()

    def _open_wifi(self):
        try:
            self.api.getDevice().wifiOpenSettings()
        except Exception:
            pass

    # ---------------------------------------------------------------- screens

    def screen_networks(self, ui, api, state):
        rows = []
        for net in self._networks:
            detail = self._t("security_" + net.get("security", "unknown")) + " · " + str(net.get("rssi", -100)) + " dBm"
            if net.get("channel"):
                detail += " · ch " + str(net["channel"])
            if net.get("band"):
                detail += " (" + net["band"] + " GHz, " + str(net.get("width", "?")) + " MHz)"
            if net.get("vendor", "unknown") != "unknown":
                detail += " · " + net["vendor"]
            if net.get("wps"):
                detail += " · WPS"
            if net.get("pmf"):
                detail += " · PMF"
            elif net.get("security") in ("wpa2", "wpa3"):
                detail += " · no PMF"
            detail += " · risk " + str(net.get("risk", 0))
            if net.get("current"):
                detail += " · " + self._t("current_connected")
            rows.append(ui.settings_row(net["ssid"], detail, "wifi", on_click=self._pick_target(net["ssid"])))
        if not rows:
            rows = [ui.text(self._t("scan_empty"), "bodySmall")]
        saved_rows = []
        for item in self._saved_networks[:12]:
            ssid = str(item.get("ssid", "") or "")
            if ssid:
                saved_rows.append(ui.settings_row(ssid, self._t("saved_networks"), "lock", on_click=self._pick_target(ssid)))
        body = [
            ui.card(
                [
                    ui.row(
                        [
                            ui.icon("wifi", 34),
                            ui.column(
                                [
                                    ui.text(self._t("current_network"), "titleMedium"),
                                    ui.text((self._ssid or "?") + " · " + self._t("security_" + (self._security or "unknown")), "bodySmall"),
                                ],
                                spacing=2,
                            ),
                        ],
                        spacing=10,
                    ),
                    ui.settings_row(self._t("target"), self._target_ssid or self._t("scan_empty"), "flag"),
                    ui.text(self._t("switch_hint"), "bodySmall"),
                ]
            ),
            ui.row(
                [
                    ui.button(
                        self._t("scan_now"),
                        lambda value=None: self._refresh_scan(),
                        enabled=not self._scanning,
                        fill_max_width=True,
                    ),
                    ui.button(self._t("open_wifi"), lambda value=None: self._open_wifi(), style="tonal", fill_max_width=True),
                ],
                spacing=8,
            ),
            ui.text(self._t("nearby_networks") + (" · " + self._scan_at if self._scan_at else ""), "titleMedium"),
            ui.segmented_list(rows),
        ]
        if saved_rows:
            body.append(ui.text(self._t("saved_networks"), "titleMedium"))
            body.append(ui.segmented_list(saved_rows))
        if self._scanning:
            body.append(ui.linear_progress(None))
            body.append(ui.text(self._t("scanning"), "bodySmall"))
        return ui.scaffold(
            title=self._t("networks_title"),
            content=ui.lazy_column(body, padding=16, spacing=12, fill_max_size=True),
        )

    def screen_tools(self, ui, api, state):
        host = self._host or self._gateway
        port_rows = [ui.settings_row(str(item["port"]) + " · " + item["service"], "open", "lan") for item in self._port_results] or [ui.text(self._t("no_results"), "bodySmall")]
        dns = self._dns_results or {}
        dns_rows = []
        if dns.get("ips"):
            dns_rows.append(ui.settings_row("A/AAAA", ", ".join(dns.get("ips", [])), "dns"))
        if dns.get("reverse"):
            dns_rows.append(ui.settings_row(self._t("reverse_dns"), dns.get("reverse", ""), "swap_horiz"))
        if dns.get("mx"):
            dns_rows.append(ui.settings_row("MX", ", ".join(dns.get("mx", [])), "mail"))
        if dns.get("txt"):
            dns_rows.append(ui.settings_row("TXT", ", ".join(dns.get("txt", [])), "text_snippet"))
        for sub, values in (dns.get("subs") or {}).items():
            dns_rows.append(ui.settings_row(sub, ", ".join(values), "subdirectory_arrow_right"))
        if not dns_rows:
            dns_rows = [ui.text(self._t("no_results"), "bodySmall")]
        path_rows = [ui.settings_row(item["path"], "HTTP " + str(item["code"]) + " · " + str(item["size"]) + " B", "link") for item in self._path_results] or [ui.text(self._t("no_results"), "bodySmall")]
        hash_rows = []
        for algorithm in ("md5", "sha1", "sha256", "sha512"):
            if self._hash_result.get(algorithm):
                hash_rows.append(ui.settings_row(algorithm.upper(), self._hash_result[algorithm], "fingerprint"))
        if self._hash_result:
            hash_rows.append(ui.settings_row(self._t("strength"), self._t(self._hash_result.get("label", "weak")) + " · " + str(self._hash_result.get("entropy", 0)) + " bits", "security"))
        body = [
            ui.card(
                [
                    ui.text_field(host, self._set_host, self._t("host_hint"), single_line=True),
                    ui.row(
                        [
                            ui.button(self._t("scan_ports"), lambda value=None: self._run_tool(self._port_scan_worker), enabled=not self._tools_busy, fill_max_width=True),
                            ui.button(self._t("dns_recon"), lambda value=None: self._run_tool(self._dns_worker), style="tonal", enabled=not self._tools_busy, fill_max_width=True),
                            ui.button(self._t("web_paths"), lambda value=None: self._run_tool(self._path_scan_worker), style="outlined", enabled=not self._tools_busy, fill_max_width=True),
                        ],
                        spacing=6,
                    ),
                ]
            ),
            ui.card([ui.text(self._t("port_results"), "titleMedium"), ui.segmented_list(port_rows)]),
            ui.card([ui.text(self._t("dns_results"), "titleMedium"), ui.segmented_list(dns_rows)]),
            ui.card([ui.text(self._t("path_results"), "titleMedium"), ui.segmented_list(path_rows)]),
            ui.card(
                [
                    ui.text(self._t("crypto_lab"), "titleMedium"),
                    ui.text_field(self._hash_input, self._set_hash_input, self._t("hash_input"), single_line=True),
                    ui.button(self._t("hash_now"), lambda value=None: self._compute_hash(), fill_max_width=True),
                    ui.segmented_list(hash_rows or [ui.text(self._t("no_results"), "bodySmall")]),
                ]
            ),
        ]
        if self._tools_busy:
            body.insert(1, ui.linear_progress(None))
        if self._tool_status:
            body.append(ui.text(self._tool_status, "bodySmall"))
        return ui.scaffold(title=self._t("tools_title"), content=ui.lazy_column(body, padding=16, spacing=12, fill_max_size=True))

    def screen_main(self, ui, api, state):
        counts = self._counts()
        findings_rows = []
        for item in self._findings[:8]:
            findings_rows.append(
                ui.settings_row(
                    self._t("find_" + item["id"]),
                    self._t("sev_" + item["severity"]) + (" · " + item["evidence"][:90] if item.get("evidence") else ""),
                    "security",
                )
            )
        if not findings_rows:
            findings_rows = [ui.text(self._t("no_findings"), "bodySmall")]

        portal_value = self._portal_input or self._portal
        header = ui.card(
            [
                ui.row(
                    [
                        ui.icon("wifi", 40),
                        ui.column(
                            [
                                ui.text(self._t("title"), "titleLarge"),
                                ui.text(self._t("subtitle"), "bodySmall"),
                            ],
                            spacing=2,
                        ),
                    ],
                    spacing=12,
                ),
                ui.segmented_list(
                    [
                        ui.settings_row(self._t("ssid"), self._ssid or "?", "wifi"),
                        ui.settings_row(self._t("target"), self._target_ssid or "?", "flag"),
                        ui.settings_row(self._t("security"), self._t("security_" + (self._security or "unknown")), "lock"),
                        ui.settings_row(self._t("gateway"), self._gateway or "?", "lan"),
                        ui.settings_row(self._t("portal"), self._portal or self._t("no_portal"), "link"),
                        ui.settings_row(self._t("networks_count", len(self._networks)), str(len(self._networks)), "radar"),
                    ]
                ),
                ui.row(
                    [
                        ui.chip(self._t("portal_found") if self._portal else self._t("no_portal"), bool(self._portal)),
                        ui.chip(self._t("sev_critical") + " " + str(counts["critical"]), counts["critical"] > 0),
                        ui.chip(self._t("sev_high") + " " + str(counts["high"]), counts["high"] > 0),
                    ],
                    spacing=6,
                ),
            ]
        )

        scope = ui.card([ui.text(self._t("scope_note"), "bodySmall")])

        consent = ui.card(
            [
                ui.checkbox(self._consent, self._set_consent, self._t("consent"), self._t("consent_sub")),
                ui.text_field(portal_value, self._set_portal, self._t("portal_hint"), single_line=True),
            ]
        )

        network_controls = ui.row(
            [
                ui.button(self._t("choose_network"), self._go("networks"), style="outlined", fill_max_width=True),
                ui.button(
                    self._t("scan_now"),
                    lambda value=None: self._refresh_scan(),
                    style="text",
                    enabled=not self._scanning,
                    fill_max_width=True,
                ),
                ui.button(self._t("tools_title"), self._go("tools"), style="text", fill_max_width=True),
            ],
            spacing=8,
        )

        controls = ui.row(
            [
                ui.button(
                    self._t("detect"),
                    lambda value=None: self._detect(),
                    style="tonal",
                    enabled=not self._busy,
                    fill_max_width=True,
                ),
                ui.button(
                    self._t("run"),
                    lambda value=None: self._start(),
                    enabled=self._consent and not self._busy,
                    fill_max_width=True,
                ),
            ],
            spacing=8,
        )

        body = [header, scope, consent]
        if self._target_ssid and self._ssid and self._target_ssid != self._ssid:
            body.append(ui.card([ui.text(self._t("target_mismatch", self._target_ssid, self._ssid), "bodySmall")]))
        body.extend([network_controls, controls])
        survey = self._survey_summary or {}
        tools_rows = [
            ui.settings_row(
                self._t("survey_card"),
                self._t("survey_summary", survey.get("aps", 0), survey.get("channels", 0), survey.get("open", 0), survey.get("wps", 0)),
                "radar",
            ),
            ui.settings_row(self._t("rogue_count"), str(survey.get("rogue", 0)), "warning"),
            ui.settings_row(self._t("gateway_card"), ", ".join(str(port) for port in self._gateway_ports) or self._t("no_open_ports"), "router"),
            ui.settings_row(self._t("risk_score"), str(self._risk_score()) + "/100", "speed"),
        ]
        fingerprint = self._fingerprint or {}
        fp = [item for item in [fingerprint.get("server", ""), fingerprint.get("powered", ""), fingerprint.get("generator", "")] if item] + list(fingerprint.get("waf", []))
        if fp:
            tools_rows.append(ui.settings_row(self._t("fingerprint_card"), " · ".join(fp)[:120], "travel_explore"))
        body.append(ui.card([ui.text(self._t("tools_card"), "titleMedium"), ui.segmented_list(tools_rows), ui.text(self._t("tools_note"), "bodySmall")]))
        if self._busy:
            body.append(ui.linear_progress(None))
            body.append(ui.text(self._t("busy"), "bodySmall"))
        body.extend(
            [
                ui.text(self._t("findings") + " · " + self._t("found_summary", len(self._findings), counts["critical"], counts["high"]), "titleMedium"),
                ui.segmented_list(findings_rows),
            ]
        )
        if self._checks:
            check_rows = []
            for check in self._checks[:14]:
                check_rows.append(
                    ui.settings_row(
                        self._t(check["key"]),
                        "OK" if check.get("ok") else (check.get("note") or "WARN"),
                        "check" if check.get("ok") else "warning",
                    )
                )
            body.append(ui.card([ui.text(self._t("checks_card"), "titleMedium"), ui.segmented_list(check_rows)]))
        if self._tls:
            body.append(
                ui.card(
                    [
                        ui.text(self._t("tls"), "titleMedium"),
                        ui.segmented_list(
                            [
                                ui.settings_row(self._t("cert_issuer"), str(self._tls.get("issuer", "?")), "verified_user"),
                                ui.settings_row(self._t("cert_expires"), str(self._tls.get("expires", "?")), "schedule"),
                                ui.settings_row(self._t("cipher"), str(self._tls.get("cipher", "?")), "lock"),
                            ]
                        ),
                    ]
                )
            )
        if self._report:
            body.append(ui.text(self._report[:1200], "bodySmall"))
        body.append(
            ui.row(
                [
                    ui.button(self._t("report_btn"), self._go("report"), style="tonal", fill_max_width=True),
                    ui.button(self._t("open_wifi"), lambda value=None: self._open_wifi(), style="text", fill_max_width=True),
                ],
                spacing=8,
            )
        )
        if self._status:
            body.append(ui.text(self._status, "bodySmall"))
        body.append(
            ui.button_group(
                [
                    ["auto", self._t("language_auto")],
                    ["ar", "العربية"],
                    ["en", "English"],
                    ["ru", "Русский"],
                ],
                str(self.get_setting("language", "") or "auto"),
                on_select=self._set_language,
            )
        )
        return ui.scaffold(
            title=self._t("title"),
            content=ui.lazy_column(body, padding=16, spacing=12, fill_max_size=True),
        )

    def screen_report(self, ui, api, state):
        if not self._report:
            self._build_report()
        return ui.scaffold(
            title=self._t("report_title"),
            content=ui.lazy_column(
                [
                    ui.log_panel(self._report or self._t("empty_report"), 520),
                    ui.row(
                        [
                            ui.button(self._t("copy"), lambda value=None: self._copy_report(), fill_max_width=True),
                            ui.button(self._t("share"), lambda value=None: self._share_report(), style="tonal", fill_max_width=True),
                        ],
                        spacing=8,
                    ),
                    ui.row(
                        [
                            ui.button(self._t("export"), lambda value=None: self._export_report(), style="outlined", fill_max_width=True),
                            ui.button(self._t("refresh"), lambda value=None: (self._build_report(), self.refresh()), style="text", fill_max_width=True),
                        ],
                        spacing=8,
                    ),
                    ui.text(self._status or "", "bodySmall"),
                ],
                padding=16,
                spacing=12,
                fill_max_size=True,
            ),
        )

    # --------------------------------------------------------------- services

    def service_net_captive_audit(self, payload):
        counts = self._counts()
        return {
            "ok": True,
            "ran": bool(self._report),
            "portal": self._portal,
            "ssid": self._ssid,
            "target": self._target_ssid,
            "security": self._security,
            "scanned": len(self._networks),
            "risk": self._risk_score(),
            "rogue": self._survey_summary.get("rogue", 0),
            "open_ports": self._gateway_ports,
            "fingerprint": self._fingerprint,
            "findings": len(self._findings),
            "counts": counts,
            "message": self._t("service_ready"),
        }
